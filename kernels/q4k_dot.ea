// q4k_dot.ea — Q4_K × Q8_K dot product kernel (SSSE3/AVX2)
//
// Inline f16→f32 via pow2 table. Vector accumulation: scale applied in i32x8
// domain, single reduce_add per block (not per j-iteration).

#[cfg(x86_64)]

func ubyte(p: *restrict u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

func f16_load(p: *restrict u8, off: i32, pow2: *restrict f32) -> f32 {
    let raw: i32 = ubyte(p, off) | (ubyte(p, off + 1) << 8)
    let exp: i32 = (raw >> 10) & 31
    if exp == 0 { return 0.0 } else { return pow2[exp] * (1.0 + to_f32(raw & 1023) * 0.0009765625) }
}

func get_scale(p: *restrict u8, sp: i32, j: i32) -> i32 {
    if j < 2 {
        return ubyte(p, sp + j*2) & 63
    }
    return (ubyte(p, sp + j*2 + 4) & 15) | ((ubyte(p, sp + j*2 - 4) >> 6) << 4)
}

func get_scale_hi(p: *restrict u8, sp: i32, j: i32) -> i32 {
    if j < 2 {
        return ubyte(p, sp + j*2 + 1) & 63
    }
    return (ubyte(p, sp + j*2 + 5) & 15) | ((ubyte(p, sp + j*2 - 3) >> 6) << 4)
}

func row_mins(p: *restrict u8, sp: i32, bsums: *restrict i32, bs: i32) -> i32 {
    let mut s: i32 = 0
    let mut k: i32 = 0
    while k < 4 {
        s = s + (ubyte(p, sp + 4 + k) & 63) * (bsums[bs + k*2] + bsums[bs + k*2 + 1])
        k = k + 1
    }
    k = 0
    while k < 4 {
        s = s + ((ubyte(p, sp + 8 + k) >> 4) | ((ubyte(p, sp + 4 + k) >> 6) << 4)) * (bsums[bs + 8 + k*2] + bsums[bs + 8 + k*2 + 1])
        k = k + 1
    }
    return s
}

// Vector-accumulating dot for one Q4K block (256 elements).
// Returns i32x8 partial sums with scales applied — caller does one reduce_add.
func dot_block_vec(
    q4: *restrict u8, nib: i32, q8: *restrict i8, q8_off: i32,
    sp: i32, mask_lo: u8x32, shift4: u8x32
) -> i32x8 {
    let zero: i32x8 = splat(0)
    let mut acc: i32x8 = zero

    let p0: u8x32 = load(q4, nib)
    let q8_0a: i8x32 = load(q8, q8_off)
    let q8_0b: i8x32 = load(q8, q8_off + 32)
    acc = acc .+ maddubs_i32(p0 .& mask_lo, q8_0a) .* splat(get_scale(q4, sp, 0))
              .+ maddubs_i32(p0 .>> shift4, q8_0b) .* splat(get_scale_hi(q4, sp, 0))

    let p1: u8x32 = load(q4, nib + 32)
    let q8_1a: i8x32 = load(q8, q8_off + 64)
    let q8_1b: i8x32 = load(q8, q8_off + 96)
    acc = acc .+ maddubs_i32(p1 .& mask_lo, q8_1a) .* splat(get_scale(q4, sp, 1))
              .+ maddubs_i32(p1 .>> shift4, q8_1b) .* splat(get_scale_hi(q4, sp, 1))

    let p2: u8x32 = load(q4, nib + 64)
    let q8_2a: i8x32 = load(q8, q8_off + 128)
    let q8_2b: i8x32 = load(q8, q8_off + 160)
    acc = acc .+ maddubs_i32(p2 .& mask_lo, q8_2a) .* splat(get_scale(q4, sp, 2))
              .+ maddubs_i32(p2 .>> shift4, q8_2b) .* splat(get_scale_hi(q4, sp, 2))

    let p3: u8x32 = load(q4, nib + 96)
    let q8_3a: i8x32 = load(q8, q8_off + 192)
    let q8_3b: i8x32 = load(q8, q8_off + 224)
    acc = acc .+ maddubs_i32(p3 .& mask_lo, q8_3a) .* splat(get_scale(q4, sp, 3))
              .+ maddubs_i32(p3 .>> shift4, q8_3b) .* splat(get_scale_hi(q4, sp, 3))

    return acc
}

// Single-row dot product.
export func q4k_dot_q8k(
    q4: *restrict u8, q8: *restrict i8, bsums: *restrict i32,
    n_blocks: i32, q8_d: *restrict f32, pow2: *restrict f32
) -> f32 {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let mut result: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sumi: i32 = reduce_add(dot_block_vec(q4, bp + 16, q8, blk * 256, bp + 4, mask_lo, shift4))
        let qd: f32 = q8_d[blk]
        let d: f32 = f16_load(q4, bp, pow2) * qd
        let dm: f32 = f16_load(q4, bp + 2, pow2) * qd
        result = result + d * to_f32(sumi) - dm * to_f32(row_mins(q4, bp + 4, bsums, blk * 16))
        blk = blk + 1
    }
    return result
}

// 4-row dot product.
export func q4k_dot_q8k_4row(
    rw0: *restrict u8, rw1: *restrict u8, rw2: *restrict u8, rw3: *restrict u8,
    q8: *restrict i8, bsums: *restrict i32,
    out scores: *mut f32 [cap: 4],
    n_blocks: i32, q8_d: *restrict f32, pow2: *restrict f32
) {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let mut res0: f32 = 0.0
    let mut res1: f32 = 0.0
    let mut res2: f32 = 0.0
    let mut res3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256
        let bs: i32 = blk * 16

        let s0: i32 = reduce_add(dot_block_vec(rw0, nib, q8, q8o, sp, mask_lo, shift4))
        let s1: i32 = reduce_add(dot_block_vec(rw1, nib, q8, q8o, sp, mask_lo, shift4))
        let s2: i32 = reduce_add(dot_block_vec(rw2, nib, q8, q8o, sp, mask_lo, shift4))
        let s3: i32 = reduce_add(dot_block_vec(rw3, nib, q8, q8o, sp, mask_lo, shift4))

        let qd: f32 = q8_d[blk]
        res0 = res0 + f16_load(rw0, bp, pow2) * qd * to_f32(s0) - f16_load(rw0, bp+2, pow2) * qd * to_f32(row_mins(rw0, sp, bsums, bs))
        res1 = res1 + f16_load(rw1, bp, pow2) * qd * to_f32(s1) - f16_load(rw1, bp+2, pow2) * qd * to_f32(row_mins(rw1, sp, bsums, bs))
        res2 = res2 + f16_load(rw2, bp, pow2) * qd * to_f32(s2) - f16_load(rw2, bp+2, pow2) * qd * to_f32(row_mins(rw2, sp, bsums, bs))
        res3 = res3 + f16_load(rw3, bp, pow2) * qd * to_f32(s3) - f16_load(rw3, bp+2, pow2) * qd * to_f32(row_mins(rw3, sp, bsums, bs))

        blk = blk + 1
    }
    scores[0] = res0
    scores[1] = res1
    scores[2] = res2
    scores[3] = res3
}

// Dual 4-row (gate+up).
export func q4k_dot_q8k_4row_dual(
    gw0: *restrict u8, gw1: *restrict u8, gw2: *restrict u8, gw3: *restrict u8,
    uw0: *restrict u8, uw1: *restrict u8, uw2: *restrict u8, uw3: *restrict u8,
    q8: *restrict i8, bsums: *restrict i32,
    out gate_scores: *mut f32 [cap: 4], out up_scores: *mut f32 [cap: 4],
    n_blocks: i32, q8_d: *restrict f32, pow2: *restrict f32
) {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let mut gr0: f32 = 0.0
    let mut gr1: f32 = 0.0
    let mut gr2: f32 = 0.0
    let mut gr3: f32 = 0.0
    let mut ur0: f32 = 0.0
    let mut ur1: f32 = 0.0
    let mut ur2: f32 = 0.0
    let mut ur3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256
        let bs: i32 = blk * 16

        let gs0: i32 = reduce_add(dot_block_vec(gw0, nib, q8, q8o, sp, mask_lo, shift4))
        let gs1: i32 = reduce_add(dot_block_vec(gw1, nib, q8, q8o, sp, mask_lo, shift4))
        let gs2: i32 = reduce_add(dot_block_vec(gw2, nib, q8, q8o, sp, mask_lo, shift4))
        let gs3: i32 = reduce_add(dot_block_vec(gw3, nib, q8, q8o, sp, mask_lo, shift4))
        let us0: i32 = reduce_add(dot_block_vec(uw0, nib, q8, q8o, sp, mask_lo, shift4))
        let us1: i32 = reduce_add(dot_block_vec(uw1, nib, q8, q8o, sp, mask_lo, shift4))
        let us2: i32 = reduce_add(dot_block_vec(uw2, nib, q8, q8o, sp, mask_lo, shift4))
        let us3: i32 = reduce_add(dot_block_vec(uw3, nib, q8, q8o, sp, mask_lo, shift4))

        let qd: f32 = q8_d[blk]
        gr0 = gr0 + f16_load(gw0, bp, pow2)*qd*to_f32(gs0) - f16_load(gw0, bp+2, pow2)*qd*to_f32(row_mins(gw0, sp, bsums, bs))
        gr1 = gr1 + f16_load(gw1, bp, pow2)*qd*to_f32(gs1) - f16_load(gw1, bp+2, pow2)*qd*to_f32(row_mins(gw1, sp, bsums, bs))
        gr2 = gr2 + f16_load(gw2, bp, pow2)*qd*to_f32(gs2) - f16_load(gw2, bp+2, pow2)*qd*to_f32(row_mins(gw2, sp, bsums, bs))
        gr3 = gr3 + f16_load(gw3, bp, pow2)*qd*to_f32(gs3) - f16_load(gw3, bp+2, pow2)*qd*to_f32(row_mins(gw3, sp, bsums, bs))
        ur0 = ur0 + f16_load(uw0, bp, pow2)*qd*to_f32(us0) - f16_load(uw0, bp+2, pow2)*qd*to_f32(row_mins(uw0, sp, bsums, bs))
        ur1 = ur1 + f16_load(uw1, bp, pow2)*qd*to_f32(us1) - f16_load(uw1, bp+2, pow2)*qd*to_f32(row_mins(uw1, sp, bsums, bs))
        ur2 = ur2 + f16_load(uw2, bp, pow2)*qd*to_f32(us2) - f16_load(uw2, bp+2, pow2)*qd*to_f32(row_mins(uw2, sp, bsums, bs))
        ur3 = ur3 + f16_load(uw3, bp, pow2)*qd*to_f32(us3) - f16_load(uw3, bp+2, pow2)*qd*to_f32(row_mins(uw3, sp, bsums, bs))

        blk = blk + 1
    }
    gate_scores[0] = gr0
    gate_scores[1] = gr1
    gate_scores[2] = gr2
    gate_scores[3] = gr3
    up_scores[0] = ur0
    up_scores[1] = ur1
    up_scores[2] = ur2
    up_scores[3] = ur3
}
