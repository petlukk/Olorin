// q4k_dot.ea — Q4_K × Q8_K dot product kernel (SSSE3/AVX2)
//
// Inline f16→f32 via pow2 table (faster than F16C for 2 values per block).
// maddubs_i16 (pmaddubsw) → madd_i16(scale, ...) (pmaddwd).
// Scale baked into madd_i16 — 2 instructions, not 3.

#[cfg(x86_64)]

func ubyte(p: *restrict u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

func f16_load(p: *restrict u8, off: i32, pow2: *restrict f32) -> f32 {
    let raw: i32 = ubyte(p, off) | (ubyte(p, off + 1) << 8)
    let exp: i32 = (raw >> 10) & 31
    if exp == 0 {
        // Subnormal: value = 2^(-14) * (mantissa / 1024)
        return pow2[1] * to_f32(raw & 1023) * 0.0009765625
    } else {
        return pow2[exp] * (1.0 + to_f32(raw & 1023) * 0.0009765625)
    }
}

// Mins correction — fully SIMD: hadd_i16 + vector literal mins + madd_i16.
// Matches llama.cpp: phaddw + pinsrw(mins) + pmaddwd + reduce.
func row_mins(p: *restrict u8, sp: i32, bsums: *restrict i16, bs: i32) -> i32 {
    // SIMD bsums pairing: load 16 × i16, hadd → 8 × i16
    let bs_lo: i16x8 = load(bsums, bs)
    let bs_hi: i16x8 = load(bsums, bs + 8)
    let bp: i16x8 = hadd_i16(bs_lo, bs_hi)

    // Construct mins vector from packed scale bytes (8 × pinsrw)
    let mins: i16x8 = [
        to_i16(ubyte(p, sp + 4) & 63),
        to_i16(ubyte(p, sp + 5) & 63),
        to_i16(ubyte(p, sp + 6) & 63),
        to_i16(ubyte(p, sp + 7) & 63),
        to_i16((ubyte(p, sp + 8) >> 4) | ((ubyte(p, sp + 4) >> 6) << 4)),
        to_i16((ubyte(p, sp + 9) >> 4) | ((ubyte(p, sp + 5) >> 6) << 4)),
        to_i16((ubyte(p, sp + 10) >> 4) | ((ubyte(p, sp + 6) >> 6) << 4)),
        to_i16((ubyte(p, sp + 11) >> 4) | ((ubyte(p, sp + 7) >> 6) << 4))
    ]

    // madd_i16: mins[0]*bp[0]+mins[1]*bp[1], ... → 4 × i32, then reduce
    return reduce_add(madd_i16(mins, bp))
}

// Mins correction with pre-paired bsums (avoids redundant hadd in 4row/dual).
func row_mins_bp(p: *restrict u8, sp: i32, bp: i16x8) -> i32 {
    let mins: i16x8 = [
        to_i16(ubyte(p, sp + 4) & 63),
        to_i16(ubyte(p, sp + 5) & 63),
        to_i16(ubyte(p, sp + 6) & 63),
        to_i16(ubyte(p, sp + 7) & 63),
        to_i16((ubyte(p, sp + 8) >> 4) | ((ubyte(p, sp + 4) >> 6) << 4)),
        to_i16((ubyte(p, sp + 9) >> 4) | ((ubyte(p, sp + 5) >> 6) << 4)),
        to_i16((ubyte(p, sp + 10) >> 4) | ((ubyte(p, sp + 6) >> 6) << 4)),
        to_i16((ubyte(p, sp + 11) >> 4) | ((ubyte(p, sp + 7) >> 6) << 4))
    ]
    return reduce_add(madd_i16(mins, bp))
}

// Vector-accumulating dot for one Q4K block (256 elements).
// Pre-extracts all 8 scales from 2 × u32 reads, then splat + madd_i16.
func dot_block_vec(
    q4: *restrict u8, nib: i32, q8: *restrict i8, q8_off: i32,
    sp: i32, mask_lo: u8x32, shift4: u8x32
) -> i32x8 {
    // Pre-extract all 8 scales: 2 u32 reads + bit manipulation (vs 8 × get_scale)
    let sp32: *restrict i32 = ptr_as_i32(ptr_as_i8(q4))
    let u0: i32 = sp32[sp / 4]
    let u2: i32 = sp32[(sp + 8) / 4]
    let sc03: i32 = u0 & 0x3f3f3f3f
    let sc47: i32 = (u2 & 0x0f0f0f0f) | (((u0 >> 6) & 0x03030303) << 4)

    // Splat all 8 scales to i16x16 (vpbroadcastw)
    let s0: i16x16 = splat(to_i16(sc03 & 255))
    let s1: i16x16 = splat(to_i16((sc03 >> 8) & 255))
    let s2: i16x16 = splat(to_i16((sc03 >> 16) & 255))
    let s3: i16x16 = splat(to_i16((sc03 >> 24) & 255))
    let s4: i16x16 = splat(to_i16(sc47 & 255))
    let s5: i16x16 = splat(to_i16((sc47 >> 8) & 255))
    let s6: i16x16 = splat(to_i16((sc47 >> 16) & 255))
    let s7: i16x16 = splat(to_i16((sc47 >> 24) & 255))

    let mut acc: i32x8 = splat(0)

    let p0: u8x32 = load(q4, nib)
    let q8_0a: i8x32 = load(q8, q8_off)
    let q8_0b: i8x32 = load(q8, q8_off + 32)
    acc = acc .+ madd_i16(s0, maddubs_i16(p0 .& mask_lo, q8_0a))
              .+ madd_i16(s1, maddubs_i16(p0 .>> shift4, q8_0b))

    let p1: u8x32 = load(q4, nib + 32)
    let q8_1a: i8x32 = load(q8, q8_off + 64)
    let q8_1b: i8x32 = load(q8, q8_off + 96)
    acc = acc .+ madd_i16(s2, maddubs_i16(p1 .& mask_lo, q8_1a))
              .+ madd_i16(s3, maddubs_i16(p1 .>> shift4, q8_1b))

    let p2: u8x32 = load(q4, nib + 64)
    let q8_2a: i8x32 = load(q8, q8_off + 128)
    let q8_2b: i8x32 = load(q8, q8_off + 160)
    acc = acc .+ madd_i16(s4, maddubs_i16(p2 .& mask_lo, q8_2a))
              .+ madd_i16(s5, maddubs_i16(p2 .>> shift4, q8_2b))

    let p3: u8x32 = load(q4, nib + 96)
    let q8_3a: i8x32 = load(q8, q8_off + 192)
    let q8_3b: i8x32 = load(q8, q8_off + 224)
    acc = acc .+ madd_i16(s6, maddubs_i16(p3 .& mask_lo, q8_3a))
              .+ madd_i16(s7, maddubs_i16(p3 .>> shift4, q8_3b))

    return acc
}

// Single-row dot product.
export func q4k_dot_q8k(
    q4: *restrict u8, q8: *restrict i8, bsums: *restrict i16,
    n_blocks: i32, q8_d: *restrict f32, pow2: *restrict f32
) -> f32 {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let mut result: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sumi: i32 = reduce_add(dot_block_vec(q4, bp + 16, q8, blk * 256, bp + 4, mask_lo, shift4))
        let qd: f32 = q8_d[blk]
        let d: f32 = f16_load(q4, bp, pow2) * qd
        let dm: f32 = f16_load(q4, bp + 2, pow2) * qd
        result = result + d * to_f32(sumi) - dm * to_f32(row_mins(q4, bp + 4, bsums, blk * 16))
        blk = blk + 1
    }
    return result
}

// 4-row dot product.
export func q4k_dot_q8k_4row(
    rw0: *restrict u8, rw1: *restrict u8, rw2: *restrict u8, rw3: *restrict u8,
    q8: *restrict i8, bsums: *restrict i16,
    out scores: *mut f32 [cap: 4],
    n_blocks: i32, q8_d: *restrict f32, pow2: *restrict f32
) {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let mut res0: f32 = 0.0
    let mut res1: f32 = 0.0
    let mut res2: f32 = 0.0
    let mut res3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256
        let bs: i32 = blk * 16

        let s0: i32 = reduce_add(dot_block_vec(rw0, nib, q8, q8o, sp, mask_lo, shift4))
        let s1: i32 = reduce_add(dot_block_vec(rw1, nib, q8, q8o, sp, mask_lo, shift4))
        let s2: i32 = reduce_add(dot_block_vec(rw2, nib, q8, q8o, sp, mask_lo, shift4))
        let s3: i32 = reduce_add(dot_block_vec(rw3, nib, q8, q8o, sp, mask_lo, shift4))

        // Hoist bsums pairing — shared across all 4 rows
        let blo: i16x8 = load(bsums, bs)
        let bhi: i16x8 = load(bsums, bs + 8)
        let paired: i16x8 = hadd_i16(blo, bhi)

        let qd: f32 = q8_d[blk]
        res0 = res0 + f16_load(rw0, bp, pow2) * qd * to_f32(s0) - f16_load(rw0, bp+2, pow2) * qd * to_f32(row_mins_bp(rw0, sp, paired))
        res1 = res1 + f16_load(rw1, bp, pow2) * qd * to_f32(s1) - f16_load(rw1, bp+2, pow2) * qd * to_f32(row_mins_bp(rw1, sp, paired))
        res2 = res2 + f16_load(rw2, bp, pow2) * qd * to_f32(s2) - f16_load(rw2, bp+2, pow2) * qd * to_f32(row_mins_bp(rw2, sp, paired))
        res3 = res3 + f16_load(rw3, bp, pow2) * qd * to_f32(s3) - f16_load(rw3, bp+2, pow2) * qd * to_f32(row_mins_bp(rw3, sp, paired))

        blk = blk + 1
    }
    scores[0] = res0
    scores[1] = res1
    scores[2] = res2
    scores[3] = res3
}

// Dual 4-row (gate+up).
export func q4k_dot_q8k_4row_dual(
    gw0: *restrict u8, gw1: *restrict u8, gw2: *restrict u8, gw3: *restrict u8,
    uw0: *restrict u8, uw1: *restrict u8, uw2: *restrict u8, uw3: *restrict u8,
    q8: *restrict i8, bsums: *restrict i16,
    out gate_scores: *mut f32 [cap: 4], out up_scores: *mut f32 [cap: 4],
    n_blocks: i32, q8_d: *restrict f32, pow2: *restrict f32
) {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let mut gr0: f32 = 0.0
    let mut gr1: f32 = 0.0
    let mut gr2: f32 = 0.0
    let mut gr3: f32 = 0.0
    let mut ur0: f32 = 0.0
    let mut ur1: f32 = 0.0
    let mut ur2: f32 = 0.0
    let mut ur3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256
        let bs: i32 = blk * 16

        let gs0: i32 = reduce_add(dot_block_vec(gw0, nib, q8, q8o, sp, mask_lo, shift4))
        let gs1: i32 = reduce_add(dot_block_vec(gw1, nib, q8, q8o, sp, mask_lo, shift4))
        let gs2: i32 = reduce_add(dot_block_vec(gw2, nib, q8, q8o, sp, mask_lo, shift4))
        let gs3: i32 = reduce_add(dot_block_vec(gw3, nib, q8, q8o, sp, mask_lo, shift4))
        let us0: i32 = reduce_add(dot_block_vec(uw0, nib, q8, q8o, sp, mask_lo, shift4))
        let us1: i32 = reduce_add(dot_block_vec(uw1, nib, q8, q8o, sp, mask_lo, shift4))
        let us2: i32 = reduce_add(dot_block_vec(uw2, nib, q8, q8o, sp, mask_lo, shift4))
        let us3: i32 = reduce_add(dot_block_vec(uw3, nib, q8, q8o, sp, mask_lo, shift4))

        // Hoist bsums pairing — shared across all 8 rows
        let blo: i16x8 = load(bsums, bs)
        let bhi: i16x8 = load(bsums, bs + 8)
        let paired: i16x8 = hadd_i16(blo, bhi)

        let qd: f32 = q8_d[blk]
        gr0 = gr0 + f16_load(gw0, bp, pow2)*qd*to_f32(gs0) - f16_load(gw0, bp+2, pow2)*qd*to_f32(row_mins_bp(gw0, sp, paired))
        gr1 = gr1 + f16_load(gw1, bp, pow2)*qd*to_f32(gs1) - f16_load(gw1, bp+2, pow2)*qd*to_f32(row_mins_bp(gw1, sp, paired))
        gr2 = gr2 + f16_load(gw2, bp, pow2)*qd*to_f32(gs2) - f16_load(gw2, bp+2, pow2)*qd*to_f32(row_mins_bp(gw2, sp, paired))
        gr3 = gr3 + f16_load(gw3, bp, pow2)*qd*to_f32(gs3) - f16_load(gw3, bp+2, pow2)*qd*to_f32(row_mins_bp(gw3, sp, paired))
        ur0 = ur0 + f16_load(uw0, bp, pow2)*qd*to_f32(us0) - f16_load(uw0, bp+2, pow2)*qd*to_f32(row_mins_bp(uw0, sp, paired))
        ur1 = ur1 + f16_load(uw1, bp, pow2)*qd*to_f32(us1) - f16_load(uw1, bp+2, pow2)*qd*to_f32(row_mins_bp(uw1, sp, paired))
        ur2 = ur2 + f16_load(uw2, bp, pow2)*qd*to_f32(us2) - f16_load(uw2, bp+2, pow2)*qd*to_f32(row_mins_bp(uw2, sp, paired))
        ur3 = ur3 + f16_load(uw3, bp, pow2)*qd*to_f32(us3) - f16_load(uw3, bp+2, pow2)*qd*to_f32(row_mins_bp(uw3, sp, paired))

        blk = blk + 1
    }
    gate_scores[0] = gr0
    gate_scores[1] = gr1
    gate_scores[2] = gr2
    gate_scores[3] = gr3
    up_scores[0] = ur0
    up_scores[1] = ur1
    up_scores[2] = ur2
    up_scores[3] = ur3
}
