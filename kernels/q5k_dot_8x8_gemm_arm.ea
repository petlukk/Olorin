// q5k_dot_8x8_gemm_arm.ea — Q5Kx8 × Q8Kx4 batched GEMM (ARM NEON + dotprod).
//
// Mirrors llama.cpp ggml_gemm_q5_K_8x4_q8_K (arch/arm/repack.cpp:3523) in
// structure; uses Olorin's accumulation order for bit-exactness vs the
// single-row q5k_dot_q8k reference (sumi stays in i32 across all sub-blocks
// within a block, one f32 mul per block per (token, col-half)).
//
// Consumes:
//   packed: block_q5_Kx8 repacked layout from q5k_repack_8x8
//     (1408 B/superblock: d[8]@0, dmin[8]@16, scales[96]@32, qh[256]@128, qs[1024]@384)
//   q8_a:  block_q8_Kx4 interleaved (1168 B/superblock, produced by q8k_repack_4)
//
// Output indexing: out[token * bs + col], for 4 tokens × 8 cols per call
// (caller loops across output-row tiles via work-stealing).

#[cfg(aarch64)]

export func q5k_8x8_q8k_gemm(
    packed: *restrict u8,
    q8_a:   *restrict u8,
    scratch: *mut u8,
    out:    *mut f32,
    bs:     i32,
    n:      i32,
    nr:     i32,
    nc:     i32
) {
    let nb: i32 = n / 256
    let nr4: i32 = nr / 4

    let m4b:    i8x16 = splat(15)
    let one:    i8x16 = splat(1)
    let two:    i8x16 = splat(2)
    let shift2: i8x16 = splat(2)
    let shift3: i8x16 = splat(3)
    let shift4: i8x16 = splat(4)
    let km1: i32 = 0x3f3f3f3f
    let km2: i32 = 0x0f0f0f0f
    let km3: i32 = 0x03030303

    let packed_i8:  *restrict i8  = ptr_as_i8(packed)
    let d16:        *restrict i16 = ptr_as_i16(packed_i8)
    let q8_i8:      *restrict i8  = ptr_as_i8(q8_a)
    let q8d_f32:    *restrict f32 = ptr_as_f32(q8_i8)
    let q8_bsums_i16: *restrict i16 = ptr_as_i16(q8_i8)
    let out_f32:    *mut f32 = ptr_as_f32(ptr_as_i8(out))
    let scratch_i8: *mut i8  = ptr_as_i8(scratch)

    let mut y: i32 = 0
    while y < nr4 {
        let mut x: i32 = 0
        while x < nc / 8 {
            // Per-(token, col-half) f32 accumulators across all blocks.
            let mut acc0_0: f32x4 = splat(0.0)
            let mut acc0_1: f32x4 = splat(0.0)
            let mut acc0_2: f32x4 = splat(0.0)
            let mut acc0_3: f32x4 = splat(0.0)
            let mut acc1_0: f32x4 = splat(0.0)
            let mut acc1_1: f32x4 = splat(0.0)
            let mut acc1_2: f32x4 = splat(0.0)
            let mut acc1_3: f32x4 = splat(0.0)

            let mut b: i32 = 0
            while b < nb {
                let bp: i32 = (x * nb + b) * 1408
                let ab: i32 = (y * nb + b) * 1168

            // Per-block d, dmin for 8 rows and q8_d for 4 tokens.
            let q5d_03:  f32x4 = cvt_f16_f32(load(d16, bp / 2))
            let q5d_47:  f32x4 = cvt_f16_f32(load(d16, bp / 2 + 4))
            let q5dm_03: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 8))
            let q5dm_47: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 12))

            let q8d0: f32 = q8d_f32[ab / 4]
            let q8d1: f32 = q8d_f32[ab / 4 + 1]
            let q8d2: f32 = q8d_f32[ab / 4 + 2]
            let q8d3: f32 = q8d_f32[ab / 4 + 3]

            // Per-(token, col-half) combined scales/mins.
            let sb_sc0_0: f32x4 = q5d_03 .* splat(q8d0)
            let sb_sc0_1: f32x4 = q5d_03 .* splat(q8d1)
            let sb_sc0_2: f32x4 = q5d_03 .* splat(q8d2)
            let sb_sc0_3: f32x4 = q5d_03 .* splat(q8d3)
            let sb_sc1_0: f32x4 = q5d_47 .* splat(q8d0)
            let sb_sc1_1: f32x4 = q5d_47 .* splat(q8d1)
            let sb_sc1_2: f32x4 = q5d_47 .* splat(q8d2)
            let sb_sc1_3: f32x4 = q5d_47 .* splat(q8d3)
            let sb_mn0_0: f32x4 = q5dm_03 .* splat(q8d0)
            let sb_mn0_1: f32x4 = q5dm_03 .* splat(q8d1)
            let sb_mn0_2: f32x4 = q5dm_03 .* splat(q8d2)
            let sb_mn0_3: f32x4 = q5dm_03 .* splat(q8d3)
            let sb_mn1_0: f32x4 = q5dm_47 .* splat(q8d0)
            let sb_mn1_1: f32x4 = q5dm_47 .* splat(q8d1)
            let sb_mn1_2: f32x4 = q5dm_47 .* splat(q8d2)
            let sb_mn1_3: f32x4 = q5dm_47 .* splat(q8d3)

            // Per-block i32 accumulators (kept across sub-blocks; match single-row
            // q5k_dot_q8k ordering for bit-exactness).
            let mut sumi0_0: i32x4 = splat(0)
            let mut sumi0_1: i32x4 = splat(0)
            let mut sumi0_2: i32x4 = splat(0)
            let mut sumi0_3: i32x4 = splat(0)
            let mut sumi1_0: i32x4 = splat(0)
            let mut sumi1_1: i32x4 = splat(0)
            let mut sumi1_2: i32x4 = splat(0)
            let mut sumi1_3: i32x4 = splat(0)
            let mut bias0_0: i32x4 = splat(0)
            let mut bias0_1: i32x4 = splat(0)
            let mut bias0_2: i32x4 = splat(0)
            let mut bias0_3: i32x4 = splat(0)
            let mut bias1_0: i32x4 = splat(0)
            let mut bias1_1: i32x4 = splat(0)
            let mut bias1_2: i32x4 = splat(0)
            let mut bias1_3: i32x4 = splat(0)

            // Copy qh vectors to scratch so we can shift in place across sub-blocks.
            // Layout: scratch[0..128]   = 8 × i8x16 for col_group 0 (rows 0-3 qh bits)
            //         scratch[128..256] = 8 × i8x16 for col_group 1 (rows 4-7 qh bits)
            let mut qi: i32 = 0
            while qi < 8 {
                let qh_c0: i8x16 = load(packed_i8, bp + 128 + qi * 32)
                let qh_c1: i8x16 = load(packed_i8, bp + 128 + qi * 32 + 16)
                store(scratch_i8, qi * 16, qh_c0)
                store(scratch_i8, 128 + qi * 16, qh_c1)
                qi = qi + 1
            }

            let mut sb: i32 = 0
            while sb < 4 {
                // Decode 2 × 12-byte scale groups (blk0, blk1) for this sub-block.
                let sp: *restrict i32 = ptr_as_i32(packed_i8)
                let sc0: i32 = bp + 32 + 24 * sb
                let u00: i32 = sp[sc0/4]
                let u01: i32 = sp[sc0/4 + 1]
                let u02: i32 = sp[sc0/4 + 2]
                let t00: i32 = u00 & km1                                      // s[0..3] blk0
                let t01: i32 = (u02 & km2) | (((u00 >> 6) & km3) << 4)        // s[4..7] blk0
                let t02: i32 = u01 & km1                                      // m[0..3] blk0
                let t03: i32 = ((u02 >> 4) & km2) | (((u01 >> 6) & km3) << 4) // m[4..7] blk0
                let sc1: i32 = sc0 + 12
                let u10: i32 = sp[sc1/4]
                let u11: i32 = sp[sc1/4 + 1]
                let u12: i32 = sp[sc1/4 + 2]
                let t10: i32 = u10 & km1                                      // s[0..3] blk1
                let t11: i32 = (u12 & km2) | (((u10 >> 6) & km3) << 4)        // s[4..7] blk1
                let t12: i32 = u11 & km1                                      // m[0..3] blk1
                let t13: i32 = ((u12 >> 4) & km2) | (((u11 >> 6) & km3) << 4) // m[4..7] blk1

                // Broadcast 4 scale bytes into i32x4 vectors per (col-half, blk-half).
                let sc_lo_0: i32x4 = [t00 & 255, (t00>>8)&255, (t00>>16)&255, (t00>>24)&255]
                let sc_lo_1: i32x4 = [t10 & 255, (t10>>8)&255, (t10>>16)&255, (t10>>24)&255]
                let sc_hi_0: i32x4 = [t01 & 255, (t01>>8)&255, (t01>>16)&255, (t01>>24)&255]
                let sc_hi_1: i32x4 = [t11 & 255, (t11>>8)&255, (t11>>16)&255, (t11>>24)&255]
                let mn_lo_0: i32x4 = [t02 & 255, (t02>>8)&255, (t02>>16)&255, (t02>>24)&255]
                let mn_lo_1: i32x4 = [t12 & 255, (t12>>8)&255, (t12>>16)&255, (t12>>24)&255]
                let mn_hi_0: i32x4 = [t03 & 255, (t03>>8)&255, (t03>>16)&255, (t03>>24)&255]
                let mn_hi_1: i32x4 = [t13 & 255, (t13>>8)&255, (t13>>16)&255, (t13>>24)&255]

                // Per-sub-block integer accs: 4 tokens × 2 col-halves × 2 blk-halves = 16 accs.
                let mut al03_0: i32x4 = splat(0)
                let mut al03_1: i32x4 = splat(0)
                let mut al03_2: i32x4 = splat(0)
                let mut al03_3: i32x4 = splat(0)
                let mut ah03_0: i32x4 = splat(0)
                let mut ah03_1: i32x4 = splat(0)
                let mut ah03_2: i32x4 = splat(0)
                let mut ah03_3: i32x4 = splat(0)
                let mut al47_0: i32x4 = splat(0)
                let mut al47_1: i32x4 = splat(0)
                let mut al47_2: i32x4 = splat(0)
                let mut al47_3: i32x4 = splat(0)
                let mut ah47_0: i32x4 = splat(0)
                let mut ah47_1: i32x4 = splat(0)
                let mut ah47_2: i32x4 = splat(0)
                let mut ah47_3: i32x4 = splat(0)

                let qs_base:       i32 = bp + 384 + sb * 256
                let q8_blk0_base:  i32 = ab + 16 + sb * 256
                let q8_blk1_base:  i32 = q8_blk0_base + 128

                let mut k: i32 = 0
                while k < 8 {
                    let q8_blk0: i8x16 = load(q8_i8, q8_blk0_base + k * 16)
                    let q8_blk1: i8x16 = load(q8_i8, q8_blk1_base + k * 16)
                    let qs_c0:   i8x16 = load(packed_i8, qs_base + k * 32)
                    let qs_c1:   i8x16 = load(packed_i8, qs_base + k * 32 + 16)

                    let qh_c0_k: i8x16 = load(scratch_i8, k * 16)
                    let qh_c1_k: i8x16 = load(scratch_i8, 128 + k * 16)

                    let hbit_lo_c0: i8x16 = (qh_c0_k .& one) .<< shift4
                    let hbit_hi_c0: i8x16 = (qh_c0_k .& two) .<< shift3
                    let hbit_lo_c1: i8x16 = (qh_c1_k .& one) .<< shift4
                    let hbit_hi_c1: i8x16 = (qh_c1_k .& two) .<< shift3

                    let q5_lo_c0: i8x16 = (qs_c0 .& m4b) .| hbit_lo_c0
                    let q5_hi_c0: i8x16 = ((qs_c0 .>> shift4) .& m4b) .| hbit_hi_c0
                    let q5_lo_c1: i8x16 = (qs_c1 .& m4b) .| hbit_lo_c1
                    let q5_hi_c1: i8x16 = ((qs_c1 .>> shift4) .& m4b) .| hbit_hi_c1

                    al03_0 = vdot_lane_i32(al03_0, q5_lo_c0, q8_blk0, 0)
                    al03_1 = vdot_lane_i32(al03_1, q5_lo_c0, q8_blk0, 1)
                    al03_2 = vdot_lane_i32(al03_2, q5_lo_c0, q8_blk0, 2)
                    al03_3 = vdot_lane_i32(al03_3, q5_lo_c0, q8_blk0, 3)

                    ah03_0 = vdot_lane_i32(ah03_0, q5_hi_c0, q8_blk1, 0)
                    ah03_1 = vdot_lane_i32(ah03_1, q5_hi_c0, q8_blk1, 1)
                    ah03_2 = vdot_lane_i32(ah03_2, q5_hi_c0, q8_blk1, 2)
                    ah03_3 = vdot_lane_i32(ah03_3, q5_hi_c0, q8_blk1, 3)

                    al47_0 = vdot_lane_i32(al47_0, q5_lo_c1, q8_blk0, 0)
                    al47_1 = vdot_lane_i32(al47_1, q5_lo_c1, q8_blk0, 1)
                    al47_2 = vdot_lane_i32(al47_2, q5_lo_c1, q8_blk0, 2)
                    al47_3 = vdot_lane_i32(al47_3, q5_lo_c1, q8_blk0, 3)

                    ah47_0 = vdot_lane_i32(ah47_0, q5_hi_c1, q8_blk1, 0)
                    ah47_1 = vdot_lane_i32(ah47_1, q5_hi_c1, q8_blk1, 1)
                    ah47_2 = vdot_lane_i32(ah47_2, q5_hi_c1, q8_blk1, 2)
                    ah47_3 = vdot_lane_i32(ah47_3, q5_hi_c1, q8_blk1, 3)

                    k = k + 1
                }

                // Shift qh vectors right by 2 for the next sub-block.
                let mut qj: i32 = 0
                while qj < 8 {
                    let qh0: i8x16 = load(scratch_i8, qj * 16)
                    let qh1: i8x16 = load(scratch_i8, 128 + qj * 16)
                    store(scratch_i8, qj * 16, qh0 .>> shift2)
                    store(scratch_i8, 128 + qj * 16, qh1 .>> shift2)
                    qj = qj + 1
                }

                // Accumulate scaled dots into block-level sumi (kept in i32 for
                // bit-exactness). Per token, per col-half: sumi += sc_lo_0*al + sc_lo_1*ah.
                sumi0_0 = sumi0_0 .+ (sc_lo_0 .* al03_0) .+ (sc_lo_1 .* ah03_0)
                sumi0_1 = sumi0_1 .+ (sc_lo_0 .* al03_1) .+ (sc_lo_1 .* ah03_1)
                sumi0_2 = sumi0_2 .+ (sc_lo_0 .* al03_2) .+ (sc_lo_1 .* ah03_2)
                sumi0_3 = sumi0_3 .+ (sc_lo_0 .* al03_3) .+ (sc_lo_1 .* ah03_3)
                sumi1_0 = sumi1_0 .+ (sc_hi_0 .* al47_0) .+ (sc_hi_1 .* ah47_0)
                sumi1_1 = sumi1_1 .+ (sc_hi_0 .* al47_1) .+ (sc_hi_1 .* ah47_1)
                sumi1_2 = sumi1_2 .+ (sc_hi_0 .* al47_2) .+ (sc_hi_1 .* ah47_2)
                sumi1_3 = sumi1_3 .+ (sc_hi_0 .* al47_3) .+ (sc_hi_1 .* ah47_3)

                // Bias: pair-add adjacent bsum entries; accumulate min-scaled bias per token.
                // block_q8_Kx4 bsums start at byte +1040; per sub-block 16 i16 slots
                // arranged as [t0 blk0_a, t0 blk0_b, t0 blk1_a, t0 blk1_b, t1 ..., ..., t3 ...].
                let bs_base: i32 = (ab + 1040) / 2 + sb * 16
                let bs_lo_0: i32 = to_i32(q8_bsums_i16[bs_base + 0]) + to_i32(q8_bsums_i16[bs_base + 1])
                let bs_hi_0: i32 = to_i32(q8_bsums_i16[bs_base + 2]) + to_i32(q8_bsums_i16[bs_base + 3])
                let bs_lo_1: i32 = to_i32(q8_bsums_i16[bs_base + 4]) + to_i32(q8_bsums_i16[bs_base + 5])
                let bs_hi_1: i32 = to_i32(q8_bsums_i16[bs_base + 6]) + to_i32(q8_bsums_i16[bs_base + 7])
                let bs_lo_2: i32 = to_i32(q8_bsums_i16[bs_base + 8]) + to_i32(q8_bsums_i16[bs_base + 9])
                let bs_hi_2: i32 = to_i32(q8_bsums_i16[bs_base + 10]) + to_i32(q8_bsums_i16[bs_base + 11])
                let bs_lo_3: i32 = to_i32(q8_bsums_i16[bs_base + 12]) + to_i32(q8_bsums_i16[bs_base + 13])
                let bs_hi_3: i32 = to_i32(q8_bsums_i16[bs_base + 14]) + to_i32(q8_bsums_i16[bs_base + 15])

                bias0_0 = bias0_0 .+ mn_lo_0 .* splat(bs_lo_0) .+ mn_lo_1 .* splat(bs_hi_0)
                bias0_1 = bias0_1 .+ mn_lo_0 .* splat(bs_lo_1) .+ mn_lo_1 .* splat(bs_hi_1)
                bias0_2 = bias0_2 .+ mn_lo_0 .* splat(bs_lo_2) .+ mn_lo_1 .* splat(bs_hi_2)
                bias0_3 = bias0_3 .+ mn_lo_0 .* splat(bs_lo_3) .+ mn_lo_1 .* splat(bs_hi_3)
                bias1_0 = bias1_0 .+ mn_hi_0 .* splat(bs_lo_0) .+ mn_hi_1 .* splat(bs_hi_0)
                bias1_1 = bias1_1 .+ mn_hi_0 .* splat(bs_lo_1) .+ mn_hi_1 .* splat(bs_hi_1)
                bias1_2 = bias1_2 .+ mn_hi_0 .* splat(bs_lo_2) .+ mn_hi_1 .* splat(bs_hi_2)
                bias1_3 = bias1_3 .+ mn_hi_0 .* splat(bs_lo_3) .+ mn_hi_1 .* splat(bs_hi_3)

                sb = sb + 1
            }

            // One f32 mul-add per (token, col-half) per block:
            //   acc += d*q8d*sumi - dm*q8d*bias  (left-to-right order)
            acc0_0 = acc0_0 .+ sb_sc0_0 .* to_f32(sumi0_0) .- sb_mn0_0 .* to_f32(bias0_0)
            acc0_1 = acc0_1 .+ sb_sc0_1 .* to_f32(sumi0_1) .- sb_mn0_1 .* to_f32(bias0_1)
            acc0_2 = acc0_2 .+ sb_sc0_2 .* to_f32(sumi0_2) .- sb_mn0_2 .* to_f32(bias0_2)
            acc0_3 = acc0_3 .+ sb_sc0_3 .* to_f32(sumi0_3) .- sb_mn0_3 .* to_f32(bias0_3)
            acc1_0 = acc1_0 .+ sb_sc1_0 .* to_f32(sumi1_0) .- sb_mn1_0 .* to_f32(bias1_0)
            acc1_1 = acc1_1 .+ sb_sc1_1 .* to_f32(sumi1_1) .- sb_mn1_1 .* to_f32(bias1_1)
            acc1_2 = acc1_2 .+ sb_sc1_2 .* to_f32(sumi1_2) .- sb_mn1_2 .* to_f32(bias1_2)
            acc1_3 = acc1_3 .+ sb_sc1_3 .* to_f32(sumi1_3) .- sb_mn1_3 .* to_f32(bias1_3)

            b = b + 1
        }

            // 8 output cols × 4 tokens: cols 0..3 from acc0_t, cols 4..7 from acc1_t.
            store(out_f32, (y * 4 + 0) * bs + x * 8 + 0, acc0_0)
            store(out_f32, (y * 4 + 0) * bs + x * 8 + 4, acc1_0)
            store(out_f32, (y * 4 + 1) * bs + x * 8 + 0, acc0_1)
            store(out_f32, (y * 4 + 1) * bs + x * 8 + 4, acc1_1)
            store(out_f32, (y * 4 + 2) * bs + x * 8 + 0, acc0_2)
            store(out_f32, (y * 4 + 2) * bs + x * 8 + 4, acc1_2)
            store(out_f32, (y * 4 + 3) * bs + x * 8 + 0, acc0_3)
            store(out_f32, (y * 4 + 3) * bs + x * 8 + 4, acc1_3)

            x = x + 1
        }
        y = y + 1
    }
}
