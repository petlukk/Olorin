// TurboRotate — Fast Walsh-Hadamard Transform with random sign-flip.
//
// Implements data-oblivious random rotation for JL projection:
//   1. Apply random sign flips (element-wise multiply by +1.0/-1.0)
//   2. In-place FWHT (log2(dim) butterfly passes)
//   3. Scale by 1/sqrt(dim) to preserve norms
//
// The sign mask is pre-expanded by the caller: signs[i] = +1.0 or -1.0.
// FWHT butterfly: for each pair (a[j], a[j+half]):  a'=a+b, b'=a-b
//
// Eä v1.10, x86_64 f32x8, aarch64 f32x4.

// ========== sign_flip ==========
// Apply pre-expanded sign mask: vec[i] *= signs[i]
// signs[i] is +1.0 or -1.0.

#[cfg(x86_64)]
export func sign_flip(
    vec: *mut f32,
    signs: *f32,
    dim: i32
) {
    for i in 0..dim step 8 {
        if i + 8 <= dim {
            let v: f32x8 = load(vec, i)
            let s: f32x8 = load(signs, i)
            store(vec, i, v .* s)
        }
    }
    let simd_end: i32 = (dim / 8) * 8
    for i in simd_end..dim {
        let vi: f32 = to_f32(vec[i])
        let si: f32 = to_f32(signs[i])
        vec[i] = vi * si
    }
}

#[cfg(aarch64)]
export func sign_flip(
    vec: *mut f32,
    signs: *f32,
    dim: i32
) {
    for i in 0..dim step 4 {
        if i + 4 <= dim {
            let v: f32x4 = load(vec, i)
            let s: f32x4 = load(signs, i)
            store(vec, i, v .* s)
        }
    }
    let simd_end: i32 = (dim / 4) * 4
    for i in simd_end..dim {
        let vi: f32 = to_f32(vec[i])
        let si: f32 = to_f32(signs[i])
        vec[i] = vi * si
    }
}

// ========== fwht_inplace ==========
// In-place FWHT on dim elements (dim must be power of 2).
// Scales by 1/sqrt(dim) after transform to preserve L2 norm.

#[cfg(x86_64)]
export func fwht_inplace(
    vec: *mut f32,
    dim: i32
) {
    let mut half: i32 = 1
    for _step in 0..30 {
        if half >= dim {
        } else {
            let stride: i32 = half * 2
            let mut base: i32 = 0
            for _blk in 0..dim {
                if base >= dim {
                } else {
                    for j in 0..half step 8 {
                        if j + 8 <= half {
                            let a: f32x8 = load(vec, base + j)
                            let b: f32x8 = load(vec, base + j + half)
                            store(vec, base + j, a .+ b)
                            store(vec, base + j + half, a .- b)
                        }
                    }
                    let simd_end: i32 = (half / 8) * 8
                    for j in simd_end..half {
                        let ai: f32 = to_f32(vec[base + j])
                        let bi: f32 = to_f32(vec[base + j + half])
                        vec[base + j] = ai + bi
                        vec[base + j + half] = ai - bi
                    }
                    base = base + stride
                }
            }
            half = half * 2
        }
    }
    let scale: f32 = 1.0 / sqrt(to_f32(dim))
    let vs: f32x8 = splat(scale)
    for i in 0..dim step 8 {
        if i + 8 <= dim {
            let v: f32x8 = load(vec, i)
            store(vec, i, v .* vs)
        }
    }
    let tail_start: i32 = (dim / 8) * 8
    for i in tail_start..dim {
        let vi: f32 = to_f32(vec[i])
        vec[i] = vi * scale
    }
}

#[cfg(aarch64)]
export func fwht_inplace(
    vec: *mut f32,
    dim: i32
) {
    let mut half: i32 = 1
    for _step in 0..30 {
        if half >= dim {
        } else {
            let stride: i32 = half * 2
            let mut base: i32 = 0
            for _blk in 0..dim {
                if base >= dim {
                } else {
                    for j in 0..half step 4 {
                        if j + 4 <= half {
                            let a: f32x4 = load(vec, base + j)
                            let b: f32x4 = load(vec, base + j + half)
                            store(vec, base + j, a .+ b)
                            store(vec, base + j + half, a .- b)
                        }
                    }
                    let simd_end: i32 = (half / 4) * 4
                    for j in simd_end..half {
                        let ai: f32 = to_f32(vec[base + j])
                        let bi: f32 = to_f32(vec[base + j + half])
                        vec[base + j] = ai + bi
                        vec[base + j + half] = ai - bi
                    }
                    base = base + stride
                }
            }
            half = half * 2
        }
    }
    let scale: f32 = 1.0 / sqrt(to_f32(dim))
    let vs: f32x4 = splat(scale)
    for i in 0..dim step 4 {
        if i + 4 <= dim {
            let v: f32x4 = load(vec, i)
            store(vec, i, v .* vs)
        }
    }
    let tail_start: i32 = (dim / 4) * 4
    for i in tail_start..dim {
        let vi: f32 = to_f32(vec[i])
        vec[i] = vi * scale
    }
}

// ========== turbo_rotate ==========
// Combined sign-flip + FWHT — full random rotation.

#[cfg(x86_64)]
export func turbo_rotate(
    vec: *mut f32,
    signs: *f32,
    dim: i32
) {
    // Step 1: sign flip
    for i in 0..dim step 8 {
        if i + 8 <= dim {
            let v: f32x8 = load(vec, i)
            let s: f32x8 = load(signs, i)
            store(vec, i, v .* s)
        }
    }
    let sf_end: i32 = (dim / 8) * 8
    for i in sf_end..dim {
        let vi: f32 = to_f32(vec[i])
        let si: f32 = to_f32(signs[i])
        vec[i] = vi * si
    }

    // Step 2: FWHT
    let mut half: i32 = 1
    for _step in 0..30 {
        if half >= dim {
        } else {
            let stride: i32 = half * 2
            let mut base: i32 = 0
            for _blk in 0..dim {
                if base >= dim {
                } else {
                    for j in 0..half step 8 {
                        if j + 8 <= half {
                            let a: f32x8 = load(vec, base + j)
                            let b: f32x8 = load(vec, base + j + half)
                            store(vec, base + j, a .+ b)
                            store(vec, base + j + half, a .- b)
                        }
                    }
                    let se: i32 = (half / 8) * 8
                    for j in se..half {
                        let ai: f32 = to_f32(vec[base + j])
                        let bi: f32 = to_f32(vec[base + j + half])
                        vec[base + j] = ai + bi
                        vec[base + j + half] = ai - bi
                    }
                    base = base + stride
                }
            }
            half = half * 2
        }
    }

    // Step 3: scale
    let scale: f32 = 1.0 / sqrt(to_f32(dim))
    let vs: f32x8 = splat(scale)
    for i in 0..dim step 8 {
        if i + 8 <= dim {
            let v: f32x8 = load(vec, i)
            store(vec, i, v .* vs)
        }
    }
    let sc_end: i32 = (dim / 8) * 8
    for i in sc_end..dim {
        let vi: f32 = to_f32(vec[i])
        vec[i] = vi * scale
    }
}

#[cfg(aarch64)]
export func turbo_rotate(
    vec: *mut f32,
    signs: *f32,
    dim: i32
) {
    // Step 1: sign flip
    for i in 0..dim step 4 {
        if i + 4 <= dim {
            let v: f32x4 = load(vec, i)
            let s: f32x4 = load(signs, i)
            store(vec, i, v .* s)
        }
    }
    let sf_end: i32 = (dim / 4) * 4
    for i in sf_end..dim {
        let vi: f32 = to_f32(vec[i])
        let si: f32 = to_f32(signs[i])
        vec[i] = vi * si
    }

    // Step 2: FWHT
    let mut half: i32 = 1
    for _step in 0..30 {
        if half >= dim {
        } else {
            let stride: i32 = half * 2
            let mut base: i32 = 0
            for _blk in 0..dim {
                if base >= dim {
                } else {
                    for j in 0..half step 4 {
                        if j + 4 <= half {
                            let a: f32x4 = load(vec, base + j)
                            let b: f32x4 = load(vec, base + j + half)
                            store(vec, base + j, a .+ b)
                            store(vec, base + j + half, a .- b)
                        }
                    }
                    let se: i32 = (half / 4) * 4
                    for j in se..half {
                        let ai: f32 = to_f32(vec[base + j])
                        let bi: f32 = to_f32(vec[base + j + half])
                        vec[base + j] = ai + bi
                        vec[base + j + half] = ai - bi
                    }
                    base = base + stride
                }
            }
            half = half * 2
        }
    }

    // Step 3: scale
    let scale: f32 = 1.0 / sqrt(to_f32(dim))
    let vs: f32x4 = splat(scale)
    for i in 0..dim step 4 {
        if i + 4 <= dim {
            let v: f32x4 = load(vec, i)
            store(vec, i, v .* vs)
        }
    }
    let sc_end: i32 = (dim / 4) * 4
    for i in sc_end..dim {
        let vi: f32 = to_f32(vec[i])
        vec[i] = vi * scale
    }
}
