// q4k_repack.ea — Repack Q4_K weight matrix into ggml's q4_K_8x8 layout.
//
// Byte-for-byte identical to ggml's repack_q4_K_to_q4_K_8_bl
// (llama.cpp build 8685, ggml/src/ggml-cpu/repack.cpp).
//
// Reference: docs/superpowers/research/2026-04-08-ggml-q4k-8x8-format.md
//
// Source layout (per row, per 256-element block, 144 bytes):
//   0..1   d    (f16)
//   2..3   dmin (f16)
//   4..15  scales[12]   (6-bit packed scales+mins for 8 sub-blocks)
//   16..143 qs[128]     (4-bit quants)
//
// Dest layout (per 8-row tile, per column-block, 1152 bytes):
//   0..15    d[0..8]      (8 × f16)
//   16..31   dmin[0..8]   (8 × f16)
//   32..127  scales[96]   (repacked: sub-blocks 0..3 then 4..7)
//   128..1151 qs[1024]    (interleaved 8-byte chunks)
//
// nrows must be a multiple of 8, n_cols must be a multiple of 256.
// Pure scalar byte permutation; works on x86_64 and aarch64 unchanged.

export func q4k_repack_8x8(
    src: *restrict u8,
    out dst: *mut u8 [cap: nrows * (n_cols / 256) * 144],
    nrows: i32,
    n_cols: i32
) {
    let n_blocks: i32 = n_cols / 256
    let row_bytes: i32 = n_blocks * 144
    let n_tiles: i32 = nrows / 8

    for tile in 0..n_tiles {
        for blk in 0..n_blocks {
            let row0_byte: i32 = tile * 8 * row_bytes + blk * 144
            let dbase: i32 = (tile * n_blocks + blk) * 1152

            // ----- Section A: d[0..8] (16 B at +0)
            // ----- Section B: dmin[0..8] (16 B at +16)
            for i in 0..8 {
                let r: i32 = row0_byte + i * row_bytes
                dst[dbase +      i * 2 + 0] = src[r + 0]
                dst[dbase +      i * 2 + 1] = src[r + 1]
                dst[dbase + 16 + i * 2 + 0] = src[r + 2]
                dst[dbase + 16 + i * 2 + 1] = src[r + 3]
            }

            // ----- Section C, first half: sub-blocks 0..3 -> bytes 0..47
            for sb in 0..4 {
                let s_base: i32 = dbase + 32 + sb * 12
                for k in 0..4 {
                    let rk:  i32 = row0_byte + (k    ) * row_bytes
                    let rk4: i32 = row0_byte + (k + 4) * row_bytes
                    let s_lo: u8 = src[rk  + 4 + sb    ] & 63
                    let s_hi: u8 = src[rk4 + 4 + sb    ] & 63
                    let m_lo: u8 = src[rk  + 4 + sb + 4] & 63
                    let m_hi: u8 = src[rk4 + 4 + sb + 4] & 63
                    dst[s_base + k    ] = (s_lo & 63) | ((s_hi & 48) << 2)
                    dst[s_base + k + 4] = (m_lo & 63) | ((m_hi & 48) << 2)
                    dst[s_base + k + 8] = (s_hi & 15) | ((m_hi & 15) << 4)
                }
            }

            // ----- Section C, second half: sub-blocks 4..7 -> bytes 48..95
            for sb2 in 0..4 {
                let s_base: i32 = dbase + 32 + 48 + sb2 * 12
                for k in 0..4 {
                    let rk:  i32 = row0_byte + (k    ) * row_bytes
                    let rk4: i32 = row0_byte + (k + 4) * row_bytes
                    let a_lo: u8 = src[rk  + 4 + sb2    ]
                    let b_lo: u8 = src[rk  + 4 + sb2 + 4]
                    let n_lo: u8 = src[rk  + 4 + sb2 + 8]
                    let a_hi: u8 = src[rk4 + 4 + sb2    ]
                    let b_hi: u8 = src[rk4 + 4 + sb2 + 4]
                    let n_hi: u8 = src[rk4 + 4 + sb2 + 8]
                    let s_lo: u8 = ((a_lo & 192) >> 2) | (n_lo & 15)
                    let m_lo: u8 = ((b_lo & 192) >> 2) | ((n_lo & 240) >> 4)
                    let s_hi: u8 = ((a_hi & 192) >> 2) | (n_hi & 15)
                    let m_hi: u8 = ((b_hi & 192) >> 2) | ((n_hi & 240) >> 4)
                    dst[s_base + k    ] = (s_lo & 63) | ((s_hi & 48) << 2)
                    dst[s_base + k + 4] = (m_lo & 63) | ((m_hi & 48) << 2)
                    dst[s_base + k + 8] = (s_hi & 15) | ((m_hi & 15) << 4)
                }
            }

            // ----- Section D: qs[1024] = 128 × 8-byte chunks at +128
            for c in 0..128 {
                let src_id: i32 = c % 8
                let src_off: i32 = (c / 8) * 8
                let qs_src: i32 = row0_byte + src_id * row_bytes + 16 + src_off
                let qs_dst: i32 = dbase + 128 + c * 8
                for k in 0..8 {
                    dst[qs_dst + k] = src[qs_src + k]
                }
            }
        }
    }
}
