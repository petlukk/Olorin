// gemma4_rope.ea — Rotary Position Embeddings (RoPE) in-place, NEOX layout
//
// Gemma 4 uses ROPE_TYPE_NEOX: pairs are (d, d+half_dim), not (2d, 2d+1).
// data layout: [head0_dim0..head0_dimN, head1_dim0..head1_dimN, ...]
// Rotation pairs: (dim_d, dim_{d+half}) for d in 0..half_dim.
//
// new_re = re * cos[d] - im * sin[d]
// new_im = re * sin[d] + im * cos[d]

export func gemma4_rope(data: *mut f32, cos_table: *restrict f32, sin_table: *restrict f32, head_dim: i32, n_heads: i32) {
    let half_dim: i32 = head_dim / 2
    let mut h: i32 = 0
    while h < n_heads {
        let base: i32 = h * head_dim
        let mut d: i32 = 0
        while d < half_dim {
            let re: f32 = data[base + d]
            let im: f32 = data[base + d + half_dim]
            let c: f32 = cos_table[d]
            let s: f32 = sin_table[d]
            data[base + d] = re * c - im * s
            data[base + d + half_dim] = re * s + im * c
            d = d + 1
        }
        h = h + 1
    }
}
