// x86 AVX2 flash decode attention (GQA, head_dim=128).
// Single-pass: dequant K+V, online softmax, accumulate V per position.
// No causal mask -- single decode query attends to ALL KV positions.
//
// AVX2 port of flash_decode_attn_arm.ea: f32x8 (256-bit) vectors.
// Each u8x16 nibble channel yields 2 x f32x8 via widen + shuffle.

export func flash_decode_attn_f32(
    q_vecs:          *restrict f32,
    k_packed:        *restrict u8,
    k_scales:        *restrict f32,
    k_biases:        *restrict f32,
    v_packed:        *restrict u8,
    v_scales:        *restrict f32,
    v_biases:        *restrict f32,
    out state:       *mut f32,
    all_out:         *mut f32,
    seq_len:         i32,
    n_q_heads:       i32,
    n_kv_heads:      i32,
    groups_per_head: i32
) {
    let mask15: u8x16 = splat(15)
    let div16: u8x16 = splat(16)
    let rsqrt_d: f32 = 1.0 / sqrt(to_f32(128))
    let q_per_kv: i32 = n_q_heads / n_kv_heads
    let state_stride: i32 = 130

    // Init state: zero V accumulators, max=-inf, sum=0
    let mut pi: i32 = 0
    while pi < n_q_heads {
        let base: i32 = pi * state_stride
        let mut d: i32 = 0
        while d < 128 {
            state[base + d] = 0.0
            d = d + 1
        }
        state[base + 128] = -1000000.0
        state[base + 129] = 0.0
        pi = pi + 1
    }

    let mut kv_h: i32 = 0
    while kv_h < n_kv_heads {
        let group_offset: i32 = kv_h * groups_per_head

        let mut t: i32 = 0
        while t < seq_len {
            // === Dequant K[kv_h, t] — group 0 (dims 0-63) ===
            let g0: i32 = group_offset + t * 2
            let vs0: f32x8 = splat(k_scales[g0])
            let vb0: f32x8 = splat(k_biases[g0])
            let wb0: i32 = g0 * 32

            let p0: u8x16 = load(k_packed, wb0)
            let lo0: u8x16 = p0 .& mask15
            let hi0: u8x16 = p0 ./ div16
            let p1: u8x16 = load(k_packed, wb0 + 16)
            let lo1: u8x16 = p1 .& mask15
            let hi1: u8x16 = p1 ./ div16

            // K dims 0-7, 8-15, 16-23, 24-31 (lo nibbles)
            let k0: f32x8 = fma(widen_u8_f32x8(lo0), vs0, vb0)
            let k1: f32x8 = fma(widen_u8_f32x8(shuffle(lo0, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs0, vb0)
            let k2: f32x8 = fma(widen_u8_f32x8(lo1), vs0, vb0)
            let k3: f32x8 = fma(widen_u8_f32x8(shuffle(lo1, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs0, vb0)
            // K dims 32-39, 40-47, 48-55, 56-63 (hi nibbles)
            let k4: f32x8 = fma(widen_u8_f32x8(hi0), vs0, vb0)
            let k5: f32x8 = fma(widen_u8_f32x8(shuffle(hi0, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs0, vb0)
            let k6: f32x8 = fma(widen_u8_f32x8(hi1), vs0, vb0)
            let k7: f32x8 = fma(widen_u8_f32x8(shuffle(hi1, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs0, vb0)

            // === Dequant K[kv_h, t] — group 1 (dims 64-127) ===
            let g1: i32 = g0 + 1
            let vs1: f32x8 = splat(k_scales[g1])
            let vb1: f32x8 = splat(k_biases[g1])
            let wb1: i32 = g1 * 32

            let p2: u8x16 = load(k_packed, wb1)
            let lo2: u8x16 = p2 .& mask15
            let hi2: u8x16 = p2 ./ div16
            let p3: u8x16 = load(k_packed, wb1 + 16)
            let lo3: u8x16 = p3 .& mask15
            let hi3: u8x16 = p3 ./ div16

            let k8:  f32x8 = fma(widen_u8_f32x8(lo2), vs1, vb1)
            let k9:  f32x8 = fma(widen_u8_f32x8(shuffle(lo2, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs1, vb1)
            let k10: f32x8 = fma(widen_u8_f32x8(lo3), vs1, vb1)
            let k11: f32x8 = fma(widen_u8_f32x8(shuffle(lo3, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs1, vb1)
            let k12: f32x8 = fma(widen_u8_f32x8(hi2), vs1, vb1)
            let k13: f32x8 = fma(widen_u8_f32x8(shuffle(hi2, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs1, vb1)
            let k14: f32x8 = fma(widen_u8_f32x8(hi3), vs1, vb1)
            let k15: f32x8 = fma(widen_u8_f32x8(shuffle(hi3, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vs1, vb1)

            // === Dequant V[kv_h, t] — group 0 (dims 0-63) ===
            let vvs0: f32x8 = splat(v_scales[g0])
            let vvb0: f32x8 = splat(v_biases[g0])
            let vw0: i32 = g0 * 32

            let vp0: u8x16 = load(v_packed, vw0)
            let vlo0: u8x16 = vp0 .& mask15
            let vhi0: u8x16 = vp0 ./ div16
            let vp1: u8x16 = load(v_packed, vw0 + 16)
            let vlo1: u8x16 = vp1 .& mask15
            let vhi1: u8x16 = vp1 ./ div16

            // === Dequant V[kv_h, t] — group 1 (dims 64-127) ===
            let vvs1: f32x8 = splat(v_scales[g1])
            let vvb1: f32x8 = splat(v_biases[g1])
            let vw1: i32 = g1 * 32

            let vp2: u8x16 = load(v_packed, vw1)
            let vlo2: u8x16 = vp2 .& mask15
            let vhi2: u8x16 = vp2 ./ div16
            let vp3: u8x16 = load(v_packed, vw1 + 16)
            let vlo3: u8x16 = vp3 .& mask15
            let vhi3: u8x16 = vp3 ./ div16

            // === Process all query heads mapped to this KV head ===
            let mut q_off: i32 = 0
            while q_off < q_per_kv {
                let q_h: i32 = kv_h * q_per_kv + q_off
                let qbase: i32 = q_h * 128
                let sb: i32 = q_h * state_stride

                // Dot Q . K (128 dims via f32x8)
                let zero8: f32x8 = splat(0.0)
                let mut acc: f32x8 = zero8
                acc = fma(k0,  load_f32x8(q_vecs, qbase), acc)
                acc = fma(k1,  load_f32x8(q_vecs, qbase + 8), acc)
                acc = fma(k2,  load_f32x8(q_vecs, qbase + 16), acc)
                acc = fma(k3,  load_f32x8(q_vecs, qbase + 24), acc)
                acc = fma(k4,  load_f32x8(q_vecs, qbase + 32), acc)
                acc = fma(k5,  load_f32x8(q_vecs, qbase + 40), acc)
                acc = fma(k6,  load_f32x8(q_vecs, qbase + 48), acc)
                acc = fma(k7,  load_f32x8(q_vecs, qbase + 56), acc)
                acc = fma(k8,  load_f32x8(q_vecs, qbase + 64), acc)
                acc = fma(k9,  load_f32x8(q_vecs, qbase + 72), acc)
                acc = fma(k10, load_f32x8(q_vecs, qbase + 80), acc)
                acc = fma(k11, load_f32x8(q_vecs, qbase + 88), acc)
                acc = fma(k12, load_f32x8(q_vecs, qbase + 96), acc)
                acc = fma(k13, load_f32x8(q_vecs, qbase + 104), acc)
                acc = fma(k14, load_f32x8(q_vecs, qbase + 112), acc)
                acc = fma(k15, load_f32x8(q_vecs, qbase + 120), acc)

                let score: f32 = reduce_add(acc) * rsqrt_d

                // Online softmax update
                let old_max: f32 = state[sb + 128]

                if score > old_max {
                    let correction: f32 = exp(old_max - score)
                    let vc: f32x8 = splat(correction)
                    let mut di: i32 = 0
                    while di < 128 {
                        store(state, sb + di, load_f32x8(state, sb + di) .* vc)
                        di = di + 8
                    }
                    state[sb + 128] = score
                    state[sb + 129] = state[sb + 129] * correction
                }

                let weight: f32 = exp(score - state[sb + 128])
                state[sb + 129] = state[sb + 129] + weight
                let vw: f32x8 = splat(weight)

                // V accumulate — dequant V inline, group 0 (dims 0-63)
                store(state, sb,    fma(fma(widen_u8_f32x8(vlo0), vvs0, vvb0), vw, load_f32x8(state, sb)))
                store(state, sb+8,  fma(fma(widen_u8_f32x8(shuffle(vlo0, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs0, vvb0), vw, load_f32x8(state, sb+8)))
                store(state, sb+16, fma(fma(widen_u8_f32x8(vlo1), vvs0, vvb0), vw, load_f32x8(state, sb+16)))
                store(state, sb+24, fma(fma(widen_u8_f32x8(shuffle(vlo1, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs0, vvb0), vw, load_f32x8(state, sb+24)))
                store(state, sb+32, fma(fma(widen_u8_f32x8(vhi0), vvs0, vvb0), vw, load_f32x8(state, sb+32)))
                store(state, sb+40, fma(fma(widen_u8_f32x8(shuffle(vhi0, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs0, vvb0), vw, load_f32x8(state, sb+40)))
                store(state, sb+48, fma(fma(widen_u8_f32x8(vhi1), vvs0, vvb0), vw, load_f32x8(state, sb+48)))
                store(state, sb+56, fma(fma(widen_u8_f32x8(shuffle(vhi1, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs0, vvb0), vw, load_f32x8(state, sb+56)))
                // V accumulate — group 1 (dims 64-127)
                store(state, sb+64, fma(fma(widen_u8_f32x8(vlo2), vvs1, vvb1), vw, load_f32x8(state, sb+64)))
                store(state, sb+72, fma(fma(widen_u8_f32x8(shuffle(vlo2, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs1, vvb1), vw, load_f32x8(state, sb+72)))
                store(state, sb+80, fma(fma(widen_u8_f32x8(vlo3), vvs1, vvb1), vw, load_f32x8(state, sb+80)))
                store(state, sb+88, fma(fma(widen_u8_f32x8(shuffle(vlo3, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs1, vvb1), vw, load_f32x8(state, sb+88)))
                store(state, sb+96, fma(fma(widen_u8_f32x8(vhi2), vvs1, vvb1), vw, load_f32x8(state, sb+96)))
                store(state, sb+104, fma(fma(widen_u8_f32x8(shuffle(vhi2, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs1, vvb1), vw, load_f32x8(state, sb+104)))
                store(state, sb+112, fma(fma(widen_u8_f32x8(vhi3), vvs1, vvb1), vw, load_f32x8(state, sb+112)))
                store(state, sb+120, fma(fma(widen_u8_f32x8(shuffle(vhi3, [8,9,10,11,12,13,14,15, 0,0,0,0,0,0,0,0])), vvs1, vvb1), vw, load_f32x8(state, sb+120)))

                q_off = q_off + 1
            }
            t = t + 1
        }
        kv_h = kv_h + 1
    }

    // Normalize output
    pi = 0
    while pi < n_q_heads {
        let sb: i32 = pi * state_stride
        let inv_sum: f32x8 = splat(1.0 / state[sb + 129])
        let out_base: i32 = pi * 128
        let mut di: i32 = 0
        while di < 128 {
            store(all_out, out_base + di, load_f32x8(state, sb + di) .* inv_sum)
            di = di + 8
        }
        pi = pi + 1
    }
}
