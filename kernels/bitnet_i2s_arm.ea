// bitnet_i2s_arm.ea — ARM NEON ternary weight × int8 activation dot product
//
// ARM NEON port of bitnet_i2s.ea. Uses vdot_i32 (ARMv8.2-A+dotprod).
// vdot_i32 is signed × signed. Weight values {0,1,2} fit in i8.
// Fully unrolled half-loop: loads all 32 bytes per block in one pass.

#[cfg(aarch64)]

export func i2_dot_i8(
    weights: *restrict i8,
    activations: *restrict i8,
    n: i32
) -> i32 {
    let mask: i8x16 = splat(3)
    let s6: i8x16 = splat(6)
    let s4: i8x16 = splat(4)
    let s2: i8x16 = splat(2)
    let mut acc_a: i32x4 = splat(0)
    let mut acc_b: i32x4 = splat(0)
    let n_blocks: i32 = n / 128

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bw: i32 = blk * 32
        let ba: i32 = blk * 128

        // Half 0
        let p0: i8x16 = load(weights, bw)
        let a0: i8x16 = load(activations, ba)
        let a1: i8x16 = load(activations, ba + 32)
        let a2: i8x16 = load(activations, ba + 64)
        let a3: i8x16 = load(activations, ba + 96)
        acc_a = acc_a .+ vdot_i32((p0 .>> s6) .& mask, a0)
        acc_b = acc_b .+ vdot_i32((p0 .>> s4) .& mask, a1)
        acc_a = acc_a .+ vdot_i32((p0 .>> s2) .& mask, a2)
        acc_b = acc_b .+ vdot_i32(p0 .& mask, a3)

        // Half 1
        let p1: i8x16 = load(weights, bw + 16)
        let b0: i8x16 = load(activations, ba + 16)
        let b1: i8x16 = load(activations, ba + 48)
        let b2: i8x16 = load(activations, ba + 80)
        let b3: i8x16 = load(activations, ba + 112)
        acc_a = acc_a .+ vdot_i32((p1 .>> s6) .& mask, b0)
        acc_b = acc_b .+ vdot_i32((p1 .>> s4) .& mask, b1)
        acc_a = acc_a .+ vdot_i32((p1 .>> s2) .& mask, b2)
        acc_b = acc_b .+ vdot_i32(p1 .& mask, b3)

        blk = blk + 1
    }
    return reduce_add(acc_a .+ acc_b)
}

// 4-row: unrolled halves, activations loaded once per block.
export func i2_dot_i8_4row(
    rw0: *restrict i8, rw1: *restrict i8,
    rw2: *restrict i8, rw3: *restrict i8,
    activations: *restrict i8,
    out scores: *mut i32 [cap: 4],
    n: i32
) {
    let mask: i8x16 = splat(3)
    let s6: i8x16 = splat(6)
    let s4: i8x16 = splat(4)
    let s2: i8x16 = splat(2)
    let mut r0a: i32x4 = splat(0)
    let mut r1a: i32x4 = splat(0)
    let mut r2a: i32x4 = splat(0)
    let mut r3a: i32x4 = splat(0)
    let mut r0b: i32x4 = splat(0)
    let mut r1b: i32x4 = splat(0)
    let mut r2b: i32x4 = splat(0)
    let mut r3b: i32x4 = splat(0)
    let n_blocks: i32 = n / 128

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bw: i32 = blk * 32
        let ba: i32 = blk * 128

        // Half 0: activations shared across 4 rows
        let a0: i8x16 = load(activations, ba)
        let a1: i8x16 = load(activations, ba + 32)
        let a2: i8x16 = load(activations, ba + 64)
        let a3: i8x16 = load(activations, ba + 96)
        let p0: i8x16 = load(rw0, bw)
        let p1: i8x16 = load(rw1, bw)
        let p2: i8x16 = load(rw2, bw)
        let p3: i8x16 = load(rw3, bw)
        r0a = r0a .+ vdot_i32((p0 .>> s6) .& mask, a0)
        r1a = r1a .+ vdot_i32((p1 .>> s6) .& mask, a0)
        r2a = r2a .+ vdot_i32((p2 .>> s6) .& mask, a0)
        r3a = r3a .+ vdot_i32((p3 .>> s6) .& mask, a0)
        r0a = r0a .+ vdot_i32((p0 .>> s4) .& mask, a1)
        r1a = r1a .+ vdot_i32((p1 .>> s4) .& mask, a1)
        r2a = r2a .+ vdot_i32((p2 .>> s4) .& mask, a1)
        r3a = r3a .+ vdot_i32((p3 .>> s4) .& mask, a1)
        r0a = r0a .+ vdot_i32((p0 .>> s2) .& mask, a2)
        r1a = r1a .+ vdot_i32((p1 .>> s2) .& mask, a2)
        r2a = r2a .+ vdot_i32((p2 .>> s2) .& mask, a2)
        r3a = r3a .+ vdot_i32((p3 .>> s2) .& mask, a2)
        r0a = r0a .+ vdot_i32(p0 .& mask, a3)
        r1a = r1a .+ vdot_i32(p1 .& mask, a3)
        r2a = r2a .+ vdot_i32(p2 .& mask, a3)
        r3a = r3a .+ vdot_i32(p3 .& mask, a3)

        // Half 1: independent accumulators for ILP
        let b0: i8x16 = load(activations, ba + 16)
        let b1: i8x16 = load(activations, ba + 48)
        let b2: i8x16 = load(activations, ba + 80)
        let b3: i8x16 = load(activations, ba + 112)
        let q0: i8x16 = load(rw0, bw + 16)
        let q1: i8x16 = load(rw1, bw + 16)
        let q2: i8x16 = load(rw2, bw + 16)
        let q3: i8x16 = load(rw3, bw + 16)
        r0b = r0b .+ vdot_i32((q0 .>> s6) .& mask, b0)
        r1b = r1b .+ vdot_i32((q1 .>> s6) .& mask, b0)
        r2b = r2b .+ vdot_i32((q2 .>> s6) .& mask, b0)
        r3b = r3b .+ vdot_i32((q3 .>> s6) .& mask, b0)
        r0b = r0b .+ vdot_i32((q0 .>> s4) .& mask, b1)
        r1b = r1b .+ vdot_i32((q1 .>> s4) .& mask, b1)
        r2b = r2b .+ vdot_i32((q2 .>> s4) .& mask, b1)
        r3b = r3b .+ vdot_i32((q3 .>> s4) .& mask, b1)
        r0b = r0b .+ vdot_i32((q0 .>> s2) .& mask, b2)
        r1b = r1b .+ vdot_i32((q1 .>> s2) .& mask, b2)
        r2b = r2b .+ vdot_i32((q2 .>> s2) .& mask, b2)
        r3b = r3b .+ vdot_i32((q3 .>> s2) .& mask, b2)
        r0b = r0b .+ vdot_i32(q0 .& mask, b3)
        r1b = r1b .+ vdot_i32(q1 .& mask, b3)
        r2b = r2b .+ vdot_i32(q2 .& mask, b3)
        r3b = r3b .+ vdot_i32(q3 .& mask, b3)

        blk = blk + 1
    }

    scores[0] = reduce_add(r0a .+ r0b)
    scores[1] = reduce_add(r1a .+ r1b)
    scores[2] = reduce_add(r2a .+ r2b)
    scores[3] = reduce_add(r3a .+ r3b)
}

// Fused dual 4-row: gate + up, unrolled halves, pre-extracted nibbles.
// Activations loaded once, nibbles extracted once per weight, shared gate/up.
export func i2_dot_i8_4row_dual(
    gw0: *restrict i8, gw1: *restrict i8, gw2: *restrict i8, gw3: *restrict i8,
    uw0: *restrict i8, uw1: *restrict i8, uw2: *restrict i8, uw3: *restrict i8,
    activations: *restrict i8,
    out gate_scores: *mut i32 [cap: 4],
    out up_scores: *mut i32 [cap: 4],
    n: i32
) {
    let mask: i8x16 = splat(3)
    let s6: i8x16 = splat(6)
    let s4: i8x16 = splat(4)
    let s2: i8x16 = splat(2)
    let mut g0: i32x4 = splat(0)
    let mut g1: i32x4 = splat(0)
    let mut g2: i32x4 = splat(0)
    let mut g3: i32x4 = splat(0)
    let mut u0: i32x4 = splat(0)
    let mut u1: i32x4 = splat(0)
    let mut u2: i32x4 = splat(0)
    let mut u3: i32x4 = splat(0)
    let n_blocks: i32 = n / 128

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bw: i32 = blk * 32
        let ba: i32 = blk * 128

        // All 8 activations loaded once
        let a0: i8x16 = load(activations, ba)
        let a1: i8x16 = load(activations, ba + 32)
        let a2: i8x16 = load(activations, ba + 64)
        let a3: i8x16 = load(activations, ba + 96)
        let b0: i8x16 = load(activations, ba + 16)
        let b1: i8x16 = load(activations, ba + 48)
        let b2: i8x16 = load(activations, ba + 80)
        let b3: i8x16 = load(activations, ba + 112)

        // Row 0: gate + up, both halves
        let pg0: i8x16 = load(gw0, bw)
        let pu0: i8x16 = load(uw0, bw)
        let pg0h: i8x16 = load(gw0, bw + 16)
        let pu0h: i8x16 = load(uw0, bw + 16)
        g0 = g0 .+ vdot_i32((pg0 .>> s6) .& mask, a0)
        u0 = u0 .+ vdot_i32((pu0 .>> s6) .& mask, a0)
        g0 = g0 .+ vdot_i32((pg0 .>> s4) .& mask, a1)
        u0 = u0 .+ vdot_i32((pu0 .>> s4) .& mask, a1)
        g0 = g0 .+ vdot_i32((pg0 .>> s2) .& mask, a2)
        u0 = u0 .+ vdot_i32((pu0 .>> s2) .& mask, a2)
        g0 = g0 .+ vdot_i32(pg0 .& mask, a3)
        u0 = u0 .+ vdot_i32(pu0 .& mask, a3)
        g0 = g0 .+ vdot_i32((pg0h .>> s6) .& mask, b0)
        u0 = u0 .+ vdot_i32((pu0h .>> s6) .& mask, b0)
        g0 = g0 .+ vdot_i32((pg0h .>> s4) .& mask, b1)
        u0 = u0 .+ vdot_i32((pu0h .>> s4) .& mask, b1)
        g0 = g0 .+ vdot_i32((pg0h .>> s2) .& mask, b2)
        u0 = u0 .+ vdot_i32((pu0h .>> s2) .& mask, b2)
        g0 = g0 .+ vdot_i32(pg0h .& mask, b3)
        u0 = u0 .+ vdot_i32(pu0h .& mask, b3)

        // Row 1
        let pg1: i8x16 = load(gw1, bw)
        let pu1: i8x16 = load(uw1, bw)
        let pg1h: i8x16 = load(gw1, bw + 16)
        let pu1h: i8x16 = load(uw1, bw + 16)
        g1 = g1 .+ vdot_i32((pg1 .>> s6) .& mask, a0)
        u1 = u1 .+ vdot_i32((pu1 .>> s6) .& mask, a0)
        g1 = g1 .+ vdot_i32((pg1 .>> s4) .& mask, a1)
        u1 = u1 .+ vdot_i32((pu1 .>> s4) .& mask, a1)
        g1 = g1 .+ vdot_i32((pg1 .>> s2) .& mask, a2)
        u1 = u1 .+ vdot_i32((pu1 .>> s2) .& mask, a2)
        g1 = g1 .+ vdot_i32(pg1 .& mask, a3)
        u1 = u1 .+ vdot_i32(pu1 .& mask, a3)
        g1 = g1 .+ vdot_i32((pg1h .>> s6) .& mask, b0)
        u1 = u1 .+ vdot_i32((pu1h .>> s6) .& mask, b0)
        g1 = g1 .+ vdot_i32((pg1h .>> s4) .& mask, b1)
        u1 = u1 .+ vdot_i32((pu1h .>> s4) .& mask, b1)
        g1 = g1 .+ vdot_i32((pg1h .>> s2) .& mask, b2)
        u1 = u1 .+ vdot_i32((pu1h .>> s2) .& mask, b2)
        g1 = g1 .+ vdot_i32(pg1h .& mask, b3)
        u1 = u1 .+ vdot_i32(pu1h .& mask, b3)

        // Row 2
        let pg2: i8x16 = load(gw2, bw)
        let pu2: i8x16 = load(uw2, bw)
        let pg2h: i8x16 = load(gw2, bw + 16)
        let pu2h: i8x16 = load(uw2, bw + 16)
        g2 = g2 .+ vdot_i32((pg2 .>> s6) .& mask, a0)
        u2 = u2 .+ vdot_i32((pu2 .>> s6) .& mask, a0)
        g2 = g2 .+ vdot_i32((pg2 .>> s4) .& mask, a1)
        u2 = u2 .+ vdot_i32((pu2 .>> s4) .& mask, a1)
        g2 = g2 .+ vdot_i32((pg2 .>> s2) .& mask, a2)
        u2 = u2 .+ vdot_i32((pu2 .>> s2) .& mask, a2)
        g2 = g2 .+ vdot_i32(pg2 .& mask, a3)
        u2 = u2 .+ vdot_i32(pu2 .& mask, a3)
        g2 = g2 .+ vdot_i32((pg2h .>> s6) .& mask, b0)
        u2 = u2 .+ vdot_i32((pu2h .>> s6) .& mask, b0)
        g2 = g2 .+ vdot_i32((pg2h .>> s4) .& mask, b1)
        u2 = u2 .+ vdot_i32((pu2h .>> s4) .& mask, b1)
        g2 = g2 .+ vdot_i32((pg2h .>> s2) .& mask, b2)
        u2 = u2 .+ vdot_i32((pu2h .>> s2) .& mask, b2)
        g2 = g2 .+ vdot_i32(pg2h .& mask, b3)
        u2 = u2 .+ vdot_i32(pu2h .& mask, b3)

        // Row 3
        let pg3: i8x16 = load(gw3, bw)
        let pu3: i8x16 = load(uw3, bw)
        let pg3h: i8x16 = load(gw3, bw + 16)
        let pu3h: i8x16 = load(uw3, bw + 16)
        g3 = g3 .+ vdot_i32((pg3 .>> s6) .& mask, a0)
        u3 = u3 .+ vdot_i32((pu3 .>> s6) .& mask, a0)
        g3 = g3 .+ vdot_i32((pg3 .>> s4) .& mask, a1)
        u3 = u3 .+ vdot_i32((pu3 .>> s4) .& mask, a1)
        g3 = g3 .+ vdot_i32((pg3 .>> s2) .& mask, a2)
        u3 = u3 .+ vdot_i32((pu3 .>> s2) .& mask, a2)
        g3 = g3 .+ vdot_i32(pg3 .& mask, a3)
        u3 = u3 .+ vdot_i32(pu3 .& mask, a3)
        g3 = g3 .+ vdot_i32((pg3h .>> s6) .& mask, b0)
        u3 = u3 .+ vdot_i32((pu3h .>> s6) .& mask, b0)
        g3 = g3 .+ vdot_i32((pg3h .>> s4) .& mask, b1)
        u3 = u3 .+ vdot_i32((pu3h .>> s4) .& mask, b1)
        g3 = g3 .+ vdot_i32((pg3h .>> s2) .& mask, b2)
        u3 = u3 .+ vdot_i32((pu3h .>> s2) .& mask, b2)
        g3 = g3 .+ vdot_i32(pg3h .& mask, b3)
        u3 = u3 .+ vdot_i32(pu3h .& mask, b3)

        blk = blk + 1
    }

    gate_scores[0] = reduce_add(g0)
    gate_scores[1] = reduce_add(g1)
    gate_scores[2] = reduce_add(g2)
    gate_scores[3] = reduce_add(g3)
    up_scores[0] = reduce_add(u0)
    up_scores[1] = reduce_add(u1)
    up_scores[2] = reduce_add(u2)
    up_scores[3] = reduce_add(u3)
}
