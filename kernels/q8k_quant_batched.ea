// q8k_quant_batched.ea — Batched Q8_K quantization for prompt eval.
//
// Quantize N independent f32 columns (each n_cols long, n_cols % 256 == 0)
// into N independent Q8K row outputs. Each column is quantized identically
// to q4k_quant.ea::quant_f32_q8k — same banker's rounding via magic-number
// trick, same per-256-element-block scale and bsums, byte-for-byte output.
// Olorin's forward_batch uses this to quantize batched activations in one
// call instead of N separate quant_f32_q8k calls.
//
// Column-major input: column k starts at src + k * n_cols.
// Per-column output strides:
//   dst_qs    stride = n_cols + 12  (matches existing quant_input convention)
//   dst_d     stride = n_cols / 256
//   dst_bsums stride = (n_cols / 256) * 16

#[cfg(x86_64)]

export func q8k_quant_batched(
    src: *restrict f32,
    out dst_qs: *mut i8 [cap: (n_cols + 12) * n_batch],
    out dst_d: *mut f32 [cap: (n_cols / 256) * n_batch],
    out dst_bsums: *mut i16 [cap: (n_cols / 256) * 16 * n_batch],
    n_cols: i32,
    n_batch: i32
) {
    let blocks_per_col: i32 = n_cols / 256
    let qs_stride: i32 = n_cols + 12
    let d_stride: i32 = blocks_per_col
    let bsums_stride: i32 = blocks_per_col * 16

    let mut col: i32 = 0
    while col < n_batch {
        // Per-column base offsets into src/dst arrays.
        let src_base: i32 = col * n_cols
        let qs_base: i32 = col * qs_stride
        let d_base: i32 = col * d_stride
        let bs_base: i32 = col * bsums_stride

        // Body mirrors quant_f32_q8k verbatim, only addressing changes.
        let mut b: i32 = 0
        while b < blocks_per_col {
            let base: i32 = src_base + b * 256

            // Pass 1: absmax over 256 elements using f32x8 SIMD
            let mut vmax: f32x8 = splat(0.0)
            let vzero8: f32x8 = splat(0.0)
            let mut i: i32 = 0
            while i < 256 {
                let v: f32x8 = load(src, base + i)
                let neg: f32x8 = vzero8 .- v
                let abs_v: f32x8 = select(v .> neg, v, neg)
                vmax = select(abs_v .> vmax, abs_v, vmax)
                i = i + 8
            }
            let amax: f32 = reduce_max(vmax)

            if amax < 0.000001 {
                // Near-zero block: scale=0, all qs=0, all bsums=0
                dst_d[d_base + b] = 0.0
                let z16: i8x16 = splat(0)
                i = 0
                while i < 256 {
                    store(dst_qs, qs_base + b * 256 + i, z16)
                    i = i + 16
                }
                let mut j: i32 = 0
                while j < 16 {
                    dst_bsums[bs_base + b * 16 + j] = to_i16(0)
                    j = j + 1
                }
            } else {
                // Store scale
                let d: f32 = amax / 127.0
                dst_d[d_base + b] = d

                // Pass 2: quantize f32 -> i8 with banker's rounding
                // (magic-number trick, matches quantize_row_q8_K_ref exactly).
                let inv_scale: f32 = 127.0 / amax
                let v_inv: f32x4 = splat(inv_scale)
                let v_min: f32x4 = splat(-127.0)
                let v_max: f32x4 = splat(127.0)
                let v_magic: f32x4 = splat(12582912.0)

                i = 0
                while i < 256 {
                    let v: f32x4 = load(src, base + i)
                    let scaled: f32x4 = v .* v_inv
                    let clamped: f32x4 = select(scaled .< v_min, v_min, select(scaled .> v_max, v_max, scaled))
                    let rounded: f32x4 = (clamped .+ v_magic) .- v_magic
                    let narrow: i8x4 = narrow_f32x4_i8(rounded)
                    store(dst_qs, qs_base + b * 256 + i, narrow)
                    i = i + 4
                }

                // Pass 3: compute bsums — sum of 16 consecutive i8 values as i32
                let mut g: i32 = 0
                while g < 16 {
                    let gbase: i32 = qs_base + b * 256 + g * 16
                    let mut sum: i32 = 0
                    let mut kk: i32 = 0
                    while kk < 16 {
                        sum = sum + to_i32(dst_qs[gbase + kk])
                        kk = kk + 1
                    }
                    dst_bsums[bs_base + b * 16 + g] = to_i16(sum)
                    g = g + 1
                }
            }

            b = b + 1
        }
        col = col + 1
    }
}
