// Byte-level CSV boundary scanner. Scans bytes linearly, records the
// index of every `,` (44) into out_commas and every `\n` (10) into
// out_newlines. Writes the populated counts to out_n_comma / out_n_newline.
//
// Scope: assumes unquoted CSV (quoted fields with embedded commas are a
// future extension — MVP bank-statement data is unquoted numerics + text).
// The caller mmaps the file and allocates out arrays of size `len` (the
// worst case is every byte being a delimiter).

export func csv_scan(text: *u8, len: i32, out_commas: *mut i32, out_newlines: *mut i32, out_n_comma: *mut i32, out_n_newline: *mut i32) {
    let mut nc: i32 = 0
    let mut nn: i32 = 0
    let mut i: i32 = 0
    while i < len {
        let b: i32 = to_i32(text[i])
        if b == 44 {
            out_commas[nc] = i
            nc = nc + 1
        }
        if b == 10 {
            out_newlines[nn] = i
            nn = nn + 1
        }
        i = i + 1
    }
    out_n_comma[0] = nc
    out_n_newline[0] = nn
}
