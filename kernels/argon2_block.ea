// Argon2 G compression function (RFC 9106 §3.4) — one block step.
// x86 AVX2 SIMD path (u64x4) — gated #[cfg(x86_64)] for build.rs.
// ARM NEON path is in argon2_block_arm.ea (scalar; NEON has no u64×u64
// SIMD multiply, so u64x2 SIMD regressed 1.7× vs scalar — bench
// 2026-05-21 Pi 5).
//
//   G(X, Y) -> Z, all three 1024-byte (128 × u64) blocks.
//
//   R   = X XOR Y
//   R'  = apply P to each of the 8 rows of R    (rows are contiguous: 16 u64s)
//   R'' = apply P to each of the 8 columns of R' (gather → P → scatter)
//   Z   = R'' XOR R
//
// SIMD trick: Argon2's P is one Blake2b-style round = 4 column G' + 4
// diagonal G'.  The 4 column G' operate on disjoint indices of the
// 16-u64 block — they lockstep into 4 u64x4 vectors where row a/b/c/d
// occupy lane 0..3.  Diagonal phase uses the canonical Blake2b rot-
// left-by-row permutation (a: 0, b: 1, c: 2, d: 3) so the same
// vectorized G' loop runs twice with shuffles in between.
//
// BlaMka primitive `2 * lo32(a) * lo32(b)` lowers to vpmuludq directly:
// `(a .& 0xFFFFFFFF) .* (b .& 0xFFFFFFFF)` — LLVM's combineMul detects
// provably-zero upper 32 bits and picks vpmuludq.  Rotate-by-32 of a
// u64 lane lowers to vpshufd (halves-swap, 1 cycle).  Other rotates
// (24/16/63) lower to vpshufb / shr|shl|or as LLVM sees fit.  No new
// eacompute intrinsics needed.

func p_at_simd(v: *restrict mut u64, base: i32) {
    let mut va: u64x4 = load(v, base +  0)
    let mut vb: u64x4 = load(v, base +  4)
    let mut vc: u64x4 = load(v, base +  8)
    let mut vd: u64x4 = load(v, base + 12)

    let mask_s: u64 = 4294967295
    let mask:  u64x4 = splat(mask_s)
    let two_s: u64 = 2
    let two:   u64x4 = splat(two_s)

    let r32_s: u64 = 32
    let r32:   u64x4 = splat(r32_s)
    let r24_s: u64 = 24
    let r24:   u64x4 = splat(r24_s)
    let r40_s: u64 = 40
    let r40:   u64x4 = splat(r40_s)
    let r16_s: u64 = 16
    let r16:   u64x4 = splat(r16_s)
    let r48_s: u64 = 48
    let r48:   u64x4 = splat(r48_s)
    let r63_s: u64 = 63
    let r63:   u64x4 = splat(r63_s)
    let r1_s:  u64 = 1
    let r1:    u64x4 = splat(r1_s)

    // ─── Column phase ─── lanes 0..3 hold the four column G's ──────
    va = va .+ vb .+ two .* ((va .& mask) .* (vb .& mask))
    vd = vd .^ va
    vd = (vd .>> r32) .| (vd .<< r32)

    vc = vc .+ vd .+ two .* ((vc .& mask) .* (vd .& mask))
    vb = vb .^ vc
    vb = (vb .>> r24) .| (vb .<< r40)

    va = va .+ vb .+ two .* ((va .& mask) .* (vb .& mask))
    vd = vd .^ va
    vd = (vd .>> r16) .| (vd .<< r48)

    vc = vc .+ vd .+ two .* ((vc .& mask) .* (vd .& mask))
    vb = vb .^ vc
    vb = (vb .>> r63) .| (vb .<< r1)

    // ─── Pivot to diagonal layout ─── canonical Blake2b shuffle ────
    //   row a: identity   row b: rot-left 1
    //   row c: rot-left 2 row d: rot-left 3
    vb = shuffle(vb, [1, 2, 3, 0])
    vc = shuffle(vc, [2, 3, 0, 1])
    vd = shuffle(vd, [3, 0, 1, 2])

    // ─── Diagonal phase ─── same G' body on the permuted lanes ─────
    va = va .+ vb .+ two .* ((va .& mask) .* (vb .& mask))
    vd = vd .^ va
    vd = (vd .>> r32) .| (vd .<< r32)

    vc = vc .+ vd .+ two .* ((vc .& mask) .* (vd .& mask))
    vb = vb .^ vc
    vb = (vb .>> r24) .| (vb .<< r40)

    va = va .+ vb .+ two .* ((va .& mask) .* (vb .& mask))
    vd = vd .^ va
    vd = (vd .>> r16) .| (vd .<< r48)

    vc = vc .+ vd .+ two .* ((vc .& mask) .* (vd .& mask))
    vb = vb .^ vc
    vb = (vb .>> r63) .| (vb .<< r1)

    // ─── Un-pivot before store ─── inverse rotations ───────────────
    vb = shuffle(vb, [3, 0, 1, 2])   // inverse of rot-left 1
    vc = shuffle(vc, [2, 3, 0, 1])   // self-inverse (rot-left 2)
    vd = shuffle(vd, [1, 2, 3, 0])   // inverse of rot-left 3

    store(v, base +  0, va)
    store(v, base +  4, vb)
    store(v, base +  8, vc)
    store(v, base + 12, vd)
}

export func argon2_block_compress(
    x: *restrict u64,
    y: *restrict u64,
    z: *restrict mut u64,
    scratch: *restrict mut u64
) {
    // R = X XOR Y, into z.  32 u64x4 vector ops cover the 128 u64s.
    let mut i: i32 = 0
    while i < 128 {
        let xv: u64x4 = load(x, i)
        let yv: u64x4 = load(y, i)
        store(z, i, xv .^ yv)
        i = i + 4
    }

    // Row-mode P transforms (8 rows × 16 u64s).
    p_at_simd(z,   0)
    p_at_simd(z,  16)
    p_at_simd(z,  32)
    p_at_simd(z,  48)
    p_at_simd(z,  64)
    p_at_simd(z,  80)
    p_at_simd(z,  96)
    p_at_simd(z, 112)

    // Column-mode P transforms (8 columns, gather → P → scatter).
    // Column j is registers (0,j), (1,j), …, (7,j); a register is a
    // pair of u64s at z[col*2 + row*16] and z[col*2 + row*16 + 1].
    let mut col: i32 = 0
    while col < 8 {
        let col2: i32 = col * 2
        let mut row: i32 = 0
        while row < 8 {
            let r16off: i32 = row * 16
            scratch[row * 2]     = z[col2 + r16off]
            scratch[row * 2 + 1] = z[col2 + r16off + 1]
            row = row + 1
        }
        p_at_simd(scratch, 0)
        row = 0
        while row < 8 {
            let r16off: i32 = row * 16
            z[col2 + r16off]     = scratch[row * 2]
            z[col2 + r16off + 1] = scratch[row * 2 + 1]
            row = row + 1
        }
        col = col + 1
    }

    // Final XOR with R = X XOR Y.
    i = 0
    while i < 128 {
        let zv: u64x4 = load(z, i)
        let xv: u64x4 = load(x, i)
        let yv: u64x4 = load(y, i)
        store(z, i, zv .^ (xv .^ yv))
        i = i + 4
    }
}
