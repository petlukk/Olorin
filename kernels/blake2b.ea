// Blake2b compression function (RFC 7693 §3.2).
//
// One block at a time: caller initialises the chaining state h (the
// 8-u64 parameter-block XOR) and walks 128-byte message blocks through
// blake2b_compress, finalising on the last call.  The Rust wrapper in
// src/storage/blake2b.rs handles the H' variable-output construction
// (RFC 9106 §3.3) that Argon2id uses.
//
// IV constants live on the Rust side and are passed in via the
// `constants` pointer (16 u64s: the eight Blake2b IVs at indices 0..8
// and the all-ones finalization mask at index 8).  Keeping the table
// out of the kernel source matches the same data-vs-algorithm split
// used everywhere else in Olorin (GGUF weights live in Rust; matmul
// kernels just consume a `*f32`).
//
// Scalar u64 — the G function has serial data dependencies in each row
// (a → d → c → b chain).  This kernel runs once per vault open at
// startup (~ms range), not in any throughput-bound hot path, so a
// u64x2 SSE2 packing wouldn't move user-visible time.  Same source
// compiles for x86_64 and aarch64.

func rotr64(x: u64, n: u64) -> u64 {
    let shift_back: u64 = 64 - n
    return (x >> n) | (x << shift_back)
}

// Blake2b G mixing function (RFC 7693 §3.1).  Operates on v[] in place
// via the *mut u64 pointer.
func g(
    v: *restrict mut u64,
    a: i32, b: i32, c: i32, d: i32,
    x: u64, y: u64
) {
    v[a] = v[a] + v[b] + x
    v[d] = rotr64(v[d] ^ v[a], 32)
    v[c] = v[c] + v[d]
    v[b] = rotr64(v[b] ^ v[c], 24)
    v[a] = v[a] + v[b] + y
    v[d] = rotr64(v[d] ^ v[a], 16)
    v[c] = v[c] + v[d]
    v[b] = rotr64(v[b] ^ v[c], 63)
}

// One Blake2b compression — mutate state[0..8] in place.
//
//   state[0..8]       chaining variable h (in/out, 64 bytes)
//   block[0..16]      message words m[0..16] (in, 128 bytes)
//   constants[0..9]   IV[0..8] then all-ones finalization mask
//   t_low / t_high    total bytes consumed including this block
//   is_final          1 for the last block, 0 otherwise
//   v_scratch[0..16]  caller-allocated working buffer (clobbered)
//
// The SIGMA permutation is unrolled into direct block[] indices below —
// avoids an indirect load per G call and lets the compiler schedule
// the multiply-free hot loop tightly.
export func blake2b_compress(
    state: *restrict mut u64,
    block: *restrict u64,
    constants: *restrict u64,
    t_low: u64,
    t_high: u64,
    is_final: i32,
    v_scratch: *restrict mut u64
) {
    v_scratch[ 0] = state[0]
    v_scratch[ 1] = state[1]
    v_scratch[ 2] = state[2]
    v_scratch[ 3] = state[3]
    v_scratch[ 4] = state[4]
    v_scratch[ 5] = state[5]
    v_scratch[ 6] = state[6]
    v_scratch[ 7] = state[7]
    v_scratch[ 8] = constants[0]
    v_scratch[ 9] = constants[1]
    v_scratch[10] = constants[2]
    v_scratch[11] = constants[3]
    v_scratch[12] = constants[4]
    v_scratch[13] = constants[5]
    v_scratch[14] = constants[6]
    v_scratch[15] = constants[7]

    v_scratch[12] = v_scratch[12] ^ t_low
    v_scratch[13] = v_scratch[13] ^ t_high
    if is_final != 0 {
        v_scratch[14] = v_scratch[14] ^ constants[8]
    }

    // Round 0 — SIGMA[0] = identity
    g(v_scratch, 0, 4,  8, 12, block[ 0], block[ 1])
    g(v_scratch, 1, 5,  9, 13, block[ 2], block[ 3])
    g(v_scratch, 2, 6, 10, 14, block[ 4], block[ 5])
    g(v_scratch, 3, 7, 11, 15, block[ 6], block[ 7])
    g(v_scratch, 0, 5, 10, 15, block[ 8], block[ 9])
    g(v_scratch, 1, 6, 11, 12, block[10], block[11])
    g(v_scratch, 2, 7,  8, 13, block[12], block[13])
    g(v_scratch, 3, 4,  9, 14, block[14], block[15])

    // Round 1 — SIGMA[1] = [14,10,4,8,9,15,13,6,1,12,0,2,11,7,5,3]
    g(v_scratch, 0, 4,  8, 12, block[14], block[10])
    g(v_scratch, 1, 5,  9, 13, block[ 4], block[ 8])
    g(v_scratch, 2, 6, 10, 14, block[ 9], block[15])
    g(v_scratch, 3, 7, 11, 15, block[13], block[ 6])
    g(v_scratch, 0, 5, 10, 15, block[ 1], block[12])
    g(v_scratch, 1, 6, 11, 12, block[ 0], block[ 2])
    g(v_scratch, 2, 7,  8, 13, block[11], block[ 7])
    g(v_scratch, 3, 4,  9, 14, block[ 5], block[ 3])

    // Round 2 — SIGMA[2] = [11,8,12,0,5,2,15,13,10,14,3,6,7,1,9,4]
    g(v_scratch, 0, 4,  8, 12, block[11], block[ 8])
    g(v_scratch, 1, 5,  9, 13, block[12], block[ 0])
    g(v_scratch, 2, 6, 10, 14, block[ 5], block[ 2])
    g(v_scratch, 3, 7, 11, 15, block[15], block[13])
    g(v_scratch, 0, 5, 10, 15, block[10], block[14])
    g(v_scratch, 1, 6, 11, 12, block[ 3], block[ 6])
    g(v_scratch, 2, 7,  8, 13, block[ 7], block[ 1])
    g(v_scratch, 3, 4,  9, 14, block[ 9], block[ 4])

    // Round 3 — SIGMA[3] = [7,9,3,1,13,12,11,14,2,6,5,10,4,0,15,8]
    g(v_scratch, 0, 4,  8, 12, block[ 7], block[ 9])
    g(v_scratch, 1, 5,  9, 13, block[ 3], block[ 1])
    g(v_scratch, 2, 6, 10, 14, block[13], block[12])
    g(v_scratch, 3, 7, 11, 15, block[11], block[14])
    g(v_scratch, 0, 5, 10, 15, block[ 2], block[ 6])
    g(v_scratch, 1, 6, 11, 12, block[ 5], block[10])
    g(v_scratch, 2, 7,  8, 13, block[ 4], block[ 0])
    g(v_scratch, 3, 4,  9, 14, block[15], block[ 8])

    // Round 4 — SIGMA[4] = [9,0,5,7,2,4,10,15,14,1,11,12,6,8,3,13]
    g(v_scratch, 0, 4,  8, 12, block[ 9], block[ 0])
    g(v_scratch, 1, 5,  9, 13, block[ 5], block[ 7])
    g(v_scratch, 2, 6, 10, 14, block[ 2], block[ 4])
    g(v_scratch, 3, 7, 11, 15, block[10], block[15])
    g(v_scratch, 0, 5, 10, 15, block[14], block[ 1])
    g(v_scratch, 1, 6, 11, 12, block[11], block[12])
    g(v_scratch, 2, 7,  8, 13, block[ 6], block[ 8])
    g(v_scratch, 3, 4,  9, 14, block[ 3], block[13])

    // Round 5 — SIGMA[5] = [2,12,6,10,0,11,8,3,4,13,7,5,15,14,1,9]
    g(v_scratch, 0, 4,  8, 12, block[ 2], block[12])
    g(v_scratch, 1, 5,  9, 13, block[ 6], block[10])
    g(v_scratch, 2, 6, 10, 14, block[ 0], block[11])
    g(v_scratch, 3, 7, 11, 15, block[ 8], block[ 3])
    g(v_scratch, 0, 5, 10, 15, block[ 4], block[13])
    g(v_scratch, 1, 6, 11, 12, block[ 7], block[ 5])
    g(v_scratch, 2, 7,  8, 13, block[15], block[14])
    g(v_scratch, 3, 4,  9, 14, block[ 1], block[ 9])

    // Round 6 — SIGMA[6] = [12,5,1,15,14,13,4,10,0,7,6,3,9,2,8,11]
    g(v_scratch, 0, 4,  8, 12, block[12], block[ 5])
    g(v_scratch, 1, 5,  9, 13, block[ 1], block[15])
    g(v_scratch, 2, 6, 10, 14, block[14], block[13])
    g(v_scratch, 3, 7, 11, 15, block[ 4], block[10])
    g(v_scratch, 0, 5, 10, 15, block[ 0], block[ 7])
    g(v_scratch, 1, 6, 11, 12, block[ 6], block[ 3])
    g(v_scratch, 2, 7,  8, 13, block[ 9], block[ 2])
    g(v_scratch, 3, 4,  9, 14, block[ 8], block[11])

    // Round 7 — SIGMA[7] = [13,11,7,14,12,1,3,9,5,0,15,4,8,6,2,10]
    g(v_scratch, 0, 4,  8, 12, block[13], block[11])
    g(v_scratch, 1, 5,  9, 13, block[ 7], block[14])
    g(v_scratch, 2, 6, 10, 14, block[12], block[ 1])
    g(v_scratch, 3, 7, 11, 15, block[ 3], block[ 9])
    g(v_scratch, 0, 5, 10, 15, block[ 5], block[ 0])
    g(v_scratch, 1, 6, 11, 12, block[15], block[ 4])
    g(v_scratch, 2, 7,  8, 13, block[ 8], block[ 6])
    g(v_scratch, 3, 4,  9, 14, block[ 2], block[10])

    // Round 8 — SIGMA[8] = [6,15,14,9,11,3,0,8,12,2,13,7,1,4,10,5]
    g(v_scratch, 0, 4,  8, 12, block[ 6], block[15])
    g(v_scratch, 1, 5,  9, 13, block[14], block[ 9])
    g(v_scratch, 2, 6, 10, 14, block[11], block[ 3])
    g(v_scratch, 3, 7, 11, 15, block[ 0], block[ 8])
    g(v_scratch, 0, 5, 10, 15, block[12], block[ 2])
    g(v_scratch, 1, 6, 11, 12, block[13], block[ 7])
    g(v_scratch, 2, 7,  8, 13, block[ 1], block[ 4])
    g(v_scratch, 3, 4,  9, 14, block[10], block[ 5])

    // Round 9 — SIGMA[9] = [10,2,8,4,7,6,1,5,15,11,9,14,3,12,13,0]
    g(v_scratch, 0, 4,  8, 12, block[10], block[ 2])
    g(v_scratch, 1, 5,  9, 13, block[ 8], block[ 4])
    g(v_scratch, 2, 6, 10, 14, block[ 7], block[ 6])
    g(v_scratch, 3, 7, 11, 15, block[ 1], block[ 5])
    g(v_scratch, 0, 5, 10, 15, block[15], block[11])
    g(v_scratch, 1, 6, 11, 12, block[ 9], block[14])
    g(v_scratch, 2, 7,  8, 13, block[ 3], block[12])
    g(v_scratch, 3, 4,  9, 14, block[13], block[ 0])

    // Round 10 — SIGMA[10] = SIGMA[0]
    g(v_scratch, 0, 4,  8, 12, block[ 0], block[ 1])
    g(v_scratch, 1, 5,  9, 13, block[ 2], block[ 3])
    g(v_scratch, 2, 6, 10, 14, block[ 4], block[ 5])
    g(v_scratch, 3, 7, 11, 15, block[ 6], block[ 7])
    g(v_scratch, 0, 5, 10, 15, block[ 8], block[ 9])
    g(v_scratch, 1, 6, 11, 12, block[10], block[11])
    g(v_scratch, 2, 7,  8, 13, block[12], block[13])
    g(v_scratch, 3, 4,  9, 14, block[14], block[15])

    // Round 11 — SIGMA[11] = SIGMA[1]
    g(v_scratch, 0, 4,  8, 12, block[14], block[10])
    g(v_scratch, 1, 5,  9, 13, block[ 4], block[ 8])
    g(v_scratch, 2, 6, 10, 14, block[ 9], block[15])
    g(v_scratch, 3, 7, 11, 15, block[13], block[ 6])
    g(v_scratch, 0, 5, 10, 15, block[ 1], block[12])
    g(v_scratch, 1, 6, 11, 12, block[ 0], block[ 2])
    g(v_scratch, 2, 7,  8, 13, block[11], block[ 7])
    g(v_scratch, 3, 4,  9, 14, block[ 5], block[ 3])

    state[0] = state[0] ^ v_scratch[0] ^ v_scratch[ 8]
    state[1] = state[1] ^ v_scratch[1] ^ v_scratch[ 9]
    state[2] = state[2] ^ v_scratch[2] ^ v_scratch[10]
    state[3] = state[3] ^ v_scratch[3] ^ v_scratch[11]
    state[4] = state[4] ^ v_scratch[4] ^ v_scratch[12]
    state[5] = state[5] ^ v_scratch[5] ^ v_scratch[13]
    state[6] = state[6] ^ v_scratch[6] ^ v_scratch[14]
    state[7] = state[7] ^ v_scratch[7] ^ v_scratch[15]
}
