// q4k_gemm_tile.ea — Tiled Q4_K × Q8_K GEMM: 4 rows × 4 tokens per tile.
//
// Loads Q4 weight block data ONCE per tile, computes dot products against
// 4 tokens' Q8 activations. 16 accumulators (4 rows × 4 tokens).
// Reduces cache thrashing vs the current approach of cycling through
// all tokens per weight row group.

#[cfg(x86_64)]

export func q4k_gemm_4x4(
    rw0: *restrict u8, rw1: *restrict u8, rw2: *restrict u8, rw3: *restrict u8,
    q8_0: *restrict i8, q8_1: *restrict i8, q8_2: *restrict i8, q8_3: *restrict i8,
    bsums_0: *restrict i32, bsums_1: *restrict i32, bsums_2: *restrict i32, bsums_3: *restrict i32,
    sc0: *restrict u8, sc1: *restrict u8, sc2: *restrict u8, sc3: *restrict u8,
    mn0: *restrict u8, mn1: *restrict u8, mn2: *restrict u8, mn3: *restrict u8,
    d_arr0: *restrict f32, d_arr1: *restrict f32, d_arr2: *restrict f32, d_arr3: *restrict f32,
    dm_arr0: *restrict f32, dm_arr1: *restrict f32, dm_arr2: *restrict f32, dm_arr3: *restrict f32,
    q8d_0: *restrict f32, q8d_1: *restrict f32, q8d_2: *restrict f32, q8d_3: *restrict f32,
    out scores: *mut f32 [cap: 16],
    n_blocks: i32
) {
    let mask_lo: u8x16 = splat(15)
    let shift4: u8x16 = splat(4)

    // 16 accumulators: acc[row][token]
    let mut r0t0: f32 = 0.0
    let mut r0t1: f32 = 0.0
    let mut r0t2: f32 = 0.0
    let mut r0t3: f32 = 0.0
    let mut r1t0: f32 = 0.0
    let mut r1t1: f32 = 0.0
    let mut r1t2: f32 = 0.0
    let mut r1t3: f32 = 0.0
    let mut r2t0: f32 = 0.0
    let mut r2t1: f32 = 0.0
    let mut r2t2: f32 = 0.0
    let mut r2t3: f32 = 0.0
    let mut r3t0: f32 = 0.0
    let mut r3t1: f32 = 0.0
    let mut r3t2: f32 = 0.0
    let mut r3t3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let q4_off: i32 = blk * 144 + 16
        let q8_off: i32 = blk * 256
        let sc_off: i32 = blk * 8
        let bs_off: i32 = blk * 16

        // Integer accumulators per row×token
        let mut s0t0: i32 = 0
        let mut s0t1: i32 = 0
        let mut s0t2: i32 = 0
        let mut s0t3: i32 = 0
        let mut s1t0: i32 = 0
        let mut s1t1: i32 = 0
        let mut s1t2: i32 = 0
        let mut s1t3: i32 = 0
        let mut s2t0: i32 = 0
        let mut s2t1: i32 = 0
        let mut s2t2: i32 = 0
        let mut s2t3: i32 = 0
        let mut s3t0: i32 = 0
        let mut s3t1: i32 = 0
        let mut s3t2: i32 = 0
        let mut s3t3: i32 = 0

        let mut j: i32 = 0
        while j < 4 {
            // Load Q4 weight nibbles for all 4 rows — ONE load per block chunk
            let p0a: u8x16 = load(rw0, q4_off + j * 32)
            let p0b: u8x16 = load(rw0, q4_off + j * 32 + 16)
            let p1a: u8x16 = load(rw1, q4_off + j * 32)
            let p1b: u8x16 = load(rw1, q4_off + j * 32 + 16)
            let p2a: u8x16 = load(rw2, q4_off + j * 32)
            let p2b: u8x16 = load(rw2, q4_off + j * 32 + 16)
            let p3a: u8x16 = load(rw3, q4_off + j * 32)
            let p3b: u8x16 = load(rw3, q4_off + j * 32 + 16)

            // Pre-split lo/hi nibbles for all rows
            let p0a_lo: u8x16 = p0a .& mask_lo
            let p0b_lo: u8x16 = p0b .& mask_lo
            let p0a_hi: u8x16 = p0a .>> shift4
            let p0b_hi: u8x16 = p0b .>> shift4
            let p1a_lo: u8x16 = p1a .& mask_lo
            let p1b_lo: u8x16 = p1b .& mask_lo
            let p1a_hi: u8x16 = p1a .>> shift4
            let p1b_hi: u8x16 = p1b .>> shift4
            let p2a_lo: u8x16 = p2a .& mask_lo
            let p2b_lo: u8x16 = p2b .& mask_lo
            let p2a_hi: u8x16 = p2a .>> shift4
            let p2b_hi: u8x16 = p2b .>> shift4
            let p3a_lo: u8x16 = p3a .& mask_lo
            let p3b_lo: u8x16 = p3b .& mask_lo
            let p3a_hi: u8x16 = p3a .>> shift4
            let p3b_hi: u8x16 = p3b .>> shift4

            // Token 0 — load Q8 once, dot with all 4 rows
            let a0: i8x16 = load(q8_0, q8_off + j * 64)
            let a1: i8x16 = load(q8_0, q8_off + j * 64 + 16)
            let b0: i8x16 = load(q8_0, q8_off + j * 64 + 32)
            let b1: i8x16 = load(q8_0, q8_off + j * 64 + 48)
            s0t0 = s0t0 + reduce_add(maddubs_i32(p0a_lo, a0) .+ maddubs_i32(p0b_lo, a1)) * to_i32(sc0[sc_off + 2*j]) + reduce_add(maddubs_i32(p0a_hi, b0) .+ maddubs_i32(p0b_hi, b1)) * to_i32(sc0[sc_off + 2*j+1])
            s1t0 = s1t0 + reduce_add(maddubs_i32(p1a_lo, a0) .+ maddubs_i32(p1b_lo, a1)) * to_i32(sc1[sc_off + 2*j]) + reduce_add(maddubs_i32(p1a_hi, b0) .+ maddubs_i32(p1b_hi, b1)) * to_i32(sc1[sc_off + 2*j+1])
            s2t0 = s2t0 + reduce_add(maddubs_i32(p2a_lo, a0) .+ maddubs_i32(p2b_lo, a1)) * to_i32(sc2[sc_off + 2*j]) + reduce_add(maddubs_i32(p2a_hi, b0) .+ maddubs_i32(p2b_hi, b1)) * to_i32(sc2[sc_off + 2*j+1])
            s3t0 = s3t0 + reduce_add(maddubs_i32(p3a_lo, a0) .+ maddubs_i32(p3b_lo, a1)) * to_i32(sc3[sc_off + 2*j]) + reduce_add(maddubs_i32(p3a_hi, b0) .+ maddubs_i32(p3b_hi, b1)) * to_i32(sc3[sc_off + 2*j+1])

            // Token 1
            let a0: i8x16 = load(q8_1, q8_off + j * 64)
            let a1: i8x16 = load(q8_1, q8_off + j * 64 + 16)
            let b0: i8x16 = load(q8_1, q8_off + j * 64 + 32)
            let b1: i8x16 = load(q8_1, q8_off + j * 64 + 48)
            s0t1 = s0t1 + reduce_add(maddubs_i32(p0a_lo, a0) .+ maddubs_i32(p0b_lo, a1)) * to_i32(sc0[sc_off + 2*j]) + reduce_add(maddubs_i32(p0a_hi, b0) .+ maddubs_i32(p0b_hi, b1)) * to_i32(sc0[sc_off + 2*j+1])
            s1t1 = s1t1 + reduce_add(maddubs_i32(p1a_lo, a0) .+ maddubs_i32(p1b_lo, a1)) * to_i32(sc1[sc_off + 2*j]) + reduce_add(maddubs_i32(p1a_hi, b0) .+ maddubs_i32(p1b_hi, b1)) * to_i32(sc1[sc_off + 2*j+1])
            s2t1 = s2t1 + reduce_add(maddubs_i32(p2a_lo, a0) .+ maddubs_i32(p2b_lo, a1)) * to_i32(sc2[sc_off + 2*j]) + reduce_add(maddubs_i32(p2a_hi, b0) .+ maddubs_i32(p2b_hi, b1)) * to_i32(sc2[sc_off + 2*j+1])
            s3t1 = s3t1 + reduce_add(maddubs_i32(p3a_lo, a0) .+ maddubs_i32(p3b_lo, a1)) * to_i32(sc3[sc_off + 2*j]) + reduce_add(maddubs_i32(p3a_hi, b0) .+ maddubs_i32(p3b_hi, b1)) * to_i32(sc3[sc_off + 2*j+1])

            // Token 2
            let a0: i8x16 = load(q8_2, q8_off + j * 64)
            let a1: i8x16 = load(q8_2, q8_off + j * 64 + 16)
            let b0: i8x16 = load(q8_2, q8_off + j * 64 + 32)
            let b1: i8x16 = load(q8_2, q8_off + j * 64 + 48)
            s0t2 = s0t2 + reduce_add(maddubs_i32(p0a_lo, a0) .+ maddubs_i32(p0b_lo, a1)) * to_i32(sc0[sc_off + 2*j]) + reduce_add(maddubs_i32(p0a_hi, b0) .+ maddubs_i32(p0b_hi, b1)) * to_i32(sc0[sc_off + 2*j+1])
            s1t2 = s1t2 + reduce_add(maddubs_i32(p1a_lo, a0) .+ maddubs_i32(p1b_lo, a1)) * to_i32(sc1[sc_off + 2*j]) + reduce_add(maddubs_i32(p1a_hi, b0) .+ maddubs_i32(p1b_hi, b1)) * to_i32(sc1[sc_off + 2*j+1])
            s2t2 = s2t2 + reduce_add(maddubs_i32(p2a_lo, a0) .+ maddubs_i32(p2b_lo, a1)) * to_i32(sc2[sc_off + 2*j]) + reduce_add(maddubs_i32(p2a_hi, b0) .+ maddubs_i32(p2b_hi, b1)) * to_i32(sc2[sc_off + 2*j+1])
            s3t2 = s3t2 + reduce_add(maddubs_i32(p3a_lo, a0) .+ maddubs_i32(p3b_lo, a1)) * to_i32(sc3[sc_off + 2*j]) + reduce_add(maddubs_i32(p3a_hi, b0) .+ maddubs_i32(p3b_hi, b1)) * to_i32(sc3[sc_off + 2*j+1])

            // Token 3
            let a0: i8x16 = load(q8_3, q8_off + j * 64)
            let a1: i8x16 = load(q8_3, q8_off + j * 64 + 16)
            let b0: i8x16 = load(q8_3, q8_off + j * 64 + 32)
            let b1: i8x16 = load(q8_3, q8_off + j * 64 + 48)
            s0t3 = s0t3 + reduce_add(maddubs_i32(p0a_lo, a0) .+ maddubs_i32(p0b_lo, a1)) * to_i32(sc0[sc_off + 2*j]) + reduce_add(maddubs_i32(p0a_hi, b0) .+ maddubs_i32(p0b_hi, b1)) * to_i32(sc0[sc_off + 2*j+1])
            s1t3 = s1t3 + reduce_add(maddubs_i32(p1a_lo, a0) .+ maddubs_i32(p1b_lo, a1)) * to_i32(sc1[sc_off + 2*j]) + reduce_add(maddubs_i32(p1a_hi, b0) .+ maddubs_i32(p1b_hi, b1)) * to_i32(sc1[sc_off + 2*j+1])
            s2t3 = s2t3 + reduce_add(maddubs_i32(p2a_lo, a0) .+ maddubs_i32(p2b_lo, a1)) * to_i32(sc2[sc_off + 2*j]) + reduce_add(maddubs_i32(p2a_hi, b0) .+ maddubs_i32(p2b_hi, b1)) * to_i32(sc2[sc_off + 2*j+1])
            s3t3 = s3t3 + reduce_add(maddubs_i32(p3a_lo, a0) .+ maddubs_i32(p3b_lo, a1)) * to_i32(sc3[sc_off + 2*j]) + reduce_add(maddubs_i32(p3a_hi, b0) .+ maddubs_i32(p3b_hi, b1)) * to_i32(sc3[sc_off + 2*j+1])

            j = j + 1
        }

        // Min correction — shared per-row, applied to all 4 tokens
        let mut mm0: i32 = 0
        let mut mm1: i32 = 0
        let mut mm2: i32 = 0
        let mut mm3: i32 = 0
        // Token bsums corrections
        let mut mb0_t0: i32 = 0
        let mut mb0_t1: i32 = 0
        let mut mb0_t2: i32 = 0
        let mut mb0_t3: i32 = 0
        let mut mb1_t0: i32 = 0
        let mut mb1_t1: i32 = 0
        let mut mb1_t2: i32 = 0
        let mut mb1_t3: i32 = 0
        let mut mb2_t0: i32 = 0
        let mut mb2_t1: i32 = 0
        let mut mb2_t2: i32 = 0
        let mut mb2_t3: i32 = 0
        let mut mb3_t0: i32 = 0
        let mut mb3_t1: i32 = 0
        let mut mb3_t2: i32 = 0
        let mut mb3_t3: i32 = 0
        j = 0
        while j < 8 {
            let m0: i32 = to_i32(mn0[sc_off + j])
            let m1: i32 = to_i32(mn1[sc_off + j])
            let m2: i32 = to_i32(mn2[sc_off + j])
            let m3: i32 = to_i32(mn3[sc_off + j])
            let bp0: i32 = bsums_0[bs_off + 2*j] + bsums_0[bs_off + 2*j+1]
            let bp1: i32 = bsums_1[bs_off + 2*j] + bsums_1[bs_off + 2*j+1]
            let bp2: i32 = bsums_2[bs_off + 2*j] + bsums_2[bs_off + 2*j+1]
            let bp3: i32 = bsums_3[bs_off + 2*j] + bsums_3[bs_off + 2*j+1]
            mb0_t0 = mb0_t0 + m0 * bp0
            mb0_t1 = mb0_t1 + m0 * bp1
            mb0_t2 = mb0_t2 + m0 * bp2
            mb0_t3 = mb0_t3 + m0 * bp3
            mb1_t0 = mb1_t0 + m1 * bp0
            mb1_t1 = mb1_t1 + m1 * bp1
            mb1_t2 = mb1_t2 + m1 * bp2
            mb1_t3 = mb1_t3 + m1 * bp3
            mb2_t0 = mb2_t0 + m2 * bp0
            mb2_t1 = mb2_t1 + m2 * bp1
            mb2_t2 = mb2_t2 + m2 * bp2
            mb2_t3 = mb2_t3 + m2 * bp3
            mb3_t0 = mb3_t0 + m3 * bp0
            mb3_t1 = mb3_t1 + m3 * bp1
            mb3_t2 = mb3_t2 + m3 * bp2
            mb3_t3 = mb3_t3 + m3 * bp3
            j = j + 1
        }

        // Per-block d/dmin × per-token q8_d
        let db0_t0: f32 = d_arr0[blk] * q8d_0[blk]
        let db0_t1: f32 = d_arr0[blk] * q8d_1[blk]
        let db0_t2: f32 = d_arr0[blk] * q8d_2[blk]
        let db0_t3: f32 = d_arr0[blk] * q8d_3[blk]
        let db1_t0: f32 = d_arr1[blk] * q8d_0[blk]
        let db1_t1: f32 = d_arr1[blk] * q8d_1[blk]
        let db1_t2: f32 = d_arr1[blk] * q8d_2[blk]
        let db1_t3: f32 = d_arr1[blk] * q8d_3[blk]
        let db2_t0: f32 = d_arr2[blk] * q8d_0[blk]
        let db2_t1: f32 = d_arr2[blk] * q8d_1[blk]
        let db2_t2: f32 = d_arr2[blk] * q8d_2[blk]
        let db2_t3: f32 = d_arr2[blk] * q8d_3[blk]
        let db3_t0: f32 = d_arr3[blk] * q8d_0[blk]
        let db3_t1: f32 = d_arr3[blk] * q8d_1[blk]
        let db3_t2: f32 = d_arr3[blk] * q8d_2[blk]
        let db3_t3: f32 = d_arr3[blk] * q8d_3[blk]
        let mb0_q0: f32 = dm_arr0[blk] * q8d_0[blk]
        let mb0_q1: f32 = dm_arr0[blk] * q8d_1[blk]
        let mb0_q2: f32 = dm_arr0[blk] * q8d_2[blk]
        let mb0_q3: f32 = dm_arr0[blk] * q8d_3[blk]
        let mb1_q0: f32 = dm_arr1[blk] * q8d_0[blk]
        let mb1_q1: f32 = dm_arr1[blk] * q8d_1[blk]
        let mb1_q2: f32 = dm_arr1[blk] * q8d_2[blk]
        let mb1_q3: f32 = dm_arr1[blk] * q8d_3[blk]
        let mb2_q0: f32 = dm_arr2[blk] * q8d_0[blk]
        let mb2_q1: f32 = dm_arr2[blk] * q8d_1[blk]
        let mb2_q2: f32 = dm_arr2[blk] * q8d_2[blk]
        let mb2_q3: f32 = dm_arr2[blk] * q8d_3[blk]
        let mb3_q0: f32 = dm_arr3[blk] * q8d_0[blk]
        let mb3_q1: f32 = dm_arr3[blk] * q8d_1[blk]
        let mb3_q2: f32 = dm_arr3[blk] * q8d_2[blk]
        let mb3_q3: f32 = dm_arr3[blk] * q8d_3[blk]

        r0t0 = r0t0 + db0_t0 * to_f32(s0t0) - mb0_q0 * to_f32(mb0_t0)
        r0t1 = r0t1 + db0_t1 * to_f32(s0t1) - mb0_q1 * to_f32(mb0_t1)
        r0t2 = r0t2 + db0_t2 * to_f32(s0t2) - mb0_q2 * to_f32(mb0_t2)
        r0t3 = r0t3 + db0_t3 * to_f32(s0t3) - mb0_q3 * to_f32(mb0_t3)
        r1t0 = r1t0 + db1_t0 * to_f32(s1t0) - mb1_q0 * to_f32(mb1_t0)
        r1t1 = r1t1 + db1_t1 * to_f32(s1t1) - mb1_q1 * to_f32(mb1_t1)
        r1t2 = r1t2 + db1_t2 * to_f32(s1t2) - mb1_q2 * to_f32(mb1_t2)
        r1t3 = r1t3 + db1_t3 * to_f32(s1t3) - mb1_q3 * to_f32(mb1_t3)
        r2t0 = r2t0 + db2_t0 * to_f32(s2t0) - mb2_q0 * to_f32(mb2_t0)
        r2t1 = r2t1 + db2_t1 * to_f32(s2t1) - mb2_q1 * to_f32(mb2_t1)
        r2t2 = r2t2 + db2_t2 * to_f32(s2t2) - mb2_q2 * to_f32(mb2_t2)
        r2t3 = r2t3 + db2_t3 * to_f32(s2t3) - mb2_q3 * to_f32(mb2_t3)
        r3t0 = r3t0 + db3_t0 * to_f32(s3t0) - mb3_q0 * to_f32(mb3_t0)
        r3t1 = r3t1 + db3_t1 * to_f32(s3t1) - mb3_q1 * to_f32(mb3_t1)
        r3t2 = r3t2 + db3_t2 * to_f32(s3t2) - mb3_q2 * to_f32(mb3_t2)
        r3t3 = r3t3 + db3_t3 * to_f32(s3t3) - mb3_q3 * to_f32(mb3_t3)

        blk = blk + 1
    }

    // Output: scores[row * 4 + token]
    scores[0] = r0t0
    scores[1] = r0t1
    scores[2] = r0t2
    scores[3] = r0t3
    scores[4] = r1t0
    scores[5] = r1t1
    scores[6] = r1t2
    scores[7] = r1t3
    scores[8] = r2t0
    scores[9] = r2t1
    scores[10] = r2t2
    scores[11] = r2t3
    scores[12] = r3t0
    scores[13] = r3t1
    scores[14] = r3t2
    scores[15] = r3t3
}
