// q4k_dot_8x8_gemm_arm.ea — Q4Kx8 × Q8Kx4 batched gemm (ARM NEON + dotprod).
//
// ARM port of q4k_dot_8x8_gemm.ea.  Reuses the matvec's vdot body:
// vdot_i32 for 4-wide dots, addp_i32 pairwise reduction, f32x4 accumulators.
// For each Q8K row within a block_q8_Kx4 tile, extracts that row's 64 bytes
// into scratch via *i64 de-interleave, then runs the matvec inner body.

#[cfg(aarch64)]

func ubyte(p: *restrict u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

export func q4k_8x8_q8k_gemm(
    packed: *restrict u8,
    q8_a:  *restrict u8,
    scratch: *mut u8,
    out:   *mut f32,
    bs:    i32,
    n:     i32,
    nr:    i32,
    nc:    i32
) {
    let nb: i32 = n / 256
    let m4b: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let km1: i32 = 0x3f3f3f3f
    let km2: i32 = 0x0f0f0f0f
    let km3: i32 = 0x03030303

    let dup8: u8x16 = [0,1,2,3,4,5,6,7, 0,1,2,3,4,5,6,7]

    let d16: *restrict i16 = ptr_as_i16(ptr_as_i8(packed))
    let packed_i8: *restrict i8 = ptr_as_i8(packed)
    let out_f32: *mut f32 = ptr_as_f32(ptr_as_i8(out))
    let q8_i8: *restrict i8 = ptr_as_i8(q8_a)
    let q8_i64: *restrict i64 = ptr_as_i64(q8_i8)
    let scratch_i8: *mut i8 = ptr_as_i8(scratch)
    let scratch_i64: *mut i64 = ptr_as_i64(scratch_i8)

    let nr4: i32 = nr / 4
    let mut y: i32 = 0
    while y < nr4 {
        let mut x: i32 = 0
        while x < nc / 8 {
            // 4 Q8K rows × 2 f32x4 accumulators (rows 0-3 and 4-7)
            let mut acc0_0: f32x4 = splat(0.0)
            let mut acc1_0: f32x4 = splat(0.0)
            let mut acc0_1: f32x4 = splat(0.0)
            let mut acc1_1: f32x4 = splat(0.0)
            let mut acc0_2: f32x4 = splat(0.0)
            let mut acc1_2: f32x4 = splat(0.0)
            let mut acc0_3: f32x4 = splat(0.0)
            let mut acc1_3: f32x4 = splat(0.0)

            let mut b: i32 = 0
            while b < nb {
                let bp: i32 = (x * nb + b) * 1152

                // Weight d[0..3], d[4..7] as f32x4
                let q4d0: f32x4 = cvt_f16_f32(load(d16, bp / 2))
                let q4d1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 4))
                // Weight dmin[0..3], dmin[4..7]
                let q4dm0: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 8))
                let q4dm1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 12))

                // block_q8_Kx4 base for this tile
                let ab: i32 = (y * nb + b) * 1168

                // Per-row Q8K deltas (4 scalars from block_q8_Kx4.d[0..3])
                let q8d: *restrict f32 = ptr_as_f32(q8_i8)
                let q8d0: f32 = q8d[ab / 4]
                let q8d1: f32 = q8d[ab / 4 + 1]
                let q8d2: f32 = q8d[ab / 4 + 2]
                let q8d3: f32 = q8d[ab / 4 + 3]

                // Per-row scale products
                let sb_sc0_0: f32x4 = q4d0 .* splat(q8d0)
                let sb_sc1_0: f32x4 = q4d1 .* splat(q8d0)
                let sb_sc0_1: f32x4 = q4d0 .* splat(q8d1)
                let sb_sc1_1: f32x4 = q4d1 .* splat(q8d1)
                let sb_sc0_2: f32x4 = q4d0 .* splat(q8d2)
                let sb_sc1_2: f32x4 = q4d1 .* splat(q8d2)
                let sb_sc0_3: f32x4 = q4d0 .* splat(q8d3)
                let sb_sc1_3: f32x4 = q4d1 .* splat(q8d3)

                // Per-row dmin products
                let sb_mn0_0: f32x4 = q4dm0 .* splat(q8d0)
                let sb_mn1_0: f32x4 = q4dm1 .* splat(q8d0)
                let sb_mn0_1: f32x4 = q4dm0 .* splat(q8d1)
                let sb_mn1_1: f32x4 = q4dm1 .* splat(q8d1)
                let sb_mn0_2: f32x4 = q4dm0 .* splat(q8d2)
                let sb_mn1_2: f32x4 = q4dm1 .* splat(q8d2)
                let sb_mn0_3: f32x4 = q4dm0 .* splat(q8d3)
                let sb_mn1_3: f32x4 = q4dm1 .* splat(q8d3)

                // Per-row bias accumulators
                let mut bias0_0: i32x4 = splat(0)
                let mut bias1_0: i32x4 = splat(0)
                let mut bias0_1: i32x4 = splat(0)
                let mut bias1_1: i32x4 = splat(0)
                let mut bias0_2: i32x4 = splat(0)
                let mut bias1_2: i32x4 = splat(0)
                let mut bias0_3: i32x4 = splat(0)
                let mut bias1_3: i32x4 = splat(0)

                let mut sb: i32 = 0
                while sb < 4 {
                    // ── Scale decode (shared across cc) ──────────────
                    let sp: *restrict i32 = ptr_as_i32(ptr_as_i8(packed))
                    let sc0: i32 = bp + 32 + 24 * sb
                    let u00: i32 = sp[sc0/4]
                    let u01: i32 = sp[sc0/4+1]
                    let u02: i32 = sp[sc0/4+2]
                    let t00: i32 = u00 & km1
                    let t02: i32 = u01 & km1
                    let t01: i32 = (u02 & km2) | (((u00 >> 6) & km3) << 4)
                    let t03: i32 = ((u02 >> 4) & km2) | (((u01 >> 6) & km3) << 4)
                    let sc1: i32 = sc0 + 12
                    let u10: i32 = sp[sc1/4]
                    let u11: i32 = sp[sc1/4+1]
                    let u12: i32 = sp[sc1/4+2]
                    let t10: i32 = u10 & km1
                    let t12: i32 = u11 & km1
                    let t11: i32 = (u12 & km2) | (((u10 >> 6) & km3) << 4)
                    let t13: i32 = ((u12 >> 4) & km2) | (((u11 >> 6) & km3) << 4)

                    let sc_lo_0: i32x4 = [t00 & 255, (t00>>8)&255, (t00>>16)&255, (t00>>24)&255]
                    let sc_hi_0: i32x4 = [t01 & 255, (t01>>8)&255, (t01>>16)&255, (t01>>24)&255]
                    let sc_lo_1: i32x4 = [t10 & 255, (t10>>8)&255, (t10>>16)&255, (t10>>24)&255]
                    let sc_hi_1: i32x4 = [t11 & 255, (t11>>8)&255, (t11>>16)&255, (t11>>24)&255]

                    let q4_base: i32 = bp + 128 + sb * 256

                    // ── Q8K extraction base (i64 units) ──────────────
                    let aqs_i64: i32 = (ab + 16 + sb * 256) / 8

                    let mut cc: i32 = 0
                    while cc < 4 {
                        // Extract 64 bytes of row cc's Q8K into scratch
                        scratch_i64[0] = q8_i64[aqs_i64 + 0 * 4 + cc]
                        scratch_i64[1] = q8_i64[aqs_i64 + 1 * 4 + cc]
                        scratch_i64[2] = q8_i64[aqs_i64 + 2 * 4 + cc]
                        scratch_i64[3] = q8_i64[aqs_i64 + 3 * 4 + cc]
                        scratch_i64[4] = q8_i64[aqs_i64 + 16 + 0 * 4 + cc]
                        scratch_i64[5] = q8_i64[aqs_i64 + 16 + 1 * 4 + cc]
                        scratch_i64[6] = q8_i64[aqs_i64 + 16 + 2 * 4 + cc]
                        scratch_i64[7] = q8_i64[aqs_i64 + 16 + 3 * 4 + cc]

                        // Load Q8K: 8 chunks of 8 bytes, broadcast to 16
                        let q8r_0: i8x16 = load(scratch_i8, 0)
                        let q8r_1: i8x16 = load(scratch_i8, 8)
                        let q8r_2: i8x16 = load(scratch_i8, 16)
                        let q8r_3: i8x16 = load(scratch_i8, 24)
                        let q8r_4: i8x16 = load(scratch_i8, 32)
                        let q8r_5: i8x16 = load(scratch_i8, 40)
                        let q8r_6: i8x16 = load(scratch_i8, 48)
                        let q8r_7: i8x16 = load(scratch_i8, 56)
                        let q8_0: i8x16 = shuffle_bytes(q8r_0, dup8)
                        let q8_1: i8x16 = shuffle_bytes(q8r_1, dup8)
                        let q8_2: i8x16 = shuffle_bytes(q8r_2, dup8)
                        let q8_3: i8x16 = shuffle_bytes(q8r_3, dup8)
                        let q8_4: i8x16 = shuffle_bytes(q8r_4, dup8)
                        let q8_5: i8x16 = shuffle_bytes(q8r_5, dup8)
                        let q8_6: i8x16 = shuffle_bytes(q8r_6, dup8)
                        let q8_7: i8x16 = shuffle_bytes(q8r_7, dup8)

                        // ── vdot body: 4 column-pair iterations ──────
                        let mut alo0: i32x4 = splat(0)
                        let mut alo1: i32x4 = splat(0)
                        let mut alo2: i32x4 = splat(0)
                        let mut alo3: i32x4 = splat(0)
                        let mut ahi0: i32x4 = splat(0)
                        let mut ahi1: i32x4 = splat(0)
                        let mut ahi2: i32x4 = splat(0)
                        let mut ahi3: i32x4 = splat(0)

                        let mut cp: i32 = 0
                        while cp < 4 {
                            let qp0: i8x16 = load(packed_i8, q4_base + 16 * cp)
                            let qp1: i8x16 = load(packed_i8, q4_base + 16 * cp + 64)
                            let qp2: i8x16 = load(packed_i8, q4_base + 16 * cp + 128)
                            let qp3: i8x16 = load(packed_i8, q4_base + 16 * cp + 192)

                            let lo0: i8x16 = qp0 .& m4b
                            let lo1: i8x16 = qp1 .& m4b
                            let lo2: i8x16 = qp2 .& m4b
                            let lo3: i8x16 = qp3 .& m4b
                            let hi0: i8x16 = (qp0 .>> shift4) .& m4b
                            let hi1: i8x16 = (qp1 .>> shift4) .& m4b
                            let hi2: i8x16 = (qp2 .>> shift4) .& m4b
                            let hi3: i8x16 = (qp3 .>> shift4) .& m4b

                            if cp == 0 {
                                alo0 = vdot_i32(lo0, q8_0) .+ vdot_i32(lo1, q8_1) .+ vdot_i32(lo2, q8_2) .+ vdot_i32(lo3, q8_3)
                                ahi0 = vdot_i32(hi0, q8_4) .+ vdot_i32(hi1, q8_5) .+ vdot_i32(hi2, q8_6) .+ vdot_i32(hi3, q8_7)
                            }
                            if cp == 1 {
                                alo1 = vdot_i32(lo0, q8_0) .+ vdot_i32(lo1, q8_1) .+ vdot_i32(lo2, q8_2) .+ vdot_i32(lo3, q8_3)
                                ahi1 = vdot_i32(hi0, q8_4) .+ vdot_i32(hi1, q8_5) .+ vdot_i32(hi2, q8_6) .+ vdot_i32(hi3, q8_7)
                            }
                            if cp == 2 {
                                alo2 = vdot_i32(lo0, q8_0) .+ vdot_i32(lo1, q8_1) .+ vdot_i32(lo2, q8_2) .+ vdot_i32(lo3, q8_3)
                                ahi2 = vdot_i32(hi0, q8_4) .+ vdot_i32(hi1, q8_5) .+ vdot_i32(hi2, q8_6) .+ vdot_i32(hi3, q8_7)
                            }
                            if cp == 3 {
                                alo3 = vdot_i32(lo0, q8_0) .+ vdot_i32(lo1, q8_1) .+ vdot_i32(lo2, q8_2) .+ vdot_i32(lo3, q8_3)
                                ahi3 = vdot_i32(hi0, q8_4) .+ vdot_i32(hi1, q8_5) .+ vdot_i32(hi2, q8_6) .+ vdot_i32(hi3, q8_7)
                            }

                            cp = cp + 1
                        }

                        // ── Pairwise reduce + scale multiply ─────────
                        let plo_03: i32x4 = addp_i32(alo0, alo1)
                        let plo_47: i32x4 = addp_i32(alo2, alo3)
                        let phi_03: i32x4 = addp_i32(ahi0, ahi1)
                        let phi_47: i32x4 = addp_i32(ahi2, ahi3)

                        let sumf_lo_03: f32x4 = to_f32(sc_lo_0 .* plo_03)
                        let sumf_lo_47: f32x4 = to_f32(sc_lo_0 .* plo_47)
                        let sumf_hi_03: f32x4 = to_f32(sc_lo_1 .* phi_03)
                        let sumf_hi_47: f32x4 = to_f32(sc_lo_1 .* phi_47)

                        // ── Bsums for this row ───────────────────────
                        let bsums_i16: *restrict i16 = ptr_as_i16(q8_i8)
                        let bsums_base: i32 = (ab + 1040) / 2 + sb * 16
                        let rb: i32 = (cc / 2) * 8 + (cc % 2) * 4
                        let bp0: i16 = bsums_i16[bsums_base + rb]
                        let bp1: i16 = bsums_i16[bsums_base + rb + 1]
                        let bp2: i16 = bsums_i16[bsums_base + rb + 2]
                        let bp3: i16 = bsums_i16[bsums_base + rb + 3]
                        let bs0: i16 = bp0 + bp1
                        let bs1: i16 = bp2 + bp3

                        let b0_0: i32 = (t02 & 255) * to_i32(bs0) + (t12 & 255) * to_i32(bs1)
                        let b0_1: i32 = ((t02>>8)&255) * to_i32(bs0) + ((t12>>8)&255) * to_i32(bs1)
                        let b0_2: i32 = ((t02>>16)&255) * to_i32(bs0) + ((t12>>16)&255) * to_i32(bs1)
                        let b0_3: i32 = ((t02>>24)&255) * to_i32(bs0) + ((t12>>24)&255) * to_i32(bs1)
                        let bias_d0: i32x4 = [b0_0, b0_1, b0_2, b0_3]

                        let b1_0: i32 = (t03 & 255) * to_i32(bs0) + (t13 & 255) * to_i32(bs1)
                        let b1_1: i32 = ((t03>>8)&255) * to_i32(bs0) + ((t13>>8)&255) * to_i32(bs1)
                        let b1_2: i32 = ((t03>>16)&255) * to_i32(bs0) + ((t13>>16)&255) * to_i32(bs1)
                        let b1_3: i32 = ((t03>>24)&255) * to_i32(bs0) + ((t13>>24)&255) * to_i32(bs1)
                        let bias_d1: i32x4 = [b1_0, b1_1, b1_2, b1_3]

                        // ── Accumulate into the right row ────────────
                        if cc == 0 {
                            acc0_0 = fma(sb_sc0_0, sumf_lo_03, acc0_0)
                            acc1_0 = fma(sb_sc1_0, sumf_lo_47, acc1_0)
                            acc0_0 = fma(sb_sc0_0, sumf_hi_03, acc0_0)
                            acc1_0 = fma(sb_sc1_0, sumf_hi_47, acc1_0)
                            bias0_0 = bias0_0 .+ bias_d0
                            bias1_0 = bias1_0 .+ bias_d1
                        }
                        if cc == 1 {
                            acc0_1 = fma(sb_sc0_1, sumf_lo_03, acc0_1)
                            acc1_1 = fma(sb_sc1_1, sumf_lo_47, acc1_1)
                            acc0_1 = fma(sb_sc0_1, sumf_hi_03, acc0_1)
                            acc1_1 = fma(sb_sc1_1, sumf_hi_47, acc1_1)
                            bias0_1 = bias0_1 .+ bias_d0
                            bias1_1 = bias1_1 .+ bias_d1
                        }
                        if cc == 2 {
                            acc0_2 = fma(sb_sc0_2, sumf_lo_03, acc0_2)
                            acc1_2 = fma(sb_sc1_2, sumf_lo_47, acc1_2)
                            acc0_2 = fma(sb_sc0_2, sumf_hi_03, acc0_2)
                            acc1_2 = fma(sb_sc1_2, sumf_hi_47, acc1_2)
                            bias0_2 = bias0_2 .+ bias_d0
                            bias1_2 = bias1_2 .+ bias_d1
                        }
                        if cc == 3 {
                            acc0_3 = fma(sb_sc0_3, sumf_lo_03, acc0_3)
                            acc1_3 = fma(sb_sc1_3, sumf_lo_47, acc1_3)
                            acc0_3 = fma(sb_sc0_3, sumf_hi_03, acc0_3)
                            acc1_3 = fma(sb_sc1_3, sumf_hi_47, acc1_3)
                            bias0_3 = bias0_3 .+ bias_d0
                            bias1_3 = bias1_3 .+ bias_d1
                        }

                        cc = cc + 1
                    }
                    sb = sb + 1
                }

                // Subtract mins: acc -= bias * dmin
                acc0_0 = acc0_0 .- to_f32(bias0_0) .* sb_mn0_0
                acc1_0 = acc1_0 .- to_f32(bias1_0) .* sb_mn1_0
                acc0_1 = acc0_1 .- to_f32(bias0_1) .* sb_mn0_1
                acc1_1 = acc1_1 .- to_f32(bias1_1) .* sb_mn1_1
                acc0_2 = acc0_2 .- to_f32(bias0_2) .* sb_mn0_2
                acc1_2 = acc1_2 .- to_f32(bias1_2) .* sb_mn1_2
                acc0_3 = acc0_3 .- to_f32(bias0_3) .* sb_mn0_3
                acc1_3 = acc1_3 .- to_f32(bias1_3) .* sb_mn1_3

                b = b + 1
            }

            // Store: 4 Q8K rows × 8 values each
            store(out_f32, (y * 4 + 0) * bs + x * 8, acc0_0)
            store(out_f32, (y * 4 + 0) * bs + x * 8 + 4, acc1_0)
            store(out_f32, (y * 4 + 1) * bs + x * 8, acc0_1)
            store(out_f32, (y * 4 + 1) * bs + x * 8 + 4, acc1_1)
            store(out_f32, (y * 4 + 2) * bs + x * 8, acc0_2)
            store(out_f32, (y * 4 + 2) * bs + x * 8 + 4, acc1_2)
            store(out_f32, (y * 4 + 3) * bs + x * 8, acc0_3)
            store(out_f32, (y * 4 + 3) * bs + x * 8 + 4, acc1_3)

            x = x + 1
        }
        y = y + 1
    }
}
