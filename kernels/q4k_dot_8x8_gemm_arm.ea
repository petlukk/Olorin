// q4k_dot_8x8_gemm_arm.ea — Q4Kx8 x Q8Kx4 batched gemm (ARM NEON + dotprod).
//
// Uses vdot_lane_i32 with 4-byte interleaved Q4K and Q8K data.
// Each vdot_lane selects 4 bytes from the Q8K operand at lane*4,
// broadcasts them, and computes accumulating dot product with Q4K.
// No scatter-gather needed — sequential loads only.

#[cfg(aarch64)]

func ubyte(p: *restrict u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

export func q4k_8x8_q8k_gemm(
    packed: *restrict u8,
    q8_a:  *restrict u8,
    scratch: *mut u8,
    out:   *mut f32,
    bs:    i32,
    n:     i32,
    nr:    i32,
    nc:    i32
) {
    let nb: i32 = n / 256
    let m4b: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let km1: i32 = 0x3f3f3f3f
    let km2: i32 = 0x0f0f0f0f
    let km3: i32 = 0x03030303

    let d16: *restrict i16 = ptr_as_i16(ptr_as_i8(packed))
    let packed_i8: *restrict i8 = ptr_as_i8(packed)
    let out_f32: *mut f32 = ptr_as_f32(ptr_as_i8(out))
    let q8_i8: *restrict i8 = ptr_as_i8(q8_a)

    let nr4: i32 = nr / 4
    let mut y: i32 = 0
    while y < nr4 {
        let mut x: i32 = 0
        while x < nc / 8 {
            let mut acc0_0: f32x4 = splat(0.0)
            let mut acc1_0: f32x4 = splat(0.0)
            let mut acc0_1: f32x4 = splat(0.0)
            let mut acc1_1: f32x4 = splat(0.0)
            let mut acc0_2: f32x4 = splat(0.0)
            let mut acc1_2: f32x4 = splat(0.0)
            let mut acc0_3: f32x4 = splat(0.0)
            let mut acc1_3: f32x4 = splat(0.0)

            let mut b: i32 = 0
            while b < nb {
                let bp: i32 = (x * nb + b) * 1152

                let q4d0: f32x4 = cvt_f16_f32(load(d16, bp / 2))
                let q4d1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 4))
                let q4dm0: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 8))
                let q4dm1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 12))

                let ab: i32 = (y * nb + b) * 1168

                let q8d: *restrict f32 = ptr_as_f32(q8_i8)
                let q8d0: f32 = q8d[ab / 4]
                let q8d1: f32 = q8d[ab / 4 + 1]
                let q8d2: f32 = q8d[ab / 4 + 2]
                let q8d3: f32 = q8d[ab / 4 + 3]

                let sb_sc0_0: f32x4 = q4d0 .* splat(q8d0)
                let sb_sc1_0: f32x4 = q4d1 .* splat(q8d0)
                let sb_sc0_1: f32x4 = q4d0 .* splat(q8d1)
                let sb_sc1_1: f32x4 = q4d1 .* splat(q8d1)
                let sb_sc0_2: f32x4 = q4d0 .* splat(q8d2)
                let sb_sc1_2: f32x4 = q4d1 .* splat(q8d2)
                let sb_sc0_3: f32x4 = q4d0 .* splat(q8d3)
                let sb_sc1_3: f32x4 = q4d1 .* splat(q8d3)

                let sb_mn0_0: f32x4 = q4dm0 .* splat(q8d0)
                let sb_mn1_0: f32x4 = q4dm1 .* splat(q8d0)
                let sb_mn0_1: f32x4 = q4dm0 .* splat(q8d1)
                let sb_mn1_1: f32x4 = q4dm1 .* splat(q8d1)
                let sb_mn0_2: f32x4 = q4dm0 .* splat(q8d2)
                let sb_mn1_2: f32x4 = q4dm1 .* splat(q8d2)
                let sb_mn0_3: f32x4 = q4dm0 .* splat(q8d3)
                let sb_mn1_3: f32x4 = q4dm1 .* splat(q8d3)

                let mut bias0_0: i32x4 = splat(0)
                let mut bias1_0: i32x4 = splat(0)
                let mut bias0_1: i32x4 = splat(0)
                let mut bias1_1: i32x4 = splat(0)
                let mut bias0_2: i32x4 = splat(0)
                let mut bias1_2: i32x4 = splat(0)
                let mut bias0_3: i32x4 = splat(0)
                let mut bias1_3: i32x4 = splat(0)

                let mut sb: i32 = 0
                while sb < 4 {
                    // Scale decode (identical to old kernel)
                    let sp: *restrict i32 = ptr_as_i32(ptr_as_i8(packed))
                    let sc0: i32 = bp + 32 + 24 * sb
                    let u00: i32 = sp[sc0/4]
                    let u01: i32 = sp[sc0/4+1]
                    let u02: i32 = sp[sc0/4+2]
                    let t00: i32 = u00 & km1
                    let t02: i32 = u01 & km1
                    let t01: i32 = (u02 & km2) | (((u00 >> 6) & km3) << 4)
                    let t03: i32 = ((u02 >> 4) & km2) | (((u01 >> 6) & km3) << 4)
                    let sc1: i32 = sc0 + 12
                    let u10: i32 = sp[sc1/4]
                    let u11: i32 = sp[sc1/4+1]
                    let u12: i32 = sp[sc1/4+2]
                    let t10: i32 = u10 & km1
                    let t12: i32 = u11 & km1
                    let t11: i32 = (u12 & km2) | (((u10 >> 6) & km3) << 4)
                    let t13: i32 = ((u12 >> 4) & km2) | (((u11 >> 6) & km3) << 4)

                    let sc_lo_0: i32x4 = [t00 & 255, (t00>>8)&255, (t00>>16)&255, (t00>>24)&255]
                    let sc_hi_0: i32x4 = [t01 & 255, (t01>>8)&255, (t01>>16)&255, (t01>>24)&255]
                    let sc_lo_1: i32x4 = [t10 & 255, (t10>>8)&255, (t10>>16)&255, (t10>>24)&255]
                    let sc_hi_1: i32x4 = [t11 & 255, (t11>>8)&255, (t11>>16)&255, (t11>>24)&255]

                    // Q4K base for this sub-block
                    let q4_base: i32 = bp + 128 + sb * 256

                    // Q8K bases — 4-byte interleaved in block_q8_Kx4
                    // Lo positions: source bytes sb*64..sb*64+31 = groups sb*16..sb*16+7
                    // Hi positions: source bytes sb*64+32..sb*64+63 = groups sb*16+8..sb*16+15
                    let q8_lo_base: i32 = ab + 16 + sb * 256
                    let q8_hi_base: i32 = q8_lo_base + 128

                    // 16 accumulators: 4 input rows x 2 weight halves x 2 nibble halves
                    let mut al03_0: i32x4 = splat(0)
                    let mut al03_1: i32x4 = splat(0)
                    let mut al03_2: i32x4 = splat(0)
                    let mut al03_3: i32x4 = splat(0)
                    let mut ah03_0: i32x4 = splat(0)
                    let mut ah03_1: i32x4 = splat(0)
                    let mut ah03_2: i32x4 = splat(0)
                    let mut ah03_3: i32x4 = splat(0)
                    let mut al47_0: i32x4 = splat(0)
                    let mut al47_1: i32x4 = splat(0)
                    let mut al47_2: i32x4 = splat(0)
                    let mut al47_3: i32x4 = splat(0)
                    let mut ah47_0: i32x4 = splat(0)
                    let mut ah47_1: i32x4 = splat(0)
                    let mut ah47_2: i32x4 = splat(0)
                    let mut ah47_3: i32x4 = splat(0)

                    let mut k: i32 = 0
                    while k < 8 {
                        // Q8K: 4-byte interleaved, 16B per group = [r0 4B][r1 4B][r2 4B][r3 4B]
                        let q8_lo: i8x16 = load(q8_i8, q8_lo_base + k * 16)
                        let q8_hi: i8x16 = load(q8_i8, q8_hi_base + k * 16)

                        // Q4K: 4-byte interleaved, 32B per k = [r0-3 16B][r4-7 16B]
                        let w03: i8x16 = load(packed_i8, q4_base + k * 32)
                        let w47: i8x16 = load(packed_i8, q4_base + k * 32 + 16)
                        let w03_lo: i8x16 = w03 .& m4b
                        let w03_hi: i8x16 = (w03 .>> shift4) .& m4b
                        let w47_lo: i8x16 = w47 .& m4b
                        let w47_hi: i8x16 = (w47 .>> shift4) .& m4b

                        // 16 vdot_lane calls
                        al03_0 = vdot_lane_i32(al03_0, w03_lo, q8_lo, 0)
                        al03_1 = vdot_lane_i32(al03_1, w03_lo, q8_lo, 1)
                        al03_2 = vdot_lane_i32(al03_2, w03_lo, q8_lo, 2)
                        al03_3 = vdot_lane_i32(al03_3, w03_lo, q8_lo, 3)

                        ah03_0 = vdot_lane_i32(ah03_0, w03_hi, q8_hi, 0)
                        ah03_1 = vdot_lane_i32(ah03_1, w03_hi, q8_hi, 1)
                        ah03_2 = vdot_lane_i32(ah03_2, w03_hi, q8_hi, 2)
                        ah03_3 = vdot_lane_i32(ah03_3, w03_hi, q8_hi, 3)

                        al47_0 = vdot_lane_i32(al47_0, w47_lo, q8_lo, 0)
                        al47_1 = vdot_lane_i32(al47_1, w47_lo, q8_lo, 1)
                        al47_2 = vdot_lane_i32(al47_2, w47_lo, q8_lo, 2)
                        al47_3 = vdot_lane_i32(al47_3, w47_lo, q8_lo, 3)

                        ah47_0 = vdot_lane_i32(ah47_0, w47_hi, q8_hi, 0)
                        ah47_1 = vdot_lane_i32(ah47_1, w47_hi, q8_hi, 1)
                        ah47_2 = vdot_lane_i32(ah47_2, w47_hi, q8_hi, 2)
                        ah47_3 = vdot_lane_i32(ah47_3, w47_hi, q8_hi, 3)

                        k = k + 1
                    }

                    // Scale application per input row
                    // Row 0
                    let sf_lo_03_0: f32x4 = to_f32(sc_lo_0 .* al03_0)
                    let sf_hi_03_0: f32x4 = to_f32(sc_lo_1 .* ah03_0)
                    acc0_0 = fma(sb_sc0_0, sf_lo_03_0, acc0_0)
                    acc0_0 = fma(sb_sc0_0, sf_hi_03_0, acc0_0)
                    let sf_lo_47_0: f32x4 = to_f32(sc_hi_0 .* al47_0)
                    let sf_hi_47_0: f32x4 = to_f32(sc_hi_1 .* ah47_0)
                    acc1_0 = fma(sb_sc1_0, sf_lo_47_0, acc1_0)
                    acc1_0 = fma(sb_sc1_0, sf_hi_47_0, acc1_0)

                    // Row 1
                    let sf_lo_03_1: f32x4 = to_f32(sc_lo_0 .* al03_1)
                    let sf_hi_03_1: f32x4 = to_f32(sc_lo_1 .* ah03_1)
                    acc0_1 = fma(sb_sc0_1, sf_lo_03_1, acc0_1)
                    acc0_1 = fma(sb_sc0_1, sf_hi_03_1, acc0_1)
                    let sf_lo_47_1: f32x4 = to_f32(sc_hi_0 .* al47_1)
                    let sf_hi_47_1: f32x4 = to_f32(sc_hi_1 .* ah47_1)
                    acc1_1 = fma(sb_sc1_1, sf_lo_47_1, acc1_1)
                    acc1_1 = fma(sb_sc1_1, sf_hi_47_1, acc1_1)

                    // Row 2
                    let sf_lo_03_2: f32x4 = to_f32(sc_lo_0 .* al03_2)
                    let sf_hi_03_2: f32x4 = to_f32(sc_lo_1 .* ah03_2)
                    acc0_2 = fma(sb_sc0_2, sf_lo_03_2, acc0_2)
                    acc0_2 = fma(sb_sc0_2, sf_hi_03_2, acc0_2)
                    let sf_lo_47_2: f32x4 = to_f32(sc_hi_0 .* al47_2)
                    let sf_hi_47_2: f32x4 = to_f32(sc_hi_1 .* ah47_2)
                    acc1_2 = fma(sb_sc1_2, sf_lo_47_2, acc1_2)
                    acc1_2 = fma(sb_sc1_2, sf_hi_47_2, acc1_2)

                    // Row 3
                    let sf_lo_03_3: f32x4 = to_f32(sc_lo_0 .* al03_3)
                    let sf_hi_03_3: f32x4 = to_f32(sc_lo_1 .* ah03_3)
                    acc0_3 = fma(sb_sc0_3, sf_lo_03_3, acc0_3)
                    acc0_3 = fma(sb_sc0_3, sf_hi_03_3, acc0_3)
                    let sf_lo_47_3: f32x4 = to_f32(sc_hi_0 .* al47_3)
                    let sf_hi_47_3: f32x4 = to_f32(sc_hi_1 .* ah47_3)
                    acc1_3 = fma(sb_sc1_3, sf_lo_47_3, acc1_3)
                    acc1_3 = fma(sb_sc1_3, sf_hi_47_3, acc1_3)

                    // Bsums per input row
                    let bsums_i16: *restrict i16 = ptr_as_i16(q8_i8)
                    let bsums_base: i32 = (ab + 1040) / 2 + sb * 16
                    let mut cc: i32 = 0
                    while cc < 4 {
                        let rb: i32 = (cc / 2) * 8 + (cc % 2) * 4
                        let bp0: i16 = bsums_i16[bsums_base + rb]
                        let bp1: i16 = bsums_i16[bsums_base + rb + 1]
                        let bp2: i16 = bsums_i16[bsums_base + rb + 2]
                        let bp3: i16 = bsums_i16[bsums_base + rb + 3]
                        let bs0: i16 = bp0 + bp1
                        let bs1: i16 = bp2 + bp3

                        let b0_0: i32 = (t02 & 255) * to_i32(bs0) + (t12 & 255) * to_i32(bs1)
                        let b0_1: i32 = ((t02>>8)&255) * to_i32(bs0) + ((t12>>8)&255) * to_i32(bs1)
                        let b0_2: i32 = ((t02>>16)&255) * to_i32(bs0) + ((t12>>16)&255) * to_i32(bs1)
                        let b0_3: i32 = ((t02>>24)&255) * to_i32(bs0) + ((t12>>24)&255) * to_i32(bs1)
                        let bias_d0: i32x4 = [b0_0, b0_1, b0_2, b0_3]

                        let b1_0: i32 = (t03 & 255) * to_i32(bs0) + (t13 & 255) * to_i32(bs1)
                        let b1_1: i32 = ((t03>>8)&255) * to_i32(bs0) + ((t13>>8)&255) * to_i32(bs1)
                        let b1_2: i32 = ((t03>>16)&255) * to_i32(bs0) + ((t13>>16)&255) * to_i32(bs1)
                        let b1_3: i32 = ((t03>>24)&255) * to_i32(bs0) + ((t13>>24)&255) * to_i32(bs1)
                        let bias_d1: i32x4 = [b1_0, b1_1, b1_2, b1_3]

                        if cc == 0 {
                            bias0_0 = bias0_0 .+ bias_d0
                            bias1_0 = bias1_0 .+ bias_d1
                        }
                        if cc == 1 {
                            bias0_1 = bias0_1 .+ bias_d0
                            bias1_1 = bias1_1 .+ bias_d1
                        }
                        if cc == 2 {
                            bias0_2 = bias0_2 .+ bias_d0
                            bias1_2 = bias1_2 .+ bias_d1
                        }
                        if cc == 3 {
                            bias0_3 = bias0_3 .+ bias_d0
                            bias1_3 = bias1_3 .+ bias_d1
                        }

                        cc = cc + 1
                    }

                    sb = sb + 1
                }

                // Subtract mins
                acc0_0 = acc0_0 .- to_f32(bias0_0) .* sb_mn0_0
                acc1_0 = acc1_0 .- to_f32(bias1_0) .* sb_mn1_0
                acc0_1 = acc0_1 .- to_f32(bias0_1) .* sb_mn0_1
                acc1_1 = acc1_1 .- to_f32(bias1_1) .* sb_mn1_1
                acc0_2 = acc0_2 .- to_f32(bias0_2) .* sb_mn0_2
                acc1_2 = acc1_2 .- to_f32(bias1_2) .* sb_mn1_2
                acc0_3 = acc0_3 .- to_f32(bias0_3) .* sb_mn0_3
                acc1_3 = acc1_3 .- to_f32(bias1_3) .* sb_mn1_3

                b = b + 1
            }

            store(out_f32, (y * 4 + 0) * bs + x * 8, acc0_0)
            store(out_f32, (y * 4 + 0) * bs + x * 8 + 4, acc1_0)
            store(out_f32, (y * 4 + 1) * bs + x * 8, acc0_1)
            store(out_f32, (y * 4 + 1) * bs + x * 8 + 4, acc1_1)
            store(out_f32, (y * 4 + 2) * bs + x * 8, acc0_2)
            store(out_f32, (y * 4 + 2) * bs + x * 8 + 4, acc1_2)
            store(out_f32, (y * 4 + 3) * bs + x * 8, acc0_3)
            store(out_f32, (y * 4 + 3) * bs + x * 8 + 4, acc1_3)

            x = x + 1
        }
        y = y + 1
    }
}
