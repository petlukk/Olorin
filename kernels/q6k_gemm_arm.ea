// q6k_gemm_arm.ea — Q6K × Q8Kx4 GEMM kernel (ARM NEON + dotprod)
//
// Processes nc weight rows × nr tokens (4 at a time via vdot_lane_i32).
// Weight: raw Q6K blocks. Q8K input: block_q8_Kx4 interleaved format.
//
// Key optimization vs per-token matvec: Q6K weight data loaded once,
// reused across 4 tokens. Q8K is in vdot_lane-friendly format.
//
// block_q8_Kx4 layout (1168 bytes per superblock):
//   d[4] @ 0-15:     4 × f32 deltas
//   qs[1024] @ 16:   64 groups × 16B = [t0_4B, t1_4B, t2_4B, t3_4B]
//   bsums[128] @ 1040: per-group-per-token i16

#[cfg(aarch64)]

export func q6k_gemm(
    weight: *restrict i8,
    q8_a: *restrict i8,
    scratch: *mut u8,
    out: *mut f32,
    output_stride: i32,
    n_inner: i32,
    nr: i32,
    nc: i32
) {
    let nb: i32 = n_inner / 256
    let row_bytes: i32 = nb * 210
    let q8_tile_bytes: i32 = nb * 1168
    let mask_lo: i8x16 = splat(15)
    let mask_2: i8x16 = splat(3)
    let shift2: i8x16 = splat(2)
    let shift4: i8x16 = splat(4)
    let shift6: i8x16 = splat(6)
    let off32: i8x16 = splat(32)
    let nr4: i32 = nr / 4

    let out_f32: *mut f32 = ptr_as_f32(ptr_as_i8(out))
    let q8_i8: *restrict i8 = q8_a
    let q8_f32: *restrict f32 = ptr_as_f32(q8_a)

    let mut r: i32 = 0
    while r < nc {
        let wb: i32 = r * row_bytes

        let mut tg: i32 = 0
        while tg < nr4 {
            let ab: i32 = tg * q8_tile_bytes
            let mut res: f32x4 = [0.0, 0.0, 0.0, 0.0]

            let mut blk: i32 = 0
            while blk < nb {
                let w_off: i32 = wb + blk * 210
                let sc_off: i32 = w_off + 192
                let q8_off: i32 = ab + blk * 1168

                // Q8K d values for 4 tokens
                let q8d: f32x4 = [q8_f32[q8_off / 4], q8_f32[q8_off / 4 + 1],
                                  q8_f32[q8_off / 4 + 2], q8_f32[q8_off / 4 + 3]]

                // Q6K d value (f16 at byte 208) — convert via cvt_f16_f32
                let d16_ptr: *restrict i16 = ptr_as_i16(weight)
                let d_vec: f32x4 = cvt_f16_f32(load(d16_ptr, (w_off + 208) / 2))
                let d_q6k: f32 = d_vec[0]

                // Superblock scale: d_q6k × q8d per token
                let sb_scale: f32x4 = [d_q6k * q8d[0], d_q6k * q8d[1],
                                       d_q6k * q8d[2], d_q6k * q8d[3]]

                // Q6K weights are pre-shifted signed (-32) to fold the Q6K bias
                // correction into sdotq directly: sum((w-32)*q8) = sum(w*q8) - 32*sum(q8).
                // No explicit bsum term needed — sdotq over signed q6 handles it.

                let mut sumi: i32x4 = splat(0)

                let mut h: i32 = 0
                while h < 2 {
                    let ql_off: i32 = w_off + h * 64
                    let qh_off: i32 = w_off + 128 + h * 32
                    let q8_qs_off: i32 = q8_off + 16 + h * 512
                    let si: i32 = sc_off + h * 8

                    // Load weight qh (reused across all 4 groups)
                    let qh_a: i8x16 = load(weight, qh_off)
                    let qh_b: i8x16 = load(weight, qh_off + 16)

                    // Load weight ql
                    let ql0a: i8x16 = load(weight, ql_off)
                    let ql0b: i8x16 = load(weight, ql_off + 16)
                    let ql2a: i8x16 = load(weight, ql_off + 32)
                    let ql2b: i8x16 = load(weight, ql_off + 48)

                    // Group 0: ql low nibble + qh bits 0-1, folded to signed [-32, 31]
                    let q6_0a: i8x16 = ((ql0a .& mask_lo) .+ ((qh_a .& mask_2) .<< shift4)) .- off32
                    let q6_0b: i8x16 = ((ql0b .& mask_lo) .+ ((qh_b .& mask_2) .<< shift4)) .- off32

                    // Q8K for group 0: 2 sub-groups × 16B each
                    let q8_g0a: i8x16 = load(q8_i8, q8_qs_off)
                    let q8_g0b: i8x16 = load(q8_i8, q8_qs_off + 16)
                    let q8_g0c: i8x16 = load(q8_i8, q8_qs_off + 32)
                    let q8_g0d: i8x16 = load(q8_i8, q8_qs_off + 48)

                    // vdot_lane_i32(acc, q8_g0a, q6_0a, k): dot of 16B q8_g0a (= 4 tokens × 4B)
                    // against 4-byte lane k of q6_0a. Iterating k=0..3 consumes all 16B of q6_0a.
                    // dot0[t] = dot(q6_weight[0:16], q8_token_t[0:16]).
                    let mut dot0: i32x4 = splat(0)
                    dot0 = vdot_lane_i32(dot0, q8_g0a, q6_0a, 0)
                    dot0 = vdot_lane_i32(dot0, q8_g0b, q6_0a, 1)
                    dot0 = vdot_lane_i32(dot0, q8_g0c, q6_0a, 2)
                    dot0 = vdot_lane_i32(dot0, q8_g0d, q6_0a, 3)

                    // Sub-group 0: Q6K group h*8+0 — signed q6 already folded by -32
                    let mut sc0: i32 = to_i32(weight[si])
                    if sc0 > 127 { sc0 = sc0 - 256 }
                    sumi = sumi .+ splat(sc0) .* dot0

                    // Sub-group 1: Q6K group h*8+1
                    let q8_g1a: i8x16 = load(q8_i8, q8_qs_off + 64)
                    let q8_g1b: i8x16 = load(q8_i8, q8_qs_off + 80)
                    let q8_g1c: i8x16 = load(q8_i8, q8_qs_off + 96)
                    let q8_g1d: i8x16 = load(q8_i8, q8_qs_off + 112)

                    let mut dot1: i32x4 = splat(0)
                    dot1 = vdot_lane_i32(dot1, q8_g1a, q6_0b, 0)
                    dot1 = vdot_lane_i32(dot1, q8_g1b, q6_0b, 1)
                    dot1 = vdot_lane_i32(dot1, q8_g1c, q6_0b, 2)
                    dot1 = vdot_lane_i32(dot1, q8_g1d, q6_0b, 3)

                    let mut sc1: i32 = to_i32(weight[si + 1])
                    if sc1 > 127 { sc1 = sc1 - 256 }
                    sumi = sumi .+ splat(sc1) .* dot1

                    // Group 1: ql[32..63] low + qh bits 2-3 → Q6K groups h*8+2, h*8+3, signed
                    let q6_1a: i8x16 = ((ql2a .& mask_lo) .+ (((qh_a .>> shift2) .& mask_2) .<< shift4)) .- off32
                    let q6_1b: i8x16 = ((ql2b .& mask_lo) .+ (((qh_b .>> shift2) .& mask_2) .<< shift4)) .- off32

                    let q8_g2a: i8x16 = load(q8_i8, q8_qs_off + 128)
                    let q8_g2b: i8x16 = load(q8_i8, q8_qs_off + 144)
                    let q8_g2c: i8x16 = load(q8_i8, q8_qs_off + 160)
                    let q8_g2d: i8x16 = load(q8_i8, q8_qs_off + 176)

                    let mut dot2: i32x4 = splat(0)
                    dot2 = vdot_lane_i32(dot2, q8_g2a, q6_1a, 0)
                    dot2 = vdot_lane_i32(dot2, q8_g2b, q6_1a, 1)
                    dot2 = vdot_lane_i32(dot2, q8_g2c, q6_1a, 2)
                    dot2 = vdot_lane_i32(dot2, q8_g2d, q6_1a, 3)

                    let mut sc2: i32 = to_i32(weight[si + 2])
                    if sc2 > 127 { sc2 = sc2 - 256 }
                    sumi = sumi .+ splat(sc2) .* dot2

                    let q8_g3a: i8x16 = load(q8_i8, q8_qs_off + 192)
                    let q8_g3b: i8x16 = load(q8_i8, q8_qs_off + 208)
                    let q8_g3c: i8x16 = load(q8_i8, q8_qs_off + 224)
                    let q8_g3d: i8x16 = load(q8_i8, q8_qs_off + 240)

                    let mut dot3: i32x4 = splat(0)
                    dot3 = vdot_lane_i32(dot3, q8_g3a, q6_1b, 0)
                    dot3 = vdot_lane_i32(dot3, q8_g3b, q6_1b, 1)
                    dot3 = vdot_lane_i32(dot3, q8_g3c, q6_1b, 2)
                    dot3 = vdot_lane_i32(dot3, q8_g3d, q6_1b, 3)

                    let mut sc3: i32 = to_i32(weight[si + 3])
                    if sc3 > 127 { sc3 = sc3 - 256 }
                    sumi = sumi .+ splat(sc3) .* dot3

                    // Group 2: ql high nibble + qh bits 4-5 → Q6K groups h*8+4, h*8+5, signed
                    let q6_2a: i8x16 = (((ql0a .>> shift4) .& mask_lo) .+ (((qh_a .>> shift4) .& mask_2) .<< shift4)) .- off32
                    let q6_2b: i8x16 = (((ql0b .>> shift4) .& mask_lo) .+ (((qh_b .>> shift4) .& mask_2) .<< shift4)) .- off32

                    let q8_g4a: i8x16 = load(q8_i8, q8_qs_off + 256)
                    let q8_g4b: i8x16 = load(q8_i8, q8_qs_off + 272)
                    let q8_g4c: i8x16 = load(q8_i8, q8_qs_off + 288)
                    let q8_g4d: i8x16 = load(q8_i8, q8_qs_off + 304)

                    let mut dot4: i32x4 = splat(0)
                    dot4 = vdot_lane_i32(dot4, q8_g4a, q6_2a, 0)
                    dot4 = vdot_lane_i32(dot4, q8_g4b, q6_2a, 1)
                    dot4 = vdot_lane_i32(dot4, q8_g4c, q6_2a, 2)
                    dot4 = vdot_lane_i32(dot4, q8_g4d, q6_2a, 3)

                    let mut sc4: i32 = to_i32(weight[si + 4])
                    if sc4 > 127 { sc4 = sc4 - 256 }
                    sumi = sumi .+ splat(sc4) .* dot4

                    let q8_g5a: i8x16 = load(q8_i8, q8_qs_off + 320)
                    let q8_g5b: i8x16 = load(q8_i8, q8_qs_off + 336)
                    let q8_g5c: i8x16 = load(q8_i8, q8_qs_off + 352)
                    let q8_g5d: i8x16 = load(q8_i8, q8_qs_off + 368)

                    let mut dot5: i32x4 = splat(0)
                    dot5 = vdot_lane_i32(dot5, q8_g5a, q6_2b, 0)
                    dot5 = vdot_lane_i32(dot5, q8_g5b, q6_2b, 1)
                    dot5 = vdot_lane_i32(dot5, q8_g5c, q6_2b, 2)
                    dot5 = vdot_lane_i32(dot5, q8_g5d, q6_2b, 3)

                    let mut sc5: i32 = to_i32(weight[si + 5])
                    if sc5 > 127 { sc5 = sc5 - 256 }
                    sumi = sumi .+ splat(sc5) .* dot5

                    // Group 3: ql[32..63] high + qh bits 6-7 → Q6K groups h*8+6, h*8+7, signed
                    let q6_3a: i8x16 = (((ql2a .>> shift4) .& mask_lo) .+ (((qh_a .>> shift6) .& mask_2) .<< shift4)) .- off32
                    let q6_3b: i8x16 = (((ql2b .>> shift4) .& mask_lo) .+ (((qh_b .>> shift6) .& mask_2) .<< shift4)) .- off32

                    let q8_g6a: i8x16 = load(q8_i8, q8_qs_off + 384)
                    let q8_g6b: i8x16 = load(q8_i8, q8_qs_off + 400)
                    let q8_g6c: i8x16 = load(q8_i8, q8_qs_off + 416)
                    let q8_g6d: i8x16 = load(q8_i8, q8_qs_off + 432)

                    let mut dot6: i32x4 = splat(0)
                    dot6 = vdot_lane_i32(dot6, q8_g6a, q6_3a, 0)
                    dot6 = vdot_lane_i32(dot6, q8_g6b, q6_3a, 1)
                    dot6 = vdot_lane_i32(dot6, q8_g6c, q6_3a, 2)
                    dot6 = vdot_lane_i32(dot6, q8_g6d, q6_3a, 3)

                    let mut sc6: i32 = to_i32(weight[si + 6])
                    if sc6 > 127 { sc6 = sc6 - 256 }
                    sumi = sumi .+ splat(sc6) .* dot6

                    let q8_g7a: i8x16 = load(q8_i8, q8_qs_off + 448)
                    let q8_g7b: i8x16 = load(q8_i8, q8_qs_off + 464)
                    let q8_g7c: i8x16 = load(q8_i8, q8_qs_off + 480)
                    let q8_g7d: i8x16 = load(q8_i8, q8_qs_off + 496)

                    let mut dot7: i32x4 = splat(0)
                    dot7 = vdot_lane_i32(dot7, q8_g7a, q6_3b, 0)
                    dot7 = vdot_lane_i32(dot7, q8_g7b, q6_3b, 1)
                    dot7 = vdot_lane_i32(dot7, q8_g7c, q6_3b, 2)
                    dot7 = vdot_lane_i32(dot7, q8_g7d, q6_3b, 3)

                    let mut sc7: i32 = to_i32(weight[si + 7])
                    if sc7 > 127 { sc7 = sc7 - 256 }
                    sumi = sumi .+ splat(sc7) .* dot7

                    h = h + 1
                }

                res = res .+ sb_scale .* to_f32(sumi)
                blk = blk + 1
            }

            // Write results for 4 tokens
            out_f32[tg * 4 * output_stride + r] = res[0]
            out_f32[(tg * 4 + 1) * output_stride + r] = res[1]
            out_f32[(tg * 4 + 2) * output_stride + r] = res[2]
            out_f32[(tg * 4 + 3) * output_stride + r] = res[3]

            tg = tg + 1
        }

        r = r + 1
    }
}
