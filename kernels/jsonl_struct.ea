// One-pass JSONL structural scanner. For each byte in `text`, records the
// position of every newline, quote, colon, comma, and backslash into five
// caller-allocated output arrays. Mirrors csv_scan.ea — same SIMD pattern,
// five match characters instead of two.
//
// Caller sizes each out_* array at `len` (worst case: every byte is a
// structural character of that type).
//
// Backslash positions are emitted so the orchestrator can resolve escape
// sequences (`\"` inside a string is *not* a structural quote, but a
// literal quote byte). The kernel does not track parse state itself — it
// emits raw positions; escape resolution is a scalar Rust pass.
//
// SIMD strategy (same as csv_scan): 16-byte chunks compared against
// splat('\n'), splat('"'), splat(':'), splat(','), splat('\\'). Each lane
// gets a 5-bit-encoded match byte (bit 0 = newline, 1 = quote, 2 = colon,
// 3 = comma, 4 = backslash). Mask is stored to caller-provided scratch
// (16 bytes); scalar walk emits positions per type. Cross-arch — no
// movemask, no lane-extract primitive needed.
//
// Signature kept on one line: multi-line parameter lists hit the same
// Eä parser limitation as f32_stats.

export func jsonl_struct_scan(text: *u8, len: i32, out_newlines: *mut i32, out_quotes: *mut i32, out_colons: *mut i32, out_commas: *mut i32, out_backslashes: *mut i32, out_n_newline: *mut i32, out_n_quote: *mut i32, out_n_colon: *mut i32, out_n_comma: *mut i32, out_n_backslash: *mut i32, scratch: *mut u8) {
    let v_newl:  u8x16 = splat(10)
    let v_quote: u8x16 = splat(34)
    let v_colon: u8x16 = splat(58)
    let v_comma: u8x16 = splat(44)
    let v_bksl:  u8x16 = splat(92)
    let v_zero:  u8x16 = splat(0)
    let v_1:     u8x16 = splat(1)
    let v_2:     u8x16 = splat(2)
    let v_4:     u8x16 = splat(4)
    let v_8:     u8x16 = splat(8)
    let v_16:    u8x16 = splat(16)

    let mut nn: i32 = 0
    let mut nq: i32 = 0
    let mut nc: i32 = 0
    let mut nm: i32 = 0
    let mut nb: i32 = 0

    let n_full: i32 = (len / 16) * 16
    let mut i: i32 = 0
    while i < n_full {
        let c: u8x16 = load(text, i)
        let m_n: u8x16 = select(c .== v_newl,  v_1,  v_zero)
        let m_q: u8x16 = select(c .== v_quote, v_2,  v_zero)
        let m_c: u8x16 = select(c .== v_colon, v_4,  v_zero)
        let m_m: u8x16 = select(c .== v_comma, v_8,  v_zero)
        let m_b: u8x16 = select(c .== v_bksl,  v_16, v_zero)
        let m:   u8x16 = m_n .| m_q .| m_c .| m_m .| m_b
        store(scratch, 0, m)

        let mut k: i32 = 0
        while k < 16 {
            let b: i32 = to_i32(scratch[k])
            if (b & 1) != 0 {
                out_newlines[nn] = i + k
                nn = nn + 1
            }
            if (b & 2) != 0 {
                out_quotes[nq] = i + k
                nq = nq + 1
            }
            if (b & 4) != 0 {
                out_colons[nc] = i + k
                nc = nc + 1
            }
            if (b & 8) != 0 {
                out_commas[nm] = i + k
                nm = nm + 1
            }
            if (b & 16) != 0 {
                out_backslashes[nb] = i + k
                nb = nb + 1
            }
            k = k + 1
        }
        i = i + 16
    }

    // Scalar tail (< 16 bytes)
    while i < len {
        let b: i32 = to_i32(text[i])
        if b == 10 {
            out_newlines[nn] = i
            nn = nn + 1
        }
        if b == 34 {
            out_quotes[nq] = i
            nq = nq + 1
        }
        if b == 58 {
            out_colons[nc] = i
            nc = nc + 1
        }
        if b == 44 {
            out_commas[nm] = i
            nm = nm + 1
        }
        if b == 92 {
            out_backslashes[nb] = i
            nb = nb + 1
        }
        i = i + 1
    }

    out_n_newline[0]   = nn
    out_n_quote[0]     = nq
    out_n_colon[0]     = nc
    out_n_comma[0]     = nm
    out_n_backslash[0] = nb
}
