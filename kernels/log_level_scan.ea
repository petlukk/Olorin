// Multi-keyword log-severity scanner. Counts word-bounded occurrences of
// DEBUG, INFO, WARN, ERROR, FATAL (ASCII case-insensitive) across a byte
// buffer plus the total newline byte count (used for line-count reporting),
// and optionally records positions of valid high-severity (ERROR / FATAL /
// CRITICAL) matches into a caller-sized buffer (capped at `max_positions`).
//
// The long spellings WARNING and CRITICAL (used by Python `logging` and
// syslog) fold into the same tiers: WARNING -> WARN (counts[2]), CRITICAL ->
// FATAL (counts[4]). Their first letters don't collide with the 5 base
// keywords, so word-bounded matching keeps them mutually exclusive (e.g.
// "WARN" with a delimiter after position 4 is never also "WARNING").
//
// Case handling: candidate letter bytes are folded with `| 0x20` before
// comparison, so `ERROR`, `error`, and `Error` all match. The fold maps
// A-Z to a-z and only upper/lower letter pairs share a folded value, so a
// non-letter byte can never alias a keyword letter. Delimiter and newline
// checks always use the ORIGINAL (unfolded) bytes.
//
// Word boundary = preceded AND followed by one of: space, tab, newline,
// CR, '[', ']', '"', ':'. Start-of-file and end-of-file count as
// implicit delimiters (a buffer "INFO" with no surrounding bytes counts
// as one INFO).
//
// SIMD strategy (cross-arch — no movemask, no lane-extract primitive):
// for each 16-byte chunk at position i, load shifted views
// text[i..], text[i+1..], ... up to text[i+5..] plus text[i-1..] for
// the left delimiter. Per keyword K, build a u8x16 lane mask that's
// 0x01 where K starts at lane position AND the bounding bytes are
// delimiters, 0x00 otherwise. reduce_add summed into the keyword's
// running counter. Newlines counted via the same select/reduce_add idiom
// on c0 (the anchored byte view).
//
// Position recording (only when `max_positions > 0`): the OR of the
// ERROR and FATAL lane masks is reduced to detect "any high-severity
// match in this chunk"; if non-zero, the mask is stored to scratch and
// the 16 lanes scalar-walked to append positions. Position output
// saturates at `max_positions` — counts remain accurate past that
// point.
//
// Scalar prologue/epilogue handle the head (positions 0..16, where
// text[i-1] would underflow) and the tail (positions where text[i+20]
// would overflow). Scalar branch also handles buffers too small for a
// SIMD chunk.
//
// out_counts[0..6]  = [DEBUG, INFO, WARN, ERROR, FATAL, NEWLINES].
// out_positions     = ERROR/FATAL match offsets, in scan order.
// out_n_positions[0] = number of positions written (<= max_positions).
// scratch (16 bytes) holds the per-chunk OR mask; contents after the
// call are unspecified. Required only when max_positions > 0; callers
// uninterested in positions may pass any 16-byte writable buffer.

func is_delim_byte(b: i32) -> i32 {
    if b == 32 { return 1 }
    if b == 10 { return 1 }
    if b == 9  { return 1 }
    if b == 13 { return 1 }
    if b == 91 { return 1 }
    if b == 93 { return 1 }
    if b == 34 { return 1 }
    if b == 58 { return 1 }
    return 0
}

func record_high(p: i32, positions: *mut i32, max_positions: i32, n_positions: *mut i32) {
    if max_positions <= 0 { return }
    let cur: i32 = n_positions[0]
    if cur < max_positions {
        positions[cur] = p
        n_positions[0] = cur + 1
    }
}

func scan_pos(text: *u8, p: i32, len: i32, counters: *mut i32, positions: *mut i32, max_positions: i32, n_positions: *mut i32) {
    if p > 0 {
        if is_delim_byte(to_i32(text[p - 1])) == 0 { return }
    }

    // CRITICAL (8) -> FATAL bucket. Same severity tier as FATAL (Python's
    // CRITICAL is FATAL's alias); high-severity, so it records a position.
    if p + 8 <= len {
        let g0: i32 = to_i32(text[p + 0]) | 32
        let g1: i32 = to_i32(text[p + 1]) | 32
        let g2: i32 = to_i32(text[p + 2]) | 32
        let g3: i32 = to_i32(text[p + 3]) | 32
        let g4: i32 = to_i32(text[p + 4]) | 32
        let g5: i32 = to_i32(text[p + 5]) | 32
        let g6: i32 = to_i32(text[p + 6]) | 32
        let g7: i32 = to_i32(text[p + 7]) | 32
        if g0 == 99 && g1 == 114 && g2 == 105 && g3 == 116 && g4 == 105 && g5 == 99 && g6 == 97 && g7 == 108 {
            if p + 8 == len {
                counters[4] = counters[4] + 1
                record_high(p, positions, max_positions, n_positions)
                return
            }
            if is_delim_byte(to_i32(text[p + 8])) == 1 {
                counters[4] = counters[4] + 1
                record_high(p, positions, max_positions, n_positions)
                return
            }
        }
    }
    // WARNING (7) -> WARN bucket (the long spelling Python logging / syslog use).
    if p + 7 <= len {
        let h0: i32 = to_i32(text[p + 0]) | 32
        let h1: i32 = to_i32(text[p + 1]) | 32
        let h2: i32 = to_i32(text[p + 2]) | 32
        let h3: i32 = to_i32(text[p + 3]) | 32
        let h4: i32 = to_i32(text[p + 4]) | 32
        let h5: i32 = to_i32(text[p + 5]) | 32
        let h6: i32 = to_i32(text[p + 6]) | 32
        if h0 == 119 && h1 == 97 && h2 == 114 && h3 == 110 && h4 == 105 && h5 == 110 && h6 == 103 {
            if p + 7 == len {
                counters[2] = counters[2] + 1
                return
            }
            if is_delim_byte(to_i32(text[p + 7])) == 1 {
                counters[2] = counters[2] + 1
                return
            }
        }
    }

    if p + 5 <= len {
        let b0: i32 = to_i32(text[p + 0])
        let b1: i32 = to_i32(text[p + 1])
        let b2: i32 = to_i32(text[p + 2])
        let b3: i32 = to_i32(text[p + 3])
        let b4: i32 = to_i32(text[p + 4])
        // Case-fold candidate letters; delimiter checks below use originals.
        let f0: i32 = b0 | 32
        let f1: i32 = b1 | 32
        let f2: i32 = b2 | 32
        let f3: i32 = b3 | 32
        let f4: i32 = b4 | 32

        if f0 == 100 && f1 == 101 && f2 == 98 && f3 == 117 && f4 == 103 {
            if p + 5 == len {
                counters[0] = counters[0] + 1
                return
            }
            if is_delim_byte(to_i32(text[p + 5])) == 1 {
                counters[0] = counters[0] + 1
                return
            }
        }
        if f0 == 101 && f1 == 114 && f2 == 114 && f3 == 111 && f4 == 114 {
            if p + 5 == len {
                counters[3] = counters[3] + 1
                record_high(p, positions, max_positions, n_positions)
                return
            }
            if is_delim_byte(to_i32(text[p + 5])) == 1 {
                counters[3] = counters[3] + 1
                record_high(p, positions, max_positions, n_positions)
                return
            }
        }
        if f0 == 102 && f1 == 97 && f2 == 116 && f3 == 97 && f4 == 108 {
            if p + 5 == len {
                counters[4] = counters[4] + 1
                record_high(p, positions, max_positions, n_positions)
                return
            }
            if is_delim_byte(to_i32(text[p + 5])) == 1 {
                counters[4] = counters[4] + 1
                record_high(p, positions, max_positions, n_positions)
                return
            }
        }
        if f0 == 105 && f1 == 110 && f2 == 102 && f3 == 111 {
            if is_delim_byte(b4) == 1 {
                counters[1] = counters[1] + 1
                return
            }
        }
        if f0 == 119 && f1 == 97 && f2 == 114 && f3 == 110 {
            if is_delim_byte(b4) == 1 {
                counters[2] = counters[2] + 1
                return
            }
        }
        return
    }

    if p + 4 <= len {
        let b0: i32 = to_i32(text[p + 0])
        let b1: i32 = to_i32(text[p + 1])
        let b2: i32 = to_i32(text[p + 2])
        let b3: i32 = to_i32(text[p + 3])
        let f0: i32 = b0 | 32
        let f1: i32 = b1 | 32
        let f2: i32 = b2 | 32
        let f3: i32 = b3 | 32

        if f0 == 105 && f1 == 110 && f2 == 102 && f3 == 111 {
            if p + 4 == len {
                counters[1] = counters[1] + 1
                return
            }
        }
        if f0 == 119 && f1 == 97 && f2 == 114 && f3 == 110 {
            if p + 4 == len {
                counters[2] = counters[2] + 1
                return
            }
        }
    }
}

export func log_level_scan(text: *u8, len: i32, out_counts: *mut i32, out_positions: *mut i32, max_positions: i32, out_n_positions: *mut i32, scratch: *mut u8) {
    out_counts[0] = 0
    out_counts[1] = 0
    out_counts[2] = 0
    out_counts[3] = 0
    out_counts[4] = 0
    out_counts[5] = 0
    out_n_positions[0] = 0

    if len <= 0 { return }

    // Buffers too small for the SIMD body run entirely under the
    // scalar `scan_pos` helper. The SIMD body requires len >= 37
    // (i=16 first chunk + 20-byte forward window).
    if len < 37 {
        let mut p: i32 = 0
        while p < len {
            if to_i32(text[p]) == 10 { out_counts[5] = out_counts[5] + 1 }
            scan_pos(text, p, len, out_counts, out_positions, max_positions, out_n_positions)
            p = p + 1
        }
        return
    }

    // Lowercase keyword letter codes (candidate bytes are folded with v_or).
    let v_D: u8x16 = splat(100)
    let v_E: u8x16 = splat(101)
    let v_B: u8x16 = splat(98)
    let v_U: u8x16 = splat(117)
    let v_G: u8x16 = splat(103)
    let v_I: u8x16 = splat(105)
    let v_N: u8x16 = splat(110)
    let v_F: u8x16 = splat(102)
    let v_O: u8x16 = splat(111)
    let v_W: u8x16 = splat(119)
    let v_A: u8x16 = splat(97)
    let v_R: u8x16 = splat(114)
    let v_T: u8x16 = splat(116)
    let v_L: u8x16 = splat(108)
    let v_C: u8x16 = splat(99)

    let v_or: u8x16 = splat(32)

    let v_sp: u8x16 = splat(32)
    let v_lf: u8x16 = splat(10)
    let v_tb: u8x16 = splat(9)
    let v_cr: u8x16 = splat(13)
    let v_lb: u8x16 = splat(91)
    let v_rb: u8x16 = splat(93)
    let v_qt: u8x16 = splat(34)
    let v_co: u8x16 = splat(58)

    let v_one:  u8x16 = splat(1)
    let v_zero: u8x16 = splat(0)

    let mut c_debug: i32 = 0
    let mut c_info:  i32 = 0
    let mut c_warn:  i32 = 0
    let mut c_error: i32 = 0
    let mut c_fatal: i32 = 0
    let mut c_nl:    i32 = 0

    // Scalar prologue: positions [0..16).
    let mut p: i32 = 0
    while p < 16 {
        if to_i32(text[p]) == 10 { c_nl = c_nl + 1 }
        scan_pos(text, p, len, out_counts, out_positions, max_positions, out_n_positions)
        p = p + 1
    }

    // SIMD body: chunks at i = 16, 32, 48, ... while i + 24 < len.
    // The window reaches text[i+lane+8] (CRITICAL's right delimiter at the
    // last lane = i+23), so the bound is i+24; the scalar epilogue picks up
    // the few tail positions the wider window cedes.
    let mut i: i32 = 16
    while i + 24 < len {
        let c0:  u8x16 = load(text, i)
        let c1:  u8x16 = load(text, i + 1)
        let c2:  u8x16 = load(text, i + 2)
        let c3:  u8x16 = load(text, i + 3)
        let c4:  u8x16 = load(text, i + 4)
        let c5:  u8x16 = load(text, i + 5)
        let c6:  u8x16 = load(text, i + 6)
        let c7:  u8x16 = load(text, i + 7)
        let c8:  u8x16 = load(text, i + 8)
        let cm1: u8x16 = load(text, i - 1)

        // Case-folded letter views; originals kept for delimiter/newline.
        let f0: u8x16 = c0 .| v_or
        let f1: u8x16 = c1 .| v_or
        let f2: u8x16 = c2 .| v_or
        let f3: u8x16 = c3 .| v_or
        let f4: u8x16 = c4 .| v_or
        let f5: u8x16 = c5 .| v_or
        let f6: u8x16 = c6 .| v_or
        let f7: u8x16 = c7 .| v_or

        // Build a 0x01-where-delim mask from any of the 8 delimiter bytes.
        let l_sp: u8x16 = select(cm1 .== v_sp, v_one, v_zero)
        let l_lf: u8x16 = select(cm1 .== v_lf, v_one, v_zero)
        let l_tb: u8x16 = select(cm1 .== v_tb, v_one, v_zero)
        let l_cr: u8x16 = select(cm1 .== v_cr, v_one, v_zero)
        let l_lb: u8x16 = select(cm1 .== v_lb, v_one, v_zero)
        let l_rb: u8x16 = select(cm1 .== v_rb, v_one, v_zero)
        let l_qt: u8x16 = select(cm1 .== v_qt, v_one, v_zero)
        let l_co: u8x16 = select(cm1 .== v_co, v_one, v_zero)
        let ldelim: u8x16 = l_sp .| l_lf .| l_tb .| l_cr .| l_lb .| l_rb .| l_qt .| l_co

        let r4_sp: u8x16 = select(c4 .== v_sp, v_one, v_zero)
        let r4_lf: u8x16 = select(c4 .== v_lf, v_one, v_zero)
        let r4_tb: u8x16 = select(c4 .== v_tb, v_one, v_zero)
        let r4_cr: u8x16 = select(c4 .== v_cr, v_one, v_zero)
        let r4_lb: u8x16 = select(c4 .== v_lb, v_one, v_zero)
        let r4_rb: u8x16 = select(c4 .== v_rb, v_one, v_zero)
        let r4_qt: u8x16 = select(c4 .== v_qt, v_one, v_zero)
        let r4_co: u8x16 = select(c4 .== v_co, v_one, v_zero)
        let rdelim4: u8x16 = r4_sp .| r4_lf .| r4_tb .| r4_cr .| r4_lb .| r4_rb .| r4_qt .| r4_co

        let r5_sp: u8x16 = select(c5 .== v_sp, v_one, v_zero)
        let r5_lf: u8x16 = select(c5 .== v_lf, v_one, v_zero)
        let r5_tb: u8x16 = select(c5 .== v_tb, v_one, v_zero)
        let r5_cr: u8x16 = select(c5 .== v_cr, v_one, v_zero)
        let r5_lb: u8x16 = select(c5 .== v_lb, v_one, v_zero)
        let r5_rb: u8x16 = select(c5 .== v_rb, v_one, v_zero)
        let r5_qt: u8x16 = select(c5 .== v_qt, v_one, v_zero)
        let r5_co: u8x16 = select(c5 .== v_co, v_one, v_zero)
        let rdelim5: u8x16 = r5_sp .| r5_lf .| r5_tb .| r5_cr .| r5_lb .| r5_rb .| r5_qt .| r5_co

        let r7_sp: u8x16 = select(c7 .== v_sp, v_one, v_zero)
        let r7_lf: u8x16 = select(c7 .== v_lf, v_one, v_zero)
        let r7_tb: u8x16 = select(c7 .== v_tb, v_one, v_zero)
        let r7_cr: u8x16 = select(c7 .== v_cr, v_one, v_zero)
        let r7_lb: u8x16 = select(c7 .== v_lb, v_one, v_zero)
        let r7_rb: u8x16 = select(c7 .== v_rb, v_one, v_zero)
        let r7_qt: u8x16 = select(c7 .== v_qt, v_one, v_zero)
        let r7_co: u8x16 = select(c7 .== v_co, v_one, v_zero)
        let rdelim7: u8x16 = r7_sp .| r7_lf .| r7_tb .| r7_cr .| r7_lb .| r7_rb .| r7_qt .| r7_co

        let r8_sp: u8x16 = select(c8 .== v_sp, v_one, v_zero)
        let r8_lf: u8x16 = select(c8 .== v_lf, v_one, v_zero)
        let r8_tb: u8x16 = select(c8 .== v_tb, v_one, v_zero)
        let r8_cr: u8x16 = select(c8 .== v_cr, v_one, v_zero)
        let r8_lb: u8x16 = select(c8 .== v_lb, v_one, v_zero)
        let r8_rb: u8x16 = select(c8 .== v_rb, v_one, v_zero)
        let r8_qt: u8x16 = select(c8 .== v_qt, v_one, v_zero)
        let r8_co: u8x16 = select(c8 .== v_co, v_one, v_zero)
        let rdelim8: u8x16 = r8_sp .| r8_lf .| r8_tb .| r8_cr .| r8_lb .| r8_rb .| r8_qt .| r8_co

        let d_D: u8x16 = select(f0 .== v_D, v_one, v_zero)
        let d_E: u8x16 = select(f1 .== v_E, v_one, v_zero)
        let d_B: u8x16 = select(f2 .== v_B, v_one, v_zero)
        let d_U: u8x16 = select(f3 .== v_U, v_one, v_zero)
        let d_G: u8x16 = select(f4 .== v_G, v_one, v_zero)
        let kw_DEBUG: u8x16 = d_D .& d_E .& d_B .& d_U .& d_G
        let valid_DEBUG: u8x16 = kw_DEBUG .& ldelim .& rdelim5
        c_debug = c_debug + to_i32(reduce_add(valid_DEBUG))

        let i_I: u8x16 = select(f0 .== v_I, v_one, v_zero)
        let i_N: u8x16 = select(f1 .== v_N, v_one, v_zero)
        let i_F: u8x16 = select(f2 .== v_F, v_one, v_zero)
        let i_O: u8x16 = select(f3 .== v_O, v_one, v_zero)
        let kw_INFO: u8x16 = i_I .& i_N .& i_F .& i_O
        let valid_INFO: u8x16 = kw_INFO .& ldelim .& rdelim4
        c_info = c_info + to_i32(reduce_add(valid_INFO))

        let w_W: u8x16 = select(f0 .== v_W, v_one, v_zero)
        let w_A: u8x16 = select(f1 .== v_A, v_one, v_zero)
        let w_R: u8x16 = select(f2 .== v_R, v_one, v_zero)
        let w_N: u8x16 = select(f3 .== v_N, v_one, v_zero)
        let kw_WARN: u8x16 = w_W .& w_A .& w_R .& w_N
        let valid_WARN: u8x16 = kw_WARN .& ldelim .& rdelim4
        c_warn = c_warn + to_i32(reduce_add(valid_WARN))

        let e_E: u8x16 = select(f0 .== v_E, v_one, v_zero)
        let e_R1: u8x16 = select(f1 .== v_R, v_one, v_zero)
        let e_R2: u8x16 = select(f2 .== v_R, v_one, v_zero)
        let e_O: u8x16 = select(f3 .== v_O, v_one, v_zero)
        let e_R3: u8x16 = select(f4 .== v_R, v_one, v_zero)
        let kw_ERROR: u8x16 = e_E .& e_R1 .& e_R2 .& e_O .& e_R3
        let valid_ERROR: u8x16 = kw_ERROR .& ldelim .& rdelim5
        c_error = c_error + to_i32(reduce_add(valid_ERROR))

        let f_F: u8x16 = select(f0 .== v_F, v_one, v_zero)
        let f_A1: u8x16 = select(f1 .== v_A, v_one, v_zero)
        let f_T: u8x16 = select(f2 .== v_T, v_one, v_zero)
        let f_A2: u8x16 = select(f3 .== v_A, v_one, v_zero)
        let f_L: u8x16 = select(f4 .== v_L, v_one, v_zero)
        let kw_FATAL: u8x16 = f_F .& f_A1 .& f_T .& f_A2 .& f_L
        let valid_FATAL: u8x16 = kw_FATAL .& ldelim .& rdelim5
        c_fatal = c_fatal + to_i32(reduce_add(valid_FATAL))

        // WARNING (W A R N I N G) -> WARN bucket. Right delimiter at offset 7.
        let g_W: u8x16 = select(f0 .== v_W, v_one, v_zero)
        let g_A: u8x16 = select(f1 .== v_A, v_one, v_zero)
        let g_R: u8x16 = select(f2 .== v_R, v_one, v_zero)
        let g_N1: u8x16 = select(f3 .== v_N, v_one, v_zero)
        let g_I: u8x16 = select(f4 .== v_I, v_one, v_zero)
        let g_N2: u8x16 = select(f5 .== v_N, v_one, v_zero)
        let g_G: u8x16 = select(f6 .== v_G, v_one, v_zero)
        let kw_WARNING: u8x16 = g_W .& g_A .& g_R .& g_N1 .& g_I .& g_N2 .& g_G
        let valid_WARNING: u8x16 = kw_WARNING .& ldelim .& rdelim7
        c_warn = c_warn + to_i32(reduce_add(valid_WARNING))

        // CRITICAL (C R I T I C A L) -> FATAL bucket. Right delimiter at offset 8.
        let k_C1: u8x16 = select(f0 .== v_C, v_one, v_zero)
        let k_R:  u8x16 = select(f1 .== v_R, v_one, v_zero)
        let k_I1: u8x16 = select(f2 .== v_I, v_one, v_zero)
        let k_T:  u8x16 = select(f3 .== v_T, v_one, v_zero)
        let k_I2: u8x16 = select(f4 .== v_I, v_one, v_zero)
        let k_C2: u8x16 = select(f5 .== v_C, v_one, v_zero)
        let k_A:  u8x16 = select(f6 .== v_A, v_one, v_zero)
        let k_L:  u8x16 = select(f7 .== v_L, v_one, v_zero)
        let kw_CRITICAL: u8x16 = k_C1 .& k_R .& k_I1 .& k_T .& k_I2 .& k_C2 .& k_A .& k_L
        let valid_CRITICAL: u8x16 = kw_CRITICAL .& ldelim .& rdelim8
        c_fatal = c_fatal + to_i32(reduce_add(valid_CRITICAL))

        let nl: u8x16 = select(c0 .== v_lf, v_one, v_zero)
        c_nl = c_nl + to_i32(reduce_add(nl))

        // Position recording: union the two high-severity masks. The
        // reduce_add early-out keeps the no-match common case scratch-free.
        if max_positions > 0 {
            if out_n_positions[0] < max_positions {
                let valid_high: u8x16 = valid_ERROR .| valid_FATAL .| valid_CRITICAL
                let high_count: i32 = to_i32(reduce_add(valid_high))
                if high_count > 0 {
                    store(scratch, 0, valid_high)
                    let mut j: i32 = 0
                    while j < 16 {
                        if to_i32(scratch[j]) == 1 {
                            let cur: i32 = out_n_positions[0]
                            if cur < max_positions {
                                out_positions[cur] = i + j
                                out_n_positions[0] = cur + 1
                            }
                        }
                        j = j + 1
                    }
                }
            }
        }

        i = i + 16
    }

    // Scalar epilogue: scan every remaining byte for newlines and any
    // residual keyword starts.
    p = i
    while p < len {
        if to_i32(text[p]) == 10 { c_nl = c_nl + 1 }
        scan_pos(text, p, len, out_counts, out_positions, max_positions, out_n_positions)
        p = p + 1
    }

    out_counts[0] = out_counts[0] + c_debug
    out_counts[1] = out_counts[1] + c_info
    out_counts[2] = out_counts[2] + c_warn
    out_counts[3] = out_counts[3] + c_error
    out_counts[4] = out_counts[4] + c_fatal
    out_counts[5] = c_nl
}
