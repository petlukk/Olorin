// q4k_8x8_q8k.ea — Matvec (N=1) on repacked Q4K × Q8K.
//
// Input weight layout: block_q4_Kx8 tiles produced by q4k_repack_8x8. Each
// tile covers 8 output rows × 1 column-block (256 K) and is 1152 bytes:
//   0..15    d[0..8]    (8 × f16)
//   16..31   dmin[0..8] (8 × f16)
//   32..127  scales[96] (repacked sub-blocks 0..3 then 4..7)
//   128..1151 qs[1024]  (128 × 8-byte interleaved chunks)
//
// F32 reduction order matches llama.cpp ggml_gemm_q4_K_8x8_q8_K per the
// research note docs/superpowers/research/2026-04-08-ggml-q4k-8x8-q8k-gemm.md:
// four FMAs per super-block into acc, parallel mins chain into acc_min,
// single sub at the end. This is bit-exactness parity with llama's BATCHED
// gemm path, which differs from olorin's existing non-batched q4k_matvec.
//
// Strategy (row-sequential, AVX2-width inner dot): for each (tile, block),
// unpack row r's bytes into a standard block_q4_K scratch (144 bytes) once,
// then run the ggml-order dot helper on it. Per-output bit patterns match
// ggml because (a) integer math is associative, (b) the per-row f32 FMA
// sequence is identical to ggml's per-lane sequence. Row-parallelism via
// the native 8-row interleaved layout is deferred to Task 9's N>1 gemm.

#[cfg(x86_64)]

// ---------------------------------------------------------------------------
// Helpers (mirror q4k_dot.ea style)
// ---------------------------------------------------------------------------

func ubyte(p: *mut u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

func f16_load(p: *mut u8, off: i32, pow2: *f32) -> f32 {
    let raw: i32 = ubyte(p, off) | (ubyte(p, off + 1) << 8)
    let exp: i32 = (raw >> 10) & 31
    if exp == 0 {
        return pow2[1] * to_f32(raw & 1023) * 0.0009765625
    } else {
        return pow2[exp] * (1.0 + to_f32(raw & 1023) * 0.0009765625)
    }
}

// Unpack one row of a repacked block_q4_Kx8 tile back into the standard
// 144-byte block_q4_K layout in `scratch`. See the q4k_repack_8x8 research
// note §4 for the inverse of what q4k_repack does.
//
// tile_base: byte offset of the block_q4_Kx8 tile within `packed`
// r:         which row 0..7 within the tile
// scratch:   144-byte output buffer (d | dmin | scales[12] | qs[128])
func unpack_row(
    packed: *restrict u8,
    tile_base: i32,
    r: i32,
    scratch: *mut u8
) {
    // d and dmin (4 bytes)
    scratch[0] = packed[tile_base + r * 2 + 0]
    scratch[1] = packed[tile_base + r * 2 + 1]
    scratch[2] = packed[tile_base + 16 + r * 2 + 0]
    scratch[3] = packed[tile_base + 16 + r * 2 + 1]

    // Scales reconstruction — undo q4k_repack_8x8 §4c.
    // All arithmetic is in u8 throughout (Eä has no i32→u8 scalar cast);
    // values never exceed 8 bits so the low nibble / 6-bit masks keep
    // intermediates in range.
    let scales_base: i32 = tile_base + 32
    let scales_base_hi: i32 = tile_base + 32 + 48
    let k: i32 = r & 3

    let mut sb: i32 = 0
    while sb < 4 {
        // scale_sb = 6-bit scale for sub-block sb on row r
        // min_sb   = 6-bit min   for sub-block sb on row r
        // scale_sb4, min_sb4 = same for sub-block sb+4 on row r
        let mut scale_sb: u8 = 0
        let mut min_sb: u8 = 0
        let mut scale_sb4: u8 = 0
        let mut min_sb4: u8 = 0
        if r >= 4 {
            // Row r in 4..7: values split across bit 6..7 of base byte and
            // low/high nibble of the +8 byte.
            scale_sb  = ((packed[scales_base    + sb * 12 + k    ] & 192) >> 2)
                      | ( packed[scales_base    + sb * 12 + k + 8] & 15)
            min_sb    = ((packed[scales_base    + sb * 12 + k + 4] & 192) >> 2)
                      | ((packed[scales_base    + sb * 12 + k + 8] >> 4) & 15)
            scale_sb4 = ((packed[scales_base_hi + sb * 12 + k    ] & 192) >> 2)
                      | ( packed[scales_base_hi + sb * 12 + k + 8] & 15)
            min_sb4   = ((packed[scales_base_hi + sb * 12 + k + 4] & 192) >> 2)
                      | ((packed[scales_base_hi + sb * 12 + k + 8] >> 4) & 15)
        } else {
            // Row r in 0..3: values live in the low 6 bits of base byte.
            scale_sb  = packed[scales_base    + sb * 12 + k    ] & 63
            min_sb    = packed[scales_base    + sb * 12 + k + 4] & 63
            scale_sb4 = packed[scales_base_hi + sb * 12 + k    ] & 63
            min_sb4   = packed[scales_base_hi + sb * 12 + k + 4] & 63
        }

        // Reassemble the original Q4K 12-byte scales layout:
        //   scales[sb]     = (scale_sb & 63) | ((scale_sb4 & 48) << 2)
        //   scales[sb + 4] = (min_sb & 63)   | ((min_sb4   & 48) << 2)
        //   scales[sb + 8] = (scale_sb4 & 15)| ((min_sb4   & 15) << 4)
        scratch[4 + sb    ] = (scale_sb  & 63) | ((scale_sb4 & 48) << 2)
        scratch[4 + sb + 4] = (min_sb    & 63) | ((min_sb4   & 48) << 2)
        scratch[4 + sb + 8] = (scale_sb4 & 15) | ((min_sb4   & 15) << 4)
        sb = sb + 1
    }

    // qs: gather row r's 128 bytes from 16 non-contiguous 8-byte chunks.
    // Chunk c = g*8 + r lives at packed[tile_base + 128 + c*8 .. +8] and
    // goes to scratch[16 + g*8 .. +8].
    let qs_base: i32 = tile_base + 128
    let mut g: i32 = 0
    while g < 16 {
        let src: i32 = qs_base + (g * 8 + r) * 8
        let dst: i32 = 16 + g * 8
        let mut j: i32 = 0
        while j < 8 {
            scratch[dst + j] = packed[src + j]
            j = j + 1
        }
        g = g + 1
    }
}

// Vector i32 dot of one Q4K sub-block-pair (64 K positions = 2 sub-blocks
// × 32 K each), scaled by the two 6-bit per-sub-block scales.
// Returns i32x8 = [scale_a * sum(32 products) + scale_b * sum(32 products)]
// collapsed into 8 lanes (reduce_add gives the final scalar).
//
// Unlike q4k_dot.ea's dot_block_vec which processes ALL 4 sub-block pairs
// of a super-block in one call, this helper processes ONE pair so the
// caller can FMA the per-pair result into f32 acc between calls — matching
// ggml's "4 FMAs per super-block" order.
func dot_sb_pair(
    q4: *mut u8, nib_off: i32,
    q8: *i8, q8_off: i32,
    scale_a: i16, scale_b: i16,
    mask_lo: u8x32, shift4: u8x32
) -> i32 {
    let p: u8x32 = load(q4, nib_off)
    let q8a: i8x32 = load(q8, q8_off)
    let q8b: i8x32 = load(q8, q8_off + 32)
    let sa: i16x16 = splat(scale_a)
    let sb: i16x16 = splat(scale_b)
    // Per-sub-block i32x8 dots, scaled by per-sub-block 6-bit factor.
    let ia: i32x8 = madd_i16(sa, maddubs_i16(p .& mask_lo, q8a))
    let ib: i32x8 = madd_i16(sb, maddubs_i16(p .>> shift4, q8b))
    // Research note: "Two sub-blocks combined via int32 add_epi32"
    let combined: i32x8 = ia .+ ib
    return reduce_add(combined)
}

// Build the 8-lane bsums-paired vector used for the mins correction.
// bsums[bs..bs+16] holds 16 i16 per-sub-sub-block sums; hadd pairs them
// into 8 paired sums (one per sub-block).
func bsums_paired(bsums: *i16, bs: i32) -> i16x8 {
    let lo: i16x8 = load(bsums, bs)
    let hi: i16x8 = load(bsums, bs + 8)
    return hadd_i16(lo, hi)
}

// Compute row r's mins contribution for one super-block using the 8-lane
// bsums pair vector and the row's reconstructed Q4K scales[12] layout.
// Returns a single i32 that llama's path stores into an i32 register per
// sb iter for the mins FMA (but olorin collapses all 8 sub-blocks in one
// madd_i16 to avoid extra shuffles — equivalent integer sum).
//
// This mirrors q4k_dot.ea::row_mins_bp; bit-exact result.
func row_mins_bp(q4: *mut u8, sp: i32, bp: i16x8) -> i32 {
    let mins: i16x8 = [
        to_i16(ubyte(q4, sp + 4) & 63),
        to_i16(ubyte(q4, sp + 5) & 63),
        to_i16(ubyte(q4, sp + 6) & 63),
        to_i16(ubyte(q4, sp + 7) & 63),
        to_i16((ubyte(q4, sp + 8) >> 4) | ((ubyte(q4, sp + 4) >> 6) << 4)),
        to_i16((ubyte(q4, sp + 9) >> 4) | ((ubyte(q4, sp + 5) >> 6) << 4)),
        to_i16((ubyte(q4, sp + 10) >> 4) | ((ubyte(q4, sp + 6) >> 6) << 4)),
        to_i16((ubyte(q4, sp + 11) >> 4) | ((ubyte(q4, sp + 7) >> 6) << 4))
    ]
    return reduce_add(madd_i16(mins, bp))
}

// ---------------------------------------------------------------------------
// Main export
// ---------------------------------------------------------------------------

export func q4k_8x8_q8k_matvec(
    weight_packed: *restrict u8,
    q8_qs: *restrict i8,
    q8_d: *restrict f32,
    q8_bsums: *i16,
    pow2: *f32,
    scratch: *mut u8,
    out output: *mut f32 [cap: n_rows],
    n_rows: i32,
    n_cols: i32
) {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let n_blocks: i32 = n_cols / 256
    let n_tiles: i32 = n_rows / 8

    // scr aliases scratch; all helpers take *mut u8 so unpack_row (writer)
    // and f16_load / dot_sb_pair / row_mins_bp (readers) share the type.
    let scr: *mut u8 = scratch

    let mut tile: i32 = 0
    while tile < n_tiles {
        let mut r: i32 = 0
        while r < 8 {
            // Per-row f32 accumulators — ggml's per-output reduction order:
            // four FMAs into acc, four parallel FMAs into acc_min, one
            // final sub.
            let mut acc: f32 = 0.0
            let mut acc_min: f32 = 0.0

            let mut b: i32 = 0
            while b < n_blocks {
                let tile_base: i32 = (tile * n_blocks + b) * 1152
                unpack_row(weight_packed, tile_base, r, scratch)

                // Read the row's reconstructed d, dmin and scales[12].
                // The scratch layout matches a standard block_q4_K.
                let d_row: f32 = f16_load(scr, 0, pow2)
                let dmin_row: f32 = f16_load(scr, 2, pow2)
                let row_d: f32 = q8_d[b]
                let d_prod: f32 = d_row * row_d       // rounded once, as ggml does
                let dmin_prod: f32 = dmin_row * row_d

                // Extract the 8 sub-block 6-bit scales from scratch.scales[12]
                // using the same bit layout q4k_dot.ea uses.
                let sp: i32 = 4
                let sp32: *mut i32 = ptr_as_i32(ptr_as_i8(scr))
                let u0: i32 = sp32[sp / 4]
                let u2: i32 = sp32[(sp + 8) / 4]
                let sc03: i32 = u0 & 0x3f3f3f3f
                let sc47: i32 = (u2 & 0x0f0f0f0f) | (((u0 >> 6) & 0x03030303) << 4)
                let s0: i16 = to_i16(sc03 & 255)
                let s1: i16 = to_i16((sc03 >> 8) & 255)
                let s2: i16 = to_i16((sc03 >> 16) & 255)
                let s3: i16 = to_i16((sc03 >> 24) & 255)
                let s4: i16 = to_i16(sc47 & 255)
                let s5: i16 = to_i16((sc47 >> 8) & 255)
                let s6: i16 = to_i16((sc47 >> 16) & 255)
                let s7: i16 = to_i16((sc47 >> 24) & 255)

                // Four FMAs per super-block — sb = 0,1,2,3 ascending.
                // sb k covers source sub-blocks 2k (low nibbles at qs+k*32)
                // and 2k+1 (high nibbles of the same bytes).
                let q8_off: i32 = b * 256
                let nib_base: i32 = 16
                let i32_0: i32 = dot_sb_pair(scr, nib_base +  0, q8_qs, q8_off +   0, s0, s1, mask_lo, shift4)
                acc = acc + to_f32(i32_0) * d_prod
                let i32_1: i32 = dot_sb_pair(scr, nib_base + 32, q8_qs, q8_off +  64, s2, s3, mask_lo, shift4)
                acc = acc + to_f32(i32_1) * d_prod
                let i32_2: i32 = dot_sb_pair(scr, nib_base + 64, q8_qs, q8_off + 128, s4, s5, mask_lo, shift4)
                acc = acc + to_f32(i32_2) * d_prod
                let i32_3: i32 = dot_sb_pair(scr, nib_base + 96, q8_qs, q8_off + 192, s6, s7, mask_lo, shift4)
                acc = acc + to_f32(i32_3) * d_prod

                // Mins correction — parallel accumulator in acc_min,
                // subtracted once at the end after all super-blocks.
                // Olorin computes the mins term for all 8 sub-blocks with
                // one madd_i16(mins_i16x8, bsums_paired_i16x8) → scalar,
                // which is mathematically equivalent to ggml's per-sb mins
                // FMA sum (integer math is associative) and produces the
                // same final acc_min after summing over all super-blocks.
                let bp: i16x8 = bsums_paired(q8_bsums, b * 16)
                let mins_i32: i32 = row_mins_bp(scr, sp, bp)
                acc_min = acc_min + to_f32(mins_i32) * dmin_prod

                b = b + 1
            }

            // Deferred subtract — matches ggml's final _mm512_sub_ps.
            output[tile * 8 + r] = acc - acc_min
            r = r + 1
        }
        tile = tile + 1
    }
}

// ---------------------------------------------------------------------------
// q4k_8x8_q8k_gemm — N>1 batched prompt-eval gemm
// ---------------------------------------------------------------------------
//
// For each of n_cols_batch input columns, compute the same inner loop as
// q4k_8x8_q8k_matvec against the shared packed weight tile. Per-output-column
// f32 reduction order is IDENTICAL to the matvec (Task 10 asserts this with
// bit-exact equality, not tolerance).
//
// Savings over looping matvec N times: the unpack_row + scale extraction
// (read once per (tile, row, block)) is amortized across all N columns.
// Per-column inner dot is still the 4-FMA-per-block ggml order.
//
// Column-major input layouts:
//   q8_qs:    column k starts at offset k * (n_cols + 12)
//   q8_d:     column k starts at offset k * n_blocks
//   q8_bsums: column k starts at offset k * n_blocks * 16
//   output:   column k starts at offset k * n_rows
//
// Caller-provided scratches:
//   scratch:     144 bytes — standard block_q4_K unpack buffer for one row
//   acc_scratch: 2 * n_cols_batch f32 — slot [col] is acc, [n_cols_batch+col]
//                is acc_min. Zeroed per (tile, row) by the kernel.

export func q4k_8x8_q8k_gemm(
    weight_packed: *restrict u8,
    q8_qs: *restrict i8,
    q8_d: *restrict f32,
    q8_bsums: *i16,
    pow2: *f32,
    scratch: *mut u8,
    acc_scratch: *mut f32,
    out output: *mut f32 [cap: n_rows * n_cols_batch],
    n_rows: i32,
    n_cols: i32,
    n_cols_batch: i32
) {
    let mask_lo: u8x32 = splat(15)
    let shift4: u8x32 = splat(4)
    let n_blocks: i32 = n_cols / 256
    let n_tiles: i32 = n_rows / 8
    let q8_qs_stride: i32 = n_cols + 12
    let q8_d_stride: i32 = n_blocks
    let q8_bsums_stride: i32 = n_blocks * 16

    // scr aliases scratch for the read helpers, same as matvec.
    let scr: *mut u8 = scratch

    let mut tile: i32 = 0
    while tile < n_tiles {
        let mut r: i32 = 0
        while r < 8 {
            // Init per-column accumulators for this (tile, row).
            let mut ci: i32 = 0
            while ci < n_cols_batch {
                acc_scratch[ci] = 0.0
                acc_scratch[n_cols_batch + ci] = 0.0
                ci = ci + 1
            }

            let mut b: i32 = 0
            while b < n_blocks {
                let tile_base: i32 = (tile * n_blocks + b) * 1152
                unpack_row(weight_packed, tile_base, r, scratch)

                // Read row-level data ONCE, reuse across all n_cols_batch
                // input columns. This is the gemm's whole point.
                let d_row: f32 = f16_load(scr, 0, pow2)
                let dmin_row: f32 = f16_load(scr, 2, pow2)

                let sp: i32 = 4
                let sp32: *mut i32 = ptr_as_i32(ptr_as_i8(scr))
                let u0: i32 = sp32[sp / 4]
                let u2: i32 = sp32[(sp + 8) / 4]
                let sc03: i32 = u0 & 0x3f3f3f3f
                let sc47: i32 = (u2 & 0x0f0f0f0f) | (((u0 >> 6) & 0x03030303) << 4)
                let s0: i16 = to_i16(sc03 & 255)
                let s1: i16 = to_i16((sc03 >> 8) & 255)
                let s2: i16 = to_i16((sc03 >> 16) & 255)
                let s3: i16 = to_i16((sc03 >> 24) & 255)
                let s4: i16 = to_i16(sc47 & 255)
                let s5: i16 = to_i16((sc47 >> 8) & 255)
                let s6: i16 = to_i16((sc47 >> 16) & 255)
                let s7: i16 = to_i16((sc47 >> 24) & 255)

                // Per-column inner loop — each column k runs the same four
                // FMAs + mins term as matvec, feeding its own accumulator
                // lane in acc_scratch.
                let mut col: i32 = 0
                while col < n_cols_batch {
                    let q8_off: i32 = col * q8_qs_stride + b * 256
                    let row_d: f32 = q8_d[col * q8_d_stride + b]
                    let d_prod: f32 = d_row * row_d
                    let dmin_prod: f32 = dmin_row * row_d

                    let i32_0: i32 = dot_sb_pair(scr, 16,     q8_qs, q8_off +   0, s0, s1, mask_lo, shift4)
                    acc_scratch[col] = acc_scratch[col] + to_f32(i32_0) * d_prod
                    let i32_1: i32 = dot_sb_pair(scr, 16 + 32, q8_qs, q8_off +  64, s2, s3, mask_lo, shift4)
                    acc_scratch[col] = acc_scratch[col] + to_f32(i32_1) * d_prod
                    let i32_2: i32 = dot_sb_pair(scr, 16 + 64, q8_qs, q8_off + 128, s4, s5, mask_lo, shift4)
                    acc_scratch[col] = acc_scratch[col] + to_f32(i32_2) * d_prod
                    let i32_3: i32 = dot_sb_pair(scr, 16 + 96, q8_qs, q8_off + 192, s6, s7, mask_lo, shift4)
                    acc_scratch[col] = acc_scratch[col] + to_f32(i32_3) * d_prod

                    let bp: i16x8 = bsums_paired(q8_bsums, col * q8_bsums_stride + b * 16)
                    let mins_i32: i32 = row_mins_bp(scr, sp, bp)
                    acc_scratch[n_cols_batch + col] =
                        acc_scratch[n_cols_batch + col] + to_f32(mins_i32) * dmin_prod

                    col = col + 1
                }

                b = b + 1
            }

            // Deferred subtract + store — per column.
            let mut co: i32 = 0
            while co < n_cols_batch {
                output[co * n_rows + tile * 8 + r] =
                    acc_scratch[co] - acc_scratch[n_cols_batch + co]
                co = co + 1
            }
            r = r + 1
        }
        tile = tile + 1
    }
}
