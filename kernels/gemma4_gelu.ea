// gemma4_gelu.ea — Fused GELU-gated linear unit
//
// out[i] = GELU(gate[i]) * up[i]
// GELU(x) = x * 0.5 * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
//
// SIMD path uses tanh_approx_f32 (eacompute v1.14.0+): rational P(x²)·x/Q(x²)
// approximation, ~3e-7 max abs error, single fdiv per call. Internally
// clamped to [-9, 9], where tanh already saturates to ±1 within a few ulps.

export func gelu_mul(gate: *restrict f32, up: *restrict f32, out: *mut f32, n: i32) {
    let v_half: f32x4 = splat(0.5)
    let v_coeff: f32x4 = splat(0.7978845608)   // sqrt(2/pi)
    let v_cubic: f32x4 = splat(0.044715)
    let v_one: f32x4 = splat(1.0)

    let mut i: i32 = 0

    while i + 4 <= n {
        let g: f32x4 = load(gate, i)
        let u: f32x4 = load(up, i)

        let g3: f32x4 = g .* g .* g
        let inner: f32x4 = v_coeff .* (g .+ v_cubic .* g3)
        let th: f32x4 = tanh_approx_f32(inner)
        let gelu: f32x4 = g .* v_half .* (v_one .+ th)

        store(out, i, gelu .* u)
        i = i + 4
    }

    // Scalar tail: libm exp fallback (at most 3 elements per call).
    while i < n {
        let x: f32 = gate[i]
        let x3: f32 = x * x * x
        let inner: f32 = 0.7978845608 * (x + 0.044715 * x3)
        let e: f32 = exp(2.0 * inner)
        let th: f32 = 1.0 - 2.0 / (e + 1.0)
        let gelu: f32 = x * 0.5 * (1.0 + th)
        out[i] = gelu * up[i]
        i = i + 1
    }
}
