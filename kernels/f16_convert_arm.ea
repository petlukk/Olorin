// f16_convert_arm.ea — Bulk f32<->f16 conversion (ARM NEON)
//
// f16: [sign:1][exp:5][mant:10], bias=15
// f32: [sign:1][exp:8][mant:23], bias=127
// Exponent delta: 112

#[cfg(aarch64)]

func read_u16(p: *restrict u16, off: i32) -> i32 {
    return to_i32(p[off]) & 65535
}

export func f32_to_f16(src: *restrict f32, dst: *mut u16, n: i32, tmp: *mut i32) {
    let ip: *restrict i32 = ptr_as_i32(src)
    let mut i: i32 = 0
    while i < n {
        let bits: i32 = ip[i]
        let sign: i32 = (bits >> 16) & 32768
        let exp: i32 = ((bits >> 23) & 255) - 112
        let mant: i32 = (bits >> 13) & 1023

        let mut h: i32 = 0
        if exp <= 0 {
            h = sign
        } else {
            if exp >= 31 {
                h = sign | 31744
            } else {
                h = sign | (exp << 10) | mant
            }
        }
        tmp[0] = h
        let tp: *mut u16 = ptr_as_u16(tmp)
        dst[i] = tp[0]
        i = i + 1
    }
}

export func f16_to_f32(src: *restrict u16, dst: *mut f32, n: i32) {
    let op: *mut i32 = ptr_as_i32(dst)
    let mut i: i32 = 0
    while i < n {
        let raw: i32 = read_u16(src, i)
        let exp: i32 = (raw >> 10) & 31

        if exp == 0 {
            op[i] = 0
        } else {
            let sign: i32 = (raw >> 15) & 1
            let mant: i32 = raw & 1023
            op[i] = (sign << 31) | ((exp + 112) << 23) | (mant << 13)
        }
        i = i + 1
    }
}
