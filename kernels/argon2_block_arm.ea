// Argon2 G compression function (RFC 9106 §3.4) — one block step.
//
//   G(X, Y) -> Z, all three 1024-byte (128 × u64) blocks.
//
//   R = X XOR Y
//   apply Argon2 P to each of the 8 rows of R  (rows are contiguous: 16 u64s)
//   apply Argon2 P to each of the 8 columns of R'  (columns are strided)
//   Z = R'' XOR R
//
// Argon2's P transform is one Blake2b-style round (8 G' calls) operating
// on 16 u64s, using the modified G' from RFC 9106 §3.6: addition has an
// extra `2 * trunc(a) * trunc(b)` term where `trunc()` keeps the low 32
// bits.  This is what prevents off-the-shelf Blake2b hardware (or our
// own Blake2b kernel) from being usable as a drop-in.
//
// Columns are gathered into a 16-u64 scratch buffer, P'd, and scattered
// back — keeps the inner P transform branch-free and lets the same
// `p_at` helper work for rows (offset into z) and columns (offset 0
// into scratch).
//
// Constants live entirely in i32 (counters / offsets) and a single u64
// mask `0xFFFFFFFF`, which fits in i64::MAX — no need for a Rust-side
// constants table here.

func rotr64(x: u64, n: u64) -> u64 {
    let shift_back: u64 = 64 - n
    return (x >> n) | (x << shift_back)
}

// Argon2 G' (RFC 9106 §3.6).  Operates on v[] in place at the four given
// indices.  Notice the extra `2 * lo32(a) * lo32(b)` term on every
// addition — that is the only thing distinguishing this from Blake2b's
// own G.
func g_prime(
    v: *restrict mut u64,
    a: i32, b: i32, c: i32, d: i32
) {
    let mask: u64 = 0xFFFFFFFF
    v[a] = v[a] + v[b] + 2 * (v[a] & mask) * (v[b] & mask)
    v[d] = rotr64(v[d] ^ v[a], 32)
    v[c] = v[c] + v[d] + 2 * (v[c] & mask) * (v[d] & mask)
    v[b] = rotr64(v[b] ^ v[c], 24)
    v[a] = v[a] + v[b] + 2 * (v[a] & mask) * (v[b] & mask)
    v[d] = rotr64(v[d] ^ v[a], 16)
    v[c] = v[c] + v[d] + 2 * (v[c] & mask) * (v[d] & mask)
    v[b] = rotr64(v[b] ^ v[c], 63)
}

// Argon2 P transform: one Blake2b-style round on 16 u64s starting at
// offset `base` in `v`.  Index pattern matches Blake2b's first round
// (the four-column G's followed by the four-diagonal G's).
func p_at(v: *restrict mut u64, base: i32) {
    g_prime(v, base+ 0, base+ 4, base+ 8, base+12)
    g_prime(v, base+ 1, base+ 5, base+ 9, base+13)
    g_prime(v, base+ 2, base+ 6, base+10, base+14)
    g_prime(v, base+ 3, base+ 7, base+11, base+15)
    g_prime(v, base+ 0, base+ 5, base+10, base+15)
    g_prime(v, base+ 1, base+ 6, base+11, base+12)
    g_prime(v, base+ 2, base+ 7, base+ 8, base+13)
    g_prime(v, base+ 3, base+ 4, base+ 9, base+14)
}

export func argon2_block_compress(
    x: *restrict u64,
    y: *restrict u64,
    z: *restrict mut u64,
    scratch: *restrict mut u64
) {
    let mut i: i32 = 0
    while i < 128 {
        z[i] = x[i] ^ y[i]
        i = i + 1
    }

    // Row-mode P transforms (8 rows × 16 u64s).
    p_at(z,   0)
    p_at(z,  16)
    p_at(z,  32)
    p_at(z,  48)
    p_at(z,  64)
    p_at(z,  80)
    p_at(z,  96)
    p_at(z, 112)

    // Column-mode P transforms (8 columns, gather → P → scatter).
    // Column j is registers (0,j), (1,j), …, (7,j); a register is a
    // pair of u64s at z[col*2 + row*16] and z[col*2 + row*16 + 1].
    let mut col: i32 = 0
    while col < 8 {
        let col2: i32 = col * 2
        let mut row: i32 = 0
        while row < 8 {
            let r16: i32 = row * 16
            scratch[row * 2]     = z[col2 + r16]
            scratch[row * 2 + 1] = z[col2 + r16 + 1]
            row = row + 1
        }
        p_at(scratch, 0)
        row = 0
        while row < 8 {
            let r16: i32 = row * 16
            z[col2 + r16]     = scratch[row * 2]
            z[col2 + r16 + 1] = scratch[row * 2 + 1]
            row = row + 1
        }
        col = col + 1
    }

    // Final XOR with R = X XOR Y.
    i = 0
    while i < 128 {
        z[i] = z[i] ^ (x[i] ^ y[i])
        i = i + 1
    }
}
