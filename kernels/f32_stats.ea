// One-pass streaming stats over an f32 array. Out params receive the
// final count, sum, min, max.
//
// Empty input zeros all four outputs and returns without touching the
// data pointer.
//
// SIMD strategy: f32x4 accumulators for sum/min/max, updated lane-wise
// across 4-at-a-time chunks; horizontal reduce at the end via
// reduce_add / reduce_min / reduce_max. Cross-arch (x86 SSE2 / ARM NEON).
// `reduce_add` (not `reduce_add_fast`) is used so the sum is
// associativity-ordered — determinism matters more than peak speed for
// a diagnostic stats kernel.
//
// Signature is single-line to appease the current Eä parser — multi-line
// parameter lists fail with `expected parameter name`. Once that's fixed
// it can be split across lines for readability.

export func f32_stats(data: *f32, len: i32, out_count: *mut i32, out_sum: *mut f32, out_min: *mut f32, out_max: *mut f32) {
    out_count[0] = 0
    out_sum[0]   = 0.0
    out_min[0]   = 0.0
    out_max[0]   = 0.0
    if len < 1 {
        return
    }

    let first: f32 = data[0]
    let mut v_sum: f32x4 = splat(0.0)
    let mut v_min: f32x4 = splat(first)
    let mut v_max: f32x4 = splat(first)

    let n_full: i32 = (len / 4) * 4
    let mut i: i32 = 0
    while i < n_full {
        let v: f32x4 = load(data, i)
        v_sum = v_sum .+ v
        v_min = min(v_min, v)
        v_max = max(v_max, v)
        i = i + 4
    }

    let mut s:  f32 = reduce_add(v_sum)
    let mut mn: f32 = reduce_min(v_min)
    let mut mx: f32 = reduce_max(v_max)

    // Scalar tail (< 4 remaining)
    while i < len {
        let v: f32 = data[i]
        s = s + v
        if v < mn {
            mn = v
        }
        if v > mx {
            mx = v
        }
        i = i + 1
    }

    out_count[0] = len
    out_sum[0]   = s
    out_min[0]   = mn
    out_max[0]   = mx
}
