// One-pass streaming stats over an f32 array. Out params receive the
// final count, sum, min, max.
//
// Scalar Eä for MVP — an f32-reduction SIMD pass (accumulate min/max in
// lane registers, horizontal reduce at the end) can replace the body
// later. CSV parsing dominates total time so the scalar cost is small.
//
// Empty input zeros all four outputs and returns without touching the
// data pointer.
//
// TODO(simd): replace loop with f32x4 or f32x8 accumulators + horizontal
// reduce once eacrunch is past MVP.
//
// Signature is single-line to appease the current Eä parser — multi-line
// parameter lists fail with `expected parameter name`. Once that's fixed
// it can be split across lines for readability.

export func f32_stats(data: *f32, len: i32, out_count: *mut i32, out_sum: *mut f32, out_min: *mut f32, out_max: *mut f32) {
    out_count[0] = 0
    out_sum[0]   = 0.0
    out_min[0]   = 0.0
    out_max[0]   = 0.0
    if len < 1 {
        return
    }
    let mut s: f32 = 0.0
    let mut mn: f32 = data[0]
    let mut mx: f32 = data[0]
    let mut i: i32 = 0
    while i < len {
        let v: f32 = data[i]
        s = s + v
        if v < mn {
            mn = v
        }
        if v > mx {
            mx = v
        }
        i = i + 1
    }
    out_count[0] = len
    out_sum[0]   = s
    out_min[0]   = mn
    out_max[0]   = mx
}
