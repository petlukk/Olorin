// softmax.ea — In-place scaled softmax (x86 AVX2)
//
// Uses LLVM exp intrinsic (llvm.exp.v8f32) for correct SIMD exp.

#[cfg(x86_64)]

export func softmax_f32(data: *mut f32, n: i32, scale: f32) {
    // Pass 1: Scale and find max
    let v_scale: f32x8 = splat(scale)
    let mut v_max: f32x8 = splat(-1000000.0)
    let mut i: i32 = 0

    while i + 8 <= n {
        let v: f32x8 = load_f32x8(data, i) .* v_scale
        store(data, i, v)
        v_max = max(v_max, v)
        i = i + 8
    }

    let mut m: f32 = reduce_max(v_max)
    while i < n {
        data[i] = data[i] * scale
        if data[i] > m { m = data[i] }
        i = i + 1
    }

    // Pass 2: Subtract max, exp, accumulate sum
    let v_m: f32x8 = splat(m)
    let mut v_sum: f32x8 = splat(0.0)
    i = 0

    while i + 8 <= n {
        let e: f32x8 = exp(load_f32x8(data, i) .- v_m)
        store(data, i, e)
        v_sum = v_sum .+ e
        i = i + 8
    }

    let mut s: f32 = reduce_add(v_sum)

    // Scalar tail — do NOT overlap-load: positions before i were already
    // exp'd by the SIMD pass and would get double-exp'd.
    while i < n {
        let v: f32 = data[i] - m
        data[i] = exp(v)
        s = s + data[i]
        i = i + 1
    }

    // Pass 3: Normalize
    let inv_s: f32 = 1.0 / s
    let v_inv: f32x8 = splat(inv_s)
    i = 0

    while i + 8 <= n {
        store(data, i, load_f32x8(data, i) .* v_inv)
        i = i + 8
    }
    while i < n {
        data[i] = data[i] * inv_s
        i = i + 1
    }
}
