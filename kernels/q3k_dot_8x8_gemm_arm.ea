// q3k_dot_8x8_gemm_arm.ea — Q3Kx8 × Q8Kx4 batched gemm (ARM NEON + dotprod).
//
// Mirrors q4k_dot_8x8_gemm_arm.ea but for Q3_K (no min/dmin, scale-only).
// Closes the Q3K prefill gap by replacing the "1-row dot kernel called 4×
// per chunk" path with a true 8-row-tiled batched gemm.
//
// Q3Kx8 super-block tile layout (1168 B per 8 rows × 256 cols), produced by
// q3k_repack_8x8:
//   +   0..  15  8 × f16 d (one per row)                        (16 B)
//   +  16.. 143  16 sub-blocks × 8 rows × 1 byte signed scale  (128 B)
//                byte `16 + sb*8 + r` = scale for (sb, row r), in [-32..31]
//   + 144..1167  8 sub-block-pairs × 128 bytes each            (1024 B)
//                pair sp covers sub-blocks {2*sp, 2*sp+1} (adjacent — same
//                pairing scheme as Q4Kx8): low nibble of each byte =
//                sub-block 2*sp's element, high nibble = sub-block 2*sp+1's
//                element, each as 4-bit two's-complement signed in [-4..3].
//                Per pair: 4 chunks of 32 bytes; per chunk =
//                  bytes [0..15]  rows 0..3, 4 elem/row × 2 sub-blocks packed
//                  bytes [16..31] rows 4..7, same shape
//
// vdot_lane_i32 reads 4 bytes from the b-operand at `lane*4`, broadcasts,
// and accumulates 4 dot-of-4 products into the i32x4 acc (one per a-lane =
// one per weight row). 16 vdot_lane calls per (k, sub-half) cover 4 weight
// rows × 4 Q8K columns. After 4 k iterations, each i32x4 holds the
// completed 16-element dot for that (sub-block, weight-row-quad, q8-col).

#[cfg(aarch64)]

export func q3k_8x8_q8k_gemm(
    packed: *restrict u8,
    q8_a:  *restrict u8,
    scratch: *mut u8,
    out:   *mut f32,
    bs:    i32,
    n:     i32,
    nr:    i32,
    nc:    i32
) {
    let nb: i32 = n / 256
    let shift4: i8x16 = splat(4)

    let d16: *restrict i16 = ptr_as_i16(ptr_as_i8(packed))
    let packed_i8: *restrict i8 = ptr_as_i8(packed)
    let out_f32: *mut f32 = ptr_as_f32(ptr_as_i8(out))
    let q8_i8: *restrict i8 = ptr_as_i8(q8_a)

    let nr4: i32 = nr / 4
    let mut y: i32 = 0
    while y < nr4 {
        let mut x: i32 = 0
        while x < nc / 8 {
            // 8 f32x4 accumulators: 4 q8-rows × 2 weight-row-halves (rows 0..3, rows 4..7).
            let mut acc0_0: f32x4 = splat(0.0)
            let mut acc1_0: f32x4 = splat(0.0)
            let mut acc0_1: f32x4 = splat(0.0)
            let mut acc1_1: f32x4 = splat(0.0)
            let mut acc0_2: f32x4 = splat(0.0)
            let mut acc1_2: f32x4 = splat(0.0)
            let mut acc0_3: f32x4 = splat(0.0)
            let mut acc1_3: f32x4 = splat(0.0)

            let mut b: i32 = 0
            while b < nb {
                // Tile base: 1168 bytes per super-block, 8 cols per tile.
                let bp: i32 = (x * nb + b) * 1168

                // 8 × f16 d → 2 × f32x4 (rows 0..3 and rows 4..7)
                let q3d0: f32x4 = cvt_f16_f32(load(d16, bp / 2))
                let q3d1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 4))

                // Q8K block_q8_Kx4 stride is 1168 bytes (16 d + 1024 qs + 128 bsums).
                let ab: i32 = (y * nb + b) * 1168

                let q8d: *restrict f32 = ptr_as_f32(q8_i8)
                let q8d0: f32 = q8d[ab / 4]
                let q8d1: f32 = q8d[ab / 4 + 1]
                let q8d2: f32 = q8d[ab / 4 + 2]
                let q8d3: f32 = q8d[ab / 4 + 3]

                // Per (q8-col c, weight-half h ∈ {03, 47}): row scaling factor
                // d[h]·q8d[c] applied via FMA after sub-block accumulation.
                let sb_03_0: f32x4 = q3d0 .* splat(q8d0)
                let sb_47_0: f32x4 = q3d1 .* splat(q8d0)
                let sb_03_1: f32x4 = q3d0 .* splat(q8d1)
                let sb_47_1: f32x4 = q3d1 .* splat(q8d1)
                let sb_03_2: f32x4 = q3d0 .* splat(q8d2)
                let sb_47_2: f32x4 = q3d1 .* splat(q8d2)
                let sb_03_3: f32x4 = q3d0 .* splat(q8d3)
                let sb_47_3: f32x4 = q3d1 .* splat(q8d3)

                // i32 sumi accumulators per (q8-col, weight-half, row-quad), reset each
                // super-block. Match q3k_dot_q8k's accumulation order: sum 16 sub-block
                // contributions in i32, then ONE f32 conversion + FMA per super-block.
                // Without this, accumulating in f32 per sub-block gives ~5e-7 fp drift.
                let mut sumi_03_0: i32x4 = splat(0)
                let mut sumi_03_1: i32x4 = splat(0)
                let mut sumi_03_2: i32x4 = splat(0)
                let mut sumi_03_3: i32x4 = splat(0)
                let mut sumi_47_0: i32x4 = splat(0)
                let mut sumi_47_1: i32x4 = splat(0)
                let mut sumi_47_2: i32x4 = splat(0)
                let mut sumi_47_3: i32x4 = splat(0)

                // Pair sub-blocks {2*sp, 2*sp+1} per outer iteration. 8 pairs total.
                let mut sp: i32 = 0
                while sp < 8 {
                    // Quants base for this pair: 144 + sp*128.
                    let q3_base: i32 = bp + 144 + sp * 128

                    // Q8K bases. Each Q3K sub-block is 16 elements (vs Q4K's 32),
                    // so per-sub-half byte width is 16 elem × 4 q8-cols × 1 byte =
                    // 64 B (= 4 chunks × 16 B), and per-pair stride is 128 B.
                    // Lo (sub-block 2*sp) starts at sp*128; hi (sub-block 2*sp+1)
                    // is +64 from there. Critically NOT +128 as in Q4Kx8 — that
                    // would skip a whole Q3K sub-block-pair forward.
                    let q8_lo_base: i32 = ab + 16 + sp * 128
                    let q8_hi_base: i32 = q8_lo_base + 64

                    // Per-row signed i32 scales.
                    // sc_*_03 = scales for rows 0..3; sc_*_47 = scales for rows 4..7.
                    // sc_lo_* = sub-block 2*sp; sc_hi_* = sub-block 2*sp+1.
                    // Scales are at bp+16 (super-block-relative), NOT byte 16 of
                    // the whole packed buffer — that mistake reads tile-0-sb-0
                    // scales for every super-block.
                    let sc_p:  *restrict i8 = packed_i8
                    let sc_lo_03: i32x4 = [
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 0]),
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 1]),
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 2]),
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 3])
                    ]
                    let sc_lo_47: i32x4 = [
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 4]),
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 5]),
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 6]),
                        to_i32(sc_p[bp + 16 + (sp * 2) * 8 + 7])
                    ]
                    let sc_hi_03: i32x4 = [
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 0]),
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 1]),
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 2]),
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 3])
                    ]
                    let sc_hi_47: i32x4 = [
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 4]),
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 5]),
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 6]),
                        to_i32(sc_p[bp + 16 + (sp * 2 + 1) * 8 + 7])
                    ]

                    // 16 i32x4 vdot accumulators: 2 weight halves (03, 47) × 2 sub-halves (lo, hi) × 4 q8-cols.
                    let mut al03_0: i32x4 = splat(0)
                    let mut al03_1: i32x4 = splat(0)
                    let mut al03_2: i32x4 = splat(0)
                    let mut al03_3: i32x4 = splat(0)
                    let mut ah03_0: i32x4 = splat(0)
                    let mut ah03_1: i32x4 = splat(0)
                    let mut ah03_2: i32x4 = splat(0)
                    let mut ah03_3: i32x4 = splat(0)
                    let mut al47_0: i32x4 = splat(0)
                    let mut al47_1: i32x4 = splat(0)
                    let mut al47_2: i32x4 = splat(0)
                    let mut al47_3: i32x4 = splat(0)
                    let mut ah47_0: i32x4 = splat(0)
                    let mut ah47_1: i32x4 = splat(0)
                    let mut ah47_2: i32x4 = splat(0)
                    let mut ah47_3: i32x4 = splat(0)

                    let mut k: i32 = 0
                    while k < 4 {
                        // Q8K loads: 16 bytes per sub-half = 4 q8-cols × 4 elements.
                        let q8_lo: i8x16 = load(q8_i8, q8_lo_base + k * 16)
                        let q8_hi: i8x16 = load(q8_i8, q8_hi_base + k * 16)

                        // Q3K weight loads: 32 bytes per k = 16 (rows 0..3, 4 elem × 2 sub-halves) + 16 (rows 4..7).
                        let w03: i8x16 = load(packed_i8, q3_base + k * 32)
                        let w47: i8x16 = load(packed_i8, q3_base + k * 32 + 16)
                        // Sign-extend 4-bit two's-complement nibbles (Q3K range [-4..3]) to i8.
                        let w03_lo: i8x16 = (w03 .<< shift4) .>> shift4
                        let w03_hi: i8x16 = w03 .>> shift4
                        let w47_lo: i8x16 = (w47 .<< shift4) .>> shift4
                        let w47_hi: i8x16 = w47 .>> shift4

                        // 16 vdot_lane calls — each yields i32x4 of "weight-row × q8-col-lane" partial dots.
                        al03_0 = vdot_lane_i32(al03_0, w03_lo, q8_lo, 0)
                        al03_1 = vdot_lane_i32(al03_1, w03_lo, q8_lo, 1)
                        al03_2 = vdot_lane_i32(al03_2, w03_lo, q8_lo, 2)
                        al03_3 = vdot_lane_i32(al03_3, w03_lo, q8_lo, 3)

                        ah03_0 = vdot_lane_i32(ah03_0, w03_hi, q8_hi, 0)
                        ah03_1 = vdot_lane_i32(ah03_1, w03_hi, q8_hi, 1)
                        ah03_2 = vdot_lane_i32(ah03_2, w03_hi, q8_hi, 2)
                        ah03_3 = vdot_lane_i32(ah03_3, w03_hi, q8_hi, 3)

                        al47_0 = vdot_lane_i32(al47_0, w47_lo, q8_lo, 0)
                        al47_1 = vdot_lane_i32(al47_1, w47_lo, q8_lo, 1)
                        al47_2 = vdot_lane_i32(al47_2, w47_lo, q8_lo, 2)
                        al47_3 = vdot_lane_i32(al47_3, w47_lo, q8_lo, 3)

                        ah47_0 = vdot_lane_i32(ah47_0, w47_hi, q8_hi, 0)
                        ah47_1 = vdot_lane_i32(ah47_1, w47_hi, q8_hi, 1)
                        ah47_2 = vdot_lane_i32(ah47_2, w47_hi, q8_hi, 2)
                        ah47_3 = vdot_lane_i32(ah47_3, w47_hi, q8_hi, 3)

                        k = k + 1
                    }

                    // Accumulate i32 sumi += scale[sb_lo] * dot_lo + scale[sb_hi] * dot_hi
                    // for each (q8-col, weight-half), staying in i32 across all 8 sp.
                    sumi_03_0 = sumi_03_0 .+ sc_lo_03 .* al03_0 .+ sc_hi_03 .* ah03_0
                    sumi_47_0 = sumi_47_0 .+ sc_lo_47 .* al47_0 .+ sc_hi_47 .* ah47_0
                    sumi_03_1 = sumi_03_1 .+ sc_lo_03 .* al03_1 .+ sc_hi_03 .* ah03_1
                    sumi_47_1 = sumi_47_1 .+ sc_lo_47 .* al47_1 .+ sc_hi_47 .* ah47_1
                    sumi_03_2 = sumi_03_2 .+ sc_lo_03 .* al03_2 .+ sc_hi_03 .* ah03_2
                    sumi_47_2 = sumi_47_2 .+ sc_lo_47 .* al47_2 .+ sc_hi_47 .* ah47_2
                    sumi_03_3 = sumi_03_3 .+ sc_lo_03 .* al03_3 .+ sc_hi_03 .* ah03_3
                    sumi_47_3 = sumi_47_3 .+ sc_lo_47 .* al47_3 .+ sc_hi_47 .* ah47_3

                    sp = sp + 1
                }

                // Per super-block: compute d * to_f32(sumi) then ADD to acc.
                // Mirrors q3k_dot_q8k's `result = result + d * to_f32(sumi)` per-block
                // pattern EXACTLY — separate mul + add (NOT fused), matching the 1-row
                // reference's two-rounding behaviour for bit-exact parity.
                acc0_0 = acc0_0 .+ sb_03_0 .* to_f32(sumi_03_0)
                acc1_0 = acc1_0 .+ sb_47_0 .* to_f32(sumi_47_0)
                acc0_1 = acc0_1 .+ sb_03_1 .* to_f32(sumi_03_1)
                acc1_1 = acc1_1 .+ sb_47_1 .* to_f32(sumi_47_1)
                acc0_2 = acc0_2 .+ sb_03_2 .* to_f32(sumi_03_2)
                acc1_2 = acc1_2 .+ sb_47_2 .* to_f32(sumi_47_2)
                acc0_3 = acc0_3 .+ sb_03_3 .* to_f32(sumi_03_3)
                acc1_3 = acc1_3 .+ sb_47_3 .* to_f32(sumi_47_3)

                b = b + 1
            }

            // Output layout matches q4k_8x8_q8k_gemm: 4 token rows × 8 weight cols per tile.
            store(out_f32, (y * 4 + 0) * bs + x * 8,     acc0_0)
            store(out_f32, (y * 4 + 0) * bs + x * 8 + 4, acc1_0)
            store(out_f32, (y * 4 + 1) * bs + x * 8,     acc0_1)
            store(out_f32, (y * 4 + 1) * bs + x * 8 + 4, acc1_1)
            store(out_f32, (y * 4 + 2) * bs + x * 8,     acc0_2)
            store(out_f32, (y * 4 + 2) * bs + x * 8 + 4, acc1_2)
            store(out_f32, (y * 4 + 3) * bs + x * 8,     acc0_3)
            store(out_f32, (y * 4 + 3) * bs + x * 8 + 4, acc1_3)

            x = x + 1
        }
        y = y + 1
    }
}
