// Llama 3 pre-tokenizer — fused classify + span boundary detection.
//
// SIMD pass: classify every byte into flags (letter/digit/ws/punct/nonascii).
// Scalar pass: walk flags to emit span boundaries per Llama 3 tiktoken regex.
//
// Output: boundaries[i] = 1 at span starts, 0 otherwise.
// Caller collects (start, len) spans from the boundary array.

static_assert(122 - 97 == 25, "lowercase letters contiguous")
static_assert(57 - 48 == 9, "digits contiguous")

export func pretokenize(text: *u8, flags: *mut u8, boundaries: *mut u8, len: i32) {
    // ── Pass 1: SIMD byte classification ──
    let v_space: u8x16 = splat(32)
    let v_tab: u8x16 = splat(9)
    let v_lf: u8x16 = splat(10)
    let v_cr: u8x16 = splat(13)
    let v_A: u8x16 = splat(65)
    let v_Z: u8x16 = splat(90)
    let v_a: u8x16 = splat(97)
    let v_z: u8x16 = splat(122)
    let v_0: u8x16 = splat(48)
    let v_9: u8x16 = splat(57)
    let v_bang: u8x16 = splat(33)
    let v_tilde: u8x16 = splat(126)
    let v_127: u8x16 = splat(127)
    let v_zero: u8x16 = splat(0)
    let v_ones: u8x16 = splat(255)
    let v_ws_flag: u8x16 = splat(1)
    let v_letter_flag: u8x16 = splat(2)
    let v_digit_flag: u8x16 = splat(4)
    let v_punct_flag: u8x16 = splat(8)
    let v_nonascii_flag: u8x16 = splat(16)
    let v_boundary_zero: u8x16 = splat(0)

    let n_full: i32 = (len / 16) * 16
    for i in 0..n_full step 16 {
        prefetch(text, i + 128)
        let c: u8x16 = load(text, i)

        let ws1: u8x16 = select(c .== v_space, v_ws_flag, v_zero)
        let ws2: u8x16 = select(c .== v_tab, v_ws_flag, v_zero)
        let ws3: u8x16 = select(c .== v_lf, v_ws_flag, v_zero)
        let ws4: u8x16 = select(c .== v_cr, v_ws_flag, v_zero)
        let ws: u8x16 = ws1 .| ws2 .| ws3 .| ws4

        let ge_A: u8x16 = select(c .>= v_A, v_ones, v_zero)
        let le_Z: u8x16 = select(c .<= v_Z, v_ones, v_zero)
        let upper: u8x16 = (ge_A .& le_Z) .& v_letter_flag

        let ge_a: u8x16 = select(c .>= v_a, v_ones, v_zero)
        let le_z: u8x16 = select(c .<= v_z, v_ones, v_zero)
        let lower_letter: u8x16 = (ge_a .& le_z) .& v_letter_flag

        let ge_0: u8x16 = select(c .>= v_0, v_ones, v_zero)
        let le_9: u8x16 = select(c .<= v_9, v_ones, v_zero)
        let digit: u8x16 = (ge_0 .& le_9) .& v_digit_flag

        let nonascii: u8x16 = select(c .> v_127, v_nonascii_flag, v_zero)

        let known: u8x16 = ws .| upper .| lower_letter .| digit
        let ge_bang: u8x16 = select(c .>= v_bang, v_ones, v_zero)
        let le_tilde: u8x16 = select(c .<= v_tilde, v_ones, v_zero)
        let printable: u8x16 = (ge_bang .& le_tilde) .& v_punct_flag
        let punct: u8x16 = select(known .== v_zero, printable, v_zero)

        let f: u8x16 = ws .| upper .| lower_letter .| digit .| nonascii .| punct
        stream_store(flags, i, f)
        stream_store(boundaries, i, v_boundary_zero)
    }

    // Scalar tail for classification
    for i in n_full..len {
        let b: u8 = text[i]
        let mut f: u8 = 0
        if b == 32 || b == 9 || b == 10 || b == 13 {
            f = 1
        } else {
            if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) {
                f = 2
            } else {
                if b >= 48 && b <= 57 {
                    f = 4
                } else {
                    if b > 127 {
                        f = 16
                    } else {
                        if b >= 33 && b <= 126 {
                            f = 8
                        }
                    }
                }
            }
        }
        flags[i] = f
        boundaries[i] = 0
    }

    // ── Pass 2: scalar span boundary walk ──
    // Regex-aware: contractions, leading-space words, 3-digit groups, ws/punct.
    let mut i: i32 = 0
    while i < len {
        boundaries[i] = 1

        let f: u8 = flags[i]
        let b: u8 = text[i]

        // Contraction: apostrophe + suffix ('s 't 'm 'd 're 've 'll)
        if b == 39 && i + 1 < len {
            let c1: u8 = text[i + 1]
            let s1: bool = c1 == 115 || c1 == 83 || c1 == 116 || c1 == 84 || c1 == 109 || c1 == 77 || c1 == 100 || c1 == 68
            if s1 {
                i = i + 2
            } else {
                if i + 2 < len {
                    let c2: u8 = text[i + 2]
                    let re: bool = (c1 == 114 || c1 == 82) && (c2 == 101 || c2 == 69)
                    let ve: bool = (c1 == 118 || c1 == 86) && (c2 == 101 || c2 == 69)
                    let ll: bool = (c1 == 108 || c1 == 76) && (c2 == 108 || c2 == 76)
                    if re || ve || ll {
                        i = i + 3
                    } else {
                        i = i + 1
                    }
                } else {
                    i = i + 1
                }
            }
        } else {
            if f == 2 || f == 16 {
                // Pure letter start — consume letter run
                i = i + 1
                let mut cont: bool = i < len
                while cont {
                    let nf: u8 = flags[i]
                    if nf != 2 && nf != 16 { cont = false }
                    if cont { i = i + 1 }
                    cont = cont && i < len
                }
            } else {
                if f == 4 {
                    // Digits: groups of 1-3
                    let mut count: i32 = 0
                    let mut cont: bool = i < len && count < 3
                    while cont {
                        let nf: u8 = flags[i]
                        if nf != 4 { cont = false }
                        if cont { i = i + 1 }
                        count = count + 1
                        cont = cont && i < len && count < 3
                    }
                } else {
                    let mut is_space_word: bool = false
                    if f == 1 && b != 10 && b != 13 && i + 1 < len {
                        let next_f: u8 = flags[i + 1]
                        is_space_word = next_f == 2 || next_f == 16
                    }
                    if is_space_word {
                        // Space before letters: include space in word span
                        i = i + 2
                        let mut cont: bool = i < len
                        while cont {
                            let nf: u8 = flags[i]
                            if nf != 2 && nf != 16 { cont = false }
                            if cont { i = i + 1 }
                            cont = cont && i < len
                        }
                    } else {
                        if f == 1 {
                            // Pure whitespace run
                            let mut cont: bool = i < len
                            while cont {
                                let nf: u8 = flags[i]
                                if nf != 1 { cont = false }
                                if cont { i = i + 1 }
                                cont = cont && i < len
                            }
                        } else {
                            if f == 8 {
                                // Punctuation + trailing newlines
                                let mut cont: bool = i < len
                                while cont {
                                    let nf: u8 = flags[i]
                                    if nf != 8 { cont = false }
                                    if cont { i = i + 1 }
                                    cont = cont && i < len
                                }
                                let mut cont2: bool = i < len
                                while cont2 {
                                    let tb: u8 = text[i]
                                    if tb != 10 && tb != 13 { cont2 = false }
                                    if cont2 { i = i + 1 }
                                    cont2 = cont2 && i < len
                                }
                            } else {
                                i = i + 1
                            }
                        }
                    }
                }
            }
        }
    }
}
