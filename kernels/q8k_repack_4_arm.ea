// q8k_repack_4_arm.ea — Pack 4 per-row Q8K inputs into block_q8_Kx4 tiles.
//
// ARM NEON mirror of q8k_repack_4.ea. Uses 4-byte-granular interleaving
// for qs to match vdot_lane_i32 access pattern.
//
// Per super-block (1168 bytes):
//   dst[  0.. 16) — d[4]    : 4 x f32 row deltas
//   dst[ 16..1040) — qs[1024]: 4-row 4-byte-granular interleave
//   dst[1040..1168) — bsums[64]: row-group-ordered with granularity 4 i16 per row
//
// qs layout (4-byte interleaving):
//   64 groups of 16 bytes (4 rows x 4 bytes).
//   Group g: dst[16 + g*16 + r*4 .. 16 + g*16 + r*4 + 3] = row_r_qs[g*4..g*4+3]
//   A 16-byte load gives [row0 4B][row1 4B][row2 4B][row3 4B] — perfect
//   for vdot_lane_i32 where each lane selects one row's 4 bytes.
//
// bsums layout unchanged.
//
// SIMD strategy:
//   - Deltas: one f32x4 load + store per super-block.
//   - qs: 4-byte-granular interleave via *i32 pointer subscripts.
//   - bsums: 64-bit pattern via *i64 subscripts.

#[cfg(aarch64)]

// Copy the 4 row deltas for super-block b.
// row_d points to f32[nb*4]: row_d[b*4 + r] is row r's delta for super-block b.
// One f32x4 SIMD load+store.
func copy_deltas(
    row_d: *restrict f32,
    dst_f32: *mut f32,
    b: i32
) {
    let src_idx: i32 = b * 4
    let dst_idx: i32 = b * 292  // 1168 / 4 = 292 f32 per super-block
    let v: f32x4 = load(row_d, src_idx)
    store(dst_f32, dst_idx, v)
}

export func q8k_repack_4(
    row0_qs:    *restrict i8,
    row1_qs:    *restrict i8,
    row2_qs:    *restrict i8,
    row3_qs:    *restrict i8,
    row_d:      *restrict f32,
    row0_bsums: *restrict i16,
    row1_bsums: *restrict i16,
    row2_bsums: *restrict i16,
    row3_bsums: *restrict i16,
    dst:        *mut u8,
    nb:         i32
) {
    // Typed views onto dst for the three output sections.
    let dst_f32: *mut f32 = ptr_as_f32(dst)
    let dst_i32: *mut i32 = ptr_as_i32(dst)
    let dst_i64: *mut i64 = ptr_as_i64(dst)
    let dst_i16: *mut i16 = ptr_as_i16(dst)

    // Typed views onto the 4 per-row qs inputs as i32* for 4-byte copies.
    let row0_qs32: *restrict i32 = ptr_as_i32(row0_qs)
    let row1_qs32: *restrict i32 = ptr_as_i32(row1_qs)
    let row2_qs32: *restrict i32 = ptr_as_i32(row2_qs)
    let row3_qs32: *restrict i32 = ptr_as_i32(row3_qs)

    // Super-block strides in various unit sizes.
    let super_block_i32: i32 = 292       // 1168 / 4
    let super_block_i64: i32 = 146       // 1168 / 8
    let qs_i32_off:      i32 = 4         // 16   / 4 — byte offset of qs within block
    let bsums_i64_off:   i32 = 130       // 1040 / 8 — byte offset of bsums within block

    let mut b: i32 = 0
    while b < nb {
        // ── Section 1: deltas (16 B, one f32x4 SIMD store) ───────────
        copy_deltas(row_d, dst_f32, b)

        // ── Section 2: qs[1024] 4-row interleave ──
        // 4-byte interleaving: 64 groups of 16 bytes (4 rows x 4 bytes).
        // Group g: dst_i32[base + g*4 + r] = rowN_qs32[b*64 + g]
        let qs_b_dst: i32 = b * super_block_i32 + qs_i32_off

        let mut g: i32 = 0
        while g < 64 {
            let src_idx: i32 = b * 64 + g
            let dst_base: i32 = qs_b_dst + g * 4
            dst_i32[dst_base]     = row0_qs32[src_idx]
            dst_i32[dst_base + 1] = row1_qs32[src_idx]
            dst_i32[dst_base + 2] = row2_qs32[src_idx]
            dst_i32[dst_base + 3] = row3_qs32[src_idx]
            g = g + 1
        }

        // ── Section 3: bsums[64] — row-group interleave ──────────────
        // For each sb_iter ∈ 0..4 and each row r ∈ 0..4, copy 4 i16
        // (2 sub-blocks × 2 halves) as one 8-byte (4-i16) transfer.
        //
        // Source i16 index (per row): sb_iter * 4 + {0,1,2,3}
        // Dest i16 index (inside bsums[64]):
        //   sb_iter*16 + (r/2)*8 + (r%2)*4 + {0,1,2,3}
        //
        // Each copy is a 4-i16 = 8-byte transfer via *i64 pointer subscripts.
        // We use i64 views for 8-byte transfers. Each 4-i16 group is 8 bytes
        // = 1 i64 element. The i16 pointer offsets must be aligned to 4-i16
        // (8-byte) granularity — by construction they are: sb_iter*16 is
        // always a multiple of 4, (r/2)*8 + (r%2)*4 ∈ {0,4,8,12}.
        let row0_b64: *restrict i64 = ptr_as_i64(ptr_as_i8(row0_bsums))
        let row1_b64: *restrict i64 = ptr_as_i64(ptr_as_i8(row1_bsums))
        let row2_b64: *restrict i64 = ptr_as_i64(ptr_as_i8(row2_bsums))
        let row3_b64: *restrict i64 = ptr_as_i64(ptr_as_i8(row3_bsums))
        let dst_b64:  *mut i64      = ptr_as_i64(ptr_as_i8(dst_i16))

        // In i64 units (divide i16 index by 4):
        //   source per row: sb_iter * 1 (4 i16 = 1 i64)
        //   dst per-sb_iter stride: 16 i16 / 4 = 4 i64
        //   dst per-row offset inside sb_iter: {0,1,2,3} i64 (0/4/8/12 i16)
        let bs_b_dst_i64: i32 = b * super_block_i64 + bsums_i64_off

        let bs_src_base: i32 = b * 4
        let mut si: i32 = 0
        while si < 4 {
            let dst_base_i64: i32 = bs_b_dst_i64 + si * 4
            dst_b64[dst_base_i64    ] = row0_b64[bs_src_base + si]
            dst_b64[dst_base_i64 + 1] = row1_b64[bs_src_base + si]
            dst_b64[dst_base_i64 + 2] = row2_b64[bs_src_base + si]
            dst_b64[dst_base_i64 + 3] = row3_b64[bs_src_base + si]
            si = si + 1
        }

        b = b + 1
    }
}
