// silu_mul.ea — Fused SiLU(gate) * up (x86 AVX2)
//
// out[i] = gate[i] * sigmoid(gate[i]) * up[i]
// sigmoid(g) = 1 / (1 + exp(-g))

#[cfg(x86_64)]

export func silu_mul_f32(gate: *restrict f32, up: *restrict f32, out: *mut f32, n: i32) {
    let one: f32x8 = splat(1.0)
    let zero: f32x8 = splat(0.0)
    let mut i: i32 = 0

    while i + 8 <= n {
        let g: f32x8 = load_f32x8(gate, i)
        let u: f32x8 = load_f32x8(up, i)
        let neg_g: f32x8 = zero .- g
        let exp_neg: f32x8 = exp(neg_g)
        let sig: f32x8 = one ./ (one .+ exp_neg)
        store(out, i, g .* sig .* u)
        i = i + 8
    }

    while i < n {
        let g: f32 = gate[i]
        let exp_neg: f32 = exp(0.0 - g)
        let sig: f32 = 1.0 / (1.0 + exp_neg)
        out[i] = g * sig * up[i]
        i = i + 1
    }
}
