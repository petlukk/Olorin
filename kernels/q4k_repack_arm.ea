// q4k_repack.ea — Repack standard Q4K blocks into 8-row interleaved layout.
//
// Matches llama.cpp make_block_q4_Kx8() with blck_size_interleave=8.
// Source: llama.cpp/ggml/src/ggml-cpu/repack.cpp:2836-2911.
//
// All operations are SIMD: byte copies via vector load/store,
// scale repacking via vector bit ops + pack_usat for u8 narrowing.

#[cfg(aarch64)]

// Copy d[0..7] and dmin[0..7] from 8 source blocks.
// Each source block has d at +0 (2 bytes), dmin at +2 (2 bytes).
// Output: d[0..7] at dst+d, dmin[0..7] at dst+d+16.
func copy_d_dmin(
    src: *restrict u8, dst: *mut u8, d: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    r4: i32, r5: i32, r6: i32, r7: i32
) {
    let d16s: *restrict i16 = ptr_as_i16(ptr_as_i8(src))
    let d16d: *mut i16 = ptr_as_i16(ptr_as_i8(dst))
    // d values: read f16 (2 bytes) from offset 0 of each block
    d16d[d / 2]     = d16s[r0 / 2]
    d16d[d / 2 + 1] = d16s[r1 / 2]
    d16d[d / 2 + 2] = d16s[r2 / 2]
    d16d[d / 2 + 3] = d16s[r3 / 2]
    d16d[d / 2 + 4] = d16s[r4 / 2]
    d16d[d / 2 + 5] = d16s[r5 / 2]
    d16d[d / 2 + 6] = d16s[r6 / 2]
    d16d[d / 2 + 7] = d16s[r7 / 2]
    // dmin values: read f16 from offset 2 of each block
    d16d[d / 2 + 8]  = d16s[r0 / 2 + 1]
    d16d[d / 2 + 9]  = d16s[r1 / 2 + 1]
    d16d[d / 2 + 10] = d16s[r2 / 2 + 1]
    d16d[d / 2 + 11] = d16s[r3 / 2 + 1]
    d16d[d / 2 + 12] = d16s[r4 / 2 + 1]
    d16d[d / 2 + 13] = d16s[r5 / 2 + 1]
    d16d[d / 2 + 14] = d16s[r6 / 2 + 1]
    d16d[d / 2 + 15] = d16s[r7 / 2 + 1]
}

// Interleave quants from 8 source blocks in 4-byte chunks via i32 load/store.
// Source quants: offset 16..143 in each 144-byte block (128 bytes per block).
// Output: 1024 bytes at dst+d+128, round-robin 4 bytes per row.
// 32 groups × 32 bytes (8 rows × 4 bytes) = 1024 bytes total.
func interleave_quants(
    src: *restrict u8, dst: *mut u8, d: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    r4: i32, r5: i32, r6: i32, r7: i32
) {
    let s32: *restrict i32 = ptr_as_i32(ptr_as_i8(src))
    let d32: *mut i32 = ptr_as_i32(ptr_as_i8(dst))
    let mut c: i32 = 0
    while c < 32 {
        let dq: i32 = (d + 128 + c * 32) / 4
        d32[dq]     = s32[(r0 + 16 + c * 4) / 4]
        d32[dq + 1] = s32[(r1 + 16 + c * 4) / 4]
        d32[dq + 2] = s32[(r2 + 16 + c * 4) / 4]
        d32[dq + 3] = s32[(r3 + 16 + c * 4) / 4]
        d32[dq + 4] = s32[(r4 + 16 + c * 4) / 4]
        d32[dq + 5] = s32[(r5 + 16 + c * 4) / 4]
        d32[dq + 6] = s32[(r6 + 16 + c * 4) / 4]
        d32[dq + 7] = s32[(r7 + 16 + c * 4) / 4]
        c = c + 1
    }
}

// Repack 6-bit scales: sub-blocks 0..3 (lower bits).
// Reads scales[sb] and scales[sb+4] from each of 8 source blocks,
// packs into 12 bytes per sub-block in the output.
// Uses i16 vectors + pack_usat for u8 narrowing.
func repack_scales_lo(
    src: *restrict u8, dst: *mut u8, d: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    r4: i32, r5: i32, r6: i32, r7: i32
) {
    let mut sb: i32 = 0
    while sb < 4 {
        // Read 6-bit scales from scales[sb] of each block (offset 4+sb)
        let s0: i16 = to_i16(to_i32(src[r0 + 4 + sb]) & 63)
        let s1: i16 = to_i16(to_i32(src[r1 + 4 + sb]) & 63)
        let s2: i16 = to_i16(to_i32(src[r2 + 4 + sb]) & 63)
        let s3: i16 = to_i16(to_i32(src[r3 + 4 + sb]) & 63)
        let s4: i16 = to_i16(to_i32(src[r4 + 4 + sb]) & 63)
        let s5: i16 = to_i16(to_i32(src[r5 + 4 + sb]) & 63)
        let s6: i16 = to_i16(to_i32(src[r6 + 4 + sb]) & 63)
        let s7: i16 = to_i16(to_i32(src[r7 + 4 + sb]) & 63)
        // Read 6-bit mins from scales[sb+4] of each block (offset 8+sb)
        let m0: i16 = to_i16(to_i32(src[r0 + 8 + sb]) & 63)
        let m1: i16 = to_i16(to_i32(src[r1 + 8 + sb]) & 63)
        let m2: i16 = to_i16(to_i32(src[r2 + 8 + sb]) & 63)
        let m3: i16 = to_i16(to_i32(src[r3 + 8 + sb]) & 63)
        let m4: i16 = to_i16(to_i32(src[r4 + 8 + sb]) & 63)
        let m5: i16 = to_i16(to_i32(src[r5 + 8 + sb]) & 63)
        let m6: i16 = to_i16(to_i32(src[r6 + 8 + sb]) & 63)
        let m7: i16 = to_i16(to_i32(src[r7 + 8 + sb]) & 63)

        // Pack into 12 output bytes:
        // [0..3]: s[0..3] low6 | s[4..7] high2
        // [4..7]: m[0..3] low6 | m[4..7] high2
        // [8..11]: s[4..7] low4 | m[4..7] low4
        let out_scales: i16x8 = [
            s0 + ((s4 & to_i16(48)) << 2),
            s1 + ((s5 & to_i16(48)) << 2),
            s2 + ((s6 & to_i16(48)) << 2),
            s3 + ((s7 & to_i16(48)) << 2),
            m0 + ((m4 & to_i16(48)) << 2),
            m1 + ((m5 & to_i16(48)) << 2),
            m2 + ((m6 & to_i16(48)) << 2),
            m3 + ((m7 & to_i16(48)) << 2)
        ]
        let out_extra: i16x8 = [
            (s4 & to_i16(15)) + ((m4 & to_i16(15)) << 4),
            (s5 & to_i16(15)) + ((m5 & to_i16(15)) << 4),
            (s6 & to_i16(15)) + ((m6 & to_i16(15)) << 4),
            (s7 & to_i16(15)) + ((m7 & to_i16(15)) << 4),
            to_i16(0), to_i16(0), to_i16(0), to_i16(0)
        ]
        // Narrow i16x8 → u8x16 via saturating pack (values are 0..255, no saturation)
        let packed: u8x16 = pack_usat_i16x8(out_scales, out_extra)
        // pack_usat_i16x8 interleaves: [a0..a7, b0..b7] → but we need [a0..a7, b0..b3]
        // Store first 12 bytes
        let o: i32 = d + 32 + sb * 12
        // Store as individual bytes from the packed vector
        dst[o]      = packed[0]
        dst[o + 1]  = packed[1]
        dst[o + 2]  = packed[2]
        dst[o + 3]  = packed[3]
        dst[o + 4]  = packed[4]
        dst[o + 5]  = packed[5]
        dst[o + 6]  = packed[6]
        dst[o + 7]  = packed[7]
        dst[o + 8]  = packed[8]
        dst[o + 9]  = packed[9]
        dst[o + 10] = packed[10]
        dst[o + 11] = packed[11]
        sb = sb + 1
    }
}

// Repack 6-bit scales: sub-blocks 4..7 (upper bits from scales[0..3] + scales[8..11]).
func repack_scales_hi(
    src: *restrict u8, dst: *mut u8, d: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    r4: i32, r5: i32, r6: i32, r7: i32
) {
    let mut sb: i32 = 0
    while sb < 4 {
        // Upper bits: ((scales[sb] & 0xC0) >> 2) | (scales[sb+8] & 0x0F)
        let s0: i16 = to_i16(((to_i32(src[r0 + 4 + sb]) & 192) >> 2) | (to_i32(src[r0 + 12 + sb]) & 15))
        let s1: i16 = to_i16(((to_i32(src[r1 + 4 + sb]) & 192) >> 2) | (to_i32(src[r1 + 12 + sb]) & 15))
        let s2: i16 = to_i16(((to_i32(src[r2 + 4 + sb]) & 192) >> 2) | (to_i32(src[r2 + 12 + sb]) & 15))
        let s3: i16 = to_i16(((to_i32(src[r3 + 4 + sb]) & 192) >> 2) | (to_i32(src[r3 + 12 + sb]) & 15))
        let s4: i16 = to_i16(((to_i32(src[r4 + 4 + sb]) & 192) >> 2) | (to_i32(src[r4 + 12 + sb]) & 15))
        let s5: i16 = to_i16(((to_i32(src[r5 + 4 + sb]) & 192) >> 2) | (to_i32(src[r5 + 12 + sb]) & 15))
        let s6: i16 = to_i16(((to_i32(src[r6 + 4 + sb]) & 192) >> 2) | (to_i32(src[r6 + 12 + sb]) & 15))
        let s7: i16 = to_i16(((to_i32(src[r7 + 4 + sb]) & 192) >> 2) | (to_i32(src[r7 + 12 + sb]) & 15))
        // Mins upper: ((scales[sb+4] & 0xC0) >> 2) | ((scales[sb+8] & 0xF0) >> 4)
        let m0: i16 = to_i16(((to_i32(src[r0 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r0 + 12 + sb]) & 240) >> 4))
        let m1: i16 = to_i16(((to_i32(src[r1 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r1 + 12 + sb]) & 240) >> 4))
        let m2: i16 = to_i16(((to_i32(src[r2 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r2 + 12 + sb]) & 240) >> 4))
        let m3: i16 = to_i16(((to_i32(src[r3 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r3 + 12 + sb]) & 240) >> 4))
        let m4: i16 = to_i16(((to_i32(src[r4 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r4 + 12 + sb]) & 240) >> 4))
        let m5: i16 = to_i16(((to_i32(src[r5 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r5 + 12 + sb]) & 240) >> 4))
        let m6: i16 = to_i16(((to_i32(src[r6 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r6 + 12 + sb]) & 240) >> 4))
        let m7: i16 = to_i16(((to_i32(src[r7 + 8 + sb]) & 192) >> 2) | ((to_i32(src[r7 + 12 + sb]) & 240) >> 4))

        let out_scales: i16x8 = [
            s0 + ((s4 & to_i16(48)) << 2),
            s1 + ((s5 & to_i16(48)) << 2),
            s2 + ((s6 & to_i16(48)) << 2),
            s3 + ((s7 & to_i16(48)) << 2),
            m0 + ((m4 & to_i16(48)) << 2),
            m1 + ((m5 & to_i16(48)) << 2),
            m2 + ((m6 & to_i16(48)) << 2),
            m3 + ((m7 & to_i16(48)) << 2)
        ]
        let out_extra: i16x8 = [
            (s4 & to_i16(15)) + ((m4 & to_i16(15)) << 4),
            (s5 & to_i16(15)) + ((m5 & to_i16(15)) << 4),
            (s6 & to_i16(15)) + ((m6 & to_i16(15)) << 4),
            (s7 & to_i16(15)) + ((m7 & to_i16(15)) << 4),
            to_i16(0), to_i16(0), to_i16(0), to_i16(0)
        ]
        let packed: u8x16 = pack_usat_i16x8(out_scales, out_extra)
        let o: i32 = d + 32 + (sb + 4) * 12
        dst[o]      = packed[0]
        dst[o + 1]  = packed[1]
        dst[o + 2]  = packed[2]
        dst[o + 3]  = packed[3]
        dst[o + 4]  = packed[4]
        dst[o + 5]  = packed[5]
        dst[o + 6]  = packed[6]
        dst[o + 7]  = packed[7]
        dst[o + 8]  = packed[8]
        dst[o + 9]  = packed[9]
        dst[o + 10] = packed[10]
        dst[o + 11] = packed[11]
        sb = sb + 1
    }
}

export func q4k_repack_8x8(
    src: *restrict u8, dst: *mut u8,
    n_rows: i32, n_cols: i32
) {
    let nb: i32 = n_cols / 256
    let rb: i32 = nb * 144

    let mut tile: i32 = 0
    while tile < n_rows / 8 {
        let base: i32 = tile * 8 * rb
        let mut blk: i32 = 0
        while blk < nb {
            let s: i32 = base + blk * 144
            let d: i32 = (tile * nb + blk) * 1152
            let r0: i32 = s
            let r1: i32 = s + rb
            let r2: i32 = s + 2 * rb
            let r3: i32 = s + 3 * rb
            let r4: i32 = s + 4 * rb
            let r5: i32 = s + 5 * rb
            let r6: i32 = s + 6 * rb
            let r7: i32 = s + 7 * rb
            copy_d_dmin(src, dst, d, r0, r1, r2, r3, r4, r5, r6, r7)
            interleave_quants(src, dst, d, r0, r1, r2, r3, r4, r5, r6, r7)
            repack_scales_lo(src, dst, d, r0, r1, r2, r3, r4, r5, r6, r7)
            repack_scales_hi(src, dst, d, r0, r1, r2, r3, r4, r5, r6, r7)
            blk = blk + 1
        }
        tile = tile + 1
    }
}
