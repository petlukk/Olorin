// softmax_arm.ea — In-place scaled softmax (ARM NEON)
//
// Uses LLVM exp intrinsic (llvm.exp.v4f32) for correct SIMD exp.
// 1. Scale, 2. Find max, 3. Subtract max + exp, 4. Sum, 5. Normalize

#[cfg(aarch64)]

export func softmax_f32(data: *mut f32, n: i32, scale: f32) {
    // Pass 1: Scale and find max
    let v_scale: f32x4 = splat(scale)
    let mut v_max: f32x4 = splat(-1000000.0)
    let mut i: i32 = 0

    while i + 4 <= n {
        let v: f32x4 = load(data, i) .* v_scale
        store(data, i, v)
        v_max = max(v_max, v)
        i = i + 4
    }

    let mut m: f32 = reduce_max(v_max)
    while i < n {
        data[i] = data[i] * scale
        if data[i] > m { m = data[i] }
        i = i + 1
    }

    // Pass 2: Subtract max, exp, accumulate sum
    let v_m: f32x4 = splat(m)
    let mut v_sum: f32x4 = splat(0.0)
    i = 0

    while i + 4 <= n {
        let e: f32x4 = exp(load(data, i) .- v_m)
        store(data, i, e)
        v_sum = v_sum .+ e
        i = i + 4
    }

    let mut s: f32 = reduce_add(v_sum)

    // Tail: overlap-load last 4 for SIMD exp
    if i < n {
        if n >= 4 {
            let tail_off: i32 = n - 4
            let e: f32x4 = exp(load(data, tail_off) .- v_m)
            store(data, tail_off, e)
            let mut j: i32 = i
            while j < n {
                s = s + data[j]
                j = j + 1
            }
        } else {
            // n < 4: first decode step (seq_len 1..3)
            while i < n {
                let v: f32 = data[i] - m
                data[i] = exp(v)
                s = s + data[i]
                i = i + 1
            }
        }
    }

    // Pass 3: Normalize
    let inv_s: f32 = 1.0 / s
    let v_inv: f32x4 = splat(inv_s)
    i = 0

    while i + 4 <= n {
        store(data, i, load(data, i) .* v_inv)
        i = i + 4
    }
    while i < n {
        data[i] = data[i] * inv_s
        i = i + 1
    }
}
