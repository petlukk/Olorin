// Output guard — scans model output for discipline violations.
//
// Detects blocklist words, math expressions, excess length, and multi-line
// output. Returns an action code and offset for the caller to act on.
//
// Action IDs:
//   0 = PASS
//   1 = TRUNCATE_LINE (truncate at offset)
//   2 = REDIRECT_CALC (math expression detected)
//   3 = BLOCK (blocklist word found)

func to_lower(b: i32) -> i32 {
    if b >= 65 {
        if b <= 90 {
            return b + 32
        }
    }
    return b
}

export func guard_output(text: *u8, len: i32, max_len: i32, out_action: *mut i32, out_offset: *mut i32) {
    out_action[0] = 0
    out_offset[0] = 0

    if len < 1 {
        return
    }

    // --- 1. Length guard ---
    if len > max_len {
        // Find last space before max_len for word boundary truncation
        let mut trunc: i32 = max_len
        let mut j: i32 = max_len - 1
        while j >= 0 {
            if to_i32(text[j]) == 32 {
                trunc = j
                j = -1
            }
            j = j - 1
        }
        out_action[0] = 1
        out_offset[0] = trunc
        return
    }

    // --- 2. Find first newline ---
    let mut first_nl: i32 = -1
    let mut i: i32 = 0
    while i < len {
        if to_i32(text[i]) == 10 {
            if first_nl == -1 {
                first_nl = i
            }
        }
        i = i + 1
    }

    // --- 3. Blocklist scan (case-insensitive) ---
    let mut k: i32 = 0
    while k < len {
        // "```" — three backticks (byte 96)
        if k + 3 <= len {
            if to_i32(text[k]) == 96 {
                if to_i32(text[k + 1]) == 96 {
                    if to_i32(text[k + 2]) == 96 {
                        out_action[0] = 3
                        out_offset[0] = k
                        return
                    }
                }
            }
        }

        // "python" — p(112) y(121) t(116) h(104) o(111) n(110)
        if k + 6 <= len {
            if to_lower(to_i32(text[k])) == 112 {
                if to_lower(to_i32(text[k + 1])) == 121 {
                    if to_lower(to_i32(text[k + 2])) == 116 {
                        if to_lower(to_i32(text[k + 3])) == 104 {
                            if to_lower(to_i32(text[k + 4])) == 111 {
                                if to_lower(to_i32(text[k + 5])) == 110 {
                                    out_action[0] = 3
                                    out_offset[0] = k
                                    return
                                }
                            }
                        }
                    }
                }
            }
        }

        // "step N" — s(115) t(116) e(101) p(112) space(32) digit(49-57)
        if k + 6 <= len {
            if to_lower(to_i32(text[k])) == 115 {
                if to_lower(to_i32(text[k + 1])) == 116 {
                    if to_lower(to_i32(text[k + 2])) == 101 {
                        if to_lower(to_i32(text[k + 3])) == 112 {
                            if to_i32(text[k + 4]) == 32 {
                                let d: i32 = to_i32(text[k + 5])
                                if d >= 49 {
                                    if d <= 57 {
                                        out_action[0] = 3
                                        out_offset[0] = k
                                        return
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // "example" — e(101) x(120) a(97) m(109) p(112) l(108) e(101)
        if k + 7 <= len {
            if to_lower(to_i32(text[k])) == 101 {
                if to_lower(to_i32(text[k + 1])) == 120 {
                    if to_lower(to_i32(text[k + 2])) == 97 {
                        if to_lower(to_i32(text[k + 3])) == 109 {
                            if to_lower(to_i32(text[k + 4])) == 112 {
                                if to_lower(to_i32(text[k + 5])) == 108 {
                                    if to_lower(to_i32(text[k + 6])) == 101 {
                                        out_action[0] = 3
                                        out_offset[0] = k
                                        return
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        k = k + 1
    }

    // --- 4. Math redirect ---
    // State machine: digit(0->1) -> operator(1->2) -> digit(2->3) -> "="(3->MATCH)
    let mut state: i32 = 0
    i = 0
    while i < len {
        let b: i32 = to_i32(text[i])
        if state == 0 {
            if b >= 48 {
                if b <= 57 {
                    state = 1
                }
            }
        }
        if state == 1 {
            // operator: + - * / ^ %
            if b == 43 {
                state = 2
            }
            if b == 45 {
                state = 2
            }
            if b == 42 {
                state = 2
            }
            if b == 47 {
                state = 2
            }
            if b == 94 {
                state = 2
            }
            if b == 37 {
                state = 2
            }
        }
        if state == 2 {
            if b >= 48 {
                if b <= 57 {
                    state = 3
                }
            }
        }
        if state == 3 {
            if b == 61 {
                out_action[0] = 2
                out_offset[0] = i
                return
            }
        }
        i = i + 1
    }

    // --- 5. Multi-line truncation ---
    if first_nl >= 0 {
        // Check for non-whitespace content after first newline
        let mut m: i32 = first_nl + 1
        while m < len {
            let c: i32 = to_i32(text[m])
            // Not space(32), not tab(9), not newline(10), not CR(13)
            if c != 32 {
                if c != 9 {
                    if c != 10 {
                        if c != 13 {
                            out_action[0] = 1
                            out_offset[0] = first_nl
                            return
                        }
                    }
                }
            }
            m = m + 1
        }
    }

    // --- 6. Default: PASS ---
}
