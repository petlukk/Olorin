// q3k_repack.ea — Repack standard Q3K blocks into 8-row interleaved layout
// matched to q3k_dot_8x8_gemm_arm.ea's expected tile format.
//
// Q3K source block layout (110 B / 256 elements, scale-only — no min):
//   +   0.. 31  hmask[32]  one bit per element (256 bits, MSB of each q3)
//   +  32.. 95  qs[64]     low 2 bits per element (4 vals/byte at shifts 0,2,4,6)
//   +  96..107  scales[12] 16 sub-blocks × 6-bit scale, packed (kmask1/kmask2)
//   + 108..109  d (f16)    super-block scale
//
// Q3Kx8 tile output layout (1168 B per (8 rows × 256 cols)):
//   +   0..  15  8 × f16 d                                          (16 B)
//   +  16.. 143  16 sub-blocks × 8 rows × 1 byte signed scale      (128 B)
//                byte `16 + sb*8 + r` = signed scale for (sb, r), in [-32..31]
//   + 144..1167  8 sub-block-pairs × 128 bytes each                (1024 B)
//                pair sp covers Q3K sub-blocks {2*sp, 2*sp+1}; per-byte
//                low nibble = sub-block 2*sp's element value (4-bit signed
//                two's-complement, range [-4..3]), high nibble = sub-block
//                2*sp+1's element value. Per pair: 4 chunks × 32 B; per
//                chunk: 16 B for rows 0..3 + 16 B for rows 4..7; per row:
//                4 bytes covering 4 element-positions within the sub-block.
//
// SAFETY: Q3K's 110-byte block stride is not divisible by 4, so aligned i32
// reads of scales[] silently truncate for blocks past the first. This kernel
// uses byte-by-byte access throughout — same discipline as q3k_dot_arm.ea.
// Repack happens once at load, so per-element scalar work is acceptable.

#[cfg(x86_64)]

func ubyte(p: *restrict u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

// Read u32 from 4 unaligned bytes (Q3K's 110 B stride forces this).
func read_u32(p: *restrict u8, off: i32) -> i32 {
    return ubyte(p, off) | (ubyte(p, off + 1) << 8)
         | (ubyte(p, off + 2) << 16) | (ubyte(p, off + 3) << 24)
}

// Copy 8 × f16 d values from src[blk_offsets[r] + 108..109] to dst[d..d+15].
func copy_d(
    src: *restrict u8, dst: *mut u8, d: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    r4: i32, r5: i32, r6: i32, r7: i32
) {
    dst[d + 0]  = src[r0 + 108]
    dst[d + 1]  = src[r0 + 109]
    dst[d + 2]  = src[r1 + 108]
    dst[d + 3]  = src[r1 + 109]
    dst[d + 4]  = src[r2 + 108]
    dst[d + 5]  = src[r2 + 109]
    dst[d + 6]  = src[r3 + 108]
    dst[d + 7]  = src[r3 + 109]
    dst[d + 8]  = src[r4 + 108]
    dst[d + 9]  = src[r4 + 109]
    dst[d + 10] = src[r5 + 108]
    dst[d + 11] = src[r5 + 109]
    dst[d + 12] = src[r6 + 108]
    dst[d + 13] = src[r6 + 109]
    dst[d + 14] = src[r7 + 108]
    dst[d + 15] = src[r7 + 109]
}

// Unpack 16 signed scales [-32..31] from one Q3K block at blk_off into
// dst[d + 16 + sb*8 + row] for sb ∈ 0..15.
// Mirrors the kmask1/kmask2 6-bit scheme from q3k_dot_arm.ea / llama.cpp.
func unpack_scales_one_row(
    src: *restrict u8, dst: *mut u8, d: i32,
    blk_off: i32, row: i32
) {
    let a0: i32 = read_u32(src, blk_off + 96)
    let a1: i32 = read_u32(src, blk_off + 100)
    let a2: i32 = read_u32(src, blk_off + 104)
    let kmask1: i32 = 0x03030303
    let kmask2: i32 = 0x0f0f0f0f
    let u0: i32 =  (a0       & kmask2) | (((a2 >> 0) & kmask1) << 4)  // scales 0..3
    let u1: i32 =  (a1       & kmask2) | (((a2 >> 2) & kmask1) << 4)  // scales 4..7
    let u2: i32 = ((a0 >> 4) & kmask2) | (((a2 >> 4) & kmask1) << 4)  // scales 8..11
    let u3: i32 = ((a1 >> 4) & kmask2) | (((a2 >> 6) & kmask1) << 4)  // scales 12..15

    // Build 16 signed scales as a packed i8x16 via a pair of saturating narrows
    // (i32x4 → i16x8 → i8x16). Values are guaranteed in [-32..31], well within
    // i8 range [-128..127], so pack_sat does not clip. The dst byte locations
    // are strided (sub-block-major: stride 8 bytes between successive subs for
    // the same row), so individual byte writes via the i8x16 lanes are needed.
    let v0: i32x4 = [
        ( u0        & 255) - 32,
        ((u0 >>  8) & 255) - 32,
        ((u0 >> 16) & 255) - 32,
        ((u0 >> 24) & 255) - 32
    ]
    let v1: i32x4 = [
        ( u1        & 255) - 32,
        ((u1 >>  8) & 255) - 32,
        ((u1 >> 16) & 255) - 32,
        ((u1 >> 24) & 255) - 32
    ]
    let v2: i32x4 = [
        ( u2        & 255) - 32,
        ((u2 >>  8) & 255) - 32,
        ((u2 >> 16) & 255) - 32,
        ((u2 >> 24) & 255) - 32
    ]
    let v3: i32x4 = [
        ( u3        & 255) - 32,
        ((u3 >>  8) & 255) - 32,
        ((u3 >> 16) & 255) - 32,
        ((u3 >> 24) & 255) - 32
    ]
    let lo: i16x8 = pack_sat_i32x4(v0, v1)
    let hi: i16x8 = pack_sat_i32x4(v2, v3)
    let scales: i8x16 = pack_sat_i16x8(lo, hi)

    // Store one byte per sub-block at sub-block-major offsets.
    let dst_i8: *mut i8 = ptr_as_i8(dst)
    let base: i32 = d + 16 + row
    dst_i8[base +  0 * 8] = scales[0]
    dst_i8[base +  1 * 8] = scales[1]
    dst_i8[base +  2 * 8] = scales[2]
    dst_i8[base +  3 * 8] = scales[3]
    dst_i8[base +  4 * 8] = scales[4]
    dst_i8[base +  5 * 8] = scales[5]
    dst_i8[base +  6 * 8] = scales[6]
    dst_i8[base +  7 * 8] = scales[7]
    dst_i8[base +  8 * 8] = scales[8]
    dst_i8[base +  9 * 8] = scales[9]
    dst_i8[base + 10 * 8] = scales[10]
    dst_i8[base + 11 * 8] = scales[11]
    dst_i8[base + 12 * 8] = scales[12]
    dst_i8[base + 13 * 8] = scales[13]
    dst_i8[base + 14 * 8] = scales[14]
    dst_i8[base + 15 * 8] = scales[15]
}

// Repack one row's quants for one sub-block-pair sp at chunk k.
// Pair sp covers Q3K sub-blocks {2*sp, 2*sp+1}, both sharing shift/mbit but
// reading from different qs/hmask byte sub-halves (offset 0 vs 16).
// Within sub-block, element-position pos ∈ 0..15 advances by k * 4 across chunks.
func repack_chunk_one_row(
    src: *restrict u8, dst: *mut u8,
    blk_off: i32, dst_byte_base: i32,
    sp: i32, k: i32
) {
    let sh: i32 = (sp % 4) * 2     // shift within qs byte: 0, 2, 4, 6
    let mb: i32 = sp                // hmask bit index: 0..7
    let j_off: i32 = (sp / 4) * 32  // qs main-half offset: 0 (sb 0..7) or 32 (sb 8..15)

    // Per-element pos within sub-block for this chunk (k*4 .. k*4+3)
    let pos0: i32 = k * 4
    let pos1: i32 = k * 4 + 1
    let pos2: i32 = k * 4 + 2
    let pos3: i32 = k * 4 + 3

    // Sub-block 2*sp uses qs[j_off..j_off+15] and hmask[0..15].
    // Sub-block 2*sp+1 uses qs[j_off+16..j_off+31] and hmask[16..31].
    let qs_lo_base: i32 = blk_off + 32 + j_off
    let qs_hi_base: i32 = blk_off + 32 + j_off + 16
    let hm_lo_base: i32 = blk_off
    let hm_hi_base: i32 = blk_off + 16

    // Decode sub-block 2*sp's element at pos i: q3_unsigned ∈ [0..7] then -4.
    let qs_lo_0: i32 = (ubyte(src, qs_lo_base + pos0) >> sh) & 3
    let qs_lo_1: i32 = (ubyte(src, qs_lo_base + pos1) >> sh) & 3
    let qs_lo_2: i32 = (ubyte(src, qs_lo_base + pos2) >> sh) & 3
    let qs_lo_3: i32 = (ubyte(src, qs_lo_base + pos3) >> sh) & 3
    let hm_lo_0: i32 = (ubyte(src, hm_lo_base + pos0) >> mb) & 1
    let hm_lo_1: i32 = (ubyte(src, hm_lo_base + pos1) >> mb) & 1
    let hm_lo_2: i32 = (ubyte(src, hm_lo_base + pos2) >> mb) & 1
    let hm_lo_3: i32 = (ubyte(src, hm_lo_base + pos3) >> mb) & 1
    let n_lo_0: i32 = (qs_lo_0 | (hm_lo_0 << 2)) - 4
    let n_lo_1: i32 = (qs_lo_1 | (hm_lo_1 << 2)) - 4
    let n_lo_2: i32 = (qs_lo_2 | (hm_lo_2 << 2)) - 4
    let n_lo_3: i32 = (qs_lo_3 | (hm_lo_3 << 2)) - 4

    // Decode sub-block 2*sp+1's element at pos i.
    let qs_hi_0: i32 = (ubyte(src, qs_hi_base + pos0) >> sh) & 3
    let qs_hi_1: i32 = (ubyte(src, qs_hi_base + pos1) >> sh) & 3
    let qs_hi_2: i32 = (ubyte(src, qs_hi_base + pos2) >> sh) & 3
    let qs_hi_3: i32 = (ubyte(src, qs_hi_base + pos3) >> sh) & 3
    let hm_hi_0: i32 = (ubyte(src, hm_hi_base + pos0) >> mb) & 1
    let hm_hi_1: i32 = (ubyte(src, hm_hi_base + pos1) >> mb) & 1
    let hm_hi_2: i32 = (ubyte(src, hm_hi_base + pos2) >> mb) & 1
    let hm_hi_3: i32 = (ubyte(src, hm_hi_base + pos3) >> mb) & 1
    let n_hi_0: i32 = (qs_hi_0 | (hm_hi_0 << 2)) - 4
    let n_hi_1: i32 = (qs_hi_1 | (hm_hi_1 << 2)) - 4
    let n_hi_2: i32 = (qs_hi_2 | (hm_hi_2 << 2)) - 4
    let n_hi_3: i32 = (qs_hi_3 | (hm_hi_3 << 2)) - 4

    // Pack 4 bytes into one i32 (little-endian: byte 0 = low 8 bits) and store
    // via *mut i32 view. dst_byte_base is guaranteed 4-aligned (the layout
    // formula keeps each per-row 4-byte slot 4-aligned within the tile).
    // Two's-complement 4-bit per nibble: keep low 4 bits of each signed value.
    let b0: i32 = (n_lo_0 & 15) | ((n_hi_0 & 15) << 4)
    let b1: i32 = (n_lo_1 & 15) | ((n_hi_1 & 15) << 4)
    let b2: i32 = (n_lo_2 & 15) | ((n_hi_2 & 15) << 4)
    let b3: i32 = (n_lo_3 & 15) | ((n_hi_3 & 15) << 4)
    let packed: i32 = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    let dst_i32: *mut i32 = ptr_as_i32(ptr_as_i8(dst))
    dst_i32[dst_byte_base / 4] = packed
}

export func q3k_repack_8x8(
    src: *restrict u8, dst: *mut u8,
    n_rows: i32, n_cols: i32
) {
    let nb: i32 = n_cols / 256
    let rb: i32 = nb * 110  // bytes per row of Q3K source

    let mut tile: i32 = 0
    while tile < n_rows / 8 {
        let base: i32 = tile * 8 * rb
        let mut blk: i32 = 0
        while blk < nb {
            let r0: i32 = base + blk * 110
            let r1: i32 = r0 + rb
            let r2: i32 = r0 + 2 * rb
            let r3: i32 = r0 + 3 * rb
            let r4: i32 = r0 + 4 * rb
            let r5: i32 = r0 + 5 * rb
            let r6: i32 = r0 + 6 * rb
            let r7: i32 = r0 + 7 * rb
            let d: i32 = (tile * nb + blk) * 1168

            // 1) d (8 × f16)
            copy_d(src, dst, d, r0, r1, r2, r3, r4, r5, r6, r7)

            // 2) Per-row signed scales (16 sub-blocks × 8 rows = 128 B at d+16).
            unpack_scales_one_row(src, dst, d, r0, 0)
            unpack_scales_one_row(src, dst, d, r1, 1)
            unpack_scales_one_row(src, dst, d, r2, 2)
            unpack_scales_one_row(src, dst, d, r3, 3)
            unpack_scales_one_row(src, dst, d, r4, 4)
            unpack_scales_one_row(src, dst, d, r5, 5)
            unpack_scales_one_row(src, dst, d, r6, 6)
            unpack_scales_one_row(src, dst, d, r7, 7)

            // 3) Quants — 8 pairs × 4 chunks × 8 rows × 4 bytes/row = 1024 B at d+144.
            //    Per chunk: rows 0..3 in bytes [0..15], rows 4..7 in bytes [16..31].
            let mut sp: i32 = 0
            while sp < 8 {
                let mut k: i32 = 0
                while k < 4 {
                    let chunk_base: i32 = d + 144 + sp * 128 + k * 32
                    repack_chunk_one_row(src, dst, r0, chunk_base + 0 * 4,  sp, k)
                    repack_chunk_one_row(src, dst, r1, chunk_base + 1 * 4,  sp, k)
                    repack_chunk_one_row(src, dst, r2, chunk_base + 2 * 4,  sp, k)
                    repack_chunk_one_row(src, dst, r3, chunk_base + 3 * 4,  sp, k)
                    repack_chunk_one_row(src, dst, r4, chunk_base + 16 + 0 * 4, sp, k)
                    repack_chunk_one_row(src, dst, r5, chunk_base + 16 + 1 * 4, sp, k)
                    repack_chunk_one_row(src, dst, r6, chunk_base + 16 + 2 * 4, sp, k)
                    repack_chunk_one_row(src, dst, r7, chunk_base + 16 + 3 * 4, sp, k)
                    k = k + 1
                }
                sp = sp + 1
            }

            blk = blk + 1
        }
        tile = tile + 1
    }
}
