// bitnet_i8dot.ea — Tiled i8 dot product for quantized output projection (AVX2)
//
// Computes out[r] = dot(act_i8, weight_u8[r]) for 4 rows simultaneously.
// Uses madd_i16(ones, maddubs_i16(u8x32, i8x32)) for AVX2 SIMD accumulation.
// weight is stored as u8 (bias +128 applied during quantization).
// Caller corrects for bias and applies per-row scales after.

#[cfg(x86_64)]

// 4-row dot product: processes 32 bytes per iteration via AVX2.
export func i8dot_4row(
    act: *restrict i8,
    w0: *restrict u8,
    w1: *restrict u8,
    w2: *restrict u8,
    w3: *restrict u8,
    out scores: *mut i32 [cap: 4],
    n: i32
) {
    let mut r0: i32x8 = splat(0)
    let mut r1: i32x8 = splat(0)
    let mut r2: i32x8 = splat(0)
    let mut r3: i32x8 = splat(0)

    let ones: i16x16 = splat(1)
    let mut i: i32 = 0
    while i + 32 <= n {
        let a: i8x32 = load(act, i)
        let v0: u8x32 = load(w0, i)
        let v1: u8x32 = load(w1, i)
        let v2: u8x32 = load(w2, i)
        let v3: u8x32 = load(w3, i)
        r0 = r0 .+ madd_i16(ones, maddubs_i16(v0, a))
        r1 = r1 .+ madd_i16(ones, maddubs_i16(v1, a))
        r2 = r2 .+ madd_i16(ones, maddubs_i16(v2, a))
        r3 = r3 .+ madd_i16(ones, maddubs_i16(v3, a))
        i = i + 32
    }

    // Tail: remaining 16-byte block
    let mut t0: i32x4 = splat(0)
    let mut t1: i32x4 = splat(0)
    let mut t2: i32x4 = splat(0)
    let mut t3: i32x4 = splat(0)
    let ones_128: i16x8 = splat(1)
    while i + 16 <= n {
        let a: i8x16 = load(act, i)
        let v0t: u8x16 = load(w0, i)
        let v1t: u8x16 = load(w1, i)
        let v2t: u8x16 = load(w2, i)
        let v3t: u8x16 = load(w3, i)
        t0 = t0 .+ madd_i16(ones_128, maddubs_i16(v0t, a))
        t1 = t1 .+ madd_i16(ones_128, maddubs_i16(v1t, a))
        t2 = t2 .+ madd_i16(ones_128, maddubs_i16(v2t, a))
        t3 = t3 .+ madd_i16(ones_128, maddubs_i16(v3t, a))
        i = i + 16
    }

    scores[0] = reduce_add(r0) + reduce_add(t0)
    scores[1] = reduce_add(r1) + reduce_add(t1)
    scores[2] = reduce_add(r2) + reduce_add(t2)
    scores[3] = reduce_add(r3) + reduce_add(t3)
}

// Single-row dot product with AVX2.
export func i8dot_1row(
    act: *restrict i8,
    w: *restrict u8,
    n: i32
) -> i32 {
    let mut acc: i32x8 = splat(0)

    let ones: i16x16 = splat(1)
    let mut i: i32 = 0
    while i + 32 <= n {
        let wv: u8x32 = load(w, i)
        let av: i8x32 = load(act, i)
        acc = acc .+ madd_i16(ones, maddubs_i16(wv, av))
        i = i + 32
    }

    let mut tail: i32x4 = splat(0)
    let ones_128: i16x8 = splat(1)
    while i + 16 <= n {
        let wt: u8x16 = load(w, i)
        let at: i8x16 = load(act, i)
        tail = tail .+ madd_i16(ones_128, maddubs_i16(wt, at))
        i = i + 16
    }

    return reduce_add(acc) + reduce_add(tail)
}
