// ARM NEON fused V weighted sum: sum_t(weight[t] * dequant(V[t]))
//
// head_dim=128 = 2 Q4 groups per position, 32 f32x4 output accumulators.
// Each group's 64 values dequantized via shuffle+widen_u8_f32x4.

#[cfg(aarch64)]

export func q4_fused_v_sum_f32(
    weights:      *restrict f32,
    v_packed:     *restrict u8,
    v_scales:     *restrict f32,
    v_biases:     *restrict f32,
    out_vec:      *mut f32,
    seq_len:      i32,
    group_offset: i32
) {
    let mask15: u8x16 = splat(15)
    let shr4: u8x16 = splat(4)

    // 32 accumulators for 128 output floats
    let mut o00: f32x4 = splat(0.0)
    let mut o01: f32x4 = splat(0.0)
    let mut o02: f32x4 = splat(0.0)
    let mut o03: f32x4 = splat(0.0)
    let mut o04: f32x4 = splat(0.0)
    let mut o05: f32x4 = splat(0.0)
    let mut o06: f32x4 = splat(0.0)
    let mut o07: f32x4 = splat(0.0)
    let mut o08: f32x4 = splat(0.0)
    let mut o09: f32x4 = splat(0.0)
    let mut o10: f32x4 = splat(0.0)
    let mut o11: f32x4 = splat(0.0)
    let mut o12: f32x4 = splat(0.0)
    let mut o13: f32x4 = splat(0.0)
    let mut o14: f32x4 = splat(0.0)
    let mut o15: f32x4 = splat(0.0)
    let mut o16: f32x4 = splat(0.0)
    let mut o17: f32x4 = splat(0.0)
    let mut o18: f32x4 = splat(0.0)
    let mut o19: f32x4 = splat(0.0)
    let mut o20: f32x4 = splat(0.0)
    let mut o21: f32x4 = splat(0.0)
    let mut o22: f32x4 = splat(0.0)
    let mut o23: f32x4 = splat(0.0)
    let mut o24: f32x4 = splat(0.0)
    let mut o25: f32x4 = splat(0.0)
    let mut o26: f32x4 = splat(0.0)
    let mut o27: f32x4 = splat(0.0)
    let mut o28: f32x4 = splat(0.0)
    let mut o29: f32x4 = splat(0.0)
    let mut o30: f32x4 = splat(0.0)
    let mut o31: f32x4 = splat(0.0)

    let mut t: i32 = 0
    while t < seq_len {
        let vw: f32x4 = splat(weights[t])

        // Group 0: V dims [0..63]
        let g0: i32 = group_offset + t * 2
        let vs0: f32x4 = splat(v_scales[g0])
        let vb0: f32x4 = splat(v_biases[g0])
        let wb0: i32 = g0 * 32

        let p0: u8x16 = load(v_packed, wb0)
        let lo0: u8x16 = p0 .& mask15
        let hi0: u8x16 = p0 .>> shr4
        let p1: u8x16 = load(v_packed, wb0 + 16)
        let lo1: u8x16 = p1 .& mask15
        let hi1: u8x16 = p1 .>> shr4

        // lo0 -> V[0..15]
        o00 = fma(fma(widen_u8_f32x4(lo0), vs0, vb0), vw, o00)
        o01 = fma(fma(widen_u8_f32x4_4(lo0), vs0, vb0), vw, o01)
        o02 = fma(fma(widen_u8_f32x4_8(lo0), vs0, vb0), vw, o02)
        o03 = fma(fma(widen_u8_f32x4_12(lo0), vs0, vb0), vw, o03)

        // lo1 -> V[16..31]
        o04 = fma(fma(widen_u8_f32x4(lo1), vs0, vb0), vw, o04)
        o05 = fma(fma(widen_u8_f32x4_4(lo1), vs0, vb0), vw, o05)
        o06 = fma(fma(widen_u8_f32x4_8(lo1), vs0, vb0), vw, o06)
        o07 = fma(fma(widen_u8_f32x4_12(lo1), vs0, vb0), vw, o07)

        // hi0 -> V[32..47]
        o08 = fma(fma(widen_u8_f32x4(hi0), vs0, vb0), vw, o08)
        o09 = fma(fma(widen_u8_f32x4_4(hi0), vs0, vb0), vw, o09)
        o10 = fma(fma(widen_u8_f32x4_8(hi0), vs0, vb0), vw, o10)
        o11 = fma(fma(widen_u8_f32x4_12(hi0), vs0, vb0), vw, o11)

        // hi1 -> V[48..63]
        o12 = fma(fma(widen_u8_f32x4(hi1), vs0, vb0), vw, o12)
        o13 = fma(fma(widen_u8_f32x4_4(hi1), vs0, vb0), vw, o13)
        o14 = fma(fma(widen_u8_f32x4_8(hi1), vs0, vb0), vw, o14)
        o15 = fma(fma(widen_u8_f32x4_12(hi1), vs0, vb0), vw, o15)

        // Group 1: V dims [64..127]
        let g1: i32 = g0 + 1
        let vs1: f32x4 = splat(v_scales[g1])
        let vb1: f32x4 = splat(v_biases[g1])
        let wb1: i32 = g1 * 32

        let p2: u8x16 = load(v_packed, wb1)
        let lo2: u8x16 = p2 .& mask15
        let hi2: u8x16 = p2 .>> shr4
        let p3: u8x16 = load(v_packed, wb1 + 16)
        let lo3: u8x16 = p3 .& mask15
        let hi3: u8x16 = p3 .>> shr4

        // lo2 -> V[64..79]
        o16 = fma(fma(widen_u8_f32x4(lo2), vs1, vb1), vw, o16)
        o17 = fma(fma(widen_u8_f32x4_4(lo2), vs1, vb1), vw, o17)
        o18 = fma(fma(widen_u8_f32x4_8(lo2), vs1, vb1), vw, o18)
        o19 = fma(fma(widen_u8_f32x4_12(lo2), vs1, vb1), vw, o19)

        // lo3 -> V[80..95]
        o20 = fma(fma(widen_u8_f32x4(lo3), vs1, vb1), vw, o20)
        o21 = fma(fma(widen_u8_f32x4_4(lo3), vs1, vb1), vw, o21)
        o22 = fma(fma(widen_u8_f32x4_8(lo3), vs1, vb1), vw, o22)
        o23 = fma(fma(widen_u8_f32x4_12(lo3), vs1, vb1), vw, o23)

        // hi2 -> V[96..111]
        o24 = fma(fma(widen_u8_f32x4(hi2), vs1, vb1), vw, o24)
        o25 = fma(fma(widen_u8_f32x4_4(hi2), vs1, vb1), vw, o25)
        o26 = fma(fma(widen_u8_f32x4_8(hi2), vs1, vb1), vw, o26)
        o27 = fma(fma(widen_u8_f32x4_12(hi2), vs1, vb1), vw, o27)

        // hi3 -> V[112..127]
        o28 = fma(fma(widen_u8_f32x4(hi3), vs1, vb1), vw, o28)
        o29 = fma(fma(widen_u8_f32x4_4(hi3), vs1, vb1), vw, o29)
        o30 = fma(fma(widen_u8_f32x4_8(hi3), vs1, vb1), vw, o30)
        o31 = fma(fma(widen_u8_f32x4_12(hi3), vs1, vb1), vw, o31)

        t = t + 1
    }

    store(out_vec, 0, o00)
    store(out_vec, 4, o01)
    store(out_vec, 8, o02)
    store(out_vec, 12, o03)
    store(out_vec, 16, o04)
    store(out_vec, 20, o05)
    store(out_vec, 24, o06)
    store(out_vec, 28, o07)
    store(out_vec, 32, o08)
    store(out_vec, 36, o09)
    store(out_vec, 40, o10)
    store(out_vec, 44, o11)
    store(out_vec, 48, o12)
    store(out_vec, 52, o13)
    store(out_vec, 56, o14)
    store(out_vec, 60, o15)
    store(out_vec, 64, o16)
    store(out_vec, 68, o17)
    store(out_vec, 72, o18)
    store(out_vec, 76, o19)
    store(out_vec, 80, o20)
    store(out_vec, 84, o21)
    store(out_vec, 88, o22)
    store(out_vec, 92, o23)
    store(out_vec, 96, o24)
    store(out_vec, 100, o25)
    store(out_vec, 104, o26)
    store(out_vec, 108, o27)
    store(out_vec, 112, o28)
    store(out_vec, 116, o29)
    store(out_vec, 120, o30)
    store(out_vec, 124, o31)
}

// Multi-head variant
export func q4_fused_v_sum_multi_f32(
    all_weights:    *restrict f32,
    v_packed:       *restrict u8,
    v_scales:       *restrict f32,
    v_biases:       *restrict f32,
    all_out:        *mut f32,
    seq_len:        i32,
    n_heads:        i32,
    groups_per_head: i32
) {
    let mask15: u8x16 = splat(15)
    let shr4: u8x16 = splat(4)

    let mut h: i32 = 0
    while h < n_heads {
        let w_offset: i32 = h * seq_len
        let out_offset: i32 = h * 128
        let group_offset: i32 = h * groups_per_head

        let mut o00: f32x4 = splat(0.0)
        let mut o01: f32x4 = splat(0.0)
        let mut o02: f32x4 = splat(0.0)
        let mut o03: f32x4 = splat(0.0)
        let mut o04: f32x4 = splat(0.0)
        let mut o05: f32x4 = splat(0.0)
        let mut o06: f32x4 = splat(0.0)
        let mut o07: f32x4 = splat(0.0)
        let mut o08: f32x4 = splat(0.0)
        let mut o09: f32x4 = splat(0.0)
        let mut o10: f32x4 = splat(0.0)
        let mut o11: f32x4 = splat(0.0)
        let mut o12: f32x4 = splat(0.0)
        let mut o13: f32x4 = splat(0.0)
        let mut o14: f32x4 = splat(0.0)
        let mut o15: f32x4 = splat(0.0)
        let mut o16: f32x4 = splat(0.0)
        let mut o17: f32x4 = splat(0.0)
        let mut o18: f32x4 = splat(0.0)
        let mut o19: f32x4 = splat(0.0)
        let mut o20: f32x4 = splat(0.0)
        let mut o21: f32x4 = splat(0.0)
        let mut o22: f32x4 = splat(0.0)
        let mut o23: f32x4 = splat(0.0)
        let mut o24: f32x4 = splat(0.0)
        let mut o25: f32x4 = splat(0.0)
        let mut o26: f32x4 = splat(0.0)
        let mut o27: f32x4 = splat(0.0)
        let mut o28: f32x4 = splat(0.0)
        let mut o29: f32x4 = splat(0.0)
        let mut o30: f32x4 = splat(0.0)
        let mut o31: f32x4 = splat(0.0)

        let mut t: i32 = 0
        while t < seq_len {
            let vw: f32x4 = splat(all_weights[w_offset + t])

            let g0: i32 = group_offset + t * 2
            let vs0: f32x4 = splat(v_scales[g0])
            let vb0: f32x4 = splat(v_biases[g0])
            let wb0: i32 = g0 * 32

            let p0: u8x16 = load(v_packed, wb0)
            let lo0: u8x16 = p0 .& mask15
            let hi0: u8x16 = p0 .>> shr4
            let p1: u8x16 = load(v_packed, wb0 + 16)
            let lo1: u8x16 = p1 .& mask15
            let hi1: u8x16 = p1 .>> shr4

            o00 = fma(fma(widen_u8_f32x4(lo0), vs0, vb0), vw, o00)
            o01 = fma(fma(widen_u8_f32x4_4(lo0), vs0, vb0), vw, o01)
            o02 = fma(fma(widen_u8_f32x4_8(lo0), vs0, vb0), vw, o02)
            o03 = fma(fma(widen_u8_f32x4_12(lo0), vs0, vb0), vw, o03)

            o04 = fma(fma(widen_u8_f32x4(lo1), vs0, vb0), vw, o04)
            o05 = fma(fma(widen_u8_f32x4_4(lo1), vs0, vb0), vw, o05)
            o06 = fma(fma(widen_u8_f32x4_8(lo1), vs0, vb0), vw, o06)
            o07 = fma(fma(widen_u8_f32x4_12(lo1), vs0, vb0), vw, o07)

            o08 = fma(fma(widen_u8_f32x4(hi0), vs0, vb0), vw, o08)
            o09 = fma(fma(widen_u8_f32x4_4(hi0), vs0, vb0), vw, o09)
            o10 = fma(fma(widen_u8_f32x4_8(hi0), vs0, vb0), vw, o10)
            o11 = fma(fma(widen_u8_f32x4_12(hi0), vs0, vb0), vw, o11)

            o12 = fma(fma(widen_u8_f32x4(hi1), vs0, vb0), vw, o12)
            o13 = fma(fma(widen_u8_f32x4_4(hi1), vs0, vb0), vw, o13)
            o14 = fma(fma(widen_u8_f32x4_8(hi1), vs0, vb0), vw, o14)
            o15 = fma(fma(widen_u8_f32x4_12(hi1), vs0, vb0), vw, o15)

            let g1: i32 = g0 + 1
            let vs1: f32x4 = splat(v_scales[g1])
            let vb1: f32x4 = splat(v_biases[g1])
            let wb1: i32 = g1 * 32

            let p2: u8x16 = load(v_packed, wb1)
            let lo2: u8x16 = p2 .& mask15
            let hi2: u8x16 = p2 .>> shr4
            let p3: u8x16 = load(v_packed, wb1 + 16)
            let lo3: u8x16 = p3 .& mask15
            let hi3: u8x16 = p3 .>> shr4

            o16 = fma(fma(widen_u8_f32x4(lo2), vs1, vb1), vw, o16)
            o17 = fma(fma(widen_u8_f32x4_4(lo2), vs1, vb1), vw, o17)
            o18 = fma(fma(widen_u8_f32x4_8(lo2), vs1, vb1), vw, o18)
            o19 = fma(fma(widen_u8_f32x4_12(lo2), vs1, vb1), vw, o19)

            o20 = fma(fma(widen_u8_f32x4(lo3), vs1, vb1), vw, o20)
            o21 = fma(fma(widen_u8_f32x4_4(lo3), vs1, vb1), vw, o21)
            o22 = fma(fma(widen_u8_f32x4_8(lo3), vs1, vb1), vw, o22)
            o23 = fma(fma(widen_u8_f32x4_12(lo3), vs1, vb1), vw, o23)

            o24 = fma(fma(widen_u8_f32x4(hi2), vs1, vb1), vw, o24)
            o25 = fma(fma(widen_u8_f32x4_4(hi2), vs1, vb1), vw, o25)
            o26 = fma(fma(widen_u8_f32x4_8(hi2), vs1, vb1), vw, o26)
            o27 = fma(fma(widen_u8_f32x4_12(hi2), vs1, vb1), vw, o27)

            o28 = fma(fma(widen_u8_f32x4(hi3), vs1, vb1), vw, o28)
            o29 = fma(fma(widen_u8_f32x4_4(hi3), vs1, vb1), vw, o29)
            o30 = fma(fma(widen_u8_f32x4_8(hi3), vs1, vb1), vw, o30)
            o31 = fma(fma(widen_u8_f32x4_12(hi3), vs1, vb1), vw, o31)

            t = t + 1
        }

        store(all_out, out_offset, o00)
        store(all_out, out_offset + 4, o01)
        store(all_out, out_offset + 8, o02)
        store(all_out, out_offset + 12, o03)
        store(all_out, out_offset + 16, o04)
        store(all_out, out_offset + 20, o05)
        store(all_out, out_offset + 24, o06)
        store(all_out, out_offset + 28, o07)
        store(all_out, out_offset + 32, o08)
        store(all_out, out_offset + 36, o09)
        store(all_out, out_offset + 40, o10)
        store(all_out, out_offset + 44, o11)
        store(all_out, out_offset + 48, o12)
        store(all_out, out_offset + 52, o13)
        store(all_out, out_offset + 56, o14)
        store(all_out, out_offset + 60, o15)
        store(all_out, out_offset + 64, o16)
        store(all_out, out_offset + 68, o17)
        store(all_out, out_offset + 72, o18)
        store(all_out, out_offset + 76, o19)
        store(all_out, out_offset + 80, o20)
        store(all_out, out_offset + 84, o21)
        store(all_out, out_offset + 88, o22)
        store(all_out, out_offset + 92, o23)
        store(all_out, out_offset + 96, o24)
        store(all_out, out_offset + 100, o25)
        store(all_out, out_offset + 104, o26)
        store(all_out, out_offset + 108, o27)
        store(all_out, out_offset + 112, o28)
        store(all_out, out_offset + 116, o29)
        store(all_out, out_offset + 120, o30)
        store(all_out, out_offset + 124, o31)

        h = h + 1
    }
}
