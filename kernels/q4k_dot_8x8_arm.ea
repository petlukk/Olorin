// q4k_dot_8x8_lane_arm.ea — Q4Kx8 repacked matvec using vdot_lane_i32.
//
// Key change vs baseline: load 16B of Q8 per 4 k-iterations, use lane
// indexing instead of 4B load + broadcast. Eliminates shuffle_bytes
// and reduces Q8 loads by 4×.
//
// Inner loop: 8 iterations (k=0..7), process 32 Q8 bytes per half.
// Baseline: 8 × (load 4B + shuffle + 4 vdot) = 8 loads + 8 shuffles + 32 vdots
// Lane:     2 × (load 16B) + 8 × (4 vdot_lane) = 2 loads + 32 vdot_lanes
// Saves 8 loads + 8 shuffles per half per sub-block.

#[cfg(aarch64)]

func ubyte(p: *restrict u8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

export func q4k_8x8_q8k_matvec(
    packed: *restrict u8,
    q8_qs: *restrict i8,
    q8_d: *restrict f32,
    q8_bsums: *restrict i16,
    pow2: *restrict f32,
    scratch: *mut u8,
    out: *mut f32,
    n_rows: i32,
    n_cols: i32
) {
    let nb: i32 = n_cols / 256
    let m4b: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let km1: i32 = 0x3f3f3f3f
    let km2: i32 = 0x0f0f0f0f
    let km3: i32 = 0x03030303

    let d16: *restrict i16 = ptr_as_i16(ptr_as_i8(packed))
    let packed_i8: *restrict i8 = ptr_as_i8(packed)
    let out_f32: *mut f32 = ptr_as_f32(ptr_as_i8(out))
    let scratch_i16: *mut i16 = ptr_as_i16(ptr_as_i8(scratch))

    let mut x: i32 = 0
    while x < n_rows / 8 {
        let mut acc0: f32x4 = splat(0.0)
        let mut acc1: f32x4 = splat(0.0)

        let mut b: i32 = 0
        while b < nb {
            let bp: i32 = (x * nb + b) * 1152

            let q4d0: f32x4 = cvt_f16_f32(load(d16, bp / 2))
            let q4d1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 4))
            let q8d: f32x4 = splat(q8_d[b])
            let sb_sc0: f32x4 = q4d0 .* q8d
            let sb_sc1: f32x4 = q4d1 .* q8d

            let q4dm0: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 8))
            let q4dm1: f32x4 = cvt_f16_f32(load(d16, bp / 2 + 12))
            let sb_mn0: f32x4 = q4dm0 .* q8d
            let sb_mn1: f32x4 = q4dm1 .* q8d

            let mut bias0: i32x4 = splat(0)
            let mut bias1: i32x4 = splat(0)

            let bs_lo: i16x8 = load(q8_bsums, b * 16)
            let bs_hi: i16x8 = load(q8_bsums, b * 16 + 8)
            let bsums: i16x8 = addp_i16(bs_lo, bs_hi)
            store(scratch_i16, 0, bsums)

            let mut sb: i32 = 0
            while sb < 4 {
                // Scale decode (identical to baseline)
                let sp: *restrict i32 = ptr_as_i32(ptr_as_i8(packed))
                let sc0: i32 = bp + 32 + 24 * sb
                let u00: i32 = sp[sc0/4]
                let u01: i32 = sp[sc0/4+1]
                let u02: i32 = sp[sc0/4+2]
                let t00: i32 = u00 & km1
                let t02: i32 = u01 & km1
                let t01: i32 = (u02 & km2) | (((u00 >> 6) & km3) << 4)
                let t03: i32 = ((u02 >> 4) & km2) | (((u01 >> 6) & km3) << 4)

                let sc1: i32 = sc0 + 12
                let u10: i32 = sp[sc1/4]
                let u11: i32 = sp[sc1/4+1]
                let u12: i32 = sp[sc1/4+2]
                let t10: i32 = u10 & km1
                let t12: i32 = u11 & km1
                let t11: i32 = (u12 & km2) | (((u10 >> 6) & km3) << 4)
                let t13: i32 = ((u12 >> 4) & km2) | (((u11 >> 6) & km3) << 4)

                // Pack decoded scales into scratch[64..80], widen to i32x4
                let sc_scratch: *mut i32 = ptr_as_i32(ptr_as_i8(scratch))
                sc_scratch[16] = t00
                sc_scratch[17] = t01
                sc_scratch[18] = t10
                sc_scratch[19] = t11
                let sc_raw: u8x16 = load(scratch, 64)
                let sc_lo_0: i32x4 = widen_u8_i32x4(sc_raw)
                let sc_raw2: u8x16 = load(scratch, 68)
                let sc_hi_0: i32x4 = widen_u8_i32x4(sc_raw2)
                let sc_raw3: u8x16 = load(scratch, 72)
                let sc_lo_1: i32x4 = widen_u8_i32x4(sc_raw3)
                let sc_raw4: u8x16 = load(scratch, 76)
                let sc_hi_1: i32x4 = widen_u8_i32x4(sc_raw4)

                let q4_base: i32 = bp + 128 + sb * 256
                let q8b: i32 = b * 256 + sb * 64

                let mut alo_03: i32x4 = splat(0)
                let mut ahi_03: i32x4 = splat(0)
                let mut alo_47: i32x4 = splat(0)
                let mut ahi_47: i32x4 = splat(0)

                // Load 16B of Q8 per 4 k-iterations (lo and hi halves)
                // k=0..3: q8_lo_chunk covers bytes [q8b..q8b+16]
                // k=4..7: q8_lo_chunk2 covers bytes [q8b+16..q8b+32]
                let q8_lo_0: i8x16 = load(q8_qs, q8b)
                let q8_lo_1: i8x16 = load(q8_qs, q8b + 16)
                let q8_hi_0: i8x16 = load(q8_qs, q8b + 32)
                let q8_hi_1: i8x16 = load(q8_qs, q8b + 48)

                // k=0: weight at q4_base + 0, q8 lane 0
                let w03_k0: i8x16 = load(packed_i8, q4_base)
                let w47_k0: i8x16 = load(packed_i8, q4_base + 16)
                alo_03 = vdot_lane_i32(alo_03, w03_k0 .& m4b, q8_lo_0, 0)
                alo_47 = vdot_lane_i32(alo_47, w47_k0 .& m4b, q8_lo_0, 0)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k0 .>> shift4) .& m4b, q8_hi_0, 0)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k0 .>> shift4) .& m4b, q8_hi_0, 0)

                // k=1
                let w03_k1: i8x16 = load(packed_i8, q4_base + 32)
                let w47_k1: i8x16 = load(packed_i8, q4_base + 48)
                alo_03 = vdot_lane_i32(alo_03, w03_k1 .& m4b, q8_lo_0, 1)
                alo_47 = vdot_lane_i32(alo_47, w47_k1 .& m4b, q8_lo_0, 1)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k1 .>> shift4) .& m4b, q8_hi_0, 1)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k1 .>> shift4) .& m4b, q8_hi_0, 1)

                // k=2
                let w03_k2: i8x16 = load(packed_i8, q4_base + 64)
                let w47_k2: i8x16 = load(packed_i8, q4_base + 80)
                alo_03 = vdot_lane_i32(alo_03, w03_k2 .& m4b, q8_lo_0, 2)
                alo_47 = vdot_lane_i32(alo_47, w47_k2 .& m4b, q8_lo_0, 2)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k2 .>> shift4) .& m4b, q8_hi_0, 2)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k2 .>> shift4) .& m4b, q8_hi_0, 2)

                // k=3
                let w03_k3: i8x16 = load(packed_i8, q4_base + 96)
                let w47_k3: i8x16 = load(packed_i8, q4_base + 112)
                alo_03 = vdot_lane_i32(alo_03, w03_k3 .& m4b, q8_lo_0, 3)
                alo_47 = vdot_lane_i32(alo_47, w47_k3 .& m4b, q8_lo_0, 3)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k3 .>> shift4) .& m4b, q8_hi_0, 3)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k3 .>> shift4) .& m4b, q8_hi_0, 3)

                // k=4
                let w03_k4: i8x16 = load(packed_i8, q4_base + 128)
                let w47_k4: i8x16 = load(packed_i8, q4_base + 144)
                alo_03 = vdot_lane_i32(alo_03, w03_k4 .& m4b, q8_lo_1, 0)
                alo_47 = vdot_lane_i32(alo_47, w47_k4 .& m4b, q8_lo_1, 0)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k4 .>> shift4) .& m4b, q8_hi_1, 0)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k4 .>> shift4) .& m4b, q8_hi_1, 0)

                // k=5
                let w03_k5: i8x16 = load(packed_i8, q4_base + 160)
                let w47_k5: i8x16 = load(packed_i8, q4_base + 176)
                alo_03 = vdot_lane_i32(alo_03, w03_k5 .& m4b, q8_lo_1, 1)
                alo_47 = vdot_lane_i32(alo_47, w47_k5 .& m4b, q8_lo_1, 1)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k5 .>> shift4) .& m4b, q8_hi_1, 1)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k5 .>> shift4) .& m4b, q8_hi_1, 1)

                // k=6
                let w03_k6: i8x16 = load(packed_i8, q4_base + 192)
                let w47_k6: i8x16 = load(packed_i8, q4_base + 208)
                alo_03 = vdot_lane_i32(alo_03, w03_k6 .& m4b, q8_lo_1, 2)
                alo_47 = vdot_lane_i32(alo_47, w47_k6 .& m4b, q8_lo_1, 2)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k6 .>> shift4) .& m4b, q8_hi_1, 2)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k6 .>> shift4) .& m4b, q8_hi_1, 2)

                // k=7
                let w03_k7: i8x16 = load(packed_i8, q4_base + 224)
                let w47_k7: i8x16 = load(packed_i8, q4_base + 240)
                alo_03 = vdot_lane_i32(alo_03, w03_k7 .& m4b, q8_lo_1, 3)
                alo_47 = vdot_lane_i32(alo_47, w47_k7 .& m4b, q8_lo_1, 3)
                ahi_03 = vdot_lane_i32(ahi_03, (w03_k7 .>> shift4) .& m4b, q8_hi_1, 3)
                ahi_47 = vdot_lane_i32(ahi_47, (w47_k7 .>> shift4) .& m4b, q8_hi_1, 3)

                // Scale application (identical to baseline)
                let sumf_lo_03: f32x4 = to_f32(sc_lo_0 .* alo_03)
                acc0 = fma(sb_sc0, sumf_lo_03, acc0)
                let sumf_hi_03: f32x4 = to_f32(sc_lo_1 .* ahi_03)
                acc0 = fma(sb_sc0, sumf_hi_03, acc0)
                let sumf_lo_47: f32x4 = to_f32(sc_hi_0 .* alo_47)
                acc1 = fma(sb_sc1, sumf_lo_47, acc1)
                let sumf_hi_47: f32x4 = to_f32(sc_hi_1 .* ahi_47)
                acc1 = fma(sb_sc1, sumf_hi_47, acc1)

                // Mins correction (identical to baseline)
                let bs0: i16 = scratch_i16[sb * 2]
                let bs1: i16 = scratch_i16[sb * 2 + 1]
                let b0_0: i32 = (t02 & 255) * to_i32(bs0) + (t12 & 255) * to_i32(bs1)
                let b0_1: i32 = ((t02>>8)&255) * to_i32(bs0) + ((t12>>8)&255) * to_i32(bs1)
                let b0_2: i32 = ((t02>>16)&255) * to_i32(bs0) + ((t12>>16)&255) * to_i32(bs1)
                let b0_3: i32 = ((t02>>24)&255) * to_i32(bs0) + ((t12>>24)&255) * to_i32(bs1)
                let bias_delta0: i32x4 = [b0_0, b0_1, b0_2, b0_3]
                bias0 = bias0 .+ bias_delta0

                let b1_0: i32 = (t03 & 255) * to_i32(bs0) + (t13 & 255) * to_i32(bs1)
                let b1_1: i32 = ((t03>>8)&255) * to_i32(bs0) + ((t13>>8)&255) * to_i32(bs1)
                let b1_2: i32 = ((t03>>16)&255) * to_i32(bs0) + ((t13>>16)&255) * to_i32(bs1)
                let b1_3: i32 = ((t03>>24)&255) * to_i32(bs0) + ((t13>>24)&255) * to_i32(bs1)
                let bias_delta1: i32x4 = [b1_0, b1_1, b1_2, b1_3]
                bias1 = bias1 .+ bias_delta1

                sb = sb + 1
            }

            acc0 = acc0 .- to_f32(bias0) .* sb_mn0
            acc1 = acc1 .- to_f32(bias1) .* sb_mn1

            b = b + 1
        }

        store(out_f32, x * 8, acc0)
        store(out_f32, x * 8 + 4, acc1)

        x = x + 1
    }
}
