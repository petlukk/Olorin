// attn_f16_arm.ea — F16 KV-cache attention kernels (ARM NEON)
//
// attn_dot_f16: scores[t] = dot(query, f16_to_f32(k_cache[t*hd..]))
// attn_vsum_f16: out[d] = sum_t(weights[t] * f16_to_f32(v_cache[t*hd+d]))
//
// Uses cvt_f16_f32 intrinsic (fcvtl) for SIMD f16→f32 conversion.

#[cfg(aarch64)]

export func attn_dot_f16(
    query: *restrict f32,
    k_cache: *restrict u16,
    scores_out: *mut f32,
    seq_len: i32,
    head_dim: i32
) {
    let kp: *restrict i16 = ptr_as_i16(k_cache)
    let mut t: i32 = 0
    while t < seq_len {
        let k_off: i32 = t * head_dim
        let mut d: i32 = 0
        let mut acc: f32x4 = splat(0.0)

        // 4-wide SIMD loop (ARM NEON = 128-bit)
        while d + 4 <= head_dim {
            let kh: i16x4 = load_narrow(kp, k_off + d)
            let kf: f32x4 = cvt_f16_f32(kh)
            let q: f32x4 = load(query, d)
            acc = fma(q, kf, acc)
            d = d + 4
        }

        let mut dot: f32 = reduce_add(acc)

        // head_dim is always multiple of 4 for Q4K models, no scalar tail needed
        scores_out[t] = dot
        t = t + 1
    }
}

export func attn_vsum_f16(
    weights: *restrict f32,
    v_cache: *restrict u16,
    out: *mut f32,
    seq_len: i32,
    head_dim: i32
) {
    let vp: *restrict i16 = ptr_as_i16(v_cache)

    // Zero output
    let mut d: i32 = 0
    let zero4: f32x4 = splat(0.0)
    while d + 4 <= head_dim {
        store(out, d, zero4)
        d = d + 4
    }
    while d < head_dim {
        out[d] = 0.0
        d = d + 1
    }

    // Accumulate weighted V rows
    let mut t: i32 = 0
    while t < seq_len {
        let w: f32x4 = splat(weights[t])
        let v_off: i32 = t * head_dim
        d = 0

        // 4-wide SIMD loop
        while d + 4 <= head_dim {
            let vh: i16x4 = load_narrow(vp, v_off + d)
            let vf: f32x4 = cvt_f16_f32(vh)
            let cur: f32x4 = load(out, d)
            store(out, d, fma(w, vf, cur))
            d = d + 4
        }

        // head_dim is always multiple of 4 for Q4K models, no scalar tail needed

        t = t + 1
    }
}
