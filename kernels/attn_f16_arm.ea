// attn_f16_arm.ea — F16 KV-cache attention kernels (ARM NEON)
//
// Uses cvt_f16_f32(i16x4) → f32x4 via fcvtl.
// Two 4-wide loads + converts per iteration = 8 f16 elements.
// head_dim is always ≥ 64 and divisible by 8.

#[cfg(aarch64)]

export func attn_dot_f16(
    query: *restrict f32,
    k_cache: *restrict u16,
    scores_out: *mut f32,
    seq_len: i32,
    head_dim: i32
) {
    let kp: *restrict i16 = ptr_as_i16(k_cache)
    let mut t: i32 = 0
    while t < seq_len {
        let k_off: i32 = t * head_dim
        let mut d: i32 = 0
        let mut acc0: f32x4 = splat(0.0)
        let mut acc1: f32x4 = splat(0.0)

        // 8 elements per iteration: 2 × (ldr d + fcvtl + fmla)
        while d + 8 <= head_dim {
            let a: i16x4 = load(kp, k_off + d)
            let b: i16x4 = load(kp, k_off + d + 4)
            let fa: f32x4 = cvt_f16_f32(a)
            let fb: f32x4 = cvt_f16_f32(b)
            let q0: f32x4 = load(query, d)
            let q1: f32x4 = load(query, d + 4)
            acc0 = fma(q0, fa, acc0)
            acc1 = fma(q1, fb, acc1)
            d = d + 8
        }

        scores_out[t] = reduce_add(acc0) + reduce_add(acc1)
        t = t + 1
    }
}

export func attn_vsum_f16(
    weights: *restrict f32,
    v_cache: *restrict u16,
    out: *mut f32,
    seq_len: i32,
    head_dim: i32
) {
    let vp: *restrict i16 = ptr_as_i16(v_cache)

    // Zero output
    let mut d: i32 = 0
    let zero4: f32x4 = splat(0.0)
    while d + 4 <= head_dim {
        store(out, d, zero4)
        d = d + 4
    }

    // Accumulate weighted V rows — 8 elements per iteration
    let mut t: i32 = 0
    while t < seq_len {
        let w: f32x4 = splat(weights[t])
        let v_off: i32 = t * head_dim
        d = 0

        while d + 8 <= head_dim {
            let a: i16x4 = load(vp, v_off + d)
            let b: i16x4 = load(vp, v_off + d + 4)
            let fa: f32x4 = cvt_f16_f32(a)
            let fb: f32x4 = cvt_f16_f32(b)
            let cur0: f32x4 = load(out, d)
            let cur1: f32x4 = load(out, d + 4)
            store(out, d, fma(w, fa, cur0))
            store(out, d + 4, fma(w, fb, cur1))
            d = d + 8
        }

        t = t + 1
    }
}
