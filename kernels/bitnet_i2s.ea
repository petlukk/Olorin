// bitnet_i2s.ea — Ternary weight × int8 activation dot product (AVX2)
//
// BitNet b1.58 encodes ternary weights {-1, 0, +1} as 2-bit values {0, 1, 2}.
// Four weights pack into one byte: bits 7:6, 5:4, 3:2, 1:0.
//
// x86 layout (QK=128): 32 packed bytes → 128 weights
//   Group 0 (bits 7:6): weights[0..31]   matched with activations[0..31]
//   Group 1 (bits 5:4): weights[32..63]  matched with activations[32..63]
//   Group 2 (bits 3:2): weights[64..95]  matched with activations[64..95]
//   Group 3 (bits 1:0): weights[96..127] matched with activations[96..127]
//
// AVX2: loads full 32 packed bytes via u8x32, eliminates the half loop.
// madd_i16(ones, maddubs_i16(u8x32, i8x32)) → i32x8, dual accumulators for ILP.

#[cfg(x86_64)]

export func i2_dot_i8(
    weights: *restrict u8,
    activations: *restrict i8,
    n: i32
) -> i32 {
    let mask: u8x32 = splat(3)
    let s6: u8x32 = splat(6)
    let s4: u8x32 = splat(4)
    let s2: u8x32 = splat(2)
    let ones: i16x16 = splat(1)
    let mut acc_a: i32x8 = splat(0)
    let mut acc_b: i32x8 = splat(0)
    let n_blocks: i32 = n / 128

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bw: i32 = blk * 32
        let ba: i32 = blk * 128

        let packed: u8x32 = load(weights, bw)

        let a0: i8x32 = load(activations, ba)
        let a1: i8x32 = load(activations, ba + 32)
        let a2: i8x32 = load(activations, ba + 64)
        let a3: i8x32 = load(activations, ba + 96)

        acc_a = acc_a .+ madd_i16(ones, maddubs_i16((packed .>> s6) .& mask, a0))
        acc_b = acc_b .+ madd_i16(ones, maddubs_i16((packed .>> s4) .& mask, a1))
        acc_a = acc_a .+ madd_i16(ones, maddubs_i16((packed .>> s2) .& mask, a2))
        acc_b = acc_b .+ madd_i16(ones, maddubs_i16(packed .& mask, a3))

        blk = blk + 1
    }

    return reduce_add(acc_a .+ acc_b)
}

// 4-row dot product: 4 weight rows × one activation vector.
export func i2_dot_i8_4row(
    rw0: *restrict u8,
    rw1: *restrict u8,
    rw2: *restrict u8,
    rw3: *restrict u8,
    activations: *restrict i8,
    out scores: *mut i32 [cap: 4],
    n: i32
) {
    let mask: u8x32 = splat(3)
    let s6: u8x32 = splat(6)
    let s4: u8x32 = splat(4)
    let s2: u8x32 = splat(2)
    let ones: i16x16 = splat(1)
    let mut r0: i32x8 = splat(0)
    let mut r1: i32x8 = splat(0)
    let mut r2: i32x8 = splat(0)
    let mut r3: i32x8 = splat(0)
    let n_blocks: i32 = n / 128

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bw: i32 = blk * 32
        let ba: i32 = blk * 128

        let a0: i8x32 = load(activations, ba)
        let a1: i8x32 = load(activations, ba + 32)
        let a2: i8x32 = load(activations, ba + 64)
        let a3: i8x32 = load(activations, ba + 96)

        let p0: u8x32 = load(rw0, bw)
        r0 = r0 .+ madd_i16(ones, maddubs_i16((p0 .>> s6) .& mask, a0))
        r0 = r0 .+ madd_i16(ones, maddubs_i16((p0 .>> s4) .& mask, a1))
        r0 = r0 .+ madd_i16(ones, maddubs_i16((p0 .>> s2) .& mask, a2))
        r0 = r0 .+ madd_i16(ones, maddubs_i16(p0 .& mask, a3))

        let p1: u8x32 = load(rw1, bw)
        r1 = r1 .+ madd_i16(ones, maddubs_i16((p1 .>> s6) .& mask, a0))
        r1 = r1 .+ madd_i16(ones, maddubs_i16((p1 .>> s4) .& mask, a1))
        r1 = r1 .+ madd_i16(ones, maddubs_i16((p1 .>> s2) .& mask, a2))
        r1 = r1 .+ madd_i16(ones, maddubs_i16(p1 .& mask, a3))

        let p2: u8x32 = load(rw2, bw)
        r2 = r2 .+ madd_i16(ones, maddubs_i16((p2 .>> s6) .& mask, a0))
        r2 = r2 .+ madd_i16(ones, maddubs_i16((p2 .>> s4) .& mask, a1))
        r2 = r2 .+ madd_i16(ones, maddubs_i16((p2 .>> s2) .& mask, a2))
        r2 = r2 .+ madd_i16(ones, maddubs_i16(p2 .& mask, a3))

        let p3: u8x32 = load(rw3, bw)
        r3 = r3 .+ madd_i16(ones, maddubs_i16((p3 .>> s6) .& mask, a0))
        r3 = r3 .+ madd_i16(ones, maddubs_i16((p3 .>> s4) .& mask, a1))
        r3 = r3 .+ madd_i16(ones, maddubs_i16((p3 .>> s2) .& mask, a2))
        r3 = r3 .+ madd_i16(ones, maddubs_i16(p3 .& mask, a3))

        blk = blk + 1
    }

    scores[0] = reduce_add(r0)
    scores[1] = reduce_add(r1)
    scores[2] = reduce_add(r2)
    scores[3] = reduce_add(r3)
}

// Fused dual 4-row: 4 gate rows + 4 up rows × shared activations.
export func i2_dot_i8_4row_dual(
    gw0: *restrict u8, gw1: *restrict u8, gw2: *restrict u8, gw3: *restrict u8,
    uw0: *restrict u8, uw1: *restrict u8, uw2: *restrict u8, uw3: *restrict u8,
    activations: *restrict i8,
    out gate_scores: *mut i32 [cap: 4],
    out up_scores: *mut i32 [cap: 4],
    n: i32
) {
    let mask: u8x32 = splat(3)
    let s6: u8x32 = splat(6)
    let s4: u8x32 = splat(4)
    let s2: u8x32 = splat(2)
    let ones: i16x16 = splat(1)
    let mut g0: i32x8 = splat(0)
    let mut g1: i32x8 = splat(0)
    let mut g2: i32x8 = splat(0)
    let mut g3: i32x8 = splat(0)
    let mut u0: i32x8 = splat(0)
    let mut u1: i32x8 = splat(0)
    let mut u2: i32x8 = splat(0)
    let mut u3: i32x8 = splat(0)
    let n_blocks: i32 = n / 128

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bw: i32 = blk * 32
        let ba: i32 = blk * 128

        let a0: i8x32 = load(activations, ba)
        let a1: i8x32 = load(activations, ba + 32)
        let a2: i8x32 = load(activations, ba + 64)
        let a3: i8x32 = load(activations, ba + 96)

        let pg0: u8x32 = load(gw0, bw)
        let pu0: u8x32 = load(uw0, bw)
        g0 = g0 .+ madd_i16(ones, maddubs_i16((pg0 .>> s6) .& mask, a0))
        u0 = u0 .+ madd_i16(ones, maddubs_i16((pu0 .>> s6) .& mask, a0))
        g0 = g0 .+ madd_i16(ones, maddubs_i16((pg0 .>> s4) .& mask, a1))
        u0 = u0 .+ madd_i16(ones, maddubs_i16((pu0 .>> s4) .& mask, a1))
        g0 = g0 .+ madd_i16(ones, maddubs_i16((pg0 .>> s2) .& mask, a2))
        u0 = u0 .+ madd_i16(ones, maddubs_i16((pu0 .>> s2) .& mask, a2))
        g0 = g0 .+ madd_i16(ones, maddubs_i16(pg0 .& mask, a3))
        u0 = u0 .+ madd_i16(ones, maddubs_i16(pu0 .& mask, a3))

        let pg1: u8x32 = load(gw1, bw)
        let pu1: u8x32 = load(uw1, bw)
        g1 = g1 .+ madd_i16(ones, maddubs_i16((pg1 .>> s6) .& mask, a0))
        u1 = u1 .+ madd_i16(ones, maddubs_i16((pu1 .>> s6) .& mask, a0))
        g1 = g1 .+ madd_i16(ones, maddubs_i16((pg1 .>> s4) .& mask, a1))
        u1 = u1 .+ madd_i16(ones, maddubs_i16((pu1 .>> s4) .& mask, a1))
        g1 = g1 .+ madd_i16(ones, maddubs_i16((pg1 .>> s2) .& mask, a2))
        u1 = u1 .+ madd_i16(ones, maddubs_i16((pu1 .>> s2) .& mask, a2))
        g1 = g1 .+ madd_i16(ones, maddubs_i16(pg1 .& mask, a3))
        u1 = u1 .+ madd_i16(ones, maddubs_i16(pu1 .& mask, a3))

        let pg2: u8x32 = load(gw2, bw)
        let pu2: u8x32 = load(uw2, bw)
        g2 = g2 .+ madd_i16(ones, maddubs_i16((pg2 .>> s6) .& mask, a0))
        u2 = u2 .+ madd_i16(ones, maddubs_i16((pu2 .>> s6) .& mask, a0))
        g2 = g2 .+ madd_i16(ones, maddubs_i16((pg2 .>> s4) .& mask, a1))
        u2 = u2 .+ madd_i16(ones, maddubs_i16((pu2 .>> s4) .& mask, a1))
        g2 = g2 .+ madd_i16(ones, maddubs_i16((pg2 .>> s2) .& mask, a2))
        u2 = u2 .+ madd_i16(ones, maddubs_i16((pu2 .>> s2) .& mask, a2))
        g2 = g2 .+ madd_i16(ones, maddubs_i16(pg2 .& mask, a3))
        u2 = u2 .+ madd_i16(ones, maddubs_i16(pu2 .& mask, a3))

        let pg3: u8x32 = load(gw3, bw)
        let pu3: u8x32 = load(uw3, bw)
        g3 = g3 .+ madd_i16(ones, maddubs_i16((pg3 .>> s6) .& mask, a0))
        u3 = u3 .+ madd_i16(ones, maddubs_i16((pu3 .>> s6) .& mask, a0))
        g3 = g3 .+ madd_i16(ones, maddubs_i16((pg3 .>> s4) .& mask, a1))
        u3 = u3 .+ madd_i16(ones, maddubs_i16((pu3 .>> s4) .& mask, a1))
        g3 = g3 .+ madd_i16(ones, maddubs_i16((pg3 .>> s2) .& mask, a2))
        u3 = u3 .+ madd_i16(ones, maddubs_i16((pu3 .>> s2) .& mask, a2))
        g3 = g3 .+ madd_i16(ones, maddubs_i16(pg3 .& mask, a3))
        u3 = u3 .+ madd_i16(ones, maddubs_i16(pu3 .& mask, a3))

        blk = blk + 1
    }

    gate_scores[0] = reduce_add(g0)
    gate_scores[1] = reduce_add(g1)
    gate_scores[2] = reduce_add(g2)
    gate_scores[3] = reduce_add(g3)
    up_scores[0] = reduce_add(u0)
    up_scores[1] = reduce_add(u1)
    up_scores[2] = reduce_add(u2)
    up_scores[3] = reduce_add(u3)
}
