// attn_ops_arm.ea — Attention f32 dot product + weighted V accumulation (ARM NEON)
//
// Matches x86 pipeline: 16-wide main loop (4×f32x4), 8-wide cleanup, 4-wide cleanup, scalar tail.

#[cfg(aarch64)]

export func f32_dot(a: *restrict f32, b: *restrict f32, n: i32) -> f32 {
    let mut acc0: f32x4 = splat(0.0)
    let mut acc1: f32x4 = splat(0.0)
    let mut acc2: f32x4 = splat(0.0)
    let mut acc3: f32x4 = splat(0.0)
    let mut i: i32 = 0

    while i + 16 <= n {
        let va0: f32x4 = load(a, i)
        let vb0: f32x4 = load(b, i)
        let va1: f32x4 = load(a, i + 4)
        let vb1: f32x4 = load(b, i + 4)
        let va2: f32x4 = load(a, i + 8)
        let vb2: f32x4 = load(b, i + 8)
        let va3: f32x4 = load(a, i + 12)
        let vb3: f32x4 = load(b, i + 12)
        acc0 = fma(va0, vb0, acc0)
        acc1 = fma(va1, vb1, acc1)
        acc2 = fma(va2, vb2, acc2)
        acc3 = fma(va3, vb3, acc3)
        i = i + 16
    }

    while i + 8 <= n {
        let va0: f32x4 = load(a, i)
        let vb0: f32x4 = load(b, i)
        let va1: f32x4 = load(a, i + 4)
        let vb1: f32x4 = load(b, i + 4)
        acc0 = fma(va0, vb0, acc0)
        acc1 = fma(va1, vb1, acc1)
        i = i + 8
    }

    let mut result: f32 = reduce_add(acc0) + reduce_add(acc1) + reduce_add(acc2) + reduce_add(acc3)

    while i + 4 <= n {
        let va: f32x4 = load(a, i)
        let vb: f32x4 = load(b, i)
        result = result + reduce_add(va .* vb)
        i = i + 4
    }

    while i < n {
        result = result + a[i] * b[i]
        i = i + 1
    }
    return result
}

export func f32_dot_acc(out: *mut f32, a: *restrict f32, s: f32, n: i32) {
    let vs: f32x4 = splat(s)
    let mut i: i32 = 0

    while i + 16 <= n {
        let vo0: f32x4 = load(out, i)
        let va0: f32x4 = load(a, i)
        let vo1: f32x4 = load(out, i + 4)
        let va1: f32x4 = load(a, i + 4)
        let vo2: f32x4 = load(out, i + 8)
        let va2: f32x4 = load(a, i + 8)
        let vo3: f32x4 = load(out, i + 12)
        let va3: f32x4 = load(a, i + 12)
        store(out, i, fma(va0, vs, vo0))
        store(out, i + 4, fma(va1, vs, vo1))
        store(out, i + 8, fma(va2, vs, vo2))
        store(out, i + 12, fma(va3, vs, vo3))
        i = i + 16
    }

    while i + 8 <= n {
        let vo0: f32x4 = load(out, i)
        let va0: f32x4 = load(a, i)
        let vo1: f32x4 = load(out, i + 4)
        let va1: f32x4 = load(a, i + 4)
        store(out, i, fma(va0, vs, vo0))
        store(out, i + 4, fma(va1, vs, vo1))
        i = i + 8
    }

    while i + 4 <= n {
        let vo: f32x4 = load(out, i)
        let va: f32x4 = load(a, i)
        store(out, i, fma(va, vs, vo))
        i = i + 4
    }

    while i < n {
        out[i] = out[i] + a[i] * s
        i = i + 1
    }
}
