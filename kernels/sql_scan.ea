// SQL-dump structure scanner for the `easql` rune. One SIMD sweep over a
// .sql dump (pg_dump / mysqldump) counting the structural keywords CREATE,
// INSERT, COPY (ASCII case-insensitive, word-bounded) plus the total newline
// count, and recording the byte offset of each keyword match so the rune can
// scalar-extract the table name / attribute rows per statement.
//
// KISS by design: this is `log_level_scan` with three SQL keywords instead of
// five log levels. It does NOT parse SQL — it sweeps for markers; the rune
// does the cheap per-marker work (name after the keyword, row count in the
// statement region). CREATE is matched as a bare token (it also starts CREATE
// INDEX / VIEW); the rune disambiguates "CREATE TABLE" at each position.
//
// Case fold: candidate letters are OR'd with 0x20 before comparison, so
// `CREATE`/`create`/`Create` all match. Delimiter checks use original bytes.
// Word boundary = preceded AND followed by space / tab / newline / CR, with
// start-of-file and end-of-file as implicit delimiters.
//
// out_counts[0..4]   = [CREATE, INSERT, COPY, NEWLINES].
// out_positions      = keyword match offsets in scan order (<= max_positions).
// out_n_positions[0] = number of positions written.
// scratch (16 bytes) = per-chunk OR mask; contents after the call unspecified.

func is_ws(b: i32) -> i32 {
    if b == 32 { return 1 }
    if b == 10 { return 1 }
    if b == 9  { return 1 }
    if b == 13 { return 1 }
    return 0
}

func record_pos(p: i32, positions: *mut i32, max_positions: i32, n: *mut i32) {
    if max_positions <= 0 { return }
    let cur: i32 = n[0]
    if cur < max_positions {
        positions[cur] = p
        n[0] = cur + 1
    }
}

// Match a keyword at position p with word boundaries. Returns 1 if the next
// `klen` folded bytes equal `k0..k5` (k5 unused when klen==4) and the byte
// after is a delimiter (or EOF). Left boundary is the caller's responsibility.
func scan_pos(text: *u8, p: i32, len: i32, counters: *mut i32, positions: *mut i32, max_positions: i32, n: *mut i32) {
    if p > 0 {
        if is_ws(to_i32(text[p - 1])) == 0 { return }
    }

    // CREATE (6) -> counters[0]
    if p + 6 <= len {
        let f0: i32 = to_i32(text[p + 0]) | 32
        let f1: i32 = to_i32(text[p + 1]) | 32
        let f2: i32 = to_i32(text[p + 2]) | 32
        let f3: i32 = to_i32(text[p + 3]) | 32
        let f4: i32 = to_i32(text[p + 4]) | 32
        let f5: i32 = to_i32(text[p + 5]) | 32
        if f0 == 99 && f1 == 114 && f2 == 101 && f3 == 97 && f4 == 116 && f5 == 101 {
            if p + 6 == len {
                counters[0] = counters[0] + 1
                record_pos(p, positions, max_positions, n)
                return
            }
            if is_ws(to_i32(text[p + 6])) == 1 {
                counters[0] = counters[0] + 1
                record_pos(p, positions, max_positions, n)
                return
            }
        }
        // INSERT (6) -> counters[1]
        if f0 == 105 && f1 == 110 && f2 == 115 && f3 == 101 && f4 == 114 && f5 == 116 {
            if p + 6 == len {
                counters[1] = counters[1] + 1
                record_pos(p, positions, max_positions, n)
                return
            }
            if is_ws(to_i32(text[p + 6])) == 1 {
                counters[1] = counters[1] + 1
                record_pos(p, positions, max_positions, n)
                return
            }
        }
    }
    // COPY (4) -> counters[2]
    if p + 4 <= len {
        let g0: i32 = to_i32(text[p + 0]) | 32
        let g1: i32 = to_i32(text[p + 1]) | 32
        let g2: i32 = to_i32(text[p + 2]) | 32
        let g3: i32 = to_i32(text[p + 3]) | 32
        if g0 == 99 && g1 == 111 && g2 == 112 && g3 == 121 {
            if p + 4 == len {
                counters[2] = counters[2] + 1
                record_pos(p, positions, max_positions, n)
                return
            }
            if is_ws(to_i32(text[p + 4])) == 1 {
                counters[2] = counters[2] + 1
                record_pos(p, positions, max_positions, n)
                return
            }
        }
    }
}

export func sql_scan(text: *u8, len: i32, out_counts: *mut i32, out_positions: *mut i32, max_positions: i32, out_n_positions: *mut i32, scratch: *mut u8) {
    out_counts[0] = 0
    out_counts[1] = 0
    out_counts[2] = 0
    out_counts[3] = 0
    out_n_positions[0] = 0

    if len <= 0 { return }

    // Buffers too small for the SIMD body run entirely scalar. The body's
    // farthest load is c6 = load(text, i+6), reaching text[i+21]; with i
    // starting at 16 the first chunk needs len > 38.
    if len < 39 {
        let mut p: i32 = 0
        while p < len {
            if to_i32(text[p]) == 10 { out_counts[3] = out_counts[3] + 1 }
            scan_pos(text, p, len, out_counts, out_positions, max_positions, out_n_positions)
            p = p + 1
        }
        return
    }

    let v_C: u8x16 = splat(99)
    let v_R: u8x16 = splat(114)
    let v_E: u8x16 = splat(101)
    let v_A: u8x16 = splat(97)
    let v_T: u8x16 = splat(116)
    let v_I: u8x16 = splat(105)
    let v_N: u8x16 = splat(110)
    let v_S: u8x16 = splat(115)
    let v_O: u8x16 = splat(111)
    let v_P: u8x16 = splat(112)
    let v_Y: u8x16 = splat(121)
    let v_or: u8x16 = splat(32)

    let v_sp: u8x16 = splat(32)
    let v_lf: u8x16 = splat(10)
    let v_tb: u8x16 = splat(9)
    let v_cr: u8x16 = splat(13)
    let v_one:  u8x16 = splat(1)
    let v_zero: u8x16 = splat(0)

    let mut c_create: i32 = 0
    let mut c_insert: i32 = 0
    let mut c_copy:   i32 = 0
    let mut c_nl:     i32 = 0

    // Scalar prologue: positions [0..16).
    let mut p: i32 = 0
    while p < 16 {
        if to_i32(text[p]) == 10 { c_nl = c_nl + 1 }
        scan_pos(text, p, len, out_counts, out_positions, max_positions, out_n_positions)
        p = p + 1
    }

    // SIMD body: chunks at i = 16, 32, ... while i + 22 < len. The bound
    // covers the farthest load c6 = load(text, i+6) (reads to text[i+21]); the
    // scalar epilogue picks up the tail positions the window cedes.
    let mut i: i32 = 16
    while i + 22 < len {
        let c0:  u8x16 = load(text, i)
        let c1:  u8x16 = load(text, i + 1)
        let c2:  u8x16 = load(text, i + 2)
        let c3:  u8x16 = load(text, i + 3)
        let c4:  u8x16 = load(text, i + 4)
        let c5:  u8x16 = load(text, i + 5)
        let c6:  u8x16 = load(text, i + 6)
        let cm1: u8x16 = load(text, i - 1)

        let f0: u8x16 = c0 .| v_or
        let f1: u8x16 = c1 .| v_or
        let f2: u8x16 = c2 .| v_or
        let f3: u8x16 = c3 .| v_or
        let f4: u8x16 = c4 .| v_or
        let f5: u8x16 = c5 .| v_or

        // Left delimiter from cm1.
        let l_sp: u8x16 = select(cm1 .== v_sp, v_one, v_zero)
        let l_lf: u8x16 = select(cm1 .== v_lf, v_one, v_zero)
        let l_tb: u8x16 = select(cm1 .== v_tb, v_one, v_zero)
        let l_cr: u8x16 = select(cm1 .== v_cr, v_one, v_zero)
        let ldelim: u8x16 = l_sp .| l_lf .| l_tb .| l_cr

        // Right delimiter at offset 6 (CREATE/INSERT) from c6.
        let r6_sp: u8x16 = select(c6 .== v_sp, v_one, v_zero)
        let r6_lf: u8x16 = select(c6 .== v_lf, v_one, v_zero)
        let r6_tb: u8x16 = select(c6 .== v_tb, v_one, v_zero)
        let r6_cr: u8x16 = select(c6 .== v_cr, v_one, v_zero)
        let rdelim6: u8x16 = r6_sp .| r6_lf .| r6_tb .| r6_cr

        // Right delimiter at offset 4 (COPY) from c4.
        let r4_sp: u8x16 = select(c4 .== v_sp, v_one, v_zero)
        let r4_lf: u8x16 = select(c4 .== v_lf, v_one, v_zero)
        let r4_tb: u8x16 = select(c4 .== v_tb, v_one, v_zero)
        let r4_cr: u8x16 = select(c4 .== v_cr, v_one, v_zero)
        let rdelim4: u8x16 = r4_sp .| r4_lf .| r4_tb .| r4_cr

        // CREATE = C R E A T E
        let a0: u8x16 = select(f0 .== v_C, v_one, v_zero)
        let a1: u8x16 = select(f1 .== v_R, v_one, v_zero)
        let a2: u8x16 = select(f2 .== v_E, v_one, v_zero)
        let a3: u8x16 = select(f3 .== v_A, v_one, v_zero)
        let a4: u8x16 = select(f4 .== v_T, v_one, v_zero)
        let a5: u8x16 = select(f5 .== v_E, v_one, v_zero)
        let kw_CREATE: u8x16 = a0 .& a1 .& a2 .& a3 .& a4 .& a5
        let valid_CREATE: u8x16 = kw_CREATE .& ldelim .& rdelim6
        c_create = c_create + to_i32(reduce_add(valid_CREATE))

        // INSERT = I N S E R T
        let b0: u8x16 = select(f0 .== v_I, v_one, v_zero)
        let b1: u8x16 = select(f1 .== v_N, v_one, v_zero)
        let b2: u8x16 = select(f2 .== v_S, v_one, v_zero)
        let b3: u8x16 = select(f3 .== v_E, v_one, v_zero)
        let b4: u8x16 = select(f4 .== v_R, v_one, v_zero)
        let b5: u8x16 = select(f5 .== v_T, v_one, v_zero)
        let kw_INSERT: u8x16 = b0 .& b1 .& b2 .& b3 .& b4 .& b5
        let valid_INSERT: u8x16 = kw_INSERT .& ldelim .& rdelim6
        c_insert = c_insert + to_i32(reduce_add(valid_INSERT))

        // COPY = C O P Y
        let d0: u8x16 = select(f0 .== v_C, v_one, v_zero)
        let d1: u8x16 = select(f1 .== v_O, v_one, v_zero)
        let d2: u8x16 = select(f2 .== v_P, v_one, v_zero)
        let d3: u8x16 = select(f3 .== v_Y, v_one, v_zero)
        let kw_COPY: u8x16 = d0 .& d1 .& d2 .& d3
        let valid_COPY: u8x16 = kw_COPY .& ldelim .& rdelim4
        c_copy = c_copy + to_i32(reduce_add(valid_COPY))

        let nl: u8x16 = select(c0 .== v_lf, v_one, v_zero)
        c_nl = c_nl + to_i32(reduce_add(nl))

        // Position recording: union of the three keyword masks.
        if max_positions > 0 {
            if out_n_positions[0] < max_positions {
                let any: u8x16 = valid_CREATE .| valid_INSERT .| valid_COPY
                let cnt: i32 = to_i32(reduce_add(any))
                if cnt > 0 {
                    store(scratch, 0, any)
                    let mut j: i32 = 0
                    while j < 16 {
                        if to_i32(scratch[j]) == 1 {
                            let cur: i32 = out_n_positions[0]
                            if cur < max_positions {
                                out_positions[cur] = i + j
                                out_n_positions[0] = cur + 1
                            }
                        }
                        j = j + 1
                    }
                }
            }
        }

        i = i + 16
    }

    // Scalar epilogue.
    p = i
    while p < len {
        if to_i32(text[p]) == 10 { c_nl = c_nl + 1 }
        scan_pos(text, p, len, out_counts, out_positions, max_positions, out_n_positions)
        p = p + 1
    }

    out_counts[0] = out_counts[0] + c_create
    out_counts[1] = out_counts[1] + c_insert
    out_counts[2] = out_counts[2] + c_copy
    out_counts[3] = c_nl
}
