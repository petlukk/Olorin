// q6k_gemm.ea — Q6K × Q8Kx4 GEMM kernel (x86 stub)
// ARM-only for now. x86 uses fallback path.

#[cfg(x86_64)]

export func q6k_gemm(
    weight: *restrict u8,
    q8_a: *restrict u8,
    scratch: *mut u8,
    out: *mut f32,
    output_stride: i32,
    n_inner: i32,
    nr: i32,
    nc: i32
) {
    // x86 stub — not optimized, used for testing only
    // Real inference on x86 falls through to matvec_batch_ws
    let mut r: i32 = 0
    while r < nc {
        let mut t: i32 = 0
        while t < nr {
            out[t * output_stride + r] = 0.0
            t = t + 1
        }
        r = r + 1
    }
}
