// gemma4_rope_batched.ea — Rotary Position Embeddings for N batched tokens.
//
// Applies gemma4_rope in-place to N columns of a {n_heads * head_dim, N}
// Q or K tensor, with per-column cos/sin tables. Each column represents a
// different absolute token position, so each column gets its own rotation.
//
// Caller responsibility: precompute cos/sin tables for N positions into
// concatenated buffers of length half_dim * N. Column k uses
// cos_tables[k * half_dim .. (k+1) * half_dim] and sin_tables similarly.
//
// Per-column body is a verbatim inline of kernels/gemma4_rope.ea, so
// output is bit-for-bit identical to looping gemma4_rope N times.

export func gemma4_rope_batched(
    data: *mut f32,                    // {n_heads * head_dim, n_batch}
    cos_tables: *restrict f32,         // {half_dim * n_batch}
    sin_tables: *restrict f32,         // {half_dim * n_batch}
    head_dim: i32,
    n_heads: i32,
    n_batch: i32
) {
    let half_dim: i32 = head_dim / 2
    let qk_stride: i32 = n_heads * head_dim

    let mut col: i32 = 0
    while col < n_batch {
        let data_base: i32 = col * qk_stride
        let cs_base: i32 = col * half_dim

        let mut h: i32 = 0
        while h < n_heads {
            let base: i32 = data_base + h * head_dim
            let mut d: i32 = 0
            while d < half_dim {
                let re: f32 = data[base + d]
                let im: f32 = data[base + d + half_dim]
                let c: f32 = cos_tables[cs_base + d]
                let s: f32 = sin_tables[cs_base + d]
                data[base + d] = re * c - im * s
                data[base + d + half_dim] = re * s + im * c
                d = d + 1
            }
            h = h + 1
        }
        col = col + 1
    }
}
