// f16_convert.ea — Bulk f32<->f16 conversion (x86 AVX2/F16C)
//
// Uses cvt_f16_f32/cvt_f32_f16 intrinsics (vcvtph2ps/vcvtps2ph).
// n must be a multiple of 8 (guaranteed for all inference dimensions).

#[cfg(x86_64)]

export func f32_to_f16(src: *restrict f32, dst: *mut u16, n: i32) {
    let dp: *mut i16 = ptr_as_i16(dst)
    let mut i: i32 = 0
    while i + 8 <= n {
        let v: f32x8 = load(src, i)
        let h: i16x8 = cvt_f32_f16(v)
        store(dp, i, h)
        i = i + 8
    }
}

export func f16_to_f32(src: *restrict u16, dst: *mut f32, n: i32) {
    let sp: *restrict i16 = ptr_as_i16(src)
    let mut i: i32 = 0
    while i + 8 <= n {
        let h: i16x8 = load(sp, i)
        let v: f32x8 = cvt_f16_f32(h)
        store(dst, i, v)
        i = i + 8
    }
}
