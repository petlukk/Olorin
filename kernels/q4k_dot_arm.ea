// q4k_dot_arm.ea — ARM NEON Q4_K × Q8_K dot product kernel
//
// Inline 6-bit scale unpacking from Q4K block headers.
// d_arr/dmin_arr pre-computed in Rust (f16→f32 + q8_d multiply).
// Vector-domain accumulation: one reduce_add per row per block.

#[cfg(aarch64)]

// Read unsigned byte from i8 pointer
func ubyte(p: *restrict i8, off: i32) -> i32 {
    return to_i32(p[off]) & 255
}

// Unpack scale at group j (0..3) from 12-byte packed header at p+sp
func get_scale(p: *restrict i8, sp: i32, j: i32) -> i32 {
    if j < 2 {
        return ubyte(p, sp + j*2) & 63
    }
    return (ubyte(p, sp + j*2 + 4) & 15) | ((ubyte(p, sp + j*2 - 4) >> 6) << 4)
}

func get_scale_hi(p: *restrict i8, sp: i32, j: i32) -> i32 {
    if j < 2 {
        return ubyte(p, sp + j*2 + 1) & 63
    }
    return (ubyte(p, sp + j*2 + 5) & 15) | ((ubyte(p, sp + j*2 - 3) >> 6) << 4)
}

// Mins correction for one row
func row_mins(p: *restrict i8, sp: i32, bsums: *restrict i32, bs: i32) -> i32 {
    let mut s: i32 = 0
    let mut k: i32 = 0
    while k < 4 {
        s = s + (ubyte(p, sp + 4 + k) & 63) * (bsums[bs + k*2] + bsums[bs + k*2 + 1])
        k = k + 1
    }
    k = 0
    while k < 4 {
        s = s + ((ubyte(p, sp + 8 + k) >> 4) | ((ubyte(p, sp + 4 + k) >> 6) << 4)) * (bsums[bs + 8 + k*2] + bsums[bs + 8 + k*2 + 1])
        k = k + 1
    }
    return s
}

// Single-row Q4_K × Q8_K with inline scale unpacking.
export func q4k_dot_q8k(
    q4: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    n_blocks: i32,
    d_arr: *restrict f32,
    dmin_arr: *restrict f32
) -> f32 {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut result: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let nib: i32 = bp + 16
        let q8_off: i32 = blk * 256
        let sp: i32 = bp + 4

        let mut vacc: i32x4 = splat(0)
        let mut j: i32 = 0
        while j < 4 {
            let pa: i8x16 = load(q4, nib + j * 32)
            let pb: i8x16 = load(q4, nib + j * 32 + 16)
            let qa: i8x16 = load(q8, q8_off + j * 64)
            let qb: i8x16 = load(q8, q8_off + j * 64 + 16)
            let qc: i8x16 = load(q8, q8_off + j * 64 + 32)
            let qd: i8x16 = load(q8, q8_off + j * 64 + 48)
            vacc = vacc .+ (vdot_i32(pa .& mask_lo, qa) .+ vdot_i32(pb .& mask_lo, qb)) .* splat(get_scale(q4, sp, j))
            vacc = vacc .+ (vdot_i32((pa .>> shift4) .& mask_lo, qc) .+ vdot_i32((pb .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(q4, sp, j))
            j = j + 1
        }

        result = result + d_arr[blk] * to_f32(reduce_add(vacc)) - dmin_arr[blk] * to_f32(row_mins(q4, sp, bsums, blk * 16))
        blk = blk + 1
    }
    return result
}

// 4-row Q4_K × Q8_K — inline scale unpacking, shared Q8 loads.
export func q4k_dot_q8k_4row(
    rw0: *restrict i8, rw1: *restrict i8, rw2: *restrict i8, rw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    out scores: *mut f32,
    n_blocks: i32,
    d0: *restrict f32, d1: *restrict f32, d2: *restrict f32, d3: *restrict f32,
    dm0: *restrict f32, dm1: *restrict f32, dm2: *restrict f32, dm3: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut res0: f32 = 0.0
    let mut res1: f32 = 0.0
    let mut res2: f32 = 0.0
    let mut res3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let nib: i32 = bp + 16
        let q8_off: i32 = blk * 256
        let sp: i32 = bp + 4
        let bs: i32 = blk * 16

        let mut v0: i32x4 = splat(0)
        let mut v1: i32x4 = splat(0)
        let mut v2: i32x4 = splat(0)
        let mut v3: i32x4 = splat(0)

        let mut j: i32 = 0
        while j < 4 {
            let qa: i8x16 = load(q8, q8_off + j * 64)
            let qb: i8x16 = load(q8, q8_off + j * 64 + 16)
            let qc: i8x16 = load(q8, q8_off + j * 64 + 32)
            let qd: i8x16 = load(q8, q8_off + j * 64 + 48)

            let p0a: i8x16 = load(rw0, nib + j*32)
            let p0b: i8x16 = load(rw0, nib + j*32 + 16)
            v0 = v0 .+ (vdot_i32(p0a .& mask_lo, qa) .+ vdot_i32(p0b .& mask_lo, qb)) .* splat(get_scale(rw0, sp, j))
            v0 = v0 .+ (vdot_i32((p0a .>> shift4) .& mask_lo, qc) .+ vdot_i32((p0b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(rw0, sp, j))

            let p1a: i8x16 = load(rw1, nib + j*32)
            let p1b: i8x16 = load(rw1, nib + j*32 + 16)
            v1 = v1 .+ (vdot_i32(p1a .& mask_lo, qa) .+ vdot_i32(p1b .& mask_lo, qb)) .* splat(get_scale(rw1, sp, j))
            v1 = v1 .+ (vdot_i32((p1a .>> shift4) .& mask_lo, qc) .+ vdot_i32((p1b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(rw1, sp, j))

            let p2a: i8x16 = load(rw2, nib + j*32)
            let p2b: i8x16 = load(rw2, nib + j*32 + 16)
            v2 = v2 .+ (vdot_i32(p2a .& mask_lo, qa) .+ vdot_i32(p2b .& mask_lo, qb)) .* splat(get_scale(rw2, sp, j))
            v2 = v2 .+ (vdot_i32((p2a .>> shift4) .& mask_lo, qc) .+ vdot_i32((p2b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(rw2, sp, j))

            let p3a: i8x16 = load(rw3, nib + j*32)
            let p3b: i8x16 = load(rw3, nib + j*32 + 16)
            v3 = v3 .+ (vdot_i32(p3a .& mask_lo, qa) .+ vdot_i32(p3b .& mask_lo, qb)) .* splat(get_scale(rw3, sp, j))
            v3 = v3 .+ (vdot_i32((p3a .>> shift4) .& mask_lo, qc) .+ vdot_i32((p3b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(rw3, sp, j))

            j = j + 1
        }

        res0 = res0 + d0[blk] * to_f32(reduce_add(v0)) - dm0[blk] * to_f32(row_mins(rw0, sp, bsums, bs))
        res1 = res1 + d1[blk] * to_f32(reduce_add(v1)) - dm1[blk] * to_f32(row_mins(rw1, sp, bsums, bs))
        res2 = res2 + d2[blk] * to_f32(reduce_add(v2)) - dm2[blk] * to_f32(row_mins(rw2, sp, bsums, bs))
        res3 = res3 + d3[blk] * to_f32(reduce_add(v3)) - dm3[blk] * to_f32(row_mins(rw3, sp, bsums, bs))

        blk = blk + 1
    }

    scores[0] = res0
    scores[1] = res1
    scores[2] = res2
    scores[3] = res3
}

// Dual 4-row: 4 gate + 4 up rows × shared activations.
export func q4k_dot_q8k_4row_dual(
    gw0: *restrict i8, gw1: *restrict i8, gw2: *restrict i8, gw3: *restrict i8,
    uw0: *restrict i8, uw1: *restrict i8, uw2: *restrict i8, uw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    out gate_scores: *mut f32,
    out up_scores: *mut f32,
    n_blocks: i32,
    gd0: *restrict f32, gd1: *restrict f32, gd2: *restrict f32, gd3: *restrict f32,
    gdm0: *restrict f32, gdm1: *restrict f32, gdm2: *restrict f32, gdm3: *restrict f32,
    ud0: *restrict f32, ud1: *restrict f32, ud2: *restrict f32, ud3: *restrict f32,
    udm0: *restrict f32, udm1: *restrict f32, udm2: *restrict f32, udm3: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut gr0: f32 = 0.0
    let mut gr1: f32 = 0.0
    let mut gr2: f32 = 0.0
    let mut gr3: f32 = 0.0
    let mut ur0: f32 = 0.0
    let mut ur1: f32 = 0.0
    let mut ur2: f32 = 0.0
    let mut ur3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let nib: i32 = bp + 16
        let q8_off: i32 = blk * 256
        let sp: i32 = bp + 4
        let bs: i32 = blk * 16

        let mut gv0: i32x4 = splat(0)
        let mut gv1: i32x4 = splat(0)
        let mut gv2: i32x4 = splat(0)
        let mut gv3: i32x4 = splat(0)
        let mut uv0: i32x4 = splat(0)
        let mut uv1: i32x4 = splat(0)
        let mut uv2: i32x4 = splat(0)
        let mut uv3: i32x4 = splat(0)

        let mut j: i32 = 0
        while j < 4 {
            let qa: i8x16 = load(q8, q8_off + j * 64)
            let qb: i8x16 = load(q8, q8_off + j * 64 + 16)
            let qc: i8x16 = load(q8, q8_off + j * 64 + 32)
            let qd: i8x16 = load(q8, q8_off + j * 64 + 48)

            let gp0a: i8x16 = load(gw0, nib + j*32)
            let gp0b: i8x16 = load(gw0, nib + j*32 + 16)
            let up0a: i8x16 = load(uw0, nib + j*32)
            let up0b: i8x16 = load(uw0, nib + j*32 + 16)
            gv0 = gv0 .+ (vdot_i32(gp0a .& mask_lo, qa) .+ vdot_i32(gp0b .& mask_lo, qb)) .* splat(get_scale(gw0, sp, j))
            gv0 = gv0 .+ (vdot_i32((gp0a .>> shift4) .& mask_lo, qc) .+ vdot_i32((gp0b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(gw0, sp, j))
            uv0 = uv0 .+ (vdot_i32(up0a .& mask_lo, qa) .+ vdot_i32(up0b .& mask_lo, qb)) .* splat(get_scale(uw0, sp, j))
            uv0 = uv0 .+ (vdot_i32((up0a .>> shift4) .& mask_lo, qc) .+ vdot_i32((up0b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(uw0, sp, j))

            let gp1a: i8x16 = load(gw1, nib + j*32)
            let gp1b: i8x16 = load(gw1, nib + j*32 + 16)
            let up1a: i8x16 = load(uw1, nib + j*32)
            let up1b: i8x16 = load(uw1, nib + j*32 + 16)
            gv1 = gv1 .+ (vdot_i32(gp1a .& mask_lo, qa) .+ vdot_i32(gp1b .& mask_lo, qb)) .* splat(get_scale(gw1, sp, j))
            gv1 = gv1 .+ (vdot_i32((gp1a .>> shift4) .& mask_lo, qc) .+ vdot_i32((gp1b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(gw1, sp, j))
            uv1 = uv1 .+ (vdot_i32(up1a .& mask_lo, qa) .+ vdot_i32(up1b .& mask_lo, qb)) .* splat(get_scale(uw1, sp, j))
            uv1 = uv1 .+ (vdot_i32((up1a .>> shift4) .& mask_lo, qc) .+ vdot_i32((up1b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(uw1, sp, j))

            let gp2a: i8x16 = load(gw2, nib + j*32)
            let gp2b: i8x16 = load(gw2, nib + j*32 + 16)
            let up2a: i8x16 = load(uw2, nib + j*32)
            let up2b: i8x16 = load(uw2, nib + j*32 + 16)
            gv2 = gv2 .+ (vdot_i32(gp2a .& mask_lo, qa) .+ vdot_i32(gp2b .& mask_lo, qb)) .* splat(get_scale(gw2, sp, j))
            gv2 = gv2 .+ (vdot_i32((gp2a .>> shift4) .& mask_lo, qc) .+ vdot_i32((gp2b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(gw2, sp, j))
            uv2 = uv2 .+ (vdot_i32(up2a .& mask_lo, qa) .+ vdot_i32(up2b .& mask_lo, qb)) .* splat(get_scale(uw2, sp, j))
            uv2 = uv2 .+ (vdot_i32((up2a .>> shift4) .& mask_lo, qc) .+ vdot_i32((up2b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(uw2, sp, j))

            let gp3a: i8x16 = load(gw3, nib + j*32)
            let gp3b: i8x16 = load(gw3, nib + j*32 + 16)
            let up3a: i8x16 = load(uw3, nib + j*32)
            let up3b: i8x16 = load(uw3, nib + j*32 + 16)
            gv3 = gv3 .+ (vdot_i32(gp3a .& mask_lo, qa) .+ vdot_i32(gp3b .& mask_lo, qb)) .* splat(get_scale(gw3, sp, j))
            gv3 = gv3 .+ (vdot_i32((gp3a .>> shift4) .& mask_lo, qc) .+ vdot_i32((gp3b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(gw3, sp, j))
            uv3 = uv3 .+ (vdot_i32(up3a .& mask_lo, qa) .+ vdot_i32(up3b .& mask_lo, qb)) .* splat(get_scale(uw3, sp, j))
            uv3 = uv3 .+ (vdot_i32((up3a .>> shift4) .& mask_lo, qc) .+ vdot_i32((up3b .>> shift4) .& mask_lo, qd)) .* splat(get_scale_hi(uw3, sp, j))

            j = j + 1
        }

        gr0 = gr0 + gd0[blk] * to_f32(reduce_add(gv0)) - gdm0[blk] * to_f32(row_mins(gw0, sp, bsums, bs))
        gr1 = gr1 + gd1[blk] * to_f32(reduce_add(gv1)) - gdm1[blk] * to_f32(row_mins(gw1, sp, bsums, bs))
        gr2 = gr2 + gd2[blk] * to_f32(reduce_add(gv2)) - gdm2[blk] * to_f32(row_mins(gw2, sp, bsums, bs))
        gr3 = gr3 + gd3[blk] * to_f32(reduce_add(gv3)) - gdm3[blk] * to_f32(row_mins(gw3, sp, bsums, bs))
        ur0 = ur0 + ud0[blk] * to_f32(reduce_add(uv0)) - udm0[blk] * to_f32(row_mins(uw0, sp, bsums, bs))
        ur1 = ur1 + ud1[blk] * to_f32(reduce_add(uv1)) - udm1[blk] * to_f32(row_mins(uw1, sp, bsums, bs))
        ur2 = ur2 + ud2[blk] * to_f32(reduce_add(uv2)) - udm2[blk] * to_f32(row_mins(uw2, sp, bsums, bs))
        ur3 = ur3 + ud3[blk] * to_f32(reduce_add(uv3)) - udm3[blk] * to_f32(row_mins(uw3, sp, bsums, bs))

        blk = blk + 1
    }

    gate_scores[0] = gr0
    gate_scores[1] = gr1
    gate_scores[2] = gr2
    gate_scores[3] = gr3
    up_scores[0] = ur0
    up_scores[1] = ur1
    up_scores[2] = ur2
    up_scores[3] = ur3
}
