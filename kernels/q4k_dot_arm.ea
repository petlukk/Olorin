// q4k_dot_arm.ea — ARM NEON Q4_K × Q8_K dot product kernel
//
// Optimized: scale multiplication stays in i32x4 vector domain.
// reduce_add called once per row per block instead of once per scale group.
// Q4 nibbles 0-15, signed i8 domain. vdotq_s32 (ARMv8.2-A+).

#[cfg(aarch64)]

// Single-row Q4_K × Q8_K dot product.
export func q4k_dot_q8k(
    q4: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    scales: *restrict u8,
    mins: *restrict u8,
    n_blocks: i32,
    d_arr: *restrict f32,
    dmin_arr: *restrict f32
) -> f32 {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut result: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let q4_off: i32 = blk * 144 + 16
        let q8_off: i32 = blk * 256
        let sc_off: i32 = blk * 8
        let bs_off: i32 = blk * 16

        let mut vacc: i32x4 = splat(0)

        let mut j: i32 = 0
        while j < 4 {
            let p0: i8x16 = load(q4, q4_off + j * 32)
            let p1: i8x16 = load(q4, q4_off + j * 32 + 16)
            let q8_a: i8x16 = load(q8, q8_off + j * 64)
            let q8_b: i8x16 = load(q8, q8_off + j * 64 + 16)
            let q8_c: i8x16 = load(q8, q8_off + j * 64 + 32)
            let q8_d: i8x16 = load(q8, q8_off + j * 64 + 48)

            let lo: i32x4 = vdot_i32(p0 .& mask_lo, q8_a) .+ vdot_i32(p1 .& mask_lo, q8_b)
            vacc = vacc .+ lo .* splat(to_i32(scales[sc_off + 2 * j]))

            let hi: i32x4 = vdot_i32((p0 .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((p1 .>> shift4) .& mask_lo, q8_d)
            vacc = vacc .+ hi .* splat(to_i32(scales[sc_off + 2 * j + 1]))

            j = j + 1
        }

        let sumi: i32 = reduce_add(vacc)

        let mut summs: i32 = 0
        j = 0
        while j < 8 {
            summs = summs + to_i32(mins[sc_off + j]) * (bsums[bs_off + 2 * j] + bsums[bs_off + 2 * j + 1])
            j = j + 1
        }

        result = result + d_arr[blk] * to_f32(sumi) - dmin_arr[blk] * to_f32(summs)
        blk = blk + 1
    }

    return result
}

// 4-row Q4_K × Q8_K dot product: 4 weight rows × shared activations.
// Vector-domain scale accumulation: 4 reduces per block instead of 32.
export func q4k_dot_q8k_4row(
    rw0: *restrict i8, rw1: *restrict i8, rw2: *restrict i8, rw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    sc0: *restrict u8, sc1: *restrict u8, sc2: *restrict u8, sc3: *restrict u8,
    mn0: *restrict u8, mn1: *restrict u8, mn2: *restrict u8, mn3: *restrict u8,
    out scores: *mut f32 [cap: 4],
    n_blocks: i32,
    d0_arr: *restrict f32, d1_arr: *restrict f32, d2_arr: *restrict f32, d3_arr: *restrict f32,
    dm0_arr: *restrict f32, dm1_arr: *restrict f32, dm2_arr: *restrict f32, dm3_arr: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut res0: f32 = 0.0
    let mut res1: f32 = 0.0
    let mut res2: f32 = 0.0
    let mut res3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let q4_off: i32 = blk * 144 + 16
        let q8_off: i32 = blk * 256
        let sc_off: i32 = blk * 8
        let bs_off: i32 = blk * 16

        let mut vacc0: i32x4 = splat(0)
        let mut vacc1: i32x4 = splat(0)
        let mut vacc2: i32x4 = splat(0)
        let mut vacc3: i32x4 = splat(0)

        let mut j: i32 = 0
        while j < 4 {
            let q8_a: i8x16 = load(q8, q8_off + j * 64)
            let q8_b: i8x16 = load(q8, q8_off + j * 64 + 16)
            let q8_c: i8x16 = load(q8, q8_off + j * 64 + 32)
            let q8_d: i8x16 = load(q8, q8_off + j * 64 + 48)

            let s_lo0: i32x4 = splat(to_i32(sc0[sc_off + 2*j]))
            let s_hi0: i32x4 = splat(to_i32(sc0[sc_off + 2*j + 1]))
            let s_lo1: i32x4 = splat(to_i32(sc1[sc_off + 2*j]))
            let s_hi1: i32x4 = splat(to_i32(sc1[sc_off + 2*j + 1]))
            let s_lo2: i32x4 = splat(to_i32(sc2[sc_off + 2*j]))
            let s_hi2: i32x4 = splat(to_i32(sc2[sc_off + 2*j + 1]))
            let s_lo3: i32x4 = splat(to_i32(sc3[sc_off + 2*j]))
            let s_hi3: i32x4 = splat(to_i32(sc3[sc_off + 2*j + 1]))

            let p0a: i8x16 = load(rw0, q4_off + j * 32)
            let p0b: i8x16 = load(rw0, q4_off + j * 32 + 16)
            vacc0 = vacc0 .+ (vdot_i32(p0a .& mask_lo, q8_a) .+ vdot_i32(p0b .& mask_lo, q8_b)) .* s_lo0
            vacc0 = vacc0 .+ (vdot_i32((p0a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((p0b .>> shift4) .& mask_lo, q8_d)) .* s_hi0

            let p1a: i8x16 = load(rw1, q4_off + j * 32)
            let p1b: i8x16 = load(rw1, q4_off + j * 32 + 16)
            vacc1 = vacc1 .+ (vdot_i32(p1a .& mask_lo, q8_a) .+ vdot_i32(p1b .& mask_lo, q8_b)) .* s_lo1
            vacc1 = vacc1 .+ (vdot_i32((p1a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((p1b .>> shift4) .& mask_lo, q8_d)) .* s_hi1

            let p2a: i8x16 = load(rw2, q4_off + j * 32)
            let p2b: i8x16 = load(rw2, q4_off + j * 32 + 16)
            vacc2 = vacc2 .+ (vdot_i32(p2a .& mask_lo, q8_a) .+ vdot_i32(p2b .& mask_lo, q8_b)) .* s_lo2
            vacc2 = vacc2 .+ (vdot_i32((p2a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((p2b .>> shift4) .& mask_lo, q8_d)) .* s_hi2

            let p3a: i8x16 = load(rw3, q4_off + j * 32)
            let p3b: i8x16 = load(rw3, q4_off + j * 32 + 16)
            vacc3 = vacc3 .+ (vdot_i32(p3a .& mask_lo, q8_a) .+ vdot_i32(p3b .& mask_lo, q8_b)) .* s_lo3
            vacc3 = vacc3 .+ (vdot_i32((p3a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((p3b .>> shift4) .& mask_lo, q8_d)) .* s_hi3

            j = j + 1
        }

        let sumi0: i32 = reduce_add(vacc0)
        let sumi1: i32 = reduce_add(vacc1)
        let sumi2: i32 = reduce_add(vacc2)
        let sumi3: i32 = reduce_add(vacc3)

        let mut summs0: i32 = 0
        let mut summs1: i32 = 0
        let mut summs2: i32 = 0
        let mut summs3: i32 = 0
        j = 0
        while j < 8 {
            let bs_pair: i32 = bsums[bs_off + 2*j] + bsums[bs_off + 2*j + 1]
            summs0 = summs0 + to_i32(mn0[sc_off + j]) * bs_pair
            summs1 = summs1 + to_i32(mn1[sc_off + j]) * bs_pair
            summs2 = summs2 + to_i32(mn2[sc_off + j]) * bs_pair
            summs3 = summs3 + to_i32(mn3[sc_off + j]) * bs_pair
            j = j + 1
        }

        res0 = res0 + d0_arr[blk] * to_f32(sumi0) - dm0_arr[blk] * to_f32(summs0)
        res1 = res1 + d1_arr[blk] * to_f32(sumi1) - dm1_arr[blk] * to_f32(summs1)
        res2 = res2 + d2_arr[blk] * to_f32(sumi2) - dm2_arr[blk] * to_f32(summs2)
        res3 = res3 + d3_arr[blk] * to_f32(sumi3) - dm3_arr[blk] * to_f32(summs3)

        blk = blk + 1
    }

    scores[0] = res0
    scores[1] = res1
    scores[2] = res2
    scores[3] = res3
}

// Dual 4-row: 4 gate + 4 up rows × shared activations.
// 8 vector accumulators, 8 reduces per block instead of 64.
export func q4k_dot_q8k_4row_dual(
    gw0: *restrict i8, gw1: *restrict i8, gw2: *restrict i8, gw3: *restrict i8,
    uw0: *restrict i8, uw1: *restrict i8, uw2: *restrict i8, uw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    gsc0: *restrict u8, gsc1: *restrict u8, gsc2: *restrict u8, gsc3: *restrict u8,
    gmn0: *restrict u8, gmn1: *restrict u8, gmn2: *restrict u8, gmn3: *restrict u8,
    usc0: *restrict u8, usc1: *restrict u8, usc2: *restrict u8, usc3: *restrict u8,
    umn0: *restrict u8, umn1: *restrict u8, umn2: *restrict u8, umn3: *restrict u8,
    out gate_scores: *mut f32 [cap: 4],
    out up_scores: *mut f32 [cap: 4],
    n_blocks: i32,
    gd0: *restrict f32, gd1: *restrict f32, gd2: *restrict f32, gd3: *restrict f32,
    gdm0: *restrict f32, gdm1: *restrict f32, gdm2: *restrict f32, gdm3: *restrict f32,
    ud0: *restrict f32, ud1: *restrict f32, ud2: *restrict f32, ud3: *restrict f32,
    udm0: *restrict f32, udm1: *restrict f32, udm2: *restrict f32, udm3: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut gr0: f32 = 0.0
    let mut gr1: f32 = 0.0
    let mut gr2: f32 = 0.0
    let mut gr3: f32 = 0.0
    let mut ur0: f32 = 0.0
    let mut ur1: f32 = 0.0
    let mut ur2: f32 = 0.0
    let mut ur3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let q4_off: i32 = blk * 144 + 16
        let q8_off: i32 = blk * 256
        let sc_off: i32 = blk * 8
        let bs_off: i32 = blk * 16

        let mut gv0: i32x4 = splat(0)
        let mut gv1: i32x4 = splat(0)
        let mut gv2: i32x4 = splat(0)
        let mut gv3: i32x4 = splat(0)
        let mut uv0: i32x4 = splat(0)
        let mut uv1: i32x4 = splat(0)
        let mut uv2: i32x4 = splat(0)
        let mut uv3: i32x4 = splat(0)

        let mut j: i32 = 0
        while j < 4 {
            let q8_a: i8x16 = load(q8, q8_off + j * 64)
            let q8_b: i8x16 = load(q8, q8_off + j * 64 + 16)
            let q8_c: i8x16 = load(q8, q8_off + j * 64 + 32)
            let q8_d: i8x16 = load(q8, q8_off + j * 64 + 48)

            // Row 0: gate + up
            let gp0a: i8x16 = load(gw0, q4_off + j * 32)
            let gp0b: i8x16 = load(gw0, q4_off + j * 32 + 16)
            let up0a: i8x16 = load(uw0, q4_off + j * 32)
            let up0b: i8x16 = load(uw0, q4_off + j * 32 + 16)
            let gs_lo: i32x4 = splat(to_i32(gsc0[sc_off + 2*j]))
            let gs_hi: i32x4 = splat(to_i32(gsc0[sc_off + 2*j+1]))
            let us_lo: i32x4 = splat(to_i32(usc0[sc_off + 2*j]))
            let us_hi: i32x4 = splat(to_i32(usc0[sc_off + 2*j+1]))
            gv0 = gv0 .+ (vdot_i32(gp0a .& mask_lo, q8_a) .+ vdot_i32(gp0b .& mask_lo, q8_b)) .* gs_lo
            gv0 = gv0 .+ (vdot_i32((gp0a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((gp0b .>> shift4) .& mask_lo, q8_d)) .* gs_hi
            uv0 = uv0 .+ (vdot_i32(up0a .& mask_lo, q8_a) .+ vdot_i32(up0b .& mask_lo, q8_b)) .* us_lo
            uv0 = uv0 .+ (vdot_i32((up0a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((up0b .>> shift4) .& mask_lo, q8_d)) .* us_hi

            // Row 1
            let gp1a: i8x16 = load(gw1, q4_off + j * 32)
            let gp1b: i8x16 = load(gw1, q4_off + j * 32 + 16)
            let up1a: i8x16 = load(uw1, q4_off + j * 32)
            let up1b: i8x16 = load(uw1, q4_off + j * 32 + 16)
            let gs1_lo: i32x4 = splat(to_i32(gsc1[sc_off + 2*j]))
            let gs1_hi: i32x4 = splat(to_i32(gsc1[sc_off + 2*j+1]))
            let us1_lo: i32x4 = splat(to_i32(usc1[sc_off + 2*j]))
            let us1_hi: i32x4 = splat(to_i32(usc1[sc_off + 2*j+1]))
            gv1 = gv1 .+ (vdot_i32(gp1a .& mask_lo, q8_a) .+ vdot_i32(gp1b .& mask_lo, q8_b)) .* gs1_lo
            gv1 = gv1 .+ (vdot_i32((gp1a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((gp1b .>> shift4) .& mask_lo, q8_d)) .* gs1_hi
            uv1 = uv1 .+ (vdot_i32(up1a .& mask_lo, q8_a) .+ vdot_i32(up1b .& mask_lo, q8_b)) .* us1_lo
            uv1 = uv1 .+ (vdot_i32((up1a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((up1b .>> shift4) .& mask_lo, q8_d)) .* us1_hi

            // Row 2
            let gp2a: i8x16 = load(gw2, q4_off + j * 32)
            let gp2b: i8x16 = load(gw2, q4_off + j * 32 + 16)
            let up2a: i8x16 = load(uw2, q4_off + j * 32)
            let up2b: i8x16 = load(uw2, q4_off + j * 32 + 16)
            let gs2_lo: i32x4 = splat(to_i32(gsc2[sc_off + 2*j]))
            let gs2_hi: i32x4 = splat(to_i32(gsc2[sc_off + 2*j+1]))
            let us2_lo: i32x4 = splat(to_i32(usc2[sc_off + 2*j]))
            let us2_hi: i32x4 = splat(to_i32(usc2[sc_off + 2*j+1]))
            gv2 = gv2 .+ (vdot_i32(gp2a .& mask_lo, q8_a) .+ vdot_i32(gp2b .& mask_lo, q8_b)) .* gs2_lo
            gv2 = gv2 .+ (vdot_i32((gp2a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((gp2b .>> shift4) .& mask_lo, q8_d)) .* gs2_hi
            uv2 = uv2 .+ (vdot_i32(up2a .& mask_lo, q8_a) .+ vdot_i32(up2b .& mask_lo, q8_b)) .* us2_lo
            uv2 = uv2 .+ (vdot_i32((up2a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((up2b .>> shift4) .& mask_lo, q8_d)) .* us2_hi

            // Row 3
            let gp3a: i8x16 = load(gw3, q4_off + j * 32)
            let gp3b: i8x16 = load(gw3, q4_off + j * 32 + 16)
            let up3a: i8x16 = load(uw3, q4_off + j * 32)
            let up3b: i8x16 = load(uw3, q4_off + j * 32 + 16)
            let gs3_lo: i32x4 = splat(to_i32(gsc3[sc_off + 2*j]))
            let gs3_hi: i32x4 = splat(to_i32(gsc3[sc_off + 2*j+1]))
            let us3_lo: i32x4 = splat(to_i32(usc3[sc_off + 2*j]))
            let us3_hi: i32x4 = splat(to_i32(usc3[sc_off + 2*j+1]))
            gv3 = gv3 .+ (vdot_i32(gp3a .& mask_lo, q8_a) .+ vdot_i32(gp3b .& mask_lo, q8_b)) .* gs3_lo
            gv3 = gv3 .+ (vdot_i32((gp3a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((gp3b .>> shift4) .& mask_lo, q8_d)) .* gs3_hi
            uv3 = uv3 .+ (vdot_i32(up3a .& mask_lo, q8_a) .+ vdot_i32(up3b .& mask_lo, q8_b)) .* us3_lo
            uv3 = uv3 .+ (vdot_i32((up3a .>> shift4) .& mask_lo, q8_c) .+ vdot_i32((up3b .>> shift4) .& mask_lo, q8_d)) .* us3_hi

            j = j + 1
        }

        // 8 reduces instead of 64
        let gs0: i32 = reduce_add(gv0)
        let gs1: i32 = reduce_add(gv1)
        let gs2: i32 = reduce_add(gv2)
        let gs3: i32 = reduce_add(gv3)
        let us0: i32 = reduce_add(uv0)
        let us1: i32 = reduce_add(uv1)
        let us2: i32 = reduce_add(uv2)
        let us3: i32 = reduce_add(uv3)

        let mut gm0: i32 = 0
        let mut gm1: i32 = 0
        let mut gm2: i32 = 0
        let mut gm3: i32 = 0
        let mut um0: i32 = 0
        let mut um1: i32 = 0
        let mut um2: i32 = 0
        let mut um3: i32 = 0
        j = 0
        while j < 8 {
            let bs_pair: i32 = bsums[bs_off + 2*j] + bsums[bs_off + 2*j + 1]
            gm0 = gm0 + to_i32(gmn0[sc_off + j]) * bs_pair
            gm1 = gm1 + to_i32(gmn1[sc_off + j]) * bs_pair
            gm2 = gm2 + to_i32(gmn2[sc_off + j]) * bs_pair
            gm3 = gm3 + to_i32(gmn3[sc_off + j]) * bs_pair
            um0 = um0 + to_i32(umn0[sc_off + j]) * bs_pair
            um1 = um1 + to_i32(umn1[sc_off + j]) * bs_pair
            um2 = um2 + to_i32(umn2[sc_off + j]) * bs_pair
            um3 = um3 + to_i32(umn3[sc_off + j]) * bs_pair
            j = j + 1
        }

        gr0 = gr0 + gd0[blk] * to_f32(gs0) - gdm0[blk] * to_f32(gm0)
        gr1 = gr1 + gd1[blk] * to_f32(gs1) - gdm1[blk] * to_f32(gm1)
        gr2 = gr2 + gd2[blk] * to_f32(gs2) - gdm2[blk] * to_f32(gm2)
        gr3 = gr3 + gd3[blk] * to_f32(gs3) - gdm3[blk] * to_f32(gm3)
        ur0 = ur0 + ud0[blk] * to_f32(us0) - udm0[blk] * to_f32(um0)
        ur1 = ur1 + ud1[blk] * to_f32(us1) - udm1[blk] * to_f32(um1)
        ur2 = ur2 + ud2[blk] * to_f32(us2) - udm2[blk] * to_f32(um2)
        ur3 = ur3 + ud3[blk] * to_f32(us3) - udm3[blk] * to_f32(um3)

        blk = blk + 1
    }

    gate_scores[0] = gr0
    gate_scores[1] = gr1
    gate_scores[2] = gr2
    gate_scores[3] = gr3
    up_scores[0] = ur0
    up_scores[1] = ur1
    up_scores[2] = ur2
    up_scores[3] = ur3
}
