// q4k_dot_arm.ea — ARM NEON Q4_K × Q8_K dot product kernel
//
// Inline f16→f32 d/dmin via cvt_f16_f32 (fcvtl) + lane extract.
// NEON DOTPROD (sdot/vdot) for accumulation.
// SIMD mins: addp_i16 bsums pairing + vector literal mins + wmul_i32.
// pow2 unused on ARM — kept for ABI compat with x86 kernel.

#[cfg(aarch64)]

func read_u32(p: *restrict i8, off: i32) -> i32 {
    let p32: *restrict i32 = ptr_as_i32(p)
    return p32[off / 4]
}

// Read d (lane 0) and dmin (lane 1) from Q4K block header via fcvtl.
func f16_d_dm(p: *restrict i8, bp: i32) -> f32x4 {
    let ph: *restrict i16 = ptr_as_i16(p)
    let raw: i16x4 = load(ph, bp / 2)
    return cvt_f16_f32(raw)
}

// Mins correction — fully SIMD: addp_i16 + vector literal mins + wmul_i32.
// Matches llama.cpp NEON: vpaddq_s16 + vmovl_u8 + vmull_s16 + vaddvq_s32.
func mins_corr(rw: *restrict i8, sp: i32, bsums: *restrict i16, bs: i32) -> i32 {
    let u1: i32 = read_u32(rw, sp + 4)
    let u2: i32 = read_u32(rw, sp + 8)
    let mn0: i32 = u1 & 0x3f3f3f3f
    let mn1: i32 = ((u2 >> 4) & 0x0f0f0f0f) | (((u1 >> 6) & 0x03030303) << 4)

    let bs_lo: i16x8 = load(bsums, bs)
    let bs_hi: i16x8 = load(bsums, bs + 8)
    let paired: i16x8 = addp_i16(bs_lo, bs_hi)

    // Scalar mins correction — avoids i16x8→i16x4 shuffle limitation.
    // 8 multiply-adds is negligible vs the dot product itself.
    let mut corr: i32 = 0
    let m0: i32 = mn0 & 255
    let m1: i32 = (mn0 >> 8) & 255
    let m2: i32 = (mn0 >> 16) & 255
    let m3: i32 = (mn0 >> 24) & 255
    let m4: i32 = mn1 & 255
    let m5: i32 = (mn1 >> 8) & 255
    let m6: i32 = (mn1 >> 16) & 255
    let m7: i32 = (mn1 >> 24) & 255
    corr = corr + m0 * to_i32(paired[0]) + m1 * to_i32(paired[1])
    corr = corr + m2 * to_i32(paired[2]) + m3 * to_i32(paired[3])
    corr = corr + m4 * to_i32(paired[4]) + m5 * to_i32(paired[5])
    corr = corr + m6 * to_i32(paired[6]) + m7 * to_i32(paired[7])
    return corr
}

// Mins correction with pre-paired bsums (avoids redundant addp in 4row/dual).
func mins_corr_bp(rw: *restrict i8, sp: i32, paired: i16x8) -> i32 {
    let u1: i32 = read_u32(rw, sp + 4)
    let u2: i32 = read_u32(rw, sp + 8)
    let mn0: i32 = u1 & 0x3f3f3f3f
    let mn1: i32 = ((u2 >> 4) & 0x0f0f0f0f) | (((u1 >> 6) & 0x03030303) << 4)

    let mut corr: i32 = 0
    let m0: i32 = mn0 & 255
    let m1: i32 = (mn0 >> 8) & 255
    let m2: i32 = (mn0 >> 16) & 255
    let m3: i32 = (mn0 >> 24) & 255
    let m4: i32 = mn1 & 255
    let m5: i32 = (mn1 >> 8) & 255
    let m6: i32 = (mn1 >> 16) & 255
    let m7: i32 = (mn1 >> 24) & 255
    corr = corr + m0 * to_i32(paired[0]) + m1 * to_i32(paired[1])
    corr = corr + m2 * to_i32(paired[2]) + m3 * to_i32(paired[3])
    corr = corr + m4 * to_i32(paired[4]) + m5 * to_i32(paired[5])
    corr = corr + m6 * to_i32(paired[6]) + m7 * to_i32(paired[7])
    return corr
}

// SIMD dot for one block: pre-extract scales via 2×u32, 4 groups × (lo + hi nibbles)
func dot_row(
    rw: *restrict i8, nib: i32, sp: i32,
    q8: *restrict i8, q8_off: i32,
    mask_lo: i8x16, shift4: i8x16
) -> i32 {
    // Pre-extract all 8 scales from 2 u32 reads
    let u0: i32 = read_u32(rw, sp)
    let u2: i32 = read_u32(rw, sp + 8)
    let sc03: i32 = u0 & 0x3f3f3f3f
    let sc47: i32 = (u2 & 0x0f0f0f0f) | (((u0 >> 6) & 0x03030303) << 4)

    // Pre-extract all 8 scales (matching x86 pattern exactly)
    let s0: i32 = sc03 & 255
    let s1: i32 = (sc03 >> 8) & 255
    let s2: i32 = (sc03 >> 16) & 255
    let s3: i32 = (sc03 >> 24) & 255
    let s4: i32 = sc47 & 255
    let s5: i32 = (sc47 >> 8) & 255
    let s6: i32 = (sc47 >> 16) & 255
    let s7: i32 = (sc47 >> 24) & 255

    let mut sumi: i32 = 0

    // 4 groups of 32 bytes each = 128 bytes of nibbles
    // Each group: lo nibble (32 elem) + hi nibble (32 elem) = 64 elements
    // 4 groups × 64 = 256 elements per block
    let mut wi: i32 = nib
    let mut qi: i32 = q8_off

    // Group 0: scale s0 (lo), s1 (hi)
    let pa0: i8x16 = load(rw, wi)
    let pb0: i8x16 = load(rw, wi + 16)
    let q0a: i8x16 = load(q8, qi)
    let q0b: i8x16 = load(q8, qi + 16)
    let q0c: i8x16 = load(q8, qi + 32)
    let q0d: i8x16 = load(q8, qi + 48)
    sumi = sumi + reduce_add(vdot_i32(pa0 .& mask_lo, q0a) .+ vdot_i32(pb0 .& mask_lo, q0b)) * s0
    sumi = sumi + reduce_add(vdot_i32((pa0 .>> shift4) .& mask_lo, q0c) .+ vdot_i32((pb0 .>> shift4) .& mask_lo, q0d)) * s1

    // Group 1: scale s2 (lo), s3 (hi)
    let pa1: i8x16 = load(rw, wi + 32)
    let pb1: i8x16 = load(rw, wi + 48)
    let q1a: i8x16 = load(q8, qi + 64)
    let q1b: i8x16 = load(q8, qi + 80)
    let q1c: i8x16 = load(q8, qi + 96)
    let q1d: i8x16 = load(q8, qi + 112)
    sumi = sumi + reduce_add(vdot_i32(pa1 .& mask_lo, q1a) .+ vdot_i32(pb1 .& mask_lo, q1b)) * s2
    sumi = sumi + reduce_add(vdot_i32((pa1 .>> shift4) .& mask_lo, q1c) .+ vdot_i32((pb1 .>> shift4) .& mask_lo, q1d)) * s3

    // Group 2: scale s4 (lo), s5 (hi)
    let pa2: i8x16 = load(rw, wi + 64)
    let pb2: i8x16 = load(rw, wi + 80)
    let q2a: i8x16 = load(q8, qi + 128)
    let q2b: i8x16 = load(q8, qi + 144)
    let q2c: i8x16 = load(q8, qi + 160)
    let q2d: i8x16 = load(q8, qi + 176)
    sumi = sumi + reduce_add(vdot_i32(pa2 .& mask_lo, q2a) .+ vdot_i32(pb2 .& mask_lo, q2b)) * s4
    sumi = sumi + reduce_add(vdot_i32((pa2 .>> shift4) .& mask_lo, q2c) .+ vdot_i32((pb2 .>> shift4) .& mask_lo, q2d)) * s5

    // Group 3: scale s6 (lo), s7 (hi)
    let pa3: i8x16 = load(rw, wi + 96)
    let pb3: i8x16 = load(rw, wi + 112)
    let q3a: i8x16 = load(q8, qi + 192)
    let q3b: i8x16 = load(q8, qi + 208)
    let q3c: i8x16 = load(q8, qi + 224)
    let q3d: i8x16 = load(q8, qi + 240)
    sumi = sumi + reduce_add(vdot_i32(pa3 .& mask_lo, q3a) .+ vdot_i32(pb3 .& mask_lo, q3b)) * s6
    sumi = sumi + reduce_add(vdot_i32((pa3 .>> shift4) .& mask_lo, q3c) .+ vdot_i32((pb3 .>> shift4) .& mask_lo, q3d)) * s7

    return sumi
}

// Single-row — inline f16 scales via fcvtl
export func q4k_dot_q8k(
    q4: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i16,
    n_blocks: i32,
    q8_d: *restrict f32,
    pow2: *restrict f32
) -> f32 {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut result: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sumi: i32 = dot_row(q4, bp + 16, bp + 4, q8, blk * 256, mask_lo, shift4)
        let dd: f32x4 = f16_d_dm(q4, bp)
        let qd: f32 = q8_d[blk]
        let d: f32 = dd[0] * qd
        let dm: f32 = dd[1] * qd
        result = result + d * to_f32(sumi) - dm * to_f32(mins_corr(q4, bp + 4, bsums, blk * 16))
        blk = blk + 1
    }
    return result
}

// 4-row — inline f16 scales, shared q8, hoisted bsums pairing
export func q4k_dot_q8k_4row(
    rw0: *restrict i8, rw1: *restrict i8, rw2: *restrict i8, rw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i16,
    out scores: *mut f32,
    n_blocks: i32,
    q8_d: *restrict f32,
    pow2: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut res0: f32 = 0.0
    let mut res1: f32 = 0.0
    let mut res2: f32 = 0.0
    let mut res3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256

        let s0: i32 = dot_row(rw0, nib, sp, q8, q8o, mask_lo, shift4)
        let s1: i32 = dot_row(rw1, nib, sp, q8, q8o, mask_lo, shift4)
        let s2: i32 = dot_row(rw2, nib, sp, q8, q8o, mask_lo, shift4)
        let s3: i32 = dot_row(rw3, nib, sp, q8, q8o, mask_lo, shift4)

        // Hoist bsums pairing — shared across all 4 rows
        let blo: i16x8 = load(bsums, blk * 16)
        let bhi: i16x8 = load(bsums, blk * 16 + 8)
        let paired: i16x8 = addp_i16(blo, bhi)

        let qd: f32 = q8_d[blk]
        let dd0: f32x4 = f16_d_dm(rw0, bp)
        let dd1: f32x4 = f16_d_dm(rw1, bp)
        let dd2: f32x4 = f16_d_dm(rw2, bp)
        let dd3: f32x4 = f16_d_dm(rw3, bp)
        res0 = res0 + dd0[0]*qd*to_f32(s0) - dd0[1]*qd*to_f32(mins_corr_bp(rw0, sp, paired))
        res1 = res1 + dd1[0]*qd*to_f32(s1) - dd1[1]*qd*to_f32(mins_corr_bp(rw1, sp, paired))
        res2 = res2 + dd2[0]*qd*to_f32(s2) - dd2[1]*qd*to_f32(mins_corr_bp(rw2, sp, paired))
        res3 = res3 + dd3[0]*qd*to_f32(s3) - dd3[1]*qd*to_f32(mins_corr_bp(rw3, sp, paired))

        blk = blk + 1
    }
    scores[0] = res0
    scores[1] = res1
    scores[2] = res2
    scores[3] = res3
}

// Dual 4-row (gate+up) — hoisted bsums pairing
export func q4k_dot_q8k_4row_dual(
    gw0: *restrict i8, gw1: *restrict i8, gw2: *restrict i8, gw3: *restrict i8,
    uw0: *restrict i8, uw1: *restrict i8, uw2: *restrict i8, uw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i16,
    out gate_scores: *mut f32,
    out up_scores: *mut f32,
    n_blocks: i32,
    q8_d: *restrict f32,
    pow2: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut gr0: f32 = 0.0
    let mut gr1: f32 = 0.0
    let mut gr2: f32 = 0.0
    let mut gr3: f32 = 0.0
    let mut ur0: f32 = 0.0
    let mut ur1: f32 = 0.0
    let mut ur2: f32 = 0.0
    let mut ur3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256

        let gs0: i32 = dot_row(gw0, nib, sp, q8, q8o, mask_lo, shift4)
        let gs1: i32 = dot_row(gw1, nib, sp, q8, q8o, mask_lo, shift4)
        let gs2: i32 = dot_row(gw2, nib, sp, q8, q8o, mask_lo, shift4)
        let gs3: i32 = dot_row(gw3, nib, sp, q8, q8o, mask_lo, shift4)
        let us0: i32 = dot_row(uw0, nib, sp, q8, q8o, mask_lo, shift4)
        let us1: i32 = dot_row(uw1, nib, sp, q8, q8o, mask_lo, shift4)
        let us2: i32 = dot_row(uw2, nib, sp, q8, q8o, mask_lo, shift4)
        let us3: i32 = dot_row(uw3, nib, sp, q8, q8o, mask_lo, shift4)

        // Hoist bsums pairing — shared across all 8 rows
        let blo: i16x8 = load(bsums, blk * 16)
        let bhi: i16x8 = load(bsums, blk * 16 + 8)
        let paired: i16x8 = addp_i16(blo, bhi)

        let qd: f32 = q8_d[blk]
        let gd0: f32x4 = f16_d_dm(gw0, bp)
        let gd1: f32x4 = f16_d_dm(gw1, bp)
        let gd2: f32x4 = f16_d_dm(gw2, bp)
        let gd3: f32x4 = f16_d_dm(gw3, bp)
        let ud0: f32x4 = f16_d_dm(uw0, bp)
        let ud1: f32x4 = f16_d_dm(uw1, bp)
        let ud2: f32x4 = f16_d_dm(uw2, bp)
        let ud3: f32x4 = f16_d_dm(uw3, bp)
        gr0 = gr0 + gd0[0]*qd*to_f32(gs0) - gd0[1]*qd*to_f32(mins_corr_bp(gw0, sp, paired))
        gr1 = gr1 + gd1[0]*qd*to_f32(gs1) - gd1[1]*qd*to_f32(mins_corr_bp(gw1, sp, paired))
        gr2 = gr2 + gd2[0]*qd*to_f32(gs2) - gd2[1]*qd*to_f32(mins_corr_bp(gw2, sp, paired))
        gr3 = gr3 + gd3[0]*qd*to_f32(gs3) - gd3[1]*qd*to_f32(mins_corr_bp(gw3, sp, paired))
        ur0 = ur0 + ud0[0]*qd*to_f32(us0) - ud0[1]*qd*to_f32(mins_corr_bp(uw0, sp, paired))
        ur1 = ur1 + ud1[0]*qd*to_f32(us1) - ud1[1]*qd*to_f32(mins_corr_bp(uw1, sp, paired))
        ur2 = ur2 + ud2[0]*qd*to_f32(us2) - ud2[1]*qd*to_f32(mins_corr_bp(uw2, sp, paired))
        ur3 = ur3 + ud3[0]*qd*to_f32(us3) - ud3[1]*qd*to_f32(mins_corr_bp(uw3, sp, paired))

        blk = blk + 1
    }
    gate_scores[0] = gr0
    gate_scores[1] = gr1
    gate_scores[2] = gr2
    gate_scores[3] = gr3
    up_scores[0] = ur0
    up_scores[1] = ur1
    up_scores[2] = ur2
    up_scores[3] = ur3
}
