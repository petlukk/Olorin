// q4k_dot_arm.ea — ARM NEON Q4_K × Q8_K dot product kernel
//
// Inline f16→f32 d/dmin from block header. NEON DOTPROD for accumulation.
// Matches x86 q4k_dot.ea signature: (q4, q8, bsums, n_blocks, q8_d, pow2)

#[cfg(aarch64)]

func read_u32(p: *restrict i8, off: i32) -> i32 {
    let p32: *restrict i32 = ptr_as_i32(p)
    return p32[off / 4]
}

// Read f16 from Q4K block header via pow2 table (same as x86)
func f16_load(p: *restrict i8, off: i32, pow2: *restrict f32) -> f32 {
    let pu8: *restrict u8 = ptr_as_u8(p)
    let raw: i32 = (to_i32(pu8[off]) & 255) | ((to_i32(pu8[off + 1]) & 255) << 8)
    let exp: i32 = (raw >> 10) & 31
    if exp == 0 { return 0.0 } else { return pow2[exp] * (1.0 + to_f32(raw & 1023) * 0.0009765625) }
}

func scale_at(sc0: i32, sc1: i32, idx: i32) -> i32 {
    if idx < 4 {
        return (sc0 >> (idx * 8)) & 255
    }
    return (sc1 >> ((idx - 4) * 8)) & 255
}

func mins_corr(mn0: i32, mn1: i32, bsums: *restrict i32, bs: i32) -> i32 {
    return (mn0 & 255) * (bsums[bs] + bsums[bs+1])
         + ((mn0 >> 8) & 255) * (bsums[bs+2] + bsums[bs+3])
         + ((mn0 >> 16) & 255) * (bsums[bs+4] + bsums[bs+5])
         + ((mn0 >> 24) & 255) * (bsums[bs+6] + bsums[bs+7])
         + (mn1 & 255) * (bsums[bs+8] + bsums[bs+9])
         + ((mn1 >> 8) & 255) * (bsums[bs+10] + bsums[bs+11])
         + ((mn1 >> 16) & 255) * (bsums[bs+12] + bsums[bs+13])
         + ((mn1 >> 24) & 255) * (bsums[bs+14] + bsums[bs+15])
}

func row_mins(rw: *restrict i8, sp: i32, bsums: *restrict i32, bs: i32) -> i32 {
    let u1: i32 = read_u32(rw, sp + 4)
    let u2: i32 = read_u32(rw, sp + 8)
    let mn0: i32 = u1 & 0x3f3f3f3f
    let mn1: i32 = ((u2 >> 4) & 0x0f0f0f0f) | (((u1 >> 6) & 0x03030303) << 4)
    return mins_corr(mn0, mn1, bsums, bs)
}

// SIMD dot for one block: 4 × (load q4 nibbles, vdot with q8, scale)
func dot_row(
    rw: *restrict i8, nib: i32, sp: i32,
    q8: *restrict i8, q8_off: i32,
    mask_lo: i8x16, shift4: i8x16
) -> i32 {
    let u0: i32 = read_u32(rw, sp)
    let u2: i32 = read_u32(rw, sp + 8)
    let sc0: i32 = u0 & 0x3f3f3f3f
    let sc1: i32 = (u2 & 0x0f0f0f0f) | (((u0 >> 6) & 0x03030303) << 4)

    let mut sumi1: i32 = 0
    let mut sumi2: i32 = 0
    let mut wi: i32 = nib
    let mut qi: i32 = q8_off
    let mut si: i32 = 0
    while si < 8 {
        let pa: i8x16 = load(rw, wi)
        let pb: i8x16 = load(rw, wi + 16)
        let qa: i8x16 = load(q8, qi)
        let qb: i8x16 = load(q8, qi + 16)
        let p1: i32x4 = vdot_i32(pa .& mask_lo, qa) .+ vdot_i32(pb .& mask_lo, qb)
        sumi1 = sumi1 + reduce_add(p1) * scale_at(sc0, sc1, si)
        let qc: i8x16 = load(q8, qi + 32)
        let qd: i8x16 = load(q8, qi + 48)
        let p2: i32x4 = vdot_i32((pa .>> shift4) .& mask_lo, qc) .+ vdot_i32((pb .>> shift4) .& mask_lo, qd)
        sumi2 = sumi2 + reduce_add(p2) * scale_at(sc0, sc1, si + 1)
        wi = wi + 32
        qi = qi + 64
        si = si + 2
    }
    return sumi1 + sumi2
}

// Single-row — inline scales via pow2 table
export func q4k_dot_q8k(
    q4: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    n_blocks: i32,
    q8_d: *restrict f32,
    pow2: *restrict f32
) -> f32 {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut result: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sumi: i32 = dot_row(q4, bp + 16, bp + 4, q8, blk * 256, mask_lo, shift4)
        let qd: f32 = q8_d[blk]
        let d: f32 = f16_load(q4, bp, pow2) * qd
        let dm: f32 = f16_load(q4, bp + 2, pow2) * qd
        result = result + d * to_f32(sumi) - dm * to_f32(row_mins(q4, bp + 4, bsums, blk * 16))
        blk = blk + 1
    }
    return result
}

// 4-row — inline scales, shared q8
export func q4k_dot_q8k_4row(
    rw0: *restrict i8, rw1: *restrict i8, rw2: *restrict i8, rw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    out scores: *mut f32,
    n_blocks: i32,
    q8_d: *restrict f32,
    pow2: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut res0: f32 = 0.0
    let mut res1: f32 = 0.0
    let mut res2: f32 = 0.0
    let mut res3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256
        let bs: i32 = blk * 16

        let s0: i32 = dot_row(rw0, nib, sp, q8, q8o, mask_lo, shift4)
        let s1: i32 = dot_row(rw1, nib, sp, q8, q8o, mask_lo, shift4)
        let s2: i32 = dot_row(rw2, nib, sp, q8, q8o, mask_lo, shift4)
        let s3: i32 = dot_row(rw3, nib, sp, q8, q8o, mask_lo, shift4)

        let qd: f32 = q8_d[blk]
        res0 = res0 + f16_load(rw0, bp, pow2) * qd * to_f32(s0) - f16_load(rw0, bp+2, pow2) * qd * to_f32(row_mins(rw0, sp, bsums, bs))
        res1 = res1 + f16_load(rw1, bp, pow2) * qd * to_f32(s1) - f16_load(rw1, bp+2, pow2) * qd * to_f32(row_mins(rw1, sp, bsums, bs))
        res2 = res2 + f16_load(rw2, bp, pow2) * qd * to_f32(s2) - f16_load(rw2, bp+2, pow2) * qd * to_f32(row_mins(rw2, sp, bsums, bs))
        res3 = res3 + f16_load(rw3, bp, pow2) * qd * to_f32(s3) - f16_load(rw3, bp+2, pow2) * qd * to_f32(row_mins(rw3, sp, bsums, bs))

        blk = blk + 1
    }
    scores[0] = res0
    scores[1] = res1
    scores[2] = res2
    scores[3] = res3
}

// Dual 4-row (gate+up) — inline scales
export func q4k_dot_q8k_4row_dual(
    gw0: *restrict i8, gw1: *restrict i8, gw2: *restrict i8, gw3: *restrict i8,
    uw0: *restrict i8, uw1: *restrict i8, uw2: *restrict i8, uw3: *restrict i8,
    q8: *restrict i8,
    bsums: *restrict i32,
    out gate_scores: *mut f32,
    out up_scores: *mut f32,
    n_blocks: i32,
    q8_d: *restrict f32,
    pow2: *restrict f32
) {
    let mask_lo: i8x16 = splat(15)
    let shift4: i8x16 = splat(4)
    let mut gr0: f32 = 0.0
    let mut gr1: f32 = 0.0
    let mut gr2: f32 = 0.0
    let mut gr3: f32 = 0.0
    let mut ur0: f32 = 0.0
    let mut ur1: f32 = 0.0
    let mut ur2: f32 = 0.0
    let mut ur3: f32 = 0.0

    let mut blk: i32 = 0
    while blk < n_blocks {
        let bp: i32 = blk * 144
        let sp: i32 = bp + 4
        let nib: i32 = bp + 16
        let q8o: i32 = blk * 256
        let bs: i32 = blk * 16

        let gs0: i32 = dot_row(gw0, nib, sp, q8, q8o, mask_lo, shift4)
        let gs1: i32 = dot_row(gw1, nib, sp, q8, q8o, mask_lo, shift4)
        let gs2: i32 = dot_row(gw2, nib, sp, q8, q8o, mask_lo, shift4)
        let gs3: i32 = dot_row(gw3, nib, sp, q8, q8o, mask_lo, shift4)
        let us0: i32 = dot_row(uw0, nib, sp, q8, q8o, mask_lo, shift4)
        let us1: i32 = dot_row(uw1, nib, sp, q8, q8o, mask_lo, shift4)
        let us2: i32 = dot_row(uw2, nib, sp, q8, q8o, mask_lo, shift4)
        let us3: i32 = dot_row(uw3, nib, sp, q8, q8o, mask_lo, shift4)

        let qd: f32 = q8_d[blk]
        gr0 = gr0 + f16_load(gw0, bp, pow2)*qd*to_f32(gs0) - f16_load(gw0, bp+2, pow2)*qd*to_f32(row_mins(gw0, sp, bsums, bs))
        gr1 = gr1 + f16_load(gw1, bp, pow2)*qd*to_f32(gs1) - f16_load(gw1, bp+2, pow2)*qd*to_f32(row_mins(gw1, sp, bsums, bs))
        gr2 = gr2 + f16_load(gw2, bp, pow2)*qd*to_f32(gs2) - f16_load(gw2, bp+2, pow2)*qd*to_f32(row_mins(gw2, sp, bsums, bs))
        gr3 = gr3 + f16_load(gw3, bp, pow2)*qd*to_f32(gs3) - f16_load(gw3, bp+2, pow2)*qd*to_f32(row_mins(gw3, sp, bsums, bs))
        ur0 = ur0 + f16_load(uw0, bp, pow2)*qd*to_f32(us0) - f16_load(uw0, bp+2, pow2)*qd*to_f32(row_mins(uw0, sp, bsums, bs))
        ur1 = ur1 + f16_load(uw1, bp, pow2)*qd*to_f32(us1) - f16_load(uw1, bp+2, pow2)*qd*to_f32(row_mins(uw1, sp, bsums, bs))
        ur2 = ur2 + f16_load(uw2, bp, pow2)*qd*to_f32(us2) - f16_load(uw2, bp+2, pow2)*qd*to_f32(row_mins(uw2, sp, bsums, bs))
        ur3 = ur3 + f16_load(uw3, bp, pow2)*qd*to_f32(us3) - f16_load(uw3, bp+2, pow2)*qd*to_f32(row_mins(uw3, sp, bsums, bs))

        blk = blk + 1
    }
    gate_scores[0] = gr0
    gate_scores[1] = gr1
    gate_scores[2] = gr2
    gate_scores[3] = gr3
    up_scores[0] = ur0
    up_scores[1] = ur1
    up_scores[2] = ur2
    up_scores[3] = ur3
}
