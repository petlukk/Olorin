/target
*.so
*.ea.json

# Disassembly / IR dumps (debug output from `ea --emit-asm` and friends).
# These land in the repo root; keep them out of git.
/*.s
/*.ll
/*.o

# Internal docs and Claude Code workspace — local-only, not for remote.
# README.md remains tracked; public docs under /docs/ are listed below.
/CLAUDE.md
/docs/*
!/docs/runes.md
!/docs/architecture.md
!/docs/THIRD_PARTY.md
!/docs/images/
!/docs/images/**
/.claude/
*.pdf

# Robustness-campaign real datasets (fetched on demand, see benchmarks/robustness/SOURCES.md)
benchmarks/robustness/data/

# incident-lab: live-server-generated logs (the committed fixtures live in goldens/,
# which these globs don't reach since * doesn't cross /). Plus Python bytecode.
benchmarks/incident-lab/*.log
benchmarks/incident-lab/*.jsonl
benchmarks/incident-lab/*.syslog
benchmarks/incident-lab/version
benchmarks/incident-lab/__pycache__/
